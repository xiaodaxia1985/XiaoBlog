---
import { topics } from '../../data/topics.mjs';
import { getPublishedPosts } from '../../lib/insights';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

export function getStaticPaths() {
  return topics.map((topic) => ({ params: { slug: topic.slug }, props: { topic } }));
}

const { topic } = Astro.props;
const posts = (await getPublishedPosts()).filter((p) => p.topic === topic.title);
const siblings = topics.filter((t) => t.slug !== topic.slug);
const topicNo = topic.num.split('·')[0].trim();
---
<!DOCTYPE html>
<html lang="zh-CN" style="background:#0c0c0c;">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#0c0c0c">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<title>{topic.title} — 个人商业创造者</title>
<meta name="description" content={`${topic.definition} ${topic.title}方向的专题页：在写什么，以及已经发布的相关文章。`}>
<link rel="stylesheet" href="/fonts/fonts.css">
<link rel="stylesheet" href="/css/tokens.css">
<style is:global>
  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{font-family:'Noto Sans SC','Inter',-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Microsoft YaHei',sans-serif;font-size:var(--fs-16);line-height:var(--lh-body);background:var(--bg);color:var(--text);overflow-x:hidden;font-feature-settings:"palt" 1;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility;}
  ::selection{background:var(--accent);color:var(--accent-ink);}
  a{text-decoration:none;color:inherit;}
  ul,ol{list-style:none;}
  :focus-visible{outline:2px solid var(--accent);outline-offset:3px;border-radius:2px;}
  ::-webkit-scrollbar{width:8px;}
  ::-webkit-scrollbar-track{background:var(--bg);}
  ::-webkit-scrollbar-thumb{background:#2a2a2a;border-radius:4px;}

  .wrap{max-width:var(--container-w);margin:0 auto;padding:0 var(--gutter);}

  /* ===== 页头 ===== */
  .page-hero{padding:calc(64px + var(--space-40)) 0 var(--space-40);border-bottom:1px solid var(--border);}
  .crumb{display:flex;align-items:center;gap:var(--space-8);font-size:var(--fs-12);color:var(--text-muted);margin-bottom:var(--space-24);}
  .crumb a{transition:color .2s ease;}
  .crumb a:hover{color:var(--text);}
  .eyebrow{display:flex;align-items:center;gap:var(--space-8);font-size:var(--fs-12);color:var(--text-muted);margin-bottom:var(--space-16);}
  .eyebrow::before{content:'';width:6px;height:6px;border-radius:50%;background:var(--accent);flex-shrink:0;}
  .page-hero h1{font-size:var(--fs-48);font-weight:600;line-height:1.18;letter-spacing:0;margin-bottom:var(--space-12);text-wrap:balance;}
  .page-hero .definition{max-width:720px;font-size:var(--fs-20);line-height:var(--lh-tight);color:var(--text);}
  .page-hero .intro{max-width:720px;margin-top:var(--space-16);font-size:var(--fs-16);color:var(--text-secondary);}
  .page-hero .intro + .intro{margin-top:var(--space-12);}

  /* ===== 区块 ===== */
  .section{padding:var(--space-40) 0 var(--space-56);}
  .section + .section{padding-top:0;}
  .section-head{margin-bottom:var(--space-24);}
  .section-head h2{font-size:var(--fs-28);font-weight:600;line-height:1.3;letter-spacing:0;}

  /* 文章列表 */
  .post-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:var(--space-24);}
  .post-card{display:flex;flex-direction:column;gap:var(--space-8);min-height:200px;padding:var(--space-24);background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);transition:background-color .2s ease,border-color .2s ease;}
  .post-card:hover{background:var(--surface-2);border-color:rgba(255,255,255,.2);}
  .post-tag{align-self:flex-start;padding:2px 6px;border:1px solid var(--border);border-radius:4px;font-size:var(--fs-12);color:var(--text-muted);}
  .post-card h3{font-size:var(--fs-20);font-weight:600;line-height:1.4;letter-spacing:0;}
  .post-excerpt{flex:1;font-size:var(--fs-14);line-height:var(--lh-tight);color:var(--text-secondary);}
  .post-meta{font-family:'Inter',sans-serif;font-variant-numeric:tabular-nums;font-size:var(--fs-12);color:var(--text-muted);}

  /* 其他方向 */
  .siblings{display:grid;grid-template-columns:repeat(2,1fr);gap:var(--space-16);}
  .sibling{display:flex;flex-direction:column;gap:var(--space-8);padding:var(--space-24);background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);transition:background-color .2s ease,border-color .2s ease;}
  .sibling:hover{background:var(--surface-2);border-color:rgba(255,255,255,.2);}
  .sib-num{font-family:'Inter',sans-serif;font-variant-numeric:tabular-nums;font-size:var(--fs-12);color:var(--text-muted);}
  .sibling h3{font-size:var(--fs-16);font-weight:600;}
  .sibling p{font-size:var(--fs-14);color:var(--text-muted);line-height:var(--lh-tight);}
  .sibling .arrow{margin-top:var(--space-4);font-size:var(--fs-14);color:var(--text);}

  @media(max-width:768px){
    .page-hero{padding:calc(56px + var(--space-32)) 0 var(--space-32);}
    .page-hero h1{font-size:28px;line-height:1.25;}
    .page-hero .definition{font-size:var(--fs-16);}
    .page-hero .intro{font-size:var(--fs-14);}
    .post-grid{grid-template-columns:1fr;}
    .post-card{min-height:0;padding:var(--space-16);}
    .siblings{grid-template-columns:1fr;}
  }
</style>
</head>
<body>

<Nav active="focus" />

<header class="page-hero">
  <div class="wrap">
    <div class="crumb"><a href="/#focus">我在做什么</a><span aria-hidden="true">/</span><span>{topic.title}</span></div>
    <p class="eyebrow">{topicNo}</p>
    <h1>{topic.title}</h1>
    <p class="definition">{topic.definition}</p>
    {topic.intro.map((para) => <p class="intro">{para}</p>)}
  </div>
</header>

<main>
  {posts.length > 0 && (
    <section class="section" aria-labelledby="articlesTitle">
      <div class="wrap">
        <div class="section-head"><h2 id="articlesTitle">已经发布</h2></div>
        <div class="post-grid">
          {posts.map((post) => (
            <a class="post-card" href={post.url}>
              <span class="post-tag">{post.category}</span>
              <h3>{post.title}</h3>
              <p class="post-excerpt">{post.excerpt}</p>
              <span class="post-meta">{post.date} · {post.readTime}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="wrap">
      <div class="section-head"><h2>切换到其他方向</h2></div>
      <div class="siblings">
        {siblings.map((s) => (
          <a class="sibling" href={`/topics/${s.slug}`}>
            <span class="sib-num">{s.num.split('·')[0].trim()}</span>
            <h3>{s.title}</h3>
            <p>{s.definition}</p>
            <span class="arrow">进入专题 →</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</main>

<Footer />
</body>
</html>
