---
import { topics } from '../../data/topics.mjs';
import { getPublishedPosts } from '../../lib/insights';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

export function getStaticPaths() {
  return topics.map((topic) => ({ params: { slug: topic.slug }, props: { topic } }));
}

const { topic } = Astro.props;
const pageTitle = topic.title + ' — 个人商业创造者';
const pageDescription = topic.definition + ' ' + topic.title + '方向的专题页：主题介绍、实践思考与相关文章。';
const canonical = new URL('/topics/' + topic.slug + '/', Astro.site ?? 'https://xiaomaker.top').toString();
const posts = (await getPublishedPosts()).filter((p) => p.topic === topic.title);
const siblings = topics.filter((t) => t.slug !== topic.slug);
import { ClientRouter } from 'astro:transitions';
---
<!DOCTYPE html>
<html lang="zh-CN" style="background:#0c0c0c;">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#0c0c0c">
<meta name="color-scheme" content="dark">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<title>{pageTitle}</title>
<meta name="description" content={pageDescription}>
<link rel="canonical" href={canonical}>
<meta property="og:type" content="website">
<meta property="og:locale" content="zh_CN">
<meta property="og:title" content={pageTitle}>
<meta property="og:description" content={pageDescription}>
<meta property="og:url" content={canonical}>
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content={pageTitle}>
<meta name="twitter:description" content={pageDescription}>
<link rel="stylesheet" href="/fonts/fonts.css">
<link rel="stylesheet" href="/css/tokens.css">
<script is:inline>document.documentElement.classList.add('js');</script>
<script is:inline src="/js/site-shell.js" defer></script>
<style is:global>
  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{font-family:'Noto Sans SC','Inter',-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Microsoft YaHei',sans-serif;font-size:var(--fs-16);line-height:var(--lh-body);background:var(--bg);color:var(--text);overflow-x:hidden;font-feature-settings:"palt" 1;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility;}
  ::selection{background:var(--accent);color:var(--accent-ink);}
  a{text-decoration:none;color:inherit;}
  :focus-visible{outline:2px solid var(--accent);outline-offset:3px;border-radius:2px;}
  .wrap{max-width:1040px;margin:0 auto;padding:0 28px;}
  .page-hero{padding:calc(64px + 68px) 0 52px;}
  .crumb{display:flex;align-items:center;gap:10px;font-size:12px;color:var(--text-muted);margin-bottom:30px;}
  .crumb a:hover,.crumb a:focus-visible{color:var(--accent);}
  .eyebrow{font-family:'Inter','Noto Sans SC',sans-serif;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--accent);margin-bottom:18px;}
  .page-hero h1{font-size:clamp(34px,5vw,54px);font-weight:700;line-height:1.2;letter-spacing:-.025em;text-wrap:balance;max-width:820px;}
  .hero-point{font-size:clamp(19px,2.2vw,24px);line-height:1.55;font-weight:500;color:var(--text);margin-top:22px;max-width:760px;}
  .hero-definition{font-size:16px;line-height:1.9;color:var(--text-secondary);margin-top:12px;max-width:680px;}
  .hero-rule{width:52px;height:2px;background:var(--accent);margin-top:30px;}
  .intro{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(280px,.9fr);gap:64px;padding:36px 0 56px;border-top:1px solid var(--border);}
  .intro h2,.block-title{font-size:20px;font-weight:650;line-height:1.45;letter-spacing:-.01em;margin-bottom:16px;}
  .intro-copy p{font-size:15px;line-height:1.9;color:var(--text-secondary);}
  .intro-copy p+p{margin-top:14px;}
  .practice-note{border-left:2px solid var(--accent);padding:4px 0 4px 22px;align-self:start;}
  .practice-note .note-label{font-size:11px;letter-spacing:.12em;color:var(--accent);margin-bottom:12px;}
  .practice-note p{font-size:14px;line-height:1.9;color:var(--text-secondary);}
  .practice-note p+p{margin-top:12px;}
  .block{padding:42px 0 0;margin-top:0;border-top:1px solid var(--border);}
  .block-heading{display:flex;justify-content:space-between;align-items:baseline;gap:20px;margin-bottom:20px;}
  .block-heading h2{font-size:21px;font-weight:650;letter-spacing:-.01em;}
  .count{font-family:'Inter',sans-serif;font-size:12px;color:var(--text-muted);white-space:nowrap;}
  .post-list{border-top:1px solid var(--border);}
  .post-row{display:grid;grid-template-columns:minmax(0,1fr) 24px;gap:24px;align-items:center;padding:24px 4px;border-bottom:1px solid var(--border);transition:padding .2s ease,background .2s ease;}
  .post-row:hover,.post-row:focus-visible{padding-left:12px;padding-right:12px;background:rgba(255,255,255,.035);}
  .post-row:hover .post-title,.post-row:focus-visible .post-title{color:var(--accent);}
  .post-tag{display:inline-block;font-size:11px;letter-spacing:.04em;color:var(--text-muted);margin-bottom:9px;}
  .post-title{font-size:19px;font-weight:600;line-height:1.5;color:var(--text);transition:color .2s ease;text-wrap:balance;}
  .post-excerpt{margin-top:7px;font-size:14px;line-height:1.8;color:var(--text-secondary);max-width:720px;}
  .post-meta{margin-top:12px;font-family:'Inter','Noto Sans SC',sans-serif;font-size:11px;color:var(--text-muted);}
  .post-arrow{font-size:19px;color:var(--text-muted);transition:transform .2s ease;}
  .post-row:hover .post-arrow,.post-row:focus-visible .post-arrow{transform:translateX(4px);color:var(--accent);}
  .empty-row{padding:24px 0;font-size:14px;color:var(--text-secondary);}
  .more-topics{display:flex;flex-wrap:wrap;gap:12px;margin:20px 0 64px;}
  .topic-link{display:flex;align-items:center;gap:12px;padding:13px 17px;border:1px solid var(--border);min-width:220px;transition:border-color .2s ease,background .2s ease;}
  .topic-link:hover,.topic-link:focus-visible{border-color:rgba(216,242,107,.55);background:rgba(216,242,107,.045);}
  .topic-link span{font-size:14px;font-weight:550;}
  .topic-link small{font-size:11px;color:var(--text-muted);}
  .topic-link .arrow{margin-left:auto;color:var(--text-muted);}
  @media(max-width:768px){
    .wrap{padding:0 20px;}
    .page-hero{padding:calc(56px + 40px) 0 34px;}
    .crumb{margin-bottom:24px;}
    .page-hero h1{font-size:34px;line-height:1.25;}
    .hero-point{font-size:19px;margin-top:18px;}
    .hero-definition{font-size:14px;line-height:1.85;}
    .intro{grid-template-columns:1fr;gap:28px;padding:28px 0 38px;}
    .intro h2,.block-title{font-size:18px;}
    .intro-copy p{font-size:14px;}
    .practice-note{padding-left:17px;}
    .block{padding-top:32px;}
    .block-heading h2{font-size:19px;}
    .post-row{gap:12px;padding:20px 0;}
    .post-title{font-size:16px;}
    .post-excerpt{font-size:13px;}
    .more-topics{display:grid;grid-template-columns:1fr;margin-bottom:44px;}
    .topic-link{min-width:0;}
  }
  @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.post-row,.post-arrow{transition:none}}
</style>
  <ClientRouter fallback="swap" />
</head>
<body>
<Nav active="focus" />
<header class="page-hero">
  <div class="wrap">
    <div class="crumb"><a href="/#focus">我在做什么</a><span aria-hidden="true">/</span><span>{topic.title}</span></div>
    <p class="eyebrow">A FIELD OF PRACTICE</p>
    <h1>{topic.title}</h1>
    <p class="hero-point">{topic.point}</p>
    <p class="hero-definition">{topic.definition}</p>
    <div class="hero-rule" aria-hidden="true"></div>
  </div>
</header>
<main>
  <section class="wrap intro" aria-labelledby="introTitle">
    <div class="intro-copy">
      <h2 id="introTitle">我关注的问题</h2>
      <p>{topic.lens.theory}</p>
      <p>{topic.lens.method}</p>
    </div>
    <aside class="practice-note">
      <p class="note-label">FROM PRACTICE</p>
      {topic.lens.practice.map((text) => <p>{text}</p>)}
    </aside>
  </section>
  <section class="wrap block" aria-labelledby="articlesTitle">
    <div class="block-heading">
      <h2 id="articlesTitle">相关记录</h2>
      {posts.length > 0 && <span class="count">{posts.length} 篇文章</span>}
    </div>
    {posts.length > 0 ? (
      <div class="post-list">
        {posts.map((post) => (
          <a class="post-row" href={post.url}>
            <span>
              <span class="post-tag">{post.category}</span>
              <h3 class="post-title">{post.title}</h3>
              <span class="post-excerpt">{post.excerpt}</span>
              <span class="post-meta">{post.date} · {post.readTime}</span>
            </span>
            <span class="post-arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    ) : (
      <p class="empty-row">这个方向的第一批记录还在整理，稍后发布。</p>
    )}
  </section>
  <section class="wrap block" aria-labelledby="otherTopicsTitle">
    <div class="block-heading"><h2 id="otherTopicsTitle">继续探索</h2></div>
    <nav class="more-topics" aria-label="其他主题">
      {siblings.map((s) => (
        <a class="topic-link" href={`/topics/${s.slug}/`}>
          <span>{s.title}</span>
          <small>{s.point}</small>
          <span class="arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </nav>
  </section>
</main>
<Footer />
</body>
</html>
