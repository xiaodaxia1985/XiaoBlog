---
import { topics } from '../../data/topics.mjs';
import { getPublishedPosts } from '../../lib/insights';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

export function getStaticPaths() {
  return topics.map((topic) => ({ params: { slug: topic.slug }, props: { topic } }));
}

const { topic } = Astro.props;
const posts = (await getPublishedPosts()).filter((p) => p.topic === topic.title);
const siblings = topics.filter((t) => t.slug !== topic.slug);
const topicNo = topic.num.split('·')[0].trim();

const lens = [
  { num: '01', label: '这段方向在讲什么', title: topic.point, body: [topic.definition] },
  { num: '02', label: '理论', body: [topic.lens.theory] },
  { num: '03', label: '方法', body: [topic.lens.method] },
  { num: '04', label: '实践', body: topic.lens.practice },
];
---
<!DOCTYPE html>
<html lang="zh-CN" style="background:#0c0c0c;">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#0c0c0c">
<meta name="color-scheme" content="dark">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<title>{topic.title} — 个人商业创造者</title>
<meta name="description" content={`${topic.definition} ${topic.title}方向的专题页：在写什么，以及已经发布的相关文章。`}>
<link rel="stylesheet" href="/fonts/fonts.css">
<link rel="stylesheet" href="/css/tokens.css">
<script is:inline>document.documentElement.classList.add('js');</script>
<script is:inline src="/js/site-shell.js" defer></script>
<style is:global>
  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{font-family:'Noto Sans SC','Inter',-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Microsoft YaHei',sans-serif;font-size:var(--fs-16);line-height:var(--lh-body);background:var(--bg);color:var(--text);overflow-x:hidden;font-feature-settings:"palt" 1;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility;}
  ::selection{background:var(--accent);color:var(--accent-ink);}
  a{text-decoration:none;color:inherit;}
  ul,ol{list-style:none;}
  :focus-visible{outline:2px solid var(--accent);outline-offset:3px;border-radius:2px;}
  ::-webkit-scrollbar{width:8px;}
  ::-webkit-scrollbar-track{background:var(--bg);}
  ::-webkit-scrollbar-thumb{background:#2a2a2a;border-radius:4px;}

  .wrap{max-width:1040px;margin:0 auto;padding:0 24px;}

  /* ===== 页头 ===== */
  .page-hero{padding:calc(64px + 40px) 0 34px;}
  .crumb{display:flex;align-items:center;gap:var(--space-8);font-size:12px;color:var(--text-muted);margin-bottom:22px;}
  .crumb a:hover{color:var(--text);}
  .eyebrow{display:flex;align-items:baseline;gap:10px;font-family:'Inter',sans-serif;font-variant-numeric:tabular-nums;font-size:13px;letter-spacing:.04em;color:var(--accent);margin-bottom:12px;}
  .eyebrow span{font-family:'Noto Sans SC',sans-serif;font-size:10px;letter-spacing:.14em;color:var(--text-muted);}
  .page-hero h1{font-size:clamp(28px,3vw,36px);font-weight:700;line-height:1.28;letter-spacing:.004em;text-wrap:balance;}

  /* ===== 导语：四块 ===== */
  .lens{padding:6px 0 0;}
  .lens-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
  .lens-card{padding:20px 22px;border:1px solid var(--border);border-radius:2px;background:rgba(255,255,255,.022);}
  .lens-no{display:block;font-family:'Inter',sans-serif;font-size:19px;font-weight:700;line-height:1;letter-spacing:-.02em;color:var(--accent);margin-bottom:8px;font-variant-numeric:tabular-nums;}
  .lens-label{display:block;font-size:10px;letter-spacing:.14em;color:var(--text-muted);margin-bottom:10px;}
  .lens-title{font-size:16px;font-weight:600;line-height:1.5;color:var(--text);margin-bottom:10px;}
  .lens-card p{font-size:14.5px;line-height:1.8;color:var(--text-secondary);}
  .lens-card p + p{margin-top:12px;}

  /* ===== 区块 ===== */
  .block{padding:36px 0 0;margin-top:36px;border-top:1px solid rgba(255,255,255,.10);}
  .block-head{display:flex;align-items:baseline;gap:12px;margin-bottom:20px;}
  .block-no{font-family:'Inter',sans-serif;font-variant-numeric:tabular-nums;font-size:20px;font-weight:700;line-height:1;letter-spacing:-.02em;color:var(--accent);}
  .block-head h2{font-size:15px;font-weight:700;letter-spacing:.05em;color:var(--text);}
  .block-head .count{margin-left:auto;font-family:'Inter',sans-serif;font-variant-numeric:tabular-nums;font-size:12px;color:var(--text-muted);}

  /* 文章条目：编号 + 标签 + 标题 + 摘要 */
  .post-row{display:grid;grid-template-columns:34px minmax(0,1fr) 18px;column-gap:16px;align-items:start;padding:20px 0;border-top:1px solid var(--border);transition:opacity .2s ease;}
  .post-row:first-of-type{border-top:none;padding-top:4px;}
  .post-row:hover .post-title{color:var(--accent);}
  .post-row:hover .post-arrow{transform:translateX(3px);}
  .post-no{font-family:'Inter',sans-serif;font-variant-numeric:tabular-nums;font-size:13px;font-weight:600;color:var(--accent);padding-top:3px;}
  .post-tag{display:inline-block;padding:2px 6px;border:1px solid var(--border);border-radius:3px;font-size:11px;color:var(--text-muted);margin-bottom:8px;}
  .post-title{font-size:17px;font-weight:600;line-height:1.5;color:var(--text);transition:color .2s ease;text-wrap:balance;}
  .post-excerpt{margin-top:8px;font-size:14px;line-height:1.75;color:var(--text-secondary);max-width:640px;}
  .post-meta{margin-top:10px;display:block;font-family:'Inter',sans-serif;font-variant-numeric:tabular-nums;font-size:12px;color:var(--text-muted);}
  .post-arrow{align-self:center;font-size:14px;color:var(--text-muted);transition:transform .2s ease;}

  .empty-row{padding:22px 0;border-top:1px solid var(--border);font-size:14px;line-height:1.8;color:var(--text-secondary);}

  /* 其他方向：同一套编号 */
  .sib-row{display:grid;grid-template-columns:34px minmax(0,1fr) 18px;column-gap:16px;align-items:start;padding:18px 0;border-top:1px solid var(--border);}
  .sib-row:first-of-type{border-top:none;}
  .sib-row:hover .sib-title{color:var(--accent);}
  .sib-no{font-family:'Inter',sans-serif;font-variant-numeric:tabular-nums;font-size:13px;font-weight:600;color:var(--accent);padding-top:3px;}
  .sib-title{font-size:16px;font-weight:600;line-height:1.5;color:var(--text);transition:color .2s ease;}
  .sib-def{margin-top:6px;font-size:13.5px;line-height:1.7;color:var(--text-muted);max-width:560px;}
  .sib-arrow{align-self:center;font-size:14px;color:var(--text-muted);}

  main{padding-bottom:var(--space-56);}

  @media(max-width:768px){
    .wrap{padding:0 20px;}
    .page-hero{padding:calc(56px + 24px) 0 22px;}
    .page-hero h1{font-size:26px;line-height:1.32;}
    .lens-grid{grid-template-columns:1fr;gap:12px;}
    .lens-card{padding:18px;}
    .lens-no{font-size:17px;}
    .lens-card p{font-size:14px;line-height:1.8;}
    .block{padding-top:28px;margin-top:28px;}
    .post-row{grid-template-columns:26px minmax(0,1fr) 14px;column-gap:12px;padding:18px 0;}
    .post-title{font-size:16px;}
    .post-excerpt{font-size:13.5px;}
    .sib-row{grid-template-columns:26px minmax(0,1fr) 14px;column-gap:12px;}
  }
</style>
</head>
<body>

<Nav active="focus" />

<header class="page-hero">
  <div class="wrap">
    <div class="crumb"><a href="/#focus">我在做什么</a><span aria-hidden="true">/</span><span>{topic.title}</span></div>
    <div class="eyebrow">{topicNo}<span>{topic.num.split('·')[1]?.trim() ?? ''}</span></div>
    <h1>{topic.title}</h1>
  </div>
</header>

<main>
  <section class="wrap lens" aria-label="这个方向在讲什么">
    <div class="lens-grid">
      {lens.map((item) => (
        <div class="lens-card">
          <span class="lens-no">{item.num}</span>
          <span class="lens-label">{item.label}</span>
          {item.title && <h2 class="lens-title">{item.title}</h2>}
          {item.body.map((text) => <p>{text}</p>)}
        </div>
      ))}
    </div>
  </section>

  <section class="wrap block" aria-labelledby="articlesTitle">
    <div class="block-head">
      <span class="block-no">05</span>
      <h2 id="articlesTitle">已经发布</h2>
      {posts.length > 0 && <span class="count">{posts.length} 篇</span>}
    </div>
    {posts.length > 0 ? (
      <div>
        {posts.map((post, i) => (
          <a class="post-row" href={post.url}>
            <span class="post-no">{String(i + 1).padStart(2, '0')}</span>
            <span>
              <span class="post-tag">{post.category}</span>
              <h3 class="post-title">{post.title}</h3>
              <span class="post-excerpt">{post.excerpt}</span>
              <span class="post-meta">{post.date} · {post.readTime}</span>
            </span>
            <span class="post-arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    ) : (
      <p class="empty-row">这个方向的第一批记录还在整理，稍后发布。</p>
    )}
  </section>

  <section class="wrap block" aria-labelledby="siblingsTitle">
    <div class="block-head"><span class="block-no">06</span><h2 id="siblingsTitle">切换到其他方向</h2></div>
    {siblings.map((s) => (
      <a class="sib-row" href={`/topics/${s.slug}`}>
        <span class="sib-no">{s.num.split('·')[0].trim()}</span>
        <span>
          <h3 class="sib-title">{s.title}</h3>
          <span class="sib-def">{s.definition}</span>
        </span>
        <span class="sib-arrow" aria-hidden="true">→</span>
      </a>
    ))}
  </section>
</main>

<Footer />
</body>
</html>
