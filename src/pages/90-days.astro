---
import { getPracticeSnapshot, practiceStartDate } from '../data/stages.mjs';
import { getPublishedPosts } from '../lib/insights';
import { tracking } from '../data/practice-tracking.mjs';
import BaseLayout from '../layouts/BaseLayout.astro';
import daily from '../../journal/daily.json';
import { pageGraph } from '../lib/seo';

const practice = getPracticeSnapshot();
const stages = practice.stages;
const published = await getPublishedPosts();
const postOf = (slug) => published.find((p) => p.slug === slug);
const archiveCount = published.filter((p) => p.category === '90天实战').length;
const cnNums = ['一', '二', '三', '四'];
const description = '90 天个人商业实践的四个阶段：目标、产出与公开记录。';

// ---- 每日记录（数据源 journal/daily.json，经用户审核才写入）----
// 内容是重点，站点是施工日志：渲染顺序固定为 内容 → 产线 → 文档 → 站点，不依赖 json 的数组顺序
const FACES = ['内容', '产线', '文档', '站点'];
const WEEK = ['周日', '周一', '周二', '周三', '周四', '周五', '周六'];

const toUTC = (value) => {
  const [y, m, d] = value.split('-').map(Number);
  return Date.UTC(y, m - 1, d);
};
const dayIndexOf = (value) => Math.floor((toUTC(value) - toUTC(practiceStartDate)) / 86400000) + 1;
const shortOf = (value) => {
  const [, m, d] = value.split('-');
  return `${m}.${d}`;
};
const weekOf = (value) => {
  const [y, m, d] = value.split('-').map(Number);
  return WEEK[new Date(Date.UTC(y, m - 1, d)).getUTCDay()];
};

// 一条记录拆成「主句 + 细节」：主句一行讲完，细节降到小字，避免整条糊成一段
const splitLine = (text) => {
  const t = String(text).trim();
  const marks = ['；', ';', '。'].map((ch) => {
    const i = t.indexOf(ch);
    return i < 0 ? Infinity : i;
  });
  const cut = Math.min(...marks);
  if (cut !== Infinity && cut <= 56) {
    const main = t.slice(0, cut);
    const rest = t
      .slice(cut + 1)
      .split(/[；;]/)
      .map((s) => s.trim())
      .filter(Boolean);
    return { main, rest };
  }
  return { main: t, rest: [] };
};

const journalEntries = (daily.entries ?? [])
  .slice()
  .sort((a, b) => b.date.localeCompare(a.date))
  .map((entry) => ({
  ...entry,
  dayNo: entry.label ? null : `Day ${dayIndexOf(entry.date)}`,
  shortDate: shortOf(entry.date),
  week: weekOf(entry.date),
  groups: FACES.filter((face) => entry.items?.some((item) => item.face === face)).map((face) => {
    const items = entry.items.filter((item) => item.face === face);
    return {
      face,
      commits: items.reduce((sum, item) => sum + (item.commits ?? 0), 0),
      lines: items.map((item) => splitLine(item.title)),
    };
  }),
}));
journalEntries.forEach((entry) => {
  entry.faces = entry.groups.map((group) => group.face);
});

// 默认只展开最近一天：今天有记录就今天，今天没有就退到有记录的最近一天
const journalLatestDate = journalEntries.length
  ? journalEntries.reduce((max, entry) => (entry.date > max ? entry.date : max), journalEntries[0].date)
  : null;
journalEntries.forEach((entry) => {
  entry.open = entry.date === journalLatestDate;
});

// 阶段视图：筹备期 + 四个阶段各一张卡，每天的记录挂在所属阶段卡里（时间顺序：筹备期在前）
const stageOfDate = (date) => stages.find((stage) => date >= stage.startDate && date <= stage.endDate) ?? null;

const stageViews = (() => {
  const prepEntries = journalEntries.filter((entry) => stageOfDate(entry.date) === null);
  const views = [];

  stages.forEach((s) => {
    const entries = journalEntries.filter((entry) => stageOfDate(entry.date)?.id === s.id);
    // 筹备期（正式开始之前）的记录并入第一阶段，不单独成块
    if (s.id === 1 && prepEntries.length > 0) entries.push(...prepEntries);
    views.push({
      key: `stage-${s.id}`,
      title: `第${cnNums[s.id - 1]}阶段`,
      name: s.name,
      range: `${s.range.start} — ${s.range.end} · ${s.days} 天`,
      status: s.status,
      isCurrent: s.status === '当前',
      goal: s.goal,
      outputs: s.outputs,
      days: entries.length,
      commits: entries.reduce((sum, entry) => sum + (entry.commits ?? 0), 0),
      startDate: s.startDate,
      endDate: s.endDate,
      entries,
      // 有记录的段可以折叠；当前阶段默认展开，其余带记录的段默认收起
      collapsible: entries.length > 0,
      open: entries.length > 0 ? s.status === '当前' : true,
    });
  });

  return views;
})();

const journalDays = journalEntries.length;
const journalCommits = journalEntries.reduce((sum, entry) => sum + (entry.commits ?? 0), 0);
const journalLast = journalLatestDate;
const journalPosts = journalEntries.reduce((sum, entry) => sum + (entry.posts?.length ?? 0), 0);
const journalFaces = FACES.filter((face) => journalEntries.some((entry) => entry.faces.includes(face)));
const journalHasMilestone = journalEntries.some((entry) => (entry.milestones?.length ?? 0) > 0);
const jsonLd = pageGraph([
  { name: '首页', path: '/' },
  { name: '90 天实践', path: '/90-days/' },
]);
---
<BaseLayout title="90天创造者实践 — 个人成长实践者" description={description} canonicalPath="/90-days/" active="focus">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
  </Fragment>
  <header class="page-hero">
    <div class="wrap">
      <p class="eyebrow">90 天创造者实践</p>
      <h1>我的 90 天创造者实践</h1>
      <p class="intro">从寻找真实需求开始，用 90 天做出一个产品，并公开记录每一步。</p>
      <div class="hero-meta">
        <span data-practice-period>{practice.period}</span>
        <span class="sep" aria-hidden="true">·</span>
        <span class="day" data-practice-day>{`Day ${String(practice.dayNumber).padStart(2, '0')} / 90`}</span>
        <span class="sep" aria-hidden="true">·</span>
        <span class="state" data-practice-state>{(stages.find((stage) => stage.id === practice.currentStageId)?.status ?? '当前') + ' · 第' + cnNums[practice.currentStageId - 1] + '阶段'}</span>
      </div>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/insights/?category=90天实战">查看实战记录{archiveCount > 0 && ` · ${archiveCount} 篇`}</a>
        <a class="btn btn-secondary" href="/#focus">回到三个方向</a>
      </div>
    </div>
  </header>

  <main id="main-content" class="wrap">
    <div class="log-strip">
      <div class="log-stat"><strong>{journalDays}</strong><span>已记录天数</span></div>
      <div class="log-stat"><strong>{journalCommits}</strong><span>累计提交</span></div>
      <div class="log-stat"><strong>{journalPosts}</strong><span>公开文章</span></div>
      <div class="log-stat"><strong>{`Day ${practice.dayNumber}`}</strong><span>当前进度 / 90</span></div>
    </div>

    <section class="battlemap" id="battlemap" aria-label="90 天作战地图">
      <div class="battlemap-head">
        <h2>总纲 · 90 天作战地图</h2>
        <p class="battlemap-lead">三条主线并行：内容线管供给，产品线管可交付，商单线管现金；底下还有一条不占节奏的暗线——关系。实线是已发生，虚线是计划，赤圈是今天正在做的动作。</p>
      </div>
      <figure class="battlemap-fig">
        <a href="/battlemap/90-days-battlemap.jpg" target="_blank" rel="noopener">
          <picture>
            <source srcset="/battlemap/90-days-battlemap.webp" type="image/webp" />
            <img src="/battlemap/90-days-battlemap.jpg" alt="90 天作战地图：内容线、产品线、商单线三条主线加一条关系暗线，节点按已发生、正在做、计划区分" width="2200" height="1281" loading="lazy" decoding="async" />
          </picture>
        </a>
        <figcaption>点开看大图<span>V1.4 · 2026.11.23 · Day 16</span></figcaption>
      </figure>
    </section>

    <section class="journal" id="journal" aria-label="每日记录">
      <div class="journal-head">
        <h2>每日记录</h2>
        <p class="journal-meta">
          {journalLast && <span>记录到 {shortOf(journalLast)}</span>}
          <span class="sep" aria-hidden="true">·</span>
          <span>{journalDays} 天</span>
          <span class="sep" aria-hidden="true">·</span>
          <span>{journalCommits} 个提交</span>
        </p>
      </div>
      <p class="journal-lead">一天一张卡。左边是日期，卡里是那天真正发生的事：改了什么、发了什么、留下了什么。</p>
      <div class="journal-filter" role="group" aria-label="按内容面筛选">
        <button type="button" class="is-on" data-filter="all">全部</button>
        {journalFaces.map((face) => <button type="button" data-filter={face}>{face}</button>)}
        {journalHasMilestone && <button type="button" data-filter="里程碑">里程碑</button>}
        <button type="button" class="journal-expand" data-expand-all>全部展开</button>
      </div>

      <div class="stage-list">
        {stageViews.map((view) => (
          <article
            class={`stage-card${view.isCurrent ? ' is-current' : ''}`}
            id={view.key}
            data-stage-key={view.key}
            data-open={view.open ? '1' : '0'}
            data-practice-stage={view.startDate ? '' : undefined}
            data-stage-start={view.startDate}
            data-stage-end={view.endDate}
          >
            {view.collapsible ? (
              <button type="button" class="stage-head is-toggle" data-stage-toggle aria-expanded={view.open ? 'true' : 'false'}>
                <span class="stage-no">{view.title}</span>
                <span class="stage-range" data-stage-range>{view.range}</span>
                <span class="stage-count">{view.days} 天记录 · {view.commits} 提交</span>
                {view.status && <span class={`stage-state${view.isCurrent ? ' is-current' : ''}`} data-stage-status>{view.status}</span>}
                <span class="stage-caret" aria-hidden="true">{view.open ? '收起 ⌃' : '展开 ⌄'}</span>
              </button>
            ) : (
              <div class="stage-head">
                <span class="stage-no">{view.title}</span>
                <span class="stage-range" data-stage-range>{view.range}</span>
                <span class="stage-count">这一段还没有记录</span>
                {view.status && <span class={`stage-state${view.isCurrent ? ' is-current' : ''}`} data-stage-status>{view.status}</span>}
              </div>
            )}

            <div class="stage-body">
              <h2>{view.name}</h2>
              {view.goal && <p class="stage-goal">{view.goal}</p>}

              {view.outputs && (
                <>
                  <h3 class="stage-label">阶段产出</h3>
                  <ol class="outputs">
                    {view.outputs.map((o, i) => (
                      <li><span class="num">{String(i + 1).padStart(2, '0')}</span><span>{o}</span></li>
                    ))}
                  </ol>
                </>
              )}

              {view.entries.length > 0 && (
                <div class="stage-record">
                  <h3 class="stage-label">这一段记录</h3>
                  <ol class="journal-list">
                    {view.entries.map((entry) => (
                      <li class="log-day" data-date={entry.date} data-faces={entry.faces.join(' ')} data-milestone={entry.milestones?.length ? '1' : '0'} data-open={entry.open ? '1' : '0'}>
                        <div class="log-rail">
                          <span class="log-dot" aria-hidden="true"></span>
                          <span class="log-no">{entry.dayNo ?? entry.label}</span>
                          <span class="log-date">{entry.range ?? entry.shortDate}</span>
                          {!entry.range && <span class="log-week">{entry.week}</span>}
                        </div>

                        <button type="button" class="log-fold" data-fold aria-expanded="false">
                          <span class="fold-kicker">{entry.range ?? `${entry.shortDate} ${entry.week}`}</span>
                          <span class="fold-theme">{entry.theme}</span>
                          <span class="fold-meta">{entry.commits} 提交</span>
                          <span class="fold-caret" aria-hidden="true">展开</span>
                        </button>

                        <div class="log-card">
                          <div class="log-top">
                            <span class="log-kicker">{entry.range ? '筹备期' : `${entry.shortDate} ${entry.week}`}</span>
                            <span class="log-count">{entry.commits} 个提交</span>
                          </div>
                          {entry.theme && <h3 class="log-theme">{entry.theme}</h3>}
                          {entry.summary && <p class="log-sum">{entry.summary}</p>}

                          {entry.milestones?.length > 0 && (
                            <div class="milestones">
                              {entry.milestones.map((m) => (
                                <p class="milestone">{m.text}</p>
                              ))}
                            </div>
                          )}

                          {entry.groups.map((group) => (
                            <div class="log-group">
                              <div class="log-group-head">
                                <span class="g-pill">{group.face}</span>
                                <span class="g-count">{group.commits} 提交</span>
                              </div>
                              <ul class="log-lines">
                                {group.lines.map((line) => (
                                  <li>
                                    <span class="line-main">{line.main}</span>
                                    {line.rest.length > 0 && <span class="line-rest">{line.rest.join('；')}</span>}
                                  </li>
                                ))}
                              </ul>
                            </div>
                          ))}

                          {entry.activities?.length > 0 && (
                            <div class="log-notes">
                              {entry.activities.map((a) => (
                                <p class="log-note" data-tag={a.tag}>
                                  <span class="note-tag">{a.tag}</span>
                                  <span class="note-text">{a.text}</span>
                                </p>
                              ))}
                            </div>
                          )}

                          {entry.posts?.length > 0 && (
                            <div class="log-posts">
                              {entry.posts.map((post) => (
                                <a class="log-post" href={post.url}>
                                  <span class="log-post-tag">发文</span>
                                  <span class="log-post-title">{post.title}</span>
                                  <span class="log-post-arrow" aria-hidden="true">↗</span>
                                </a>
                              ))}
                            </div>
                          )}
                          <button type="button" class="log-collapse" data-fold aria-expanded="true">收起 ⌃</button>
                        </div>
                      </li>
                    ))}
                  </ol>
                </div>
              )}
            </div>
          </article>
        ))}
      </div>
      <p class="journal-note">记录来自四个仓库的实际提交，加上每天自己补的判断、失误与活动。只记已发生的事，不写计划。</p>
    </section>

    <section class="acceptance" aria-label="验收指标与披露规则">
      <div class="acceptance-head">
        <h2>验收指标</h2>
        <p class="acceptance-note">90 天结束时按这四项判断，不看过程中的自我感觉。</p>
      </div>
      <div class="acceptance-metrics">
        <div class="acceptance-metric"><strong>{tracking.acceptance.content.value}</strong><span>{tracking.acceptance.content.label}</span></div>
        <div class="acceptance-metric"><strong>{tracking.acceptance.feedback.value}</strong><span>{tracking.acceptance.feedback.label}</span></div>
        <div class="acceptance-metric"><strong>{tracking.acceptance.paidUsers.value}</strong><span>{tracking.acceptance.paidUsers.label}</span></div>
        <div class="acceptance-metric"><strong>{tracking.acceptance.monthlyIncome.value}</strong><span>{tracking.acceptance.monthlyIncome.label}</span></div>
      </div>
      <p class="disclosure"><strong>披露规则</strong>{tracking.incomeDisclosure}</p>
    </section>
  </main>

  <style is:global>
    body{font-feature-settings:"palt" 1;}
    ul,ol{list-style:none;}
    :focus-visible{outline:2px solid var(--accent);outline-offset:3px;border-radius:2px;}
    ::-webkit-scrollbar{width:8px;}
    ::-webkit-scrollbar-track{background:var(--bg);}
    ::-webkit-scrollbar-thumb{background:var(--scrollbar);border-radius:4px;}

    .wrap{max-width:var(--container-w);margin:0 auto;padding:0 var(--gutter);}

    /* ===== 页头 ===== */
    .page-hero{padding:calc(64px + var(--space-56)) 0 var(--space-40);border-bottom:1px solid var(--border);}
    .eyebrow{display:flex;align-items:center;gap:var(--space-8);font-size:var(--fs-12);color:var(--text-muted);margin-bottom:var(--space-16);}
    .eyebrow::before{content:'';width:6px;height:6px;border-radius:50%;background:var(--accent);flex-shrink:0;}
    .page-hero h1{font-size:var(--fs-48);font-weight:600;line-height:1.18;letter-spacing:0;text-wrap:balance;}
    .page-hero .intro{max-width:640px;margin-top:var(--space-12);font-size:var(--fs-16);color:var(--text-secondary);}
    .hero-meta{display:flex;flex-wrap:wrap;align-items:center;gap:var(--space-8);margin-top:var(--space-24);font-family:'Inter',sans-serif;font-variant-numeric:tabular-nums;font-size:var(--fs-12);color:var(--text-muted);}
    .hero-meta .sep{color:var(--border);}
    .hero-meta .day{color:var(--text);}
    .hero-meta .state{display:inline-flex;align-items:center;gap:var(--space-8);color:var(--text-secondary);}
    .hero-meta .state::before{content:'';width:6px;height:6px;border-radius:50%;background:var(--accent);flex-shrink:0;}
    .hero-actions{display:flex;flex-wrap:wrap;gap:var(--space-12);margin-top:var(--space-24);}
    .btn{display:inline-flex;align-items:center;justify-content:center;gap:var(--space-8);padding:var(--space-12) var(--space-24);border-radius:var(--radius-sm);font-size:var(--fs-14);font-weight:500;cursor:pointer;border:1px solid transparent;transition:background-color .2s ease,border-color .2s ease,color .2s ease;}
    .btn-primary{background:var(--accent);color:var(--accent-ink);border-color:var(--accent);}
    .btn-primary:hover,.btn-primary:focus-visible{background:var(--accent-hover);border-color:var(--accent-hover);}
    .btn-secondary{background:transparent;color:var(--text);border-color:var(--border);}
    .btn-secondary:hover,.btn-secondary:focus-visible{background:var(--surface);border-color:rgba(var(--accent-rgb),.5);color:var(--accent);}

    /* ===== 数据带 ===== */
    .log-strip{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:var(--space-16);padding:24px 0;border-bottom:1px solid var(--border);}
    .log-stat{display:flex;flex-direction:column;gap:6px;}
    .log-stat strong{font-family:'Inter',sans-serif;font-variant-numeric:tabular-nums;font-size:28px;font-weight:600;line-height:1;letter-spacing:-.03em;color:var(--text);}
    .log-stat span{font-size:11px;letter-spacing:.06em;color:var(--text-muted);}

    /* ===== 总纲：作战地图 ===== */
    .battlemap{padding:40px 0 var(--space-32);border-bottom:1px solid var(--border);}
    .battlemap-head h2{font-size:var(--fs-20);font-weight:600;letter-spacing:-.01em;}
    .battlemap-lead{max-width:760px;margin-top:6px;font-size:13px;color:var(--text-muted);line-height:1.75;}
    .battlemap-fig{margin:20px 0 0;}
    .battlemap-fig a{display:block;border-radius:10px;overflow:hidden;background:#0b0a0d;box-shadow:0 1px 2px rgba(15,23,32,.06);}
    .battlemap-fig img{display:block;width:100%;height:auto;}
    .battlemap-fig figcaption{display:flex;flex-wrap:wrap;align-items:baseline;gap:var(--space-8);margin-top:10px;font-family:'Inter',sans-serif;font-variant-numeric:tabular-nums;font-size:11px;letter-spacing:.04em;color:var(--text-muted);}
    .battlemap-fig figcaption span{color:var(--text-secondary);}
    .battlemap-fig figcaption span::before{content:'·';margin-right:var(--space-8);color:var(--border);}

    /* ===== 每日记录 ===== */
    .journal{padding:40px 0 var(--space-40);}
    .journal-head{display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:var(--space-12);}
    .journal-head h2{font-size:var(--fs-20);font-weight:600;letter-spacing:-.01em;}
    .journal-meta{display:flex;flex-wrap:wrap;align-items:center;gap:var(--space-8);font-family:'Inter',sans-serif;font-variant-numeric:tabular-nums;font-size:var(--fs-12);color:var(--text-muted);}
    .journal-meta .sep{color:var(--border);}
    .journal-lead{margin-top:6px;font-size:13px;color:var(--text-muted);line-height:1.7;}
    .journal-filter{display:flex;flex-wrap:wrap;gap:var(--space-8);margin:20px 0 0;}
    .journal-filter button{padding:5px 12px;font-size:11px;letter-spacing:.02em;color:var(--text-muted);background:transparent;border:1px solid var(--border);border-radius:999px;cursor:pointer;transition:background-color .2s ease,border-color .2s ease,color .2s ease;}
    .journal-filter button:hover{border-color:rgba(var(--accent-rgb),.5);color:var(--accent);}
    .journal-filter button.is-on{background:var(--text);border-color:var(--text);color:var(--bg);}
    .journal-filter button.journal-expand{margin-left:auto;border-color:transparent;color:var(--text-secondary);}

    .journal-list{display:flex;flex-direction:column;gap:22px;margin-top:0;}
    .log-day{display:grid;grid-template-columns:104px minmax(0,1fr);grid-template-rows:auto;align-items:start;}
    .log-rail{grid-column:1;grid-row:1;position:relative;display:flex;flex-direction:column;align-items:flex-end;gap:3px;padding:22px 38px 0 0;}
    .log-rail span{white-space:nowrap;}
    .log-rail::before{content:'';position:absolute;right:24px;top:0;bottom:-18px;width:1px;background:var(--border);}
    .log-day:last-child .log-rail::before{bottom:0;}
    .log-dot{position:absolute;right:20px;top:24px;width:9px;height:9px;border-radius:50%;background:var(--accent);box-shadow:0 0 0 3px var(--bg);}
    .log-day[data-open="0"] .log-dot{background:transparent;border:1px solid var(--text-muted);box-shadow:0 0 0 3px var(--bg);}
    .log-no{font-size:13px;font-weight:600;color:var(--text);letter-spacing:.01em;}
    .log-date{font-family:'Inter',sans-serif;font-variant-numeric:tabular-nums;font-size:11px;color:var(--text-muted);}
    .log-week{font-size:11px;color:var(--text-muted);}

    /* 折叠条：未展开的日子压成一行，仍挂在同一条时间脊柱上 */
    .log-fold{grid-column:2;grid-row:1;display:flex;align-items:center;gap:var(--space-12);width:100%;padding:15px 20px 15px 18px;background:var(--overlay-soft);border:1px solid var(--border);border-left:3px solid rgba(var(--accent-rgb),.34);border-radius:6px 12px 12px 6px;text-align:left;cursor:pointer;}
    .log-fold:hover{border-color:rgba(var(--accent-rgb),.45);}
    .fold-theme{font-size:14px;color:var(--text);line-height:1.5;}
    .fold-meta{margin-left:auto;font-family:'Inter',sans-serif;font-variant-numeric:tabular-nums;font-size:11px;color:var(--text-muted);flex-shrink:0;}
    .fold-caret{flex-shrink:0;font-size:11px;color:var(--text-muted);}
    .fold-kicker{display:none;flex-shrink:0;font-family:'Inter',sans-serif;font-variant-numeric:tabular-nums;font-size:11px;color:var(--text-muted);}
    .log-collapse{display:inline-flex;align-items:center;gap:6px;margin-top:var(--space-16);padding:6px 0 0;background:none;border:0;border-top:1px solid var(--border);width:100%;justify-content:flex-end;font-size:11px;color:var(--text-muted);cursor:pointer;transition:color .2s ease;}
    .log-collapse:hover{color:var(--accent);}

    .log-card{grid-column:2;grid-row:1;position:relative;padding:var(--space-24) 24px var(--space-16) 22px;background:var(--surface);border:1px solid var(--border);border-left:3px solid rgba(var(--accent-rgb),.45);border-radius:6px 14px 14px 6px;box-shadow:0 1px 2px rgba(15,23,32,.03);}
    .log-day[data-open="1"] .log-fold{display:none;}
    .log-day[data-open="0"] .log-card{display:none;}
    .log-top{display:flex;align-items:center;justify-content:space-between;gap:var(--space-12);margin-bottom:var(--space-12);}
    .log-kicker{font-family:'Inter',sans-serif;font-variant-numeric:tabular-nums;font-size:11px;letter-spacing:.1em;color:var(--text-muted);}
    .log-count{font-family:'Inter',sans-serif;font-variant-numeric:tabular-nums;font-size:11px;color:var(--text-muted);}
    .log-theme{font-size:20px;font-weight:600;line-height:1.35;letter-spacing:-.01em;margin:0 0 var(--space-16);text-wrap:balance;}
    /* 那天的一句话：引文式，是每张卡唯一的视觉落点 */
    .log-sum{margin:0 0 var(--space-24);padding-left:14px;border-left:2px solid rgba(var(--accent-rgb),.55);font-size:15px;color:var(--text);line-height:1.75;letter-spacing:.01em;}

    .milestones{display:flex;flex-direction:column;gap:6px;margin-top:var(--space-16);padding:var(--space-12) var(--space-16);background:rgba(var(--accent-rgb),.05);border-left:3px solid var(--accent);border-radius:0 4px 4px 0;}
    .milestone{margin:0;font-size:var(--fs-12);color:var(--text);line-height:1.7;letter-spacing:.01em;}

    .log-group{margin-top:var(--space-24);}
    .log-group-head{display:flex;align-items:center;gap:var(--space-8);margin-bottom:var(--space-12);}
    .g-pill{font-size:11px;letter-spacing:.08em;color:var(--text-secondary);background:var(--overlay-soft);border:1px solid var(--border);border-radius:3px;padding:2px 7px;}
    .g-count{font-family:'Inter',sans-serif;font-variant-numeric:tabular-nums;font-size:11px;color:var(--text-muted);}
    .log-lines{display:flex;flex-direction:column;gap:11px;}
    .log-lines li{position:relative;padding-left:14px;}
    .log-lines li::before{content:'';position:absolute;left:0;top:8px;width:4px;height:4px;border-radius:50%;background:rgba(var(--accent-rgb),.45);}
    .line-main{display:block;font-size:13px;color:var(--text);line-height:1.7;}
    .line-rest{display:block;margin-top:3px;font-size:var(--fs-12);color:var(--text-muted);line-height:1.75;}

    /* 那天自己补的判断 / 失误 / 反馈 / 收入：git 里没有，只有人知道 */
    .log-notes{display:flex;flex-direction:column;gap:9px;margin-top:var(--space-24);padding-top:var(--space-16);border-top:1px solid var(--border);}
    .log-note{display:flex;align-items:flex-start;gap:var(--space-8);margin:0;font-size:var(--fs-12);line-height:1.75;color:var(--text-secondary);}
    .note-tag{flex-shrink:0;min-width:30px;padding:1px 6px;border:1px solid var(--border);border-radius:3px;font-size:10px;letter-spacing:.06em;text-align:center;color:var(--text-muted);}
    .note-text{min-width:0;}
    .log-note[data-tag="失误"] .note-tag{background:var(--text);border-color:var(--text);color:var(--bg);}
    .log-note[data-tag="失误"] .note-text{color:var(--text);}
    .log-note[data-tag="反馈"] .note-tag{border-color:rgba(var(--accent-rgb),.45);color:var(--accent);}

    .log-posts{display:flex;flex-direction:column;gap:var(--space-8);margin-top:var(--space-24);padding-top:var(--space-16);border-top:1px solid var(--border);}
    .log-post{display:flex;align-items:flex-start;gap:var(--space-8);font-size:13px;color:var(--text);line-height:1.7;}
    .log-post-tag{flex-shrink:0;font-size:11px;letter-spacing:.08em;color:var(--accent);}
    .log-post-title{border-bottom:1px solid var(--border);transition:border-color .2s ease;}
    .log-post-arrow{margin-left:auto;flex-shrink:0;font-size:11px;color:var(--text-muted);}
    .log-post:hover .log-post-title,.log-post:focus-visible .log-post-title{border-bottom-color:var(--accent);color:var(--accent);}
    .log-post:hover .log-post-arrow,.log-post:focus-visible .log-post-arrow{color:var(--accent);}

    .journal-note{margin-top:var(--space-24);font-size:var(--fs-12);color:var(--text-muted);line-height:1.8;}

    /* ===== 验收指标 ===== */
    .acceptance{margin-bottom:var(--space-56);padding:var(--space-32);background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);}
    .acceptance-head{display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:var(--space-12);margin-bottom:20px;}
    .acceptance-head h2{font-size:var(--fs-20);font-weight:600;}
    .acceptance-note{font-size:13px;color:var(--text-secondary);}
    .acceptance-metrics{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:var(--space-12);}
    .acceptance-metric{padding:var(--space-16);background:var(--overlay-soft);border:1px solid var(--border);border-radius:var(--radius-sm);}
    .acceptance-metric strong{display:block;font-size:var(--fs-16);font-weight:550;letter-spacing:0;}
    .acceptance-metric span{display:block;margin-top:4px;font-size:var(--fs-12);color:var(--text-muted);line-height:1.6;}
    .disclosure{display:flex;flex-wrap:wrap;gap:var(--space-8);margin-top:20px;padding-top:var(--space-16);border-top:1px solid var(--border);font-size:13px;color:var(--text-secondary);line-height:1.8;}
    .disclosure strong{flex-shrink:0;font-weight:500;color:var(--text);}

    /* ===== 阶段列表 ===== */
    .stage-list{display:flex;flex-direction:column;gap:var(--space-24);margin-top:var(--space-32);}
    .stage-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);overflow:hidden;}
    .stage-card.is-current{border-color:rgba(var(--accent-rgb),.35);}
    .stage-head{display:flex;flex-wrap:wrap;align-items:center;gap:var(--space-12);width:100%;padding:18px var(--space-32);text-align:left;background:none;border:0;border-bottom:1px solid var(--border);}
    .stage-head.is-toggle{cursor:pointer;}
    .stage-head.is-toggle:hover{background:var(--overlay-hover);}
    .stage-caret{font-size:11px;color:var(--text-secondary);}
    .stage-count{margin-left:auto;font-family:'Inter',sans-serif;font-variant-numeric:tabular-nums;font-size:11px;color:var(--text-muted);}
    .stage-body{padding:var(--space-24) var(--space-32) var(--space-32);}
    .stage-card[data-open="0"] .stage-body{display:none;}
    .stage-record{margin-top:var(--space-24);padding-top:var(--space-24);border-top:1px solid var(--border);}
    .stage-record .journal-list{margin-top:var(--space-8);}
    .stage-no{font-size:13px;font-weight:600;color:var(--text);letter-spacing:-.01em;}
    .stage-range{font-family:'Inter',sans-serif;font-variant-numeric:tabular-nums;font-size:var(--fs-12);color:var(--text-muted);}
    .stage-state{display:inline-flex;align-items:center;gap:6px;font-size:12px;color:var(--text-muted);}
    .stage-state::before{content:'';width:1px;height:10px;margin-right:6px;background:var(--border);}
    .stage-state.is-current{color:var(--accent);}
    .stage-state.is-current::before{background:rgba(var(--accent-rgb),.35);}
    .stage-state.is-current{color:var(--text-secondary);}
    .stage-state.is-current::before{content:'';width:6px;height:6px;border-radius:50%;background:var(--accent);flex-shrink:0;}
    .stage-card h2{font-size:var(--fs-20);font-weight:600;line-height:1.4;letter-spacing:0;margin-bottom:var(--space-8);}
    .stage-goal{font-size:var(--fs-14);color:var(--text-secondary);margin-bottom:var(--space-24);}
    .stage-label{font-size:var(--fs-14);font-weight:500;color:var(--text-muted);margin-bottom:var(--space-12);}
    .outputs{display:grid;grid-template-columns:repeat(2,1fr);gap:var(--space-12);margin-bottom:var(--space-24);}
    .outputs li{display:flex;gap:var(--space-12);padding:var(--space-12) var(--space-16);background:var(--overlay-soft);border:1px solid var(--border);border-radius:var(--radius-sm);font-size:var(--fs-14);color:var(--text-secondary);line-height:var(--lh-tight);}
    .outputs .num{font-family:'Inter',sans-serif;font-variant-numeric:tabular-nums;font-size:var(--fs-12);color:var(--text-muted);flex-shrink:0;}
    .records{display:flex;flex-direction:column;gap:var(--space-8);padding-top:var(--space-16);border-top:1px solid var(--border);}
    .record{display:flex;align-items:baseline;gap:var(--space-12);font-size:var(--fs-14);color:var(--text);}
    .record-date{font-family:'Inter',sans-serif;font-variant-numeric:tabular-nums;font-size:var(--fs-12);color:var(--text-muted);flex-shrink:0;}
    .record-title{border-bottom:1px solid var(--border);transition:border-color .2s ease;}
    .record:hover .record-title,.record:focus-visible .record-title{border-bottom-color:var(--accent);color:var(--accent);}
    .record-empty{font-size:var(--fs-14);color:var(--text-muted);}

    @media(max-width:720px){
      .page-hero{padding:calc(56px + var(--space-32)) 0 var(--space-32);}
      .page-hero h1{font-size:28px;line-height:1.25;}
      .page-hero .intro{font-size:var(--fs-14);}
      .hero-meta{flex-direction:column;align-items:flex-start;gap:var(--space-4);}
      .hero-meta .sep{display:none;}
      .log-strip{grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--space-16);padding:var(--space-20) 0;}
      .log-stat strong{font-size:22px;}
      .journal{padding:var(--space-32) 0 var(--space-32);}
      .battlemap{padding:var(--space-32) 0 var(--space-20);}
      .battlemap-lead{font-size:12.5px;}
      .journal-filter button{padding:5px 10px;}
      .journal-list{gap:14px;margin-top:var(--space-20);}
      .stage-block{margin-top:var(--space-32);padding-top:var(--space-12);}
      .stage-band{gap:var(--space-4) var(--space-8);padding-bottom:var(--space-12);}
      .band-title{font-size:12px;}
      .band-name{font-size:12px;}
      .band-range{order:1;font-size:11px;}
      .band-meta{order:2;margin-left:0;font-size:11px;}
      .band-caret{order:3;margin-left:auto;font-size:11px;}
      .band-state{display:none;}
      .log-day{grid-template-columns:1fr;grid-template-rows:auto auto;}
      .log-rail{display:none;}
      .log-rail::before,.log-dot{display:none;}
      .log-card,.log-fold{grid-column:1;grid-row:2;}
      .log-card{margin-left:0;padding:18px 18px 14px;border-radius:6px 12px 12px 6px;}
      .stage-record .journal-list{margin-inline:-16px;}
      .fold-kicker{display:inline-block;padding:2px 6px;border-radius:4px;background:rgba(var(--accent-rgb),.09);color:var(--text-secondary);letter-spacing:.02em;}
      .log-fold{border-left-color:rgba(var(--accent-rgb),.42);}
      .log-fold{padding:12px 14px;border-radius:8px 10px 10px 8px;gap:var(--space-8);}
      .fold-theme{font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
      .line-main{font-size:13.5px;}
      .log-top{margin-bottom:var(--space-8);}
      .log-sum{font-size:14px;margin-bottom:var(--space-16);padding-left:12px;}
      .log-theme{font-size:18px;}
      .log-group{margin-top:var(--space-24);}
      .log-posts{margin-top:var(--space-20);}
      .acceptance{padding:var(--space-20);}
      .acceptance-metrics{grid-template-columns:1fr 1fr;}
      .stage-head{padding:var(--space-16);}
      .stage-body{padding:var(--space-16);}
      .stage-state{margin-left:auto;}
      .outputs{grid-template-columns:1fr;}
    }
    @media(max-width:720px){
      .hero-actions{flex-direction:column;}
      .hero-actions .btn{width:100%;}
      .stage-head{padding:var(--space-16);}
      .stage-state{margin-left:auto;}
      .stage-state::before{display:none;}
    }
  </style>

  <script slot="scripts" is:inline src="/js/practice-clock.js" defer></script>

  <script slot="scripts" is:inline>
    const initJournal = () => {
      // ClientRouter 换页后 inline script 不会重跑，这里按容器打标记，保证每次换页只绑一次
      const stageList = document.querySelector('.stage-list');
      if (!stageList || stageList.dataset.bound === '1') return;
      stageList.dataset.bound = '1';
      const filterButtons = Array.from(document.querySelectorAll('.journal-filter button[data-filter]'));
      const days = Array.from(document.querySelectorAll('.log-day'));
      if (!days.length) return;
      let current = 'all';

      const apply = () => {
        days.forEach((day) => {
          const faces = (day.dataset.faces || '').split(' ').filter(Boolean);
          const hasMilestone = day.dataset.milestone === '1';
          const visible = current === 'all'
            ? true
            : current === '里程碑'
              ? hasMilestone
              : faces.includes(current);
          day.hidden = !visible;
          // 筛到某一面时，卡里只留那一组；折叠条没有分组，照常显示日期和主题
          day.querySelectorAll('.log-group').forEach((group) => {
            const pill = group.querySelector('.g-pill');
            const face = pill ? pill.textContent.trim() : '';
            group.hidden = current === 'all' || current === '里程碑' ? false : face !== current;
          });
        });
        // 整个阶段都没有命中，就把这一段收起，不留空标题
        document.querySelectorAll('.stage-card').forEach((block) => {
          block.hidden = !Array.from(block.querySelectorAll('.log-day')).some((day) => !day.hidden);
        });
      };

      filterButtons.forEach((button) => {
        button.addEventListener('click', () => {
          current = button.dataset.filter || 'all';
          filterButtons.forEach((item) => item.classList.toggle('is-on', item === button));
          apply();
        });
      });

      // 折叠：默认只展开最近一天，其余日子压成一行折叠条；阶段层面同理，当前阶段整段展开
      const expandAll = document.querySelector('.journal-expand');
      const stageBlocks = Array.from(document.querySelectorAll('.stage-card')).filter((card) => card.querySelector('[data-stage-toggle]'));

      const setOpen = (day, open) => {
        day.dataset.open = open ? '1' : '0';
        day.querySelectorAll('[data-fold]').forEach((btn) => btn.setAttribute('aria-expanded', open ? 'true' : 'false'));
        const caret = day.querySelector('.fold-caret');
        if (caret) caret.textContent = open ? '收起 ⌃' : '展开 ⌄';
      };

      const setStageOpen = (block, open) => {
        block.dataset.open = open ? '1' : '0';
        const band = block.querySelector('[data-stage-toggle]');
        if (band) band.setAttribute('aria-expanded', open ? 'true' : 'false');
        const caret = block.querySelector('.stage-caret');
        if (caret) caret.textContent = open ? '收起 ⌃' : '展开 ⌄';
      };

      const syncExpandAll = () => {
        if (!expandAll) return;
        const foldedDays = days.filter((day) => day.dataset.open === '0').length;
        const foldedStages = stageBlocks.filter((block) => block.dataset.open === '0').length;
        expandAll.textContent = foldedDays + foldedStages > 0 ? '全部展开' : '只看最近';
      };

      days.forEach((day) => {
        day.querySelectorAll('[data-fold]').forEach((btn) => {
          btn.addEventListener('click', () => {
            setOpen(day, day.dataset.open === '0');
            syncExpandAll();
          });
        });
      });

      stageBlocks.forEach((block) => {
        block.querySelector('[data-stage-toggle]')?.addEventListener('click', () => {
          setStageOpen(block, block.dataset.open === '0');
          syncExpandAll();
        });
      });

      if (expandAll) {
        expandAll.addEventListener('click', () => {
          const foldedDays = days.filter((day) => day.dataset.open === '0').length;
          const foldedStages = stageBlocks.filter((block) => block.dataset.open === '0').length;
          const latest = days.map((day) => day.dataset.date || '').sort().pop();
          if (foldedDays + foldedStages > 0) {
            stageBlocks.forEach((block) => setStageOpen(block, true));
            days.forEach((day) => setOpen(day, true));
          } else {
            stageBlocks.forEach((block) => {
              const isCurrent = block.querySelector('.stage-state.is-current') !== null;
              setStageOpen(block, isCurrent);
            });
            days.forEach((day) => setOpen(day, day.dataset.date === latest));
          }
          syncExpandAll();
        });
      }

      syncExpandAll();
      if (location.hash === '#journal') apply();
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initJournal);
    } else {
      initJournal();
    }
    document.addEventListener('astro:page-load', initJournal);
  </script>
</BaseLayout>
