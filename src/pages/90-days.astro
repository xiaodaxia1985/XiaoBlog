---
import { stages } from '../data/stages.mjs';
import { getPublishedPosts } from '../lib/insights';

const published = await getPublishedPosts();
const postOf = (slug) => published.find((p) => p.slug === slug);
const archiveCount = published.filter((p) => p.category === '90天实战').length;
const cnNums = ['一', '二', '三', '四'];
---
<!DOCTYPE html>
<html lang="zh-CN" style="background:#0A0A0A;">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#0A0A0A">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<title>90天创造者实践 — 个人商业创造者</title>
<meta name="description" content="90 天个人商业实践的四个阶段：目标、产出与公开记录。">
<link rel="stylesheet" href="/fonts/fonts.css">
<link rel="stylesheet" href="/css/tokens.css">
<style is:global>
  :root{
    --bg:#0A0A0A;
    --bg-card:#161616;
    --accent:#39FF14;
    --accent-rgb:57,255,20;
    --accent-dim:rgba(57,255,20,.15);
    --text:#FFFFFF;
    --text-secondary:#A1A1AA;
    --text-muted:#8E8E97;
    --border:rgba(255,255,255,.08);
    --radius:16px;
    --max-width:1000px;
  }
  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{font-family:'Noto Sans SC','Inter',sans-serif;background:var(--bg);color:var(--text);line-height:1.75;overflow-x:hidden;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility;}
  ::selection{background:var(--accent);color:#000;}
  a{text-decoration:none;color:inherit;}
  ul,ol{list-style:none;}

  /* Nav */
  .nav{position:fixed;top:0;left:0;right:0;z-index:1000;padding:var(--space-16) var(--gutter);display:flex;align-items:center;justify-content:space-between;background:rgba(10,10,10,.85);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border-bottom:1px solid var(--border);}
  .nav-inner{max-width:var(--container-w);margin:0 auto;width:100%;display:flex;align-items:center;justify-content:space-between;gap:var(--space-24);}
  .nav-logo{font-weight:800;font-size:20px;letter-spacing:-.5px;}
  .nav-logo span{color:var(--accent);}
  .nav-links{display:flex;gap:36px;}
  .nav-links a{font-size:var(--fs-14);font-weight:500;color:var(--text-secondary);position:relative;transition:color .3s ease;letter-spacing:.08em;}
  .nav-links a::after{content:'';position:absolute;bottom:-4px;left:0;width:0;height:2px;background:var(--accent);transition:width .3s ease;border-radius:2px;}
  .nav-links a:hover,.nav-links a.active{color:var(--accent);}
  .nav-links a.active::after,.nav-links a:hover::after{width:100%;}
  .nav-toggle{display:none;flex-direction:column;gap:5px;cursor:pointer;background:none;border:none;padding:4px;}
  .nav-toggle span{width:24px;height:2px;background:var(--text);border-radius:2px;transition:.3s;}

  .wrap{max-width:calc(var(--container-w) + var(--gutter) * 2);margin:0 auto;padding:0 var(--gutter);}

  /* Header */
  .page-hero{padding:calc(72px + var(--space-40)) 0 var(--space-40);background:linear-gradient(115deg,#080808 0%,#0a0a0a 45%,#151515 100%);border-bottom:1px solid var(--border);}
  .badge{display:flex;align-items:center;gap:var(--space-12);margin-bottom:var(--space-16);}
  .badge .line{width:40px;height:2px;background:var(--accent);border-radius:2px;}
  .badge .label{font-family:'Inter',sans-serif;font-size:var(--fs-12);font-weight:700;letter-spacing:.16em;color:var(--accent);}
  .page-hero h1{font-size:var(--fs-48);font-weight:800;line-height:1.2;letter-spacing:.02em;margin-bottom:var(--space-12);}
  .green{color:var(--accent);}
  .page-hero .intro{font-size:var(--fs-16);color:var(--text-secondary);line-height:var(--lh-body);max-width:640px;}
  .hero-meta{display:flex;flex-wrap:wrap;align-items:center;gap:var(--space-16);margin-top:var(--space-24);font-size:var(--fs-14);color:var(--text-secondary);}
  .hero-meta .period{font-family:'Inter',sans-serif;letter-spacing:.04em;}
  .hero-meta .day{font-family:'Inter',sans-serif;font-weight:700;color:var(--accent);}
  .hero-meta .state{border:1px solid var(--border);border-radius:99px;padding:var(--space-4) var(--space-12);font-size:var(--fs-12);}
  .hero-actions{display:flex;flex-wrap:wrap;gap:var(--space-12);margin-top:var(--space-24);}
  .btn{display:inline-flex;align-items:center;gap:var(--space-8);padding:var(--space-12) var(--space-24);border-radius:10px;font-size:var(--fs-14);font-weight:600;letter-spacing:.02em;border:1px solid transparent;transition:all .25s ease;}
  .btn-primary{background:var(--accent);color:#062b02;}
  .btn-primary:hover{box-shadow:0 0 24px rgba(var(--accent-rgb),.35);transform:translateY(-1px);}
  .btn-outline{border-color:var(--accent);color:var(--accent);}
  .btn-outline:hover{background:var(--accent-dim);}

  /* Stage list */
  .stage-list{display:flex;flex-direction:column;gap:var(--space-24);padding:var(--space-40) 0 var(--space-56);}
  .stage-card{background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:var(--space-32);}
  .stage-card.is-current{border-color:rgba(var(--accent-rgb),.35);}
  .stage-head{display:flex;flex-wrap:wrap;align-items:center;gap:var(--space-12);margin-bottom:var(--space-12);}
  .stage-no{font-family:'Inter',sans-serif;font-size:var(--fs-12);font-weight:700;letter-spacing:.12em;color:var(--text-muted);}
  .stage-range{font-family:'Inter',sans-serif;font-size:var(--fs-12);color:var(--text-muted);letter-spacing:.04em;}
  .stage-state{margin-left:auto;font-size:var(--fs-12);padding:var(--space-4) var(--space-12);border-radius:99px;border:1px solid var(--border);color:var(--text-muted);}
  .stage-state.is-current{color:var(--accent);border-color:rgba(var(--accent-rgb),.45);background:rgba(var(--accent-rgb),.08);}
  .stage-card h2{font-size:var(--fs-24);font-weight:800;letter-spacing:.02em;line-height:1.35;margin-bottom:var(--space-8);}
  .stage-goal{font-size:var(--fs-14);color:var(--text-secondary);line-height:var(--lh-body);margin-bottom:var(--space-24);}
  .stage-card h3{font-size:var(--fs-12);font-weight:600;letter-spacing:.12em;color:var(--text-muted);margin-bottom:var(--space-12);}
  .outputs{display:grid;grid-template-columns:repeat(2,1fr);gap:var(--space-12);margin-bottom:var(--space-24);}
  .outputs li{display:flex;gap:var(--space-12);padding:var(--space-12) var(--space-16);background:rgba(255,255,255,.03);border:1px solid var(--border);border-radius:10px;font-size:var(--fs-14);color:var(--text-secondary);line-height:1.6;}
  .outputs .num{font-family:'Inter',sans-serif;font-weight:700;font-size:var(--fs-12);color:var(--text-muted);flex-shrink:0;}
  .records{display:flex;flex-direction:column;gap:var(--space-8);padding-top:var(--space-16);border-top:1px solid var(--border);}
  .record{display:flex;align-items:baseline;gap:var(--space-12);font-size:var(--fs-14);color:var(--text);}
  .record-date{font-family:'Inter',sans-serif;font-size:var(--fs-12);color:var(--text-muted);flex-shrink:0;}
  .record-title{border-bottom:1px solid var(--border);transition:color .25s ease,border-color .25s ease;}
  .record:hover .record-title{color:var(--accent);border-bottom-color:rgba(var(--accent-rgb),.45);}
  .record-empty{font-size:var(--fs-14);color:var(--text-muted);}

  .page-footer{padding:var(--space-24) 0 var(--space-40);font-size:var(--fs-12);color:var(--text-muted);}
  .page-footer .wrap{display:flex;justify-content:space-between;flex-wrap:wrap;gap:var(--space-12);}
  .page-footer a{color:var(--text-secondary);border-bottom:1px solid var(--border);}

  @media(max-width:768px){
    .nav{padding:16px 24px;}
    .nav-links{position:fixed;top:0;right:-100%;width:70%;height:100vh;background:rgba(10,10,10,.98);flex-direction:column;justify-content:center;align-items:center;gap:32px;transition:right .4s ease,visibility .4s ease;visibility:hidden;border-left:1px solid var(--border);}
    .nav-links.open{right:0;visibility:visible;}
    .nav-links a{font-size:20px;}
    .nav-toggle{display:flex;z-index:1001;}
    .nav-toggle.open span:nth-child(1){transform:rotate(45deg) translate(5px,5px);}
    .nav-toggle.open span:nth-child(2){opacity:0;}
    .nav-toggle.open span:nth-child(3){transform:rotate(-45deg) translate(5px,-5px);}
    .wrap{padding:0 24px;}
    .page-hero{padding:calc(64px + var(--space-32)) 0 var(--space-32);}
    .page-hero h1{font-size:var(--fs-32);}
    .stage-card{padding:var(--space-24);}
    .stage-card h2{font-size:var(--fs-20);}
    .outputs{grid-template-columns:1fr;}
  }
  @media(max-width:480px){
    .page-hero h1{font-size:24px;}
    .page-hero .intro{font-size:var(--fs-14);}
    .stage-card{padding:var(--space-16);}
    .stage-state{margin-left:0;}
    .btn{flex:1;justify-content:center;}
  }
</style>
</head>
<body>

<nav class="nav" id="nav">
  <div class="nav-inner">
    <a href="/" class="nav-logo">个人商业<span>创造者</span></a>
    <button class="nav-toggle" id="navToggle" aria-label="菜单" aria-expanded="false" aria-controls="navLinks"><span></span><span></span><span></span></button>
    <ul class="nav-links" id="navLinks">
      <li><a href="/">首页</a></li>
      <li><a href="/#focus">我在做什么</a></li>
      <li><a href="/insights">洞察</a></li>
      <li><a href="/about">关于我</a></li>
    </ul>
  </div>
</nav>

<header class="page-hero">
  <div class="wrap">
    <div class="badge"><span class="line"></span><span class="label">90 DAYS · CREATOR PRACTICE</span></div>
    <h1>我的90天<span class="green">创造者实践</span></h1>
    <p class="intro">从寻找真实需求开始，用 90 天做出一个产品，并公开记录每一步。</p>
    <div class="hero-meta">
      <span class="period">2026.11.08 — 2027.02.05</span>
      <span class="day">Day 01 / 90</span>
      <span class="state">当前 · 第一阶段</span>
    </div>
    <div class="hero-actions">
      <a class="btn btn-primary" href="/insights/?category=90天实战">查看实战记录{archiveCount > 0 && ` · ${archiveCount} 篇`}</a>
      <a class="btn btn-outline" href="/#focus">回到三个方向</a>
    </div>
  </div>
</header>

<main class="wrap">
  <div class="stage-list">
    {stages.map((s) => {
      const posts = s.postIds.map(postOf).filter(Boolean).slice(0, 2);
      return (
        <article class={`stage-card${s.status === '当前' ? ' is-current' : ''}`} id={`stage-${s.id}`}>
          <div class="stage-head">
            <span class="stage-no">第{cnNums[s.id - 1]}阶段</span>
            <span class="stage-range">{s.range.start} — {s.range.end} · {s.days} 天</span>
            <span class={`stage-state${s.status === '当前' ? ' is-current' : ''}`}>{s.status}</span>
          </div>
          <h2>{s.name}</h2>
          <p class="stage-goal">{s.goal}</p>
          <h3>阶段产出</h3>
          <ol class="outputs">
            {s.outputs.map((o, i) => (
              <li><span class="num">{String(i + 1).padStart(2, '0')}</span><span>{o}</span></li>
            ))}
          </ol>
          <div class="records">
            <h3>相关记录</h3>
            {posts.length ? posts.map((p) => (
              <a class="record" href={p.url}>
                <span class="record-date">{p.date}</span>
                <span class="record-title">{p.title}</span>
              </a>
            )) : (
              <p class="record-empty">计划中，随实践更新</p>
            )}
          </div>
        </article>
      );
    })}
  </div>
</main>

<footer class="page-footer">
  <div class="wrap">
    <span>© 2026 个人商业创造者</span>
    <a href="/insights/?category=90天实战">全部 90天实战记录 →</a>
  </div>
</footer>

<script>
  const navToggle = document.getElementById('navToggle');
  const navLinks = document.getElementById('navLinks');
  if (navToggle && navLinks) {
    navToggle.addEventListener('click', () => {
      const open = navLinks.classList.toggle('open');
      navToggle.classList.toggle('open');
      navToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
  }
</script>
</body>
</html>
