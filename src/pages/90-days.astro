---
import { getPracticeSnapshot } from '../data/stages.mjs';
import { getPublishedPosts } from '../lib/insights';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const practice = getPracticeSnapshot();
const stages = practice.stages;
const published = await getPublishedPosts();
const postOf = (slug) => published.find((p) => p.slug === slug);
const archiveCount = published.filter((p) => p.category === '90天实战').length;
const cnNums = ['一', '二', '三', '四'];
---
<!DOCTYPE html>
<html lang="zh-CN" style="background:#0c0c0c;">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#0c0c0c">
<meta name="color-scheme" content="dark">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<title>90天创造者实践 — 个人商业创造者</title>
<meta name="description" content="90 天个人商业实践的四个阶段：目标、产出与公开记录。">
<link rel="canonical" href={new URL('/90-days/', Astro.site).toString()}>
<meta property="og:type" content="website">
<meta property="og:locale" content="zh_CN">
<meta property="og:title" content="90天创造者实践 — 个人商业创造者">
<meta property="og:description" content="90 天个人商业实践的四个阶段：目标、产出与公开记录。">
<meta property="og:url" content={new URL('/90-days/', Astro.site).toString()}>
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="90天创造者实践 — 个人商业创造者">
<meta name="twitter:description" content="90 天个人商业实践的四个阶段：目标、产出与公开记录。">
<link rel="stylesheet" href="/fonts/fonts.css">
<link rel="stylesheet" href="/css/tokens.css">
<script is:inline>document.documentElement.classList.add('js');</script>
<script is:inline src="/js/site-shell.js" defer></script>
<style is:global>
  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{font-family:'Noto Sans SC','Inter',-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Microsoft YaHei',sans-serif;font-size:var(--fs-16);line-height:var(--lh-body);background:var(--bg);color:var(--text);overflow-x:hidden;font-feature-settings:"palt" 1;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility;}
  ::selection{background:var(--accent);color:var(--accent-ink);}
  a{text-decoration:none;color:inherit;}
  ul,ol{list-style:none;}
  :focus-visible{outline:2px solid var(--accent);outline-offset:3px;border-radius:2px;}
  ::-webkit-scrollbar{width:8px;}
  ::-webkit-scrollbar-track{background:var(--bg);}
  ::-webkit-scrollbar-thumb{background:#2a2a2a;border-radius:4px;}

  .wrap{max-width:var(--container-w);margin:0 auto;padding:0 var(--gutter);}

  /* ===== 页头 ===== */
  .page-hero{padding:calc(64px + var(--space-56)) 0 var(--space-40);border-bottom:1px solid var(--border);}
  .eyebrow{display:flex;align-items:center;gap:var(--space-8);font-size:var(--fs-12);color:var(--text-muted);margin-bottom:var(--space-16);}
  .eyebrow::before{content:'';width:6px;height:6px;border-radius:50%;background:var(--accent);flex-shrink:0;}
  .page-hero h1{font-size:var(--fs-48);font-weight:600;line-height:1.18;letter-spacing:0;text-wrap:balance;}
  .page-hero .intro{max-width:640px;margin-top:var(--space-12);font-size:var(--fs-16);color:var(--text-secondary);}
  .hero-meta{display:flex;flex-wrap:wrap;align-items:center;gap:var(--space-8);margin-top:var(--space-24);font-family:'Inter',sans-serif;font-variant-numeric:tabular-nums;font-size:var(--fs-12);color:var(--text-muted);}
  .hero-meta .sep{color:rgba(255,255,255,.2);}
  .hero-meta .day{color:var(--text);}
  .hero-meta .state{display:inline-flex;align-items:center;gap:var(--space-8);color:var(--text-secondary);}
  .hero-meta .state::before{content:'';width:6px;height:6px;border-radius:50%;background:var(--accent);flex-shrink:0;}
  .hero-actions{display:flex;flex-wrap:wrap;gap:var(--space-12);margin-top:var(--space-24);}
  .btn{display:inline-flex;align-items:center;justify-content:center;gap:var(--space-8);padding:var(--space-12) var(--space-24);border-radius:var(--radius-sm);font-size:var(--fs-14);font-weight:500;cursor:pointer;border:1px solid transparent;transition:background-color .2s ease,border-color .2s ease,color .2s ease;}
  .btn-primary{background:var(--accent);color:var(--accent-ink);border-color:var(--accent);}
  .btn-primary:hover{background:#E4F98C;border-color:#E4F98C;}
  .btn-secondary{background:transparent;color:var(--text);border-color:var(--border);}
  .btn-secondary:hover{background:var(--surface);border-color:rgba(255,255,255,.22);}

  /* ===== 阶段列表 ===== */
  .stage-list{display:flex;flex-direction:column;gap:var(--space-24);padding:var(--space-40) 0 var(--space-56);}
  .stage-card{padding:var(--space-32);background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);}
  .stage-card.is-current{border-color:rgba(216,242,107,.35);}
  .stage-head{display:flex;flex-wrap:wrap;align-items:center;gap:var(--space-12);margin-bottom:var(--space-12);}
  .stage-no{font-size:var(--fs-12);color:var(--text);}
  .stage-range{font-family:'Inter',sans-serif;font-variant-numeric:tabular-nums;font-size:var(--fs-12);color:var(--text-muted);}
  .stage-state{margin-left:auto;display:inline-flex;align-items:center;gap:var(--space-8);font-size:var(--fs-12);color:var(--text-muted);}
  .stage-state.is-current{color:var(--text-secondary);}
  .stage-state.is-current::before{content:'';width:6px;height:6px;border-radius:50%;background:var(--accent);flex-shrink:0;}
  .stage-card h2{font-size:var(--fs-20);font-weight:600;line-height:1.4;letter-spacing:0;margin-bottom:var(--space-8);}
  .stage-goal{font-size:var(--fs-14);color:var(--text-secondary);margin-bottom:var(--space-24);}
  .stage-label{font-size:var(--fs-14);font-weight:500;color:var(--text-muted);margin-bottom:var(--space-12);}
  .outputs{display:grid;grid-template-columns:repeat(2,1fr);gap:var(--space-12);margin-bottom:var(--space-24);}
  .outputs li{display:flex;gap:var(--space-12);padding:var(--space-12) var(--space-16);background:rgba(255,255,255,.03);border:1px solid var(--border);border-radius:var(--radius-sm);font-size:var(--fs-14);color:var(--text-secondary);line-height:var(--lh-tight);}
  .outputs .num{font-family:'Inter',sans-serif;font-variant-numeric:tabular-nums;font-size:var(--fs-12);color:var(--text-muted);flex-shrink:0;}
  .records{display:flex;flex-direction:column;gap:var(--space-8);padding-top:var(--space-16);border-top:1px solid var(--border);}
  .record{display:flex;align-items:baseline;gap:var(--space-12);font-size:var(--fs-14);color:var(--text);}
  .record-date{font-family:'Inter',sans-serif;font-variant-numeric:tabular-nums;font-size:var(--fs-12);color:var(--text-muted);flex-shrink:0;}
  .record-title{border-bottom:1px solid var(--border);transition:border-color .2s ease;}
  .record:hover .record-title{border-bottom-color:rgba(255,255,255,.3);}
  .record-empty{font-size:var(--fs-14);color:var(--text-muted);}

  @media(max-width:768px){
    .page-hero{padding:calc(56px + var(--space-32)) 0 var(--space-32);}
    .page-hero h1{font-size:28px;line-height:1.25;}
    .page-hero .intro{font-size:var(--fs-14);}
    .hero-meta{flex-direction:column;align-items:flex-start;gap:var(--space-4);}
    .hero-meta .sep{display:none;}
    .stage-card{padding:var(--space-24);}
    .outputs{grid-template-columns:1fr;}
  }
  @media(max-width:480px){
    .hero-actions{flex-direction:column;}
    .hero-actions .btn{width:100%;}
    .stage-card{padding:var(--space-16);}
    .stage-state{margin-left:0;}
  }
</style>
</head>
<body>

<Nav active="focus" />

<header class="page-hero">
  <div class="wrap">
    <p class="eyebrow">90 天创造者实践</p>
    <h1>我的 90 天创造者实践</h1>
    <p class="intro">从寻找真实需求开始，用 90 天做出一个产品，并公开记录每一步。</p>
    <div class="hero-meta">
      <span data-practice-period>{practice.period}</span>
      <span class="sep" aria-hidden="true">·</span>
      <span class="day" data-practice-day>{`Day ${String(practice.dayNumber).padStart(2, '0')} / 90`}</span>
      <span class="sep" aria-hidden="true">·</span>
      <span class="state" data-practice-state>{(stages.find((stage) => stage.id === practice.currentStageId)?.status ?? '当前') + ' · 第' + cnNums[practice.currentStageId - 1] + '阶段'}</span>
    </div>
    <div class="hero-actions">
      <a class="btn btn-primary" href="/insights/?category=90天实战">查看实战记录{archiveCount > 0 && ` · ${archiveCount} 篇`}</a>
      <a class="btn btn-secondary" href="/#focus">回到三个方向</a>
    </div>
  </div>
</header>

<main class="wrap">
  <div class="stage-list">
    {stages.map((s) => {
      const posts = s.postIds.map(postOf).filter(Boolean).slice(0, 2);
      return (
        <article class={`stage-card${s.status === '当前' ? ' is-current' : ''}`} id={`stage-${s.id}`} data-practice-stage data-stage-start={s.startDate} data-stage-end={s.endDate}>
          <div class="stage-head">
            <span class="stage-no">第{cnNums[s.id - 1]}阶段</span>
            <span class="stage-range" data-stage-range>{s.range.start} — {s.range.end} · {s.days} 天</span>
            <span class={`stage-state${s.status === '当前' ? ' is-current' : ''}`} data-stage-status>{s.status}</span>
          </div>
          <h2>{s.name}</h2>
          <p class="stage-goal">{s.goal}</p>
          <h3 class="stage-label">阶段产出</h3>
          <ol class="outputs">
            {s.outputs.map((o, i) => (
              <li><span class="num">{String(i + 1).padStart(2, '0')}</span><span>{o}</span></li>
            ))}
          </ol>
          <div class="records">
            <h3 class="stage-label">相关记录</h3>
            {posts.length ? posts.map((p) => (
              <a class="record" href={p.url}>
                <span class="record-date">{p.date}</span>
                <span class="record-title">{p.title}</span>
              </a>
            )) : (
              <p class="record-empty">随实践更新</p>
            )}
          </div>
        </article>
      );
    })}
  </div>
</main>

<Footer />
<script is:inline src="/js/practice-clock.js" defer></script>
</body>
</html>
