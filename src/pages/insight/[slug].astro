---
import { getCollection, getEntry, render } from 'astro:content';
import { getPublishedPosts, toPost } from '../../lib/insights';
import { shade, INK } from '../../lib/cover-palette.mjs';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const entries = await getCollection('insights');
  return entries.map((entry) => ({ params: { slug: entry.id } }));
}

const { slug } = Astro.params;
const entry = await getEntry('insights', slug);
const post = toPost(entry);
const { Content, headings } = await render(entry);

const all = await getPublishedPosts();
const sameCategory = all.filter((p) => p.category === post.category);
const index = sameCategory.findIndex((p) => p.slug === post.slug);
const prevPost = index > 0 ? sameCategory[index - 1] : null;
const nextPost = sameCategory[index + 1] ?? null;
// 一条核心观点一张卡：同一主色 #D8F26B，逐张提亮，文字统一深色。
const opinionCards = post.takeaways.map((text, i) => ({
  text,
  index: i + 1,
  total: post.takeaways.length,
  ...shade(i, post.takeaways.length),
}));

const inkVars = `--oc-ink:${INK.strong};--oc-body:${INK.body};--oc-soft:${INK.soft};--oc-dot:${INK.dot};--oc-rule:${INK.rule}`;

const draftLabel = post.draft ? '草稿 · 未发布' : '';
const canonical = new URL(post.url, Astro.site ?? 'https://xiaomaker.top').toString();
const coverUrl = new URL(post.cover, Astro.site ?? 'https://xiaomaker.top').toString();
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  datePublished: post.date.replace(/\./g, '-'),
  author: { '@type': 'Person', name: '个人商业创造者' },
  description: post.excerpt,
  image: coverUrl,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  inLanguage: 'zh-CN',
  articleSection: post.category,
  keywords: post.tags,
};


import { ClientRouter } from 'astro:transitions';
---
<!DOCTYPE html>
<html lang="zh-CN" style="background:#0C0C0C;">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#0C0C0C">
<meta name="color-scheme" content="dark">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<title>{post.title} — 个人商业创造者</title>
<meta name="description" content={post.excerpt}>
{post.draft && <meta name="robots" content="noindex,nofollow">}
<link rel="canonical" href={canonical}>
<meta property="og:type" content="article">
<meta property="og:locale" content="zh_CN">
<meta property="article:section" content={post.category}>
<meta property="og:title" content={post.title}>
<meta property="og:description" content={post.excerpt}>
<meta property="og:image" content={coverUrl}>
<meta property="og:url" content={canonical}>
<meta property="article:published_time" content={post.date.replace(/\./g, '-')}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:url" content={canonical}>
<meta name="twitter:title" content={post.title}>
<meta name="twitter:description" content={post.excerpt}>
<meta name="twitter:image" content={coverUrl}>
<link rel="stylesheet" href="/fonts/fonts.css">
<link rel="stylesheet" href="/css/tokens.css">
<script is:inline data-astro-rerun>document.documentElement.classList.add('js');</script>
<script is:inline src="/js/site-shell.js" defer></script>
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
<style is:global>
  :root{
    --bg:#0C0C0C;
    --bg-card:#141414;
    --surface-2:#1A1A1A;
    --accent:#D8F26B;
    --accent-rgb:216,242,107;
    --text:#F5F5F4;
    --body:#D2D2CD;
    --text-secondary:#A8A8A3;
    --text-muted:#75756F;
    --border:rgba(255,255,255,.09);
    --radius:12px;
    --art-w:760px;
    --toc-w:196px;
    --content-gap:48px;
  }
  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{font-family:'Noto Sans SC','Inter',-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Microsoft YaHei',sans-serif;font-size:16px;background:var(--bg);color:var(--text);line-height:1.75;overflow-x:hidden;font-feature-settings:"palt" 1;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility;}
  ::selection{background:var(--accent);color:#0C0C0C;}
  a{text-decoration:none;color:inherit;}
  img{display:block;}
  :focus-visible{outline:2px solid var(--accent);outline-offset:3px;border-radius:2px;}
  ::-webkit-scrollbar{width:8px;}
  ::-webkit-scrollbar-track{background:var(--bg);}
  ::-webkit-scrollbar-thumb{background:#2A2A2A;border-radius:4px;}

  .reading-progress{position:fixed;top:0;left:0;height:2px;width:0;background:var(--accent);z-index:1100;transition:width .08s linear;}

  /* ===== 容器：标题、观点卡与正文使用同一阅读版心 ===== */
  .art-inner{width:100%;max-width:1120px;margin:0 auto;padding:0 28px;}
  .col{max-width:var(--art-w);margin-left:calc((100% - var(--toc-w) - var(--content-gap) - var(--art-w))/2 + var(--toc-w) + var(--content-gap));}
  .article-head .art-inner{max-width:1120px;}
  .card-col{max-width:var(--art-w);}

  .article-head{padding:calc(64px + 40px) 0 30px;}
  .meta-line{display:flex;flex-wrap:wrap;align-items:center;gap:var(--space-8);font-family:'Inter',sans-serif;font-size:12.5px;line-height:1.6;color:var(--text-muted);margin-bottom:12px;font-variant-numeric:tabular-nums;}
  .meta-line .dot{color:rgba(255,255,255,.22);}
  .article-status{display:inline-flex;align-items:center;padding:2px 8px;border:1px dashed rgba(242,193,78,.45);border-radius:4px;background:rgba(242,193,78,.08);color:#F2C14E;font-size:12px;font-weight:500;letter-spacing:0;}

  .article-title{font-size:clamp(28px,2.5vw,34px);font-weight:700;line-height:1.32;letter-spacing:.004em;text-wrap:balance;}
  .article-tagline{margin-top:12px;font-size:15.5px;font-weight:400;line-height:1.8;color:var(--text-secondary);letter-spacing:0;}

  .card-col{margin-bottom:var(--space-24);}
  .article-cover{width:100%;aspect-ratio:16/10;max-height:300px;border-radius:var(--radius);overflow:hidden;background:var(--bg-card);border:1px solid var(--border);}


  .article-body{padding-bottom:var(--space-40);}
  .article-body > .art-inner{max-width:1120px;}
  .reading-layout{display:grid;grid-template-columns:var(--toc-w) minmax(0,var(--art-w));gap:var(--content-gap);align-items:start;justify-content:center;}
  .article-toc{position:sticky;top:96px;max-height:calc(100vh - 120px);overflow:auto;padding:8px 0;scrollbar-width:thin;}
  .article-toc details{border-left:1px solid rgba(255,255,255,.12);padding-left:14px;}
  .article-toc summary{list-style:none;display:flex;align-items:center;justify-content:space-between;gap:8px;cursor:pointer;color:var(--text);font-size:12px;font-weight:600;letter-spacing:.04em;margin-bottom:14px;}
  .article-toc summary::-webkit-details-marker{display:none;}
  .article-toc summary::after{content:'−';color:var(--text-muted);font:14px 'Inter',sans-serif;}
  .article-toc details:not([open]) summary::after{content:'+';}
  .article-toc summary span{display:block;color:var(--text-muted);font:9px 'Inter',sans-serif;letter-spacing:.14em;white-space:nowrap;}
  .article-toc nav{display:grid;gap:3px;}
  .toc-link{display:block;padding:7px 9px;border-radius:5px;color:var(--text-muted);font-size:12px;line-height:1.55;border-left:2px solid transparent;transition:color .18s ease,background .18s ease,border-color .18s ease;}
  .toc-link:hover,.toc-link.is-active{color:var(--accent);background:rgba(216,242,107,.06);border-left-color:var(--accent);}
  .article-toc .toc-sub-link{padding-left:18px;font-size:11px;}
  .reading-content{min-width:0;width:100%;max-width:var(--art-w);}
  .reading-content > .col{max-width:none;margin-left:0;}
  .article-tools{display:flex;align-items:center;justify-content:flex-end;gap:8px;min-height:40px;margin:0 0 24px;padding:0 0 12px;border-bottom:1px solid var(--border);}
  .font-tools{display:flex;align-items:center;gap:5px;margin-right:auto;color:var(--text-muted);font-size:11px;}
  .article-tools button{min-height:34px;padding:6px 10px;border:1px solid var(--border);border-radius:6px;background:transparent;color:var(--text-secondary);font:inherit;font-size:11px;cursor:pointer;white-space:nowrap;}
  .article-tools button:hover,.article-tools button[aria-pressed="true"]{border-color:rgba(216,242,107,.45);color:var(--accent);background:rgba(216,242,107,.06);}
  .article-end{max-width:var(--art-w);margin:0 auto;}
  .reading-top{position:fixed;right:24px;bottom:24px;z-index:900;width:42px;height:42px;border:1px solid var(--border);border-radius:50%;background:rgba(20,20,20,.92);color:var(--text-secondary);display:grid;place-items:center;opacity:0;visibility:hidden;transform:translateY(8px);transition:opacity .2s ease,transform .2s ease,visibility .2s ease;cursor:pointer;backdrop-filter:blur(10px);}
  .reading-top.is-visible{opacity:1;visibility:visible;transform:translateY(0);}
  .reading-top:hover,.reading-top:focus-visible{color:var(--accent);border-color:rgba(216,242,107,.55);}
  .article-start-anchor{height:1px;scroll-margin-top:104px;}
  .markdown{--reading-font:17px;}
  @media(max-width:720px){.markdown{--reading-font:16px;}}
  .markdown p{font-size:var(--reading-font);}
  .markdown h2,.markdown h3{scroll-margin-top:88px;}
  .markdown{counter-reset:article-section;}
  .markdown h2{counter-increment:article-section;display:flex;align-items:baseline;gap:18px;padding-top:28px;margin:38px 0 20px;border-top:1px solid rgba(255,255,255,.10);font-size:21px;line-height:1.5;color:var(--text);font-weight:700;scroll-margin-top:88px;}
  .markdown h2::before{content:counter(article-section,decimal-leading-zero);flex:0 0 38px;color:var(--accent);font:700 22px/1 'Inter',sans-serif;letter-spacing:-.03em;}
  .markdown h3{font-size:17px;line-height:1.6;color:var(--text);margin:26px 0 14px;scroll-margin-top:88px;}
  .article-toc .toc-sub-link{padding-left:20px;font-size:11px;}
  .markdown blockquote{margin:28px 0;padding:20px 24px;border-left:2px solid var(--accent);background:rgba(216,242,107,.06);color:var(--text-secondary);}
  .markdown ul,.markdown ol{margin:0 0 26px;padding-left:1.4em;color:var(--body);font-size:var(--reading-font,17px);line-height:1.85;}
  .markdown li{margin:0 0 8px;}
  .markdown li::marker{color:var(--accent);}
  .markdown img{max-width:100%;height:auto;border-radius:6px;border:1px solid var(--border);}
  .markdown figure{margin:32px 0;}
  .markdown figcaption{margin-top:8px;color:var(--text-muted);font-size:12px;line-height:1.7;}

  .markdown pre{max-width:100%;overflow:auto;padding:18px 20px;margin:24px 0;background:#111;border:1px solid var(--border);border-radius:8px;line-height:1.65;}
  .markdown pre code{padding:0;background:transparent;white-space:pre;}
  .markdown table{display:block;max-width:100%;overflow-x:auto;border-collapse:collapse;margin:24px 0;font-size:14px;}
  .markdown th,.markdown td{padding:10px 12px;border:1px solid var(--border);text-align:left;vertical-align:top;}
  .markdown th{color:var(--text);background:rgba(255,255,255,.04);}
  body.is-focus-mode .article-toc,body.is-focus-mode .opinion-card{display:none;}
  body.is-focus-mode .article-body > .art-inner{max-width:880px;}
  body.is-focus-mode .reading-layout{display:block;}
  body.is-focus-mode .reading-content,body.is-focus-mode .article-end{max-width:880px;}
  body.is-focus-mode .reading-content > .col{margin-left:0;}


  /* ===== 原生 Markdown 正文排版 ===== */
  .markdown{font-family:'Inter','Noto Sans SC',-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Microsoft YaHei',sans-serif;font-feature-settings:"palt" 1,"kern" 1;font-kerning:normal;}
  .markdown p{font-size:var(--reading-font,17px);line-height:1.82;letter-spacing:.008em;color:var(--body);margin:0 0 26px;}
  .markdown p:last-child{margin-bottom:0;}
  .markdown strong{color:var(--text);font-weight:600;}
  .markdown code{font-family:'Inter',ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:.9em;background:rgba(255,255,255,.06);padding:1px 5px;border-radius:4px;}
  .markdown a{color:var(--accent);border-bottom:1px solid rgba(var(--accent-rgb),.4);}

  .article-tags{display:flex;flex-wrap:wrap;gap:var(--space-8);padding-top:var(--space-24);margin-top:var(--space-40);border-top:1px solid var(--border);}
  .article-tag{padding:4px 8px;border-radius:4px;background:transparent;border:1px solid var(--border);font-size:12px;font-weight:400;color:var(--text-secondary);letter-spacing:0;}

  .author-card{margin-top:var(--space-40);padding:var(--space-24);background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);display:flex;align-items:flex-start;gap:var(--space-16);}
  .author-avatar{width:40px;height:40px;border-radius:50%;background:var(--surface-2);border:1px solid var(--border);display:grid;place-items:center;color:var(--text);font-weight:600;font-size:16px;flex-shrink:0;}
  .author-copy strong{display:block;font-size:15px;font-weight:600;margin-bottom:var(--space-8);}
  .author-copy p{font-size:13px;color:var(--text-secondary);line-height:1.7;margin-bottom:var(--space-8);}
  .author-copy a{font-size:12.5px;color:var(--text-muted);border-bottom:1px solid var(--border);}
  .author-copy a:hover,.author-copy a:focus-visible{color:var(--accent);border-color:var(--accent);}
  .author-copy .author-social{margin:var(--space-8) 0 0;font-size:12.5px;color:var(--text-muted);line-height:1.7;}

  .article-nav{margin-top:var(--space-40);display:grid;grid-template-columns:1fr 1fr;gap:var(--space-16);}
  .article-nav-link{padding:var(--space-16) var(--space-24);background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);transition:border-color .2s ease,background-color .2s ease;display:flex;flex-direction:column;gap:var(--space-4);}
  .article-nav-link:hover,.article-nav-link:focus-visible{border-color:rgba(216,242,107,.5);background:var(--surface-2);}
  .article-nav-link.next{text-align:right;align-items:flex-end;}
  .article-nav-link .nav-label{font-size:12px;color:var(--text-muted);letter-spacing:0;}
  .article-nav-link .nav-title{font-size:13.5px;font-weight:500;color:var(--text);line-height:1.6;}

  .back-insights{display:flex;justify-content:center;margin-top:var(--space-40);}
  .back-insights a{display:inline-flex;align-items:center;gap:var(--space-8);font-size:13px;color:var(--text-secondary);letter-spacing:0;transition:color .2s ease;}
  .back-insights a:hover,.back-insights a:focus-visible{color:var(--accent);}
  .back-insights svg{width:16px;height:16px;stroke-width:1.5;}

  /* 核心观点卡：手动切换，不自动轮播，避免打断阅读。 */
  .opinion-card{position:relative;width:100%;margin:0 0 var(--space-24);background:var(--card-bg);border:1px solid var(--oc-rule);border-radius:var(--radius);overflow:hidden;touch-action:pan-y;cursor:grab;transition:background-color .3s ease;}
  .opinion-card:active{cursor:grabbing;}
  .js .opinion-card{min-height:240px;}
  .opinion-card:focus-visible{outline:2px solid var(--oc-ink);outline-offset:2px;}
  .opinion-slide{display:flex;flex-direction:column;gap:var(--space-16);padding:var(--space-32);background:var(--card-bg);}
  .opinion-slide + .opinion-slide{border-top:1px solid var(--oc-rule);}
  .js .opinion-slide{display:none;position:relative;inset:auto;opacity:1;border-top:0;pointer-events:auto;}
  .js .opinion-slide.is-active{display:flex;opacity:1;animation:oc-fade .3s ease;}
  @keyframes oc-fade{from{opacity:0;}to{opacity:1;}}
  .oc-meta{display:flex;align-items:center;justify-content:space-between;font-size:12px;letter-spacing:.02em;color:var(--oc-soft);}
  .oc-category{display:flex;align-items:center;gap:var(--space-8);color:var(--oc-soft);}
  .oc-category::before{content:'';width:24px;height:3px;background:var(--card-accent);flex-shrink:0;}
  .oc-index{font-family:'Inter',sans-serif;letter-spacing:0;color:var(--oc-soft);font-variant-numeric:tabular-nums;}
  .oc-text{flex:1;display:flex;align-items:center;font-size:clamp(24px,2.4vw,32px);font-weight:700;line-height:1.38;letter-spacing:.01em;color:var(--oc-ink);text-wrap:balance;}
  .oc-brand{display:flex;align-items:center;gap:var(--space-8);padding-right:88px;font-size:12px;letter-spacing:.02em;color:var(--oc-soft);}
  .oc-brand::before{content:'';width:6px;height:6px;border-radius:50%;background:var(--card-accent);flex-shrink:0;}
  .opinion-dots{display:none;}
  .js .opinion-dots{position:absolute;right:var(--space-24);bottom:var(--space-16);display:flex;gap:2px;z-index:2;}
  .opinion-dot{width:32px;height:32px;padding:0;border:0;background:transparent;display:grid;place-items:center;cursor:pointer;}
  .opinion-dot::before{content:'';width:7px;height:7px;border-radius:50%;background:var(--oc-dot);transition:background-color .2s ease,transform .2s ease;}
  .opinion-dot[aria-current="true"]::before{background:var(--oc-ink);transform:scale(1.2);}
  .opinion-dot:focus-visible{outline:2px solid var(--oc-ink);outline-offset:-4px;border-radius:50%;}

  /* 移动端：左右留白 20px；正文 16px/1.85，每行约 21 个汉字；编号收进标题行 */
  @media(max-width:1060px){
    .article-body > .art-inner{max-width:820px;}
    .article-head .col,.card-col{margin-left:auto;margin-right:auto;}
    .reading-layout{display:block;}
    .article-toc{position:relative;top:auto;max-height:none;margin:0 0 22px;padding:0;}
    .article-toc details{border:1px solid var(--border);border-radius:8px;padding:12px 14px;}
    .article-toc summary{margin:0;}
    .article-toc details[open] summary{margin-bottom:10px;}
    .article-toc nav{grid-template-columns:repeat(2,minmax(0,1fr));gap:3px;}
    .reading-content{max-width:760px;margin:0 auto;}
    .article-end{max-width:760px;}
  }
  @media(max-width:720px){
    .art-inner{max-width:100%;padding:0 20px;}
    .col{margin-left:0;max-width:100%;}
    .article-head .col,.card-col{max-width:100%;}
    .article-head{padding:calc(56px + 28px) 0 22px;}
    .meta-line{font-size:12px;margin-bottom:10px;}
    .article-title{font-size:26px;line-height:1.34;}
    .article-tagline{font-size:14.5px;line-height:1.75;margin-top:10px;}
    .markdown p{font-size:var(--reading-font,16px);line-height:1.85;margin-bottom:22px;}
    .markdown h2{gap:12px;padding-top:22px;margin:28px 0 16px;font-size:18px;}
    .markdown h2::before{flex-basis:30px;font-size:19px;}
    .markdown h3{font-size:16.5px;margin:22px 0 12px;}
    .article-cover{max-height:none;}
    .js .opinion-card{min-height:200px;}
    .opinion-slide{padding:20px;gap:var(--space-12);}
    .oc-text{font-size:20px;line-height:1.5;}
    .oc-brand{padding-right:96px;}
    .js .opinion-dots{right:10px;bottom:6px;gap:0;}
    .opinion-dot{width:36px;height:36px;}
    .article-nav{grid-template-columns:1fr;}
    .article-nav-link.next{text-align:left;align-items:flex-start;}
    .author-card{padding:var(--space-16);}
    .article-tools{gap:6px;margin-bottom:14px;}
    .article-tools button{padding:5px 8px;font-size:10px;}
    .article-toc nav{grid-template-columns:1fr;}
    .font-tools{gap:3px;}
    .article-tools{flex-wrap:wrap;justify-content:flex-start;}
    .font-tools{margin-right:auto;}
    .reading-top{right:16px;bottom:16px;width:40px;height:40px;}
    .article-end{max-width:100%;}
  }

  @media print{
    :root{--bg:#fff;--text:#111;--body:#222;--text-secondary:#444;--border:#ddd;}
    body{background:#fff!important;color:#111!important;overflow:visible;}
    .site-nav,.reading-progress,.article-toc,.article-tools,.reading-top,.opinion-card,.article-nav,.back-insights,footer{display:none!important;}
    .article-head{padding:24px 0;}
    .art-inner,.article-body > .art-inner{max-width:100%;padding:0;}
    .reading-layout{display:block;}
    .reading-content,.article-end{max-width:100%;}
    .markdown p,.markdown li,.markdown blockquote{color:#222!important;}
    .markdown h2,.markdown h3{break-after:avoid;color:#111!important;}
    a{color:#111!important;text-decoration:underline;}
    img{max-width:100%;break-inside:avoid;}
  }

  @media(prefers-reduced-motion:reduce){
    html{scroll-behavior:auto;}
    .js .opinion-slide.is-active{animation:none;}
    .opinion-dot::before{transition:none;}
  }

  /* 阅读体验补强：稳定的目录列、清晰的正文节奏与可触达控件。 */
  .reading-layout{width:100%;max-width:1004px;margin:0 auto;grid-template-columns:minmax(150px,var(--toc-w)) minmax(0,var(--art-w));}
  .article-toc{min-width:0;}
  .article-toc nav{max-height:calc(100vh - 190px);overflow:auto;padding-right:6px;}
  .toc-link{overflow-wrap:anywhere;}
  .article-tools{position:relative;}
  .article-tools button:disabled{opacity:.35;cursor:not-allowed;}
  .font-tools output{min-width:34px;text-align:center;color:var(--text-secondary);font:11px 'Inter',sans-serif;font-variant-numeric:tabular-nums;}
  .markdown{overflow-wrap:anywhere;}
  .markdown > :first-child{margin-top:0;}
  .markdown h2{scroll-margin-top:104px;}
  .markdown h3{scroll-margin-top:104px;}
  .markdown hr{border:0;border-top:1px solid var(--border);margin:36px 0;}
  .markdown blockquote p:last-child{margin-bottom:0;}
  .markdown pre{tab-size:2;-webkit-overflow-scrolling:touch;}
  .markdown table{width:100%;display:block;overscroll-behavior-inline:contain;-webkit-overflow-scrolling:touch;}
  .markdown th{white-space:nowrap;}
  .markdown td{min-width:100px;}
  .markdown a{overflow-wrap:anywhere;}
  .article-end{width:100%;}
  @media(max-width:1060px){
    .reading-layout{max-width:760px;}
    .article-toc nav{max-height:none;}
  }
  @media(max-width:720px){
    .article-tools{position:sticky;top:58px;z-index:20;background:rgba(12,12,12,.94);backdrop-filter:blur(12px);padding:8px 0;margin-bottom:18px;}
    .article-tools button{min-height:38px;font-size:11px;}
    .font-tools{min-height:38px;}
    .article-toc{margin-bottom:18px;}
    .article-toc details{background:rgba(20,20,20,.72);}
    .article-toc nav{padding-top:4px;}
    .markdown blockquote{padding:16px 18px;margin:24px 0;}
    .markdown pre{padding:14px;margin:20px 0;font-size:12px;}
    .markdown table{font-size:12px;}
    .markdown th,.markdown td{padding:8px 10px;}
    .reading-layout{max-width:none;}
  }
  @media(prefers-reduced-motion:reduce){
    .reading-progress,.reading-top,.toc-link{transition:none!important;}
  }
</style>
  <ClientRouter fallback="swap" />
</head>
<body>

<div class="reading-progress" id="readingProgress" role="progressbar" aria-label="文章阅读进度" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"></div>

<Nav variant="article" />

<header class="article-head">
  <div class="art-inner">
    <div class="col">
      <div class="meta-line">
        <span>{post.date}</span><span class="dot">·</span>
        <span>{post.category}</span><span class="dot">·</span>
        <span>{post.readTime}</span>
        {draftLabel && <span class="article-status">{draftLabel}</span>}
      </div>
      <h1 class="article-title">{post.title}</h1>
      {post.tagline && <p class="article-tagline">{post.tagline}</p>}
    </div>
  </div>
</header>

{opinionCards.length > 0 && (
  <div class="art-inner">
    <div class="col card-col">
      <section class="opinion-card" data-opinion tabindex="0" role="group" aria-roledescription="轮播" aria-label={`核心观点，共 ${post.takeaways.length} 条`} style={`--card-bg:${opinionCards[0].bg};--card-accent:${opinionCards[0].accent};${inkVars}`}>
        {opinionCards.map((card, i) => (
          <article class={`opinion-slide${i === 0 ? ' is-active' : ''}`} data-slide style={`--card-bg:${card.bg};--card-accent:${card.accent};${inkVars}`} aria-label={`第 ${card.index} 条，共 ${card.total} 条`}>
            <div class="oc-meta">
              <span class="oc-category">{post.category}</span>
              <span class="oc-index">{card.index} / {card.total}</span>
            </div>
            <p class="oc-text">{card.text}</p>
            <div class="oc-brand">个人商业创造者</div>
          </article>
        ))}
        {opinionCards.length > 1 && (
          <div class="opinion-dots">
            {opinionCards.map((card, i) => (
              <button type="button" class="opinion-dot" data-dot data-index={i} aria-label={`查看第 ${card.index} 条观点`} aria-current={i === 0 ? 'true' : 'false'}></button>
            ))}
          </div>
        )}
      </section>
    </div>
  </div>
)}

<main class="article-body">
  <div class="art-inner">
    {opinionCards.length === 0 && (
      <div class="col">
        <div class="article-cover">
          <img src={post.cover} alt={post.title} width="1600" height="1000" loading="eager" decoding="async">
        </div>
      </div>
    )}

    <div class="reading-layout">
      <aside class="article-toc" aria-label="文章目录">
        <details open data-toc-details>
          <summary>文章目录 <span>ON THIS PAGE</span></summary>
          <nav>
            <a class="toc-link" href="#article-start">开篇</a>
            {headings.filter((heading) => heading.depth === 2 || heading.depth === 3).map((heading) => (
              <a class:list={['toc-link', { 'toc-sub-link': heading.depth === 3 }]} href={`#${heading.slug}`}>{heading.text}</a>
            ))}
            <a class="toc-link" href="#article-end">作者与延伸阅读</a>
          </nav>
        </details>
      </aside>
      <div class="reading-content">
        <div class="article-tools" aria-label="阅读设置">
          <div class="font-tools" aria-label="字号设置">
            <span>字号</span>
            <button type="button" data-font="down" aria-label="缩小字号">A−</button>
            <output data-font-value aria-live="polite">17px</output>
            <button type="button" data-font="up" aria-label="放大字号">A＋</button>
            <button type="button" data-font="reset" aria-label="恢复默认字号">重置</button>
          </div>
          <button type="button" class="focus-toggle" data-focus-toggle aria-pressed="false">专注阅读</button>
          <button type="button" class="top-toggle" data-back-top>回到顶部 ↑</button>
        </div>
        <div class="article-start-anchor" id="article-start" aria-hidden="true"></div>
        <article class="markdown">
          <Content />
        </article>

        <div class="article-end" id="article-end">
          {post.tags.length > 0 && (
        <div class="article-tags">
          {post.tags.map((tag) => <span class="article-tag">{tag}</span>)}
        </div>
      )}

      <section class="author-card">
        <div class="author-avatar" aria-hidden="true">商</div>
        <div class="author-copy">
          <strong>个人商业创造者</strong>
          <p>18 年 IT 与产业数字化经验，正在用 AI 把专业能力转化为自己的产品与商业资产。</p>
          <a href="mailto:cronaldo.yang@outlook.com">cronaldo.yang@outlook.com</a>
          <p class="author-social">抖音、小红书和微信公众号搜索「个人商业创造者」</p>
        </div>
      </section>

      {(prevPost || nextPost) && (
        <nav class="article-nav" aria-label="同栏目文章">
          {prevPost && (
            <a class="article-nav-link" href={prevPost.url}>
              <span class="nav-label">上一篇</span>
              <span class="nav-title">{prevPost.title}</span>
            </a>
          )}
          {nextPost && (
            <a class="article-nav-link next" href={nextPost.url}>
              <span class="nav-label">下一篇</span>
              <span class="nav-title">{nextPost.title}</span>
            </a>
          )}
        </nav>
      )}

          <div class="back-insights">
            <a href="/insights">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
          返回洞察
        </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>

<button class="reading-top" type="button" data-back-top aria-label="回到页面顶部" title="回到顶部">↑</button>

<Footer />

<script is:inline data-astro-rerun>
(function () {
  const bar = document.getElementById('readingProgress');
  const article = document.querySelector('.markdown');
  const fontButtons = document.querySelectorAll('[data-font]');
  const focusButton = document.querySelector('[data-focus-toggle]');
  const topButtons = document.querySelectorAll('[data-back-top]');
  const floatingTop = document.querySelector('.reading-top');
  const tocDetails = document.querySelector('[data-toc-details]');
  const mobileReading = window.matchMedia('(max-width: 720px)');
  const fontValue = document.querySelector('[data-font-value]');
  const defaultFont = () => mobileReading.matches ? 16 : 17;
  let readingFont = defaultFont();
  const paintFont = () => {
    if (article) article.style.setProperty('--reading-font', readingFont + 'px');
    if (fontValue) fontValue.textContent = readingFont + 'px';
    fontButtons.forEach((button) => {
      const action = button.dataset.font;
      button.disabled = (action === 'down' && readingFont <= 15) || (action === 'up' && readingFont >= 21);
    });
  };
  paintFont();

  fontButtons.forEach((button) => {
    button.addEventListener('click', () => {
      if (button.dataset.font === 'reset') readingFont = defaultFont();
      else readingFont = Math.max(15, Math.min(21, readingFont + (button.dataset.font === 'up' ? 1 : -1)));
      paintFont();
    });
  });

  if (focusButton) {
    focusButton.addEventListener('click', () => {
      const enabled = document.body.classList.toggle('is-focus-mode');
      focusButton.setAttribute('aria-pressed', String(enabled));
      focusButton.textContent = enabled ? '退出专注' : '专注阅读';
    });
  }
  topButtons.forEach((button) => {
    button.addEventListener('click', () => window.scrollTo({ top: 0, behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' }));
  });
  const syncTocMode = () => {
    if (!tocDetails) return;
    if (window.matchMedia('(max-width: 900px)').matches) {
      if (!tocDetails.dataset.userToggled) tocDetails.open = false;
    } else tocDetails.open = true;
  };
  syncTocMode();
  tocDetails?.querySelector('summary')?.addEventListener('click', () => { tocDetails.dataset.userToggled = 'true'; });
  window.addEventListener('resize', syncTocMode);

  const tocItems = Array.from(document.querySelectorAll('.toc-link')).map((link) => ({
    link,
    target: document.getElementById(decodeURIComponent(link.hash.slice(1))),
  })).filter((item) => item.target);

  const updateActiveToc = () => {
    if (!tocItems.length) return;
    const activationLine = Math.min(180, Math.max(96, window.innerHeight * 0.22));
    let activeItem = tocItems[0];
    tocItems.forEach((item) => {
      if (item.target.getBoundingClientRect().top <= activationLine) activeItem = item;
    });
    tocItems.forEach(({ link }) => {
      const active = link === activeItem.link;
      link.classList.toggle('is-active', active);
      if (active) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    });
  };

  let ticking = false;
  const update = () => {
    if (ticking) return;
    ticking = true;
    window.requestAnimationFrame(() => {
      const rect = article?.getBoundingClientRect();
      const articleTop = window.scrollY + (rect?.top ?? 0);
      const articleHeight = article?.offsetHeight ?? document.documentElement.scrollHeight;
      const track = Math.max(1, articleHeight - window.innerHeight);
      const progress = Math.max(0, Math.min(1, (window.scrollY - articleTop) / track));
      bar.style.width = (progress * 100) + '%';
      bar.setAttribute('aria-valuenow', String(Math.round(progress * 100)));
      if (floatingTop) floatingTop.classList.toggle('is-visible', window.scrollY > 520);
      updateActiveToc();
      ticking = false;
    });
  };
  window.addEventListener('scroll', update, { passive: true });
  window.addEventListener('resize', update);
  if (article && 'ResizeObserver' in window) new ResizeObserver(update).observe(article);
  updateActiveToc();
  update();

})();
</script>

<script is:inline data-astro-rerun>
  (function () {
    const card = document.querySelector('[data-opinion]');
    if (!card) return;
    const slides = Array.from(card.querySelectorAll('[data-slide]'));
    const dots = Array.from(card.querySelectorAll('[data-dot]'));
    let index = 0;
    let dragging = false;
    let startX = 0;
    let startY = 0;
    let deltaX = 0;

    function paint() {
      slides.forEach(function (slide, i) {
        slide.classList.toggle('is-active', i === index);
        slide.setAttribute('aria-hidden', i === index ? 'false' : 'true');
      });
      dots.forEach(function (dot, i) {
        dot.setAttribute('aria-current', i === index ? 'true' : 'false');
      });
      card.style.setProperty('--card-bg', slides[index].style.getPropertyValue('--card-bg'));
    }
    function go(next) {
      index = (next + slides.length) % slides.length;
      paint();
    }

    card.addEventListener('keydown', function (event) {
      if (event.key === 'ArrowRight') { event.preventDefault(); go(index + 1); }
      else if (event.key === 'ArrowLeft') { event.preventDefault(); go(index - 1); }
    });
    dots.forEach(function (dot) {
      dot.addEventListener('click', function () { go(Number(dot.dataset.index)); });
    });

    card.addEventListener('pointerdown', function (event) {
      if (event.pointerType === 'mouse' && event.button !== 0) return;
      if (event.target.closest('button, a, input, textarea')) return;
      dragging = true;
      startX = event.clientX;
      startY = event.clientY;
      deltaX = 0;
      if (card.setPointerCapture) card.setPointerCapture(event.pointerId);
    });
    card.addEventListener('pointermove', function (event) {
      if (!dragging) return;
      deltaX = event.clientX - startX;
      const deltaY = event.clientY - startY;
      if (Math.abs(deltaX) > Math.abs(deltaY) + 8) {
        card.style.cursor = 'grabbing';
        card.style.userSelect = 'none';
      }
    });
    function endDrag(commit) {
      if (!dragging) return;
      dragging = false;
      card.style.cursor = '';
      card.style.userSelect = '';
      if (commit && Math.abs(deltaX) > 40) go(index + (deltaX < 0 ? 1 : -1));
      deltaX = 0;
    }
    card.addEventListener('pointerup', function () { endDrag(true); });
    card.addEventListener('pointercancel', function () { endDrag(false); });
    card.addEventListener('lostpointercapture', function () { endDrag(false); });

    paint();
  })();
</script>
</body>
</html>
