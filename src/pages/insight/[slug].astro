---
import { getCollection, getEntry, render } from 'astro:content';
import { getAllPosts, toPost } from '../../lib/insights';
import { shade } from '../../lib/cover-palette.mjs';

export async function getStaticPaths() {
  const entries = await getCollection('insights');
  return entries.map((entry) => ({ params: { slug: entry.id } }));
}

const { slug } = Astro.params;
const entry = await getEntry('insights', slug);
const post = toPost(entry);
const { Content } = await render(entry);

const all = await getAllPosts();
const sameCategory = all.filter((p) => p.category === post.category);
const index = sameCategory.findIndex((p) => p.slug === post.slug);
const prevPost = index > 0 ? sameCategory[index - 1] : null;
const nextPost = sameCategory[index + 1] ?? null;
// 一条核心观点一张卡：分类色系内明度递进，第 1 张最深。
const opinionCards = post.takeaways.map((text, i) => ({
  text,
  index: i + 1,
  total: post.takeaways.length,
  ...shade(post.category, i, post.takeaways.length),
}));

const draftLabel = post.draft ? '草稿 · 未发布' : '';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  datePublished: post.date.replace(/\./g, '-'),
  author: { '@type': 'Person', name: '个人商业创造者' },
  description: post.excerpt,
  image: post.cover,
};
---
<!DOCTYPE html>
<html lang="zh-CN" style="background:#0A0A0A;">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#0A0A0A">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<title>{post.title} — 个人商业创造者</title>
<meta name="description" content={post.excerpt}>
<link rel="canonical" href={post.url}>
<meta property="og:type" content="article">
<meta property="og:title" content={post.title}>
<meta property="og:description" content={post.excerpt}>
<meta property="og:image" content={post.cover}>
<meta property="og:url" content={post.url}>
<meta property="article:published_time" content={post.date.replace(/\./g, '-')}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={post.title}>
<meta name="twitter:description" content={post.excerpt}>
<meta name="twitter:image" content={post.cover}>
<link rel="stylesheet" href="/fonts/fonts.css">
<link rel="stylesheet" href="/css/tokens.css">
<script is:inline>document.documentElement.classList.add('js');</script>
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
<style is:global>
  :root{
    --bg:#0C0C0C;
    --bg-card:#141414;
    --surface-2:#1A1A1A;
    --accent:#D8F26B;
    --accent-rgb:216,242,107;
    --accent-dim:rgba(216,242,107,.12);
    --text:#F5F5F4;
    --text-secondary:#A8A8A3;
    --text-muted:#75756F;
    --border:rgba(255,255,255,.09);
    --radius:12px;
    --read-w:680px;
  }
  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{font-family:'Noto Sans SC','Inter',-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Microsoft YaHei',sans-serif;font-size:16px;background:var(--bg);color:var(--text);line-height:1.75;overflow-x:hidden;font-feature-settings:"palt" 1;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility;}
  ::selection{background:var(--accent);color:#0C0C0C;}
  a{text-decoration:none;color:inherit;}
  img{display:block;}
  :focus-visible{outline:2px solid var(--accent);outline-offset:3px;border-radius:2px;}
  ::-webkit-scrollbar{width:8px;}
  ::-webkit-scrollbar-track{background:var(--bg);}
  ::-webkit-scrollbar-thumb{background:#2A2A2A;border-radius:4px;}

  .reading-progress{position:fixed;top:0;left:0;height:2px;width:0;background:var(--accent);z-index:1100;transition:width .08s linear;}

  .nav{position:fixed;top:0;left:0;right:0;z-index:1000;padding:0 var(--gutter);background:rgba(12,12,12,.9);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border-bottom:1px solid var(--border);}
  .nav-inner{max-width:var(--container-w);margin:0 auto;width:100%;height:64px;display:flex;align-items:center;justify-content:space-between;gap:var(--space-24);}
  .nav-logo{display:inline-flex;align-items:center;gap:var(--space-8);font-weight:600;font-size:16px;letter-spacing:0;color:var(--text);}
  .nav-avatar{width:26px;height:26px;border-radius:50%;object-fit:cover;border:1px solid var(--border);flex-shrink:0;}
  .nav-back{display:inline-flex;align-items:center;gap:var(--space-8);font-size:14px;font-weight:400;color:var(--text-secondary);transition:color .2s ease;letter-spacing:0;}
  .nav-back:hover{color:var(--text);}
  .nav-back svg{width:16px;height:16px;stroke-width:1.5;}

  .article-head{padding:calc(64px + var(--space-40)) 0 var(--space-32);}
  .read-wrap{width:100%;max-width:calc(var(--read-w) + 48px);margin:0 auto;padding:0 24px;}

  .meta-line{display:flex;flex-wrap:wrap;align-items:center;gap:var(--space-8);font-family:'Inter',sans-serif;font-size:12px;color:var(--text-muted);margin-bottom:var(--space-16);font-variant-numeric:tabular-nums;}
  .meta-line .dot{color:rgba(255,255,255,.22);}
  .article-status{display:inline-flex;align-items:center;padding:2px 8px;border:1px dashed rgba(242,193,78,.45);border-radius:4px;background:rgba(242,193,78,.08);color:#F2C14E;font-size:12px;font-weight:500;letter-spacing:0;}

  .article-title{font-size:clamp(28px,4vw,40px);font-weight:600;line-height:1.3;letter-spacing:0;text-wrap:balance;}
  .article-tagline{margin-top:var(--space-12);font-size:16px;font-weight:400;line-height:1.7;color:var(--text-secondary);letter-spacing:0;}

  .article-cover{width:100%;aspect-ratio:16/10;max-height:300px;border-radius:var(--radius);overflow:hidden;background:var(--bg-card);border:1px solid var(--border);margin-bottom:var(--space-24);}
  .article-cover img{width:100%;height:100%;object-fit:cover;}

  .article-body{padding-bottom:var(--space-40);}
  .markdown > p{font-size:16px;color:var(--text-secondary);line-height:1.75;margin:0 0 1.1em;letter-spacing:0;}
  .markdown > p:first-child{font-size:20px;color:var(--text);line-height:1.65;margin-bottom:1.2em;}
  .markdown > h2{font-size:20px;font-weight:600;line-height:1.5;margin:40px 0 16px;letter-spacing:0;color:var(--text);}
  .markdown > h3{font-size:16px;font-weight:600;margin:32px 0 12px;color:var(--text);}
  .markdown > ul,.markdown > ol{margin:0 0 1.1em 1.3em;color:var(--text-secondary);font-size:16px;line-height:1.75;}
  .markdown li{margin-bottom:.4em;}
  .markdown > blockquote{margin:0 0 1.1em;padding:var(--space-8) 0 var(--space-8) var(--space-16);border-left:1px solid rgba(255,255,255,.28);color:var(--text);font-size:16px;}
  .markdown > blockquote p{margin:0;font-size:16px;}
  .markdown a{color:var(--accent);border-bottom:1px solid rgba(var(--accent-rgb),.4);}
  .markdown img{border-radius:var(--radius);margin:var(--space-16) 0;}
  .markdown code{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:.9em;background:rgba(255,255,255,.06);padding:1px 5px;border-radius:4px;}

  /* 核心观点单卡轮播：3 秒自动切换，可横向拖拽/滑动切换；无 JS 时各条纵向堆叠 */
  .opinion-card{position:relative;width:100%;margin:0 0 var(--space-24);background:var(--card-bg);border:1px solid rgba(255,255,255,.07);border-radius:var(--radius);overflow:hidden;touch-action:pan-y;cursor:grab;}
  .opinion-card:active{cursor:grabbing;}
  .js .opinion-card{height:288px;}
  .opinion-card:focus-visible{outline:2px solid rgba(255,255,255,.55);outline-offset:2px;}
  .opinion-slide{display:flex;flex-direction:column;gap:var(--space-16);padding:var(--space-32);background:var(--card-bg);}
  .opinion-slide + .opinion-slide{border-top:1px solid rgba(255,255,255,.08);}
  .js .opinion-slide{position:absolute;inset:0;opacity:0;border-top:0;pointer-events:none;}
  .js .opinion-slide.is-active{opacity:1;pointer-events:auto;animation:oc-fade .3s ease;}
  @keyframes oc-fade{from{opacity:0;}to{opacity:1;}}
  .oc-meta{display:flex;align-items:center;justify-content:space-between;font-size:12px;letter-spacing:0;color:rgba(255,255,255,.6);}
  .oc-category{display:flex;align-items:center;gap:var(--space-8);color:rgba(255,255,255,.72);}
  .oc-index{font-family:'Inter',sans-serif;letter-spacing:0;color:rgba(255,255,255,.55);font-variant-numeric:tabular-nums;}
  .oc-text{flex:1;display:flex;align-items:center;font-size:clamp(22px,2.2vw,32px);font-weight:600;line-height:1.4;letter-spacing:0;color:#fff;text-wrap:balance;}
  .oc-brand{display:flex;align-items:center;gap:var(--space-8);padding-right:88px;font-size:12px;letter-spacing:0;color:rgba(255,255,255,.6);}
  .oc-brand::before{content:'';width:5px;height:5px;border-radius:50%;background:rgba(255,255,255,.7);flex-shrink:0;}
  .opinion-dots{display:none;}
  .js .opinion-dots{position:absolute;right:var(--space-24);bottom:var(--space-16);display:flex;gap:2px;z-index:2;}
  .opinion-dot{width:24px;height:24px;padding:0;border:0;background:transparent;display:grid;place-items:center;cursor:pointer;}
  .opinion-dot::before{content:'';width:6px;height:6px;border-radius:50%;background:rgba(255,255,255,.32);transition:background-color .2s ease;}
  .opinion-dot[aria-current="true"]::before{background:var(--text);}
  .opinion-dot:focus-visible{outline:2px solid rgba(255,255,255,.8);outline-offset:-6px;border-radius:50%;}

  .article-tags{display:flex;flex-wrap:wrap;gap:var(--space-8);padding-top:var(--space-24);margin-top:var(--space-40);border-top:1px solid var(--border);}
  .article-tag{padding:4px 8px;border-radius:4px;background:transparent;border:1px solid var(--border);font-size:12px;font-weight:400;color:var(--text-secondary);letter-spacing:0;}

  .author-card{margin-top:var(--space-40);padding:var(--space-24);background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);display:flex;align-items:flex-start;gap:var(--space-16);}
  .author-avatar{width:40px;height:40px;border-radius:50%;background:var(--surface-2);border:1px solid var(--border);display:grid;place-items:center;color:var(--text);font-weight:600;font-size:16px;flex-shrink:0;}
  .author-copy strong{display:block;font-size:16px;font-weight:600;margin-bottom:var(--space-8);}
  .author-copy p{font-size:14px;color:var(--text-secondary);line-height:1.7;margin-bottom:var(--space-8);}
  .author-copy a{font-size:13px;color:var(--text-muted);border-bottom:1px solid var(--border);}
  .author-copy a:hover{color:var(--text);border-color:rgba(255,255,255,.3);}

  .article-nav{margin-top:var(--space-40);display:grid;grid-template-columns:1fr 1fr;gap:var(--space-16);}
  .article-nav-link{padding:var(--space-16) var(--space-24);background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);transition:border-color .2s ease,background-color .2s ease;display:flex;flex-direction:column;gap:var(--space-4);}
  .article-nav-link:hover{border-color:rgba(255,255,255,.2);background:var(--surface-2);}
  .article-nav-link.next{text-align:right;align-items:flex-end;}
  .article-nav-link .nav-label{font-size:12px;color:var(--text-muted);letter-spacing:0;}
  .article-nav-link .nav-title{font-size:14px;font-weight:500;color:var(--text);line-height:1.6;}

  .back-insights{display:flex;justify-content:center;margin-top:var(--space-40);}
  .back-insights a{display:inline-flex;align-items:center;gap:var(--space-8);font-size:14px;color:var(--text-secondary);letter-spacing:0;transition:color .2s ease;}
  .back-insights a:hover{color:var(--text);}
  .back-insights svg{width:16px;height:16px;stroke-width:1.5;}

  .footer{text-align:center;padding:var(--space-24) var(--gutter);border-top:1px solid var(--border);font-size:12px;color:var(--text-muted);margin-top:var(--space-40);}

  @media(max-width:640px){
    .article-head{padding:calc(56px + var(--space-32)) 0 var(--space-24);}
    .read-wrap{padding:0 24px;}
    .article-title{font-size:28px;line-height:1.3;}
    .article-tagline{font-size:14px;margin-top:var(--space-8);}
    .markdown > p,.markdown > ul,.markdown > ol{font-size:16px;line-height:1.8;}
    .markdown > p:first-child{font-size:18px;line-height:1.7;}
    .article-cover{margin-bottom:var(--space-24);}
    .js .opinion-card{height:250px;}
    .opinion-slide{padding:20px;gap:var(--space-12);}
    .oc-text{font-size:20px;line-height:1.45;}
    .oc-brand{padding-right:84px;}
    .js .opinion-dots{right:12px;bottom:8px;}
    .article-nav{grid-template-columns:1fr;}
    .article-nav-link.next{text-align:left;align-items:flex-start;}
    .author-card{padding:var(--space-16);}
    .nav-inner{height:56px;}
  }

  @media(prefers-reduced-motion:reduce){
    html{scroll-behavior:auto;}
    .js .opinion-slide.is-active{animation:none;}
    .opinion-dot::before{transition:none;}
  }
</style>
</head>
<body>

<div class="reading-progress" id="readingProgress"></div>

<nav class="nav">
  <div class="nav-inner">
    <a href="/" class="nav-logo"><img class="nav-avatar" src="/images/f409a539ce.jpg" alt="" decoding="async">个人商业创造者</a>
    <a href="/insights" class="nav-back">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
      返回洞察
    </a>
  </div>
</nav>

<header class="article-head">
  <div class="read-wrap">
    <div class="meta-line">
      <span>{post.date}</span><span class="dot">·</span>
      <span>{post.category}</span><span class="dot">·</span>
      <span>{post.readTime}</span>
      {draftLabel && <span class="article-status">{draftLabel}</span>}
    </div>
    <h1 class="article-title">{post.title}</h1>
    {post.tagline && <p class="article-tagline">{post.tagline}</p>}
  </div>
</header>

{opinionCards.length > 0 && (
  <div class="read-wrap">
    <section class="opinion-card" data-opinion tabindex="0" role="group" aria-roledescription="轮播" aria-label={`核心观点，共 ${post.takeaways.length} 条`} style={`--card-bg:${opinionCards[0].bg};--card-accent:${opinionCards[0].accent}`}>
      {opinionCards.map((card, i) => (
        <article class={`opinion-slide${i === 0 ? ' is-active' : ''}`} data-slide style={`--card-bg:${card.bg};--card-accent:${card.accent}`} aria-label={`第 ${card.index} 条，共 ${card.total} 条`}>
          <div class="oc-meta">
            <span class="oc-category">{post.category}</span>
            <span class="oc-index">{card.index} / {card.total}</span>
          </div>
          <p class="oc-text">{card.text}</p>
          <div class="oc-brand">个人商业创造者</div>
        </article>
      ))}
      <div class="opinion-dots">
        {opinionCards.map((card, i) => (
          <button type="button" class="opinion-dot" data-dot data-index={i} aria-label={`查看第 ${card.index} 条观点`} aria-current={i === 0 ? 'true' : 'false'}></button>
        ))}
      </div>
    </section>
  </div>
)}

<main class="article-body">
  <div class="read-wrap">
    {opinionCards.length === 0 && (
      <div class="article-cover">
        <img src={post.cover} alt={post.title} width="1600" height="1000" loading="eager" decoding="async">
      </div>
    )}

    <div class="markdown">
      <Content />
    </div>

    {post.tags.length > 0 && (
      <div class="article-tags">
        {post.tags.map((tag) => <span class="article-tag">{tag}</span>)}
      </div>
    )}

    <section class="author-card">
      <div class="author-avatar" aria-hidden="true">商</div>
      <div class="author-copy">
        <strong>个人商业创造者</strong>
        <p>18 年 IT 与产业数字化经验，正在用 AI 把专业能力转化为自己的产品与商业资产。</p>
        <a href="mailto:cronaldo.yang@outlook.com">cronaldo.yang@outlook.com</a>
      </div>
    </section>

    {(prevPost || nextPost) && (
      <nav class="article-nav" aria-label="同栏目文章">
        {prevPost && (
          <a class="article-nav-link" href={prevPost.url}>
            <span class="nav-label">上一篇</span>
            <span class="nav-title">{prevPost.title}</span>
          </a>
        )}
        {nextPost && (
          <a class="article-nav-link next" href={nextPost.url}>
            <span class="nav-label">下一篇</span>
            <span class="nav-title">{nextPost.title}</span>
          </a>
        )}
      </nav>
    )}

    <div class="back-insights">
      <a href="/insights">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
        返回洞察
      </a>
    </div>
  </div>
</main>

<footer class="footer">
  <p>© 2026 个人商业创造者. 保留所有权利.</p>
</footer>

<script is:inline>
  const bar = document.getElementById('readingProgress');
  const update = () => {
    const max = document.documentElement.scrollHeight - window.innerHeight;
    bar.style.width = (max > 0 ? Math.min(1, window.scrollY / max) * 100 : 0) + '%';
  };
  window.addEventListener('scroll', update, { passive: true });
  window.addEventListener('resize', update);
  update();
</script>

<script is:inline>
  (function () {
    const card = document.querySelector('[data-opinion]');
    if (!card) return;
    const slides = Array.from(card.querySelectorAll('[data-slide]'));
    const dots = Array.from(card.querySelectorAll('[data-dot]'));
    const reduceQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    const DURATION = 3000;
    let index = 0;
    let timer = null;
    let hovering = false;
    let focusing = false;
    let dragging = false;
    let startX = 0;
    let startY = 0;
    let deltaX = 0;

    function paint() {
      slides.forEach(function (slide, i) {
        slide.classList.toggle('is-active', i === index);
        slide.setAttribute('aria-hidden', i === index ? 'false' : 'true');
      });
      dots.forEach(function (dot, i) {
        dot.setAttribute('aria-current', i === index ? 'true' : 'false');
      });
      card.style.setProperty('--card-bg', slides[index].style.getPropertyValue('--card-bg'));
    }
    function stop() {
      if (timer) { clearInterval(timer); timer = null; }
    }
    function start() {
      stop();
      if (reduceQuery.matches || hovering || focusing || dragging) return;
      timer = setInterval(function () {
        index = (index + 1) % slides.length;
        paint();
      }, DURATION);
    }
    function go(next) {
      index = (next + slides.length) % slides.length;
      paint();
      start();
    }

    card.addEventListener('mouseenter', function () { hovering = true; stop(); });
    card.addEventListener('mouseleave', function () { hovering = false; start(); });
    card.addEventListener('focusin', function (event) {
      if (!event.target.matches(':focus-visible')) return;
      focusing = true;
      stop();
    });
    card.addEventListener('focusout', function (event) {
      if (card.contains(event.relatedTarget)) return;
      focusing = false;
      start();
    });
    card.addEventListener('keydown', function (event) {
      if (event.key === 'ArrowRight') { event.preventDefault(); go(index + 1); }
      else if (event.key === 'ArrowLeft') { event.preventDefault(); go(index - 1); }
    });
    dots.forEach(function (dot) {
      dot.addEventListener('click', function () { go(Number(dot.dataset.index)); });
    });

    // 拖拽 / 滑动切换
    card.addEventListener('pointerdown', function (event) {
      if (event.pointerType === 'mouse' && event.button !== 0) return;
      dragging = true;
      startX = event.clientX;
      startY = event.clientY;
      deltaX = 0;
      stop();
      if (card.setPointerCapture) card.setPointerCapture(event.pointerId);
    });
    card.addEventListener('pointermove', function (event) {
      if (!dragging) return;
      deltaX = event.clientX - startX;
      const deltaY = event.clientY - startY;
      if (Math.abs(deltaX) > Math.abs(deltaY) + 8) {
        card.style.cursor = 'grabbing';
        card.style.userSelect = 'none';
      }
    });
    function endDrag(commit) {
      if (!dragging) return;
      dragging = false;
      card.style.cursor = '';
      card.style.userSelect = '';
      if (commit && Math.abs(deltaX) > 40) {
        go(index + (deltaX < 0 ? 1 : -1));
      } else {
        deltaX = 0;
        start();
      }
    }
    card.addEventListener('pointerup', function () { endDrag(true); });
    card.addEventListener('pointercancel', function () { endDrag(false); });
    card.addEventListener('pointerleave', function () { endDrag(false); });

    reduceQuery.addEventListener('change', function () { start(); });

    paint();
    start();
  })();
</script>
</body>
</html>
