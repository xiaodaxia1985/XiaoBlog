---
import { projectEntries } from '../data/projects.mjs';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../lib/site';

const description = '个人商业创造者的简历：18 年 IT 与产业数字化经验，现正用 AI 把专业能力转化为产品与商业资产，并公开记录 90 天实践。';
---
<BaseLayout title="关于我 — 个人商业创造者" description={description} canonicalPath="/about/" active="about">
  <main>
    <div class="container">
      <header class="intro">
        <p class="eyebrow">ABOUT</p>
        <h1>个人商业创造者</h1>
        <p class="positioning">18 年 IT 与产业数字化经验。做过底层系统研发，也负责过集团数字化与产业平台建设。现在，我在用 AI 把专业能力转化为自己的产品与商业资产。</p>
        <div class="contact-line">
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
          <span aria-hidden="true">·</span>
          <span>公众号：个人商业创造者</span>
        </div>
      </header>

      <section class="resume-section" aria-labelledby="experienceTitle">
        <div class="section-head">
          <h2 id="experienceTitle">职业经历</h2>
          <span class="count">从技术研发到产业数字化</span>
        </div>
        <div class="timeline">
          <article class="tl">
            <span class="tl-year">2019.06 — 至今</span>
            <div class="tl-body">
              <h3>运营总监（数字化平台负责人）· 冷链物流与农产品供应链</h3>
              <p class="tl-duty">负责冷链平台的规划、建设与运营，统筹仓储、运输与订单系统的集成和数据打通；推动温控可视化、调度与异常预警在业务中落地，并牵头跨企业的数据协同项目。</p>
            </div>
          </article>
          <article class="tl">
            <span class="tl-year">2016.09 — 2019.06</span>
            <div class="tl-body">
              <h3>技术总监（集团数字化负责人）· 农牧食品与集团信息化</h3>
              <p class="tl-duty">负责集团数字化规划与年度 IT 预算，统筹 ERP、仓储、质量与 BI 系统的建设；推动 AI、物联网与大数据在养殖、生产、供应链场景的应用，管理内部团队与外部供应商。</p>
            </div>
          </article>
          <article class="tl">
            <span class="tl-year">2011.09 — 2016.08</span>
            <div class="tl-body">
              <h3>项目负责人 / 移动端技术负责人 · 移动互联网与工具类产品</h3>
              <p class="tl-duty">负责移动端产品的研发、测试与发布全流程，主导系统架构、流量监控与安全防护；管理跨职能研发团队，支撑产品的持续迭代与海外分发。</p>
            </div>
          </article>
          <article class="tl">
            <span class="tl-year">2010 — 2011</span>
            <div class="tl-body">
              <h3>Java / Android 工程师 · 移动通信与手机系统软件</h3>
              <p class="tl-duty">负责 Android Framework 层模块的维护，定位内存泄漏、线程死锁与进程间通信异常；在英文环境中与海外团队协作完成版本交付。</p>
            </div>
          </article>
          <article class="tl">
            <span class="tl-year">2008.06 — 2010.06</span>
            <div class="tl-body">
              <h3>Java 工程师 · 消费电子与制造软件</h3>
              <p class="tl-duty">参与阅读器客户端与 ERP 系统的开发，负责列表加载、缓存与数据库结构设计，处理大批量订单的查询性能问题。</p>
            </div>
          </article>
        </div>
      </section>

      <section class="resume-section" aria-labelledby="backgroundTitle">
        <div class="section-head"><h2 id="backgroundTitle">教育与专业背景</h2></div>
        <div class="education-line">
          <strong>南京工业大学</strong>
          <span>2004 — 2008 · 电子信息科学与技术（本科）</span>
        </div>
        <div class="profile-grid">
          <div class="profile-item">
            <h3>技术与架构</h3>
            <p>Android Framework、Linux、Binder、Java、高并发架构与系统性能优化。</p>
          </div>
          <div class="profile-item">
            <h3>企业与产业系统</h3>
            <p>ERP、WMS、QMS、BI、系统集成、数据治理与产业数字化平台。</p>
          </div>
          <div class="profile-item">
            <h3>AI 与产品</h3>
            <p>将 AI 和物联网技术用于真实业务流程，关注产品交付、使用效果与投入产出。</p>
          </div>
          <div class="profile-item">
            <h3>知识产权</h3>
            <p>国家专利 5 项，包括 2 项发明专利、3 项实用新型，涉及农产品质量评价、饲喂装置与数据录入系统。</p>
          </div>
        </div>
      </section>

      <section class="resume-section" aria-labelledby="capabilityTitle">
        <div class="section-head"><h2 id="capabilityTitle">我能解决什么问题</h2></div>
        <div class="profile-grid">
          <div class="profile-item">
            <h3>把复杂业务变成可运行的系统</h3>
            <p>从业务流程梳理、系统规划到集成落地，找到技术与经营之间可执行的路径。</p>
          </div>
          <div class="profile-item">
            <h3>从技术走到产品</h3>
            <p>覆盖需求分析、架构设计、研发交付与持续迭代，用真实使用结果检验投入。</p>
          </div>
          <div class="profile-item">
            <h3>让 AI 进入真实工作流</h3>
            <p>识别适合自动化的环节，把 AI 用在能节省时间、改善交付或创造价值的地方。</p>
          </div>
          <div class="profile-item">
            <h3>组织团队完成复杂交付</h3>
            <p>有跨职能团队管理经验，能够处理复杂系统中的协作、节奏、质量与风险。</p>
          </div>
        </div>
      </section>

      <section class="resume-section" id="results" aria-labelledby="resultsTitle">
        <div class="section-head"><h2 id="resultsTitle">代表成果</h2></div>
        <div class="results">
          {projectEntries.map((project) => {
            const role = project.meta.find((item) => item.label === '角色')?.value;
            return (
              <article class="result">
                <div class="result-head">
                  <h3>{project.title}</h3>
                  <span class="result-tag">{project.category}</span>
                </div>
                <p>{project.tagline}</p>
                {role && <p class="result-role">{role}</p>}
              </article>
            );
          })}
        </div>
      </section>

      <section class="resume-section" aria-labelledby="nowTitle">
        <div class="section-head">
          <h2 id="nowTitle">现在正在做的事</h2>
          <span class="count" data-practice-period>2026.11.08 — 2027.02.05</span>
        </div>
        <div class="now-block">
          <div class="now-copy">
            <p><strong>2026 年 11 月起，我用 90 天做一次完整的个人商业实践。</strong>从寻找真实需求、做出自己的产品，到建立内容与收入闭环，过程全部公开记录。</p>
            <p>我希望把过去在技术、产品和产业数字化中积累的经验，放到一个更直接的场景里验证：一个人能否借助 AI，持续创造真正有人愿意付费的产品。</p>
            <div class="now-actions">
              <a href="/insights/?category=90天实战" class="btn btn-primary">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><polyline points="19 12 12 19 5 12"/></svg>
                进入 90 天实战
              </a>
              <a href="/insights" class="btn btn-secondary">阅读洞察</a>
            </div>
          </div>
        </div>
      </section>
    </div>
  </main>

  <style>
    body{font-feature-settings:"palt" 1;}
    :focus-visible{outline:2px solid var(--accent);outline-offset:3px;border-radius:2px;}
    .container{max-width:1040px;margin:0 auto;padding:0 28px;}
    main{padding:calc(64px + 64px) 0 72px;}
    .intro{max-width:760px;padding-bottom:48px;}
    .eyebrow{display:flex;align-items:center;gap:10px;font-size:11px;letter-spacing:.14em;color:var(--accent);margin-bottom:18px;}
    .eyebrow::before{content:'';width:20px;height:1px;background:var(--accent);}
    h1{font-size:clamp(36px,5vw,52px);font-weight:700;line-height:1.2;letter-spacing:-.025em;margin-bottom:18px;text-wrap:balance;}
    .positioning{font-size:clamp(17px,2vw,20px);line-height:1.75;color:var(--text-secondary);max-width:700px;}
    .contact-line{display:flex;flex-wrap:wrap;align-items:center;gap:10px;font-size:12px;color:var(--text-muted);margin-top:22px;}
    .contact-line a{color:var(--text-secondary);border-bottom:1px solid var(--border);transition:border-color .2s ease;}
    .contact-line a:hover,.contact-line a:focus-visible{color:var(--accent);border-color:var(--accent);}
    .resume-section{padding:36px 0 0;margin-top:34px;border-top:1px solid var(--border);}
    .section-head{display:flex;align-items:baseline;justify-content:space-between;gap:20px;margin-bottom:22px;}
    .section-head h2{font-size:21px;font-weight:650;letter-spacing:-.01em;color:var(--text);}
    .section-head .count{font-family:'Inter','Noto Sans SC',sans-serif;font-size:11px;color:var(--text-muted);}
    .timeline{position:relative;}
    .timeline::before{content:'';position:absolute;left:139px;top:9px;bottom:12px;width:1px;background:var(--border);}
    .tl{display:grid;grid-template-columns:116px minmax(0,1fr);column-gap:48px;padding:17px 0;}
    .tl-year{font-family:'Inter',sans-serif;font-variant-numeric:tabular-nums;font-size:12px;color:var(--text-muted);padding-top:4px;text-align:right;white-space:nowrap;}
    .tl-body{position:relative;padding-left:24px;}
    .tl-body::before{content:'';position:absolute;left:-3px;top:8px;width:7px;height:7px;border-radius:50%;background:#555;border:2px solid var(--bg);box-shadow:0 0 0 1px #555;}
    .tl:first-child .tl-body::before{background:var(--accent);box-shadow:0 0 0 1px var(--accent);}
    .tl-body h3{font-size:16px;font-weight:600;line-height:1.6;color:var(--text);margin-bottom:6px;}
    .tl-duty{max-width:680px;font-size:14px;line-height:1.85;color:var(--text-secondary);}
    .profile-grid{display:grid;grid-template-columns:1fr 1fr;gap:28px 56px;}
    .profile-item{padding-top:16px;border-top:1px solid var(--border);}
    .profile-item h3{font-size:15px;font-weight:600;line-height:1.55;color:var(--text);margin-bottom:7px;}
    .profile-item p{font-size:13.5px;line-height:1.8;color:var(--text-secondary);}
    .education-line{display:flex;align-items:baseline;gap:16px;flex-wrap:wrap;margin-bottom:22px;}
    .education-line strong{font-size:15px;font-weight:600;color:var(--text);}
    .education-line span{font-size:13px;color:var(--text-secondary);}
    .results{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:32px;border-top:1px solid var(--border);}
    .result{padding:20px 0;border-bottom:1px solid var(--border);}
    .result-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:8px;}
    .result h3{font-size:16px;font-weight:600;line-height:1.55;color:var(--text);}
    .result-tag{font-size:11px;color:var(--accent);white-space:nowrap;}
    .result p{font-size:13px;line-height:1.8;color:var(--text-secondary);}
    .result-role{margin-top:8px;font-size:11px;color:var(--text-muted);}
    .now-block{display:flex;align-items:flex-start;justify-content:space-between;gap:32px;}
    .now-copy{max-width:700px;}
    .now-copy p{font-size:14.5px;line-height:1.9;color:var(--text-secondary);margin-bottom:12px;}
    .now-copy strong{color:var(--text);font-weight:600;}
    .now-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:20px;}
    .btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:10px 18px;border-radius:var(--radius-sm);font-size:13px;font-weight:500;cursor:pointer;border:1px solid transparent;transition:background-color .2s ease,border-color .2s ease,color .2s ease;}
    .btn-primary{background:var(--accent);color:var(--accent-ink);border-color:var(--accent);}
    .btn-primary:hover,.btn-primary:focus-visible{background:#E4F98C;border-color:#E4F98C;}
    .btn-secondary{background:transparent;color:var(--text);border-color:var(--border);}
    .btn-secondary:hover,.btn-secondary:focus-visible{background:var(--surface);border-color:rgba(216,242,107,.5);color:var(--accent);}
    .btn svg{width:15px;height:15px;stroke-width:1.5;}
    .now-period{font-family:'Inter',sans-serif;font-size:11px;color:var(--text-muted);white-space:nowrap;padding-top:5px;}
    @media(max-width:768px){
      .container{padding:0 20px;}
      main{padding:calc(56px + 38px) 0 52px;}
      .intro{padding-bottom:34px;}
      h1{font-size:36px;line-height:1.25;}
      .positioning{font-size:16px;line-height:1.8;}
      .resume-section{padding-top:28px;margin-top:28px;}
      .section-head h2{font-size:19px;}
      .timeline::before{left:3px;top:8px;bottom:10px;}
      .tl{grid-template-columns:1fr;gap:5px;padding:16px 0 16px 22px;}
      .tl-year{text-align:left;padding:0;font-size:11px;}
      .tl-body{padding-left:0;}
      .tl-body::before{left:-22px;top:8px;width:6px;height:6px;}
      .tl-body h3{font-size:15px;}
      .tl-duty{font-size:13px;}
      .profile-grid{grid-template-columns:1fr;gap:16px;}
      .results{grid-template-columns:1fr;}
      .now-block{flex-direction:column;gap:12px;}
      .now-actions{flex-direction:column;}
      .now-actions .btn{width:100%;}
    }
    @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.btn,.contact-line a{transition:none}}
  </style>

  <script slot="scripts" is:inline src="/js/practice-clock.js" defer></script>
</BaseLayout>
