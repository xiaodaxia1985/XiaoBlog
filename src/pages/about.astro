<!DOCTYPE html>
<html lang="zh-CN" style="background:#0A0A0A;">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#0A0A0A">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<title>关于我 — 个人商业创造者</title>
<meta name="description" content="个人商业创造者的简历：18 年 IT 与产业数字化经验，现正用 AI 把专业能力转化为产品与商业资产，并公开记录 90 天实践。">
<link rel="stylesheet" href="/fonts/fonts.css">
<link rel="stylesheet" href="/css/tokens.css">
<style>
  :root{--bg:#0A0A0A;--bg-card:#161616;--accent:#39FF14;--accent-rgb:57,255,20;--text:#FFFFFF;--text-secondary:#A1A1AA;--text-muted:#8E8E97;--border:rgba(255,255,255,.08);--radius:16px;}
  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{background:var(--bg);color:var(--text);font-family:'Noto Sans SC','Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;font-size:var(--fs-16);line-height:var(--lh-body);-webkit-font-smoothing:antialiased;overflow-x:hidden;}
  a{text-decoration:none;color:inherit;}
  .container{max-width:calc(var(--container-w) + var(--gutter) * 2);margin:0 auto;padding:0 var(--gutter);}
  .nav{position:fixed;top:0;left:0;right:0;z-index:100;padding:var(--space-16) var(--gutter);background:rgba(10,10,10,.85);backdrop-filter:blur(18px);border-bottom:1px solid var(--border);}
  .nav-inner{max-width:var(--container-w);margin:0 auto;width:100%;min-height:35px;display:flex;align-items:center;justify-content:space-between;gap:var(--space-24);}
  .nav-logo{font-size:20px;font-weight:800;letter-spacing:-.5px;}
  .nav-logo span{color:var(--accent);}
  .nav-links{display:flex;align-items:center;gap:var(--space-32);list-style:none;}
  .nav-links a{font-size:var(--fs-14);font-weight:500;color:var(--text-secondary);transition:color .2s ease;}
  .nav-links a:hover,.nav-links a.active{color:var(--accent);}

  main{padding:calc(72px + var(--space-32)) 0 0;}
  .eyebrow{display:flex;align-items:center;gap:var(--space-12);font-family:'Inter',sans-serif;font-size:var(--fs-12);font-weight:600;letter-spacing:.16em;color:var(--accent);margin-bottom:var(--space-16);}
  .eyebrow::before{content:'';display:block;width:32px;height:2px;background:var(--accent);}
  h1{font-size:var(--fs-48);font-weight:800;letter-spacing:.02em;line-height:1.2;margin-bottom:var(--space-12);}
  .positioning{font-size:var(--fs-16);color:var(--text-secondary);max-width:640px;margin-bottom:var(--space-16);}
  .contact-line{display:flex;flex-wrap:wrap;align-items:center;gap:var(--space-12);font-size:var(--fs-14);color:var(--text-muted);}
  .contact-line a{color:var(--text-secondary);border-bottom:1px solid var(--border);}
  .contact-line a:hover{color:var(--accent);border-color:var(--accent);}

  .resume-section{padding:var(--section-y) 0;border-top:1px solid var(--border);}
  .resume-section:first-of-type{border-top:none;padding-top:var(--space-40);}
  .section-title{font-size:var(--fs-28);font-weight:800;letter-spacing:.06em;margin-bottom:var(--space-24);}
  .section-title span{color:var(--accent);}

  /* 经历时间线：左侧年份列对齐 */
  .timeline{display:flex;flex-direction:column;}
  .timeline-item{display:grid;grid-template-columns:160px minmax(0,1fr);gap:var(--space-24);padding:var(--space-16) 0;border-bottom:1px solid var(--border);}
  .timeline-item:last-child{border-bottom:none;}
  .timeline-year{font-family:'Inter',sans-serif;font-size:var(--fs-14);font-weight:700;color:var(--accent);letter-spacing:.04em;white-space:nowrap;}
  .timeline-body h3{font-size:var(--fs-20);font-weight:700;margin-bottom:var(--space-6);letter-spacing:.02em;}
  .timeline-body .duty{font-size:var(--fs-14);color:var(--text-secondary);line-height:var(--lh-body);}

  /* 教育背景与其他 */
  .edu-grid{display:grid;grid-template-columns:1fr 1fr;gap:var(--space-24);}
  .edu-item{padding:var(--space-24);background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);}
  .edu-item h3{font-size:var(--fs-16);font-weight:700;margin-bottom:var(--space-8);}
  .edu-item p{font-size:var(--fs-14);color:var(--text-secondary);line-height:var(--lh-tight);}
  .patent-block{margin-top:var(--space-24);padding-top:var(--space-16);border-top:1px solid var(--border);}
  .patent-block h3{font-size:var(--fs-16);font-weight:700;margin-bottom:var(--space-4);}
  .patent-block p{font-size:var(--fs-14);color:var(--text-secondary);line-height:var(--lh-body);}

  /* 能力域 */
  .skill-grid{display:grid;grid-template-columns:1fr 1fr;gap:var(--space-24);}
  .skill-item{padding:var(--space-24);background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);}
  .skill-item h3{font-size:var(--fs-20);font-weight:700;margin-bottom:var(--space-8);}
  .skill-item p{font-size:var(--fs-14);color:var(--text-secondary);line-height:var(--lh-tight);}

  /* 代表成果 */
  .result-list{display:flex;flex-direction:column;gap:var(--space-12);}
  .result-item{display:flex;align-items:baseline;gap:var(--space-12);font-size:var(--fs-16);color:var(--text-secondary);line-height:var(--lh-body);}
  .result-item::before{content:'→';color:var(--accent);font-weight:700;flex-shrink:0;}

  /* 现状与方向 */
  .now-block{display:flex;align-items:flex-start;justify-content:space-between;gap:var(--space-32);}
  .now-copy{max-width:640px;}
  .now-copy p{font-size:var(--fs-16);color:var(--text-secondary);line-height:var(--lh-body);margin-bottom:var(--space-16);}
  .now-copy strong{color:var(--text);font-weight:600;}
  .now-actions{display:flex;gap:var(--space-12);flex-wrap:wrap;margin-top:var(--space-24);}
  .btn{display:inline-flex;align-items:center;gap:var(--space-8);padding:var(--space-12) var(--space-24);border-radius:10px;font-size:var(--fs-14);font-weight:600;letter-spacing:.04em;transition:all .3s ease;border:1px solid transparent;}
  .btn-primary{background:var(--accent);color:#0A0A0A;}
  .btn-primary:hover{transform:translateY(-2px);box-shadow:0 8px 24px rgba(var(--accent-rgb),.25);}
  .btn-outline{border-color:rgba(var(--accent-rgb),.35);color:var(--accent);}
  .btn-outline:hover{background:rgba(var(--accent-rgb),.1);transform:translateY(-2px);}
  .btn svg{width:16px;height:16px;}
  .now-period{font-family:'Inter',sans-serif;font-size:var(--fs-12);color:var(--text-muted);letter-spacing:.06em;white-space:nowrap;padding-top:var(--space-4);}

  .footer{border-top:1px solid var(--border);padding:var(--space-24) 0;text-align:center;}
  .footer p{font-size:var(--fs-12);color:var(--text-muted);letter-spacing:.04em;}

  @media(max-width:768px){
    main{padding:calc(64px + var(--space-24)) 0 0;}
    h1{font-size:32px;}
    .section-title{font-size:24px;}
    .nav-links{gap:var(--space-12);}
    .nav-links a{font-size:var(--fs-12);}
    .timeline-item{grid-template-columns:1fr;gap:var(--space-4);}
    .edu-grid{grid-template-columns:1fr;}
    .skill-grid{grid-template-columns:1fr;}
    .now-block{flex-direction:column;gap:var(--space-16);}
    .now-actions .btn{flex:1;justify-content:center;}
  }
</style>
</head>
<body>

