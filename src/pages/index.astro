---
import { publishedInsights } from '../data/insights.mjs';
import { stages } from '../data/stages.mjs';
import { topics } from '../data/topics.mjs';

const latest = publishedInsights.slice(0, 3);
const directions = topics;
const countByTopic = (t) => publishedInsights.filter((p) => p.topic === t).length;
const latestByTopic = (t) => publishedInsights.find((p) => p.topic === t);
const postOf = (id) => publishedInsights.find((p) => p.id === id);
const cnNums = ['一', '二', '三', '四'];
---
<!DOCTYPE html>
<html lang="zh-CN" style="background:#0A0A0A;">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#0A0A0A">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="stylesheet" href="/fonts/fonts.css">
<link rel="stylesheet" href="/css/tokens.css">
<title>从信息消费者，到商业创造者｜个人商业创造者</title>
<meta name="description" content="AI时代的个人商业创造者。每个人都应该拥有自己的商业资产。公开记录从零建立个人商业系统的过程。">
<style>
  :root{
    --bg:#0A0A0A;
    --bg-card:#161616;
    --bg-card-hover:#1E1E1E;
    --bg-input:#0F0F0F;
    --accent:#39FF14;
    --accent-rgb:57,255,20;
    --accent-dim:rgba(57,255,20,.15);
    --accent-dark:#1a8a00;
    --text:#FFFFFF;
    --text-secondary:#A1A1AA;
    --text-muted:#8E8E97;
    --border:rgba(255,255,255,.08);
    --radius:16px;
    --radius-sm:10px;
    --max-width:1200px;
  }
  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Microsoft YaHei","Hiragino Sans GB",sans-serif;
    background:var(--bg);
    color:var(--text);
    line-height:1.75;
    overflow-x:hidden;
    font-feature-settings:"palt" 1;
    -webkit-font-smoothing:antialiased;
    text-rendering:optimizeLegibility;
  }
  ::selection{background:var(--accent);color:#000;}
  a{text-decoration:none;color:inherit;}
  ul{list-style:none;}
  ::-webkit-scrollbar{width:8px;}
  ::-webkit-scrollbar-track{background:var(--bg);}
  ::-webkit-scrollbar-thumb{background:#333;border-radius:4px;}
  ::-webkit-scrollbar-thumb:hover{background:#444;}

  /* ===== Navigation ===== */
  .nav{
    position:fixed;top:0;left:0;right:0;z-index:1000;
    padding:20px 40px;display:flex;align-items:center;justify-content:space-between;
    background:rgba(10,10,10,.6);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);
    border-bottom:1px solid var(--border);transition:padding .3s ease,background .3s ease;
  }
  .nav.scrolled{padding:14px 40px;background:rgba(10,10,10,.85);}
  .nav-logo{font-weight:800;font-size:20px;letter-spacing:-.5px;color:var(--text);display:inline-flex;align-items:center;gap:10px;}
  .nav-avatar{width:34px;height:34px;border-radius:50%;object-fit:cover;border:1.5px solid rgba(var(--accent-rgb),.55);box-shadow:0 0 10px rgba(var(--accent-rgb),.25);flex-shrink:0;}
  .nav-logo span{color:var(--accent);}
  .nav-links{display:flex;gap:36px;}
  .nav-links a{font-size:14px;font-weight:500;color:var(--text-secondary);position:relative;transition:color .3s ease;letter-spacing:.08em;}
  .nav-links a::after{content:'';position:absolute;bottom:-4px;left:0;width:0;height:2px;background:var(--accent);transition:width .3s ease;border-radius:2px;}
  .nav-links a:hover,.nav-links a.active{color:var(--accent);}
  .nav-links a.active::after,.nav-links a:hover::after{width:100%;}
  .nav-toggle{display:none;flex-direction:column;gap:5px;cursor:pointer;background:none;border:none;padding:4px;}
  .nav-toggle span{width:24px;height:2px;background:var(--text);border-radius:2px;transition:.3s;}

  /* ===== Hero ===== */
  .hero{
    min-height:100vh;display:flex;align-items:center;position:relative;
    padding:120px 40px 80px;overflow:hidden;
    background:linear-gradient(110deg,#080808 0%,#0a0a0a 35%,#161616 55%,#222 75%,#2e2e2e 100%);
  }
  .hero::before{
    content:'';position:absolute;top:0;right:0;width:55%;height:100%;
    background:radial-gradient(ellipse at 70% 40%,rgba(50,50,50,.6) 0%,rgba(20,20,20,.3) 50%,transparent 80%);
    pointer-events:none;z-index:1;
  }
  .hero-watermark{
    position:absolute;bottom:40px;left:50%;transform:translateX(-50%);
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Microsoft YaHei","Hiragino Sans GB",sans-serif;font-size:clamp(80px,18vw,260px);font-weight:900;
    color:#27272A;opacity:.07;white-space:nowrap;letter-spacing:-.06em;
    pointer-events:none;z-index:0;text-transform:uppercase;
  }
  .hero-container{max-width:var(--max-width);margin:0 auto;width:100%;display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:center;position:relative;z-index:2;}
  .hero-content{max-width:none;}
  .hero-badge{display:flex;align-items:center;gap:12px;margin-bottom:24px;}
  .hero-badge .line{width:40px;height:2px;background:var(--accent);border-radius:2px;box-shadow:0 0 8px var(--accent);}
  .hero-badge .label{color:var(--accent);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Microsoft YaHei","Hiragino Sans GB",sans-serif;font-weight:700;font-size:14px;letter-spacing:3px;text-shadow:0 0 12px rgba(var(--accent-rgb),.4);}
  .hero-title{font-size:clamp(30px,6vw,48px);font-weight:800;line-height:1.15;letter-spacing:.02em;margin-bottom:18px;color:var(--text);word-break:keep-all;overflow-wrap:break-word;}
  .hero-buttons{display:flex;gap:16px;margin-bottom:36px;flex-wrap:wrap;}
  .btn{display:inline-flex;align-items:center;gap:8px;padding:14px 28px;border-radius:var(--radius-sm);font-size:14px;font-weight:600;cursor:pointer;transition:all .3s ease;border:2px solid transparent;font-family:inherit;letter-spacing:.06em;}
  .btn-primary{background:var(--accent);color:#000;border-color:var(--accent);box-shadow:0 0 20px rgba(var(--accent-rgb),.25);}
  .btn-primary:hover{box-shadow:0 0 30px rgba(var(--accent-rgb),.5);transform:translateY(-2px);}
  .btn-outline{background:transparent;color:var(--accent);border-color:var(--accent);}
  .btn-outline:hover{background:var(--accent-dim);box-shadow:0 0 20px rgba(var(--accent-rgb),.2);transform:translateY(-2px);}
  .btn svg{width:18px;height:18px;}
  /* ===== Section base ===== */
  section{position:relative;padding:100px 40px;}
  .section-container{max-width:var(--max-width);margin:0 auto;position:relative;z-index:1;}
  .section-header{margin-bottom:56px;display:flex;align-items:center;gap:16px;}
  .section-header .line{width:40px;height:2px;background:var(--accent);border-radius:2px;box-shadow:0 0 8px var(--accent);}
  .section-title{font-size:clamp(28px,4vw,46px);font-weight:800;letter-spacing:.12em;}
  .section-title .green{color:var(--accent);}

  /* ===== Footer ===== */
  .footer{text-align:center;padding:40px;border-top:1px solid var(--border);font-size:13px;color:var(--text-muted);}

  /* ===== Responsive ===== */
  @media(max-width:768px){
    .nav{padding:16px 24px;}
    .nav.scrolled{padding:12px 24px;}
    .nav-links{position:fixed;top:0;right:-100%;width:70%;height:100vh;background:rgba(10,10,10,.98);flex-direction:column;justify-content:center;align-items:center;gap:32px;transition:right .4s ease,visibility .4s ease;visibility:hidden;border-left:1px solid var(--border);}
    .nav-links.open{right:0;visibility:visible;}
    .nav-links a{font-size:20px;}
    .nav-toggle{display:flex;z-index:1001;}
    .nav-toggle.open span:nth-child(1){transform:rotate(45deg) translate(5px,5px);}
    .nav-toggle.open span:nth-child(2){opacity:0;}
    .nav-toggle.open span:nth-child(3){transform:rotate(-45deg) translate(5px,-5px);}

    .btn{justify-content:center;width:100%;}

    .nav{background:rgba(10,10,10,.95);backdrop-filter:none;-webkit-backdrop-filter:none;}
    .nav.scrolled{background:rgba(10,10,10,.98);}
    .hero::before{display:none;}
    .hero-watermark{display:none;}
  }
  .fade-up{opacity:1;transform:none;transition:opacity .8s ease,transform .8s ease;}
  .fade-up.visible{opacity:1;transform:none;}

/* 三个方向：基础卡片皮肤（尺寸由 v7 覆盖） */
.focus-card{background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);transition:all .3s ease;}
.focus-card:hover{border-color:rgba(var(--accent-rgb),.25);transform:translateY(-4px);box-shadow:0 10px 32px rgba(0,0,0,.35);}
.focus-num{font-family:'Inter',sans-serif;font-weight:700;letter-spacing:.14em;color:var(--accent);}
.focus-card h3{font-weight:700;color:var(--text);}
#focus,#practice{border-top:1px solid rgba(255,255,255,.05);}
@media(max-width:900px){.hero-brand .hero-title{font-size:clamp(28px,7vw,40px);}}














/* ===== v7 Layout System：只改栅格、间距、字号层次 ===== */
body{
  font-family:'Noto Sans SC','Inter',-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Microsoft YaHei",sans-serif;
  font-size:var(--fs-16);
  line-height:var(--lh-body);
}
.nav{padding:var(--space-16) var(--gutter);}
.nav.scrolled{padding:var(--space-12) var(--gutter);}
.nav-inner{max-width:var(--container-w);margin:0 auto;width:100%;display:flex;align-items:center;justify-content:space-between;gap:var(--space-24);}
.nav-links{gap:var(--space-32);}
.nav-avatar{width:32px;height:32px;}

section{padding:var(--section-y) var(--gutter);}
.section-container{max-width:var(--container-w);}
.section-header{margin-bottom:var(--space-16);}
.section-title{font-size:var(--fs-28);letter-spacing:.08em;line-height:1.3;}
.insight-intro{font-size:var(--fs-14);line-height:var(--lh-body);margin-bottom:var(--space-24);max-width:680px;}


/* Hero：420–480px 高 */
.hero-brand{padding:calc(72px + var(--space-24)) var(--gutter) var(--space-32);min-height:auto;display:block;}
.hero-inner{max-width:var(--container-w);margin:0 auto;width:100%;position:relative;z-index:2;}
.hero-brand .hero-container{grid-template-columns:minmax(0,1fr) 300px;gap:var(--space-56);align-items:center;}
.hero-badge{margin-bottom:var(--space-16);}
.hero-badge .label{font-size:var(--fs-12);letter-spacing:.16em;}
.hero-title{font-size:var(--fs-48);line-height:1.16;letter-spacing:.02em;margin-bottom:var(--space-12);}
.hero-sub{font-size:var(--fs-14);font-weight:700;letter-spacing:.06em;color:var(--text);margin-bottom:var(--space-16);}
.hero-copy{margin-bottom:var(--space-24);max-width:560px;}
.hero-copy .lead{font-size:var(--fs-16);font-weight:600;color:var(--text);margin-bottom:var(--space-8);line-height:1.5;letter-spacing:.02em;}
.hero-copy p{font-size:var(--fs-14);line-height:var(--lh-body);color:var(--text-secondary);margin:0;letter-spacing:.01em;}
.hero-buttons{gap:var(--space-12);margin-top:0;margin-bottom:var(--space-16);}
.btn{padding:var(--space-12) var(--space-24);font-size:var(--fs-14);}
.hero-tags{display:flex;flex-wrap:wrap;gap:var(--space-8);}
.hero-tag{font-size:var(--fs-12);color:var(--text-secondary);background:rgba(255,255,255,.04);border:1px solid var(--border);border-radius:999px;padding:var(--space-4) var(--space-12);letter-spacing:.02em;}
.hero-stats{border-left:1px solid var(--border);padding-left:var(--space-32);display:flex;flex-direction:column;gap:var(--space-16);}
.hero-stat{padding-bottom:var(--space-16);border-bottom:1px solid var(--border);}
.hero-stat:last-child{padding-bottom:0;border-bottom:none;}
.hero-stat strong{display:block;font-size:var(--fs-28);font-weight:800;color:var(--accent);line-height:1.2;letter-spacing:.02em;}
.hero-stat em{font-style:normal;font-size:var(--fs-12);color:var(--text-secondary);margin-left:var(--space-4);font-weight:600;}
.hero-stat span{display:block;font-size:var(--fs-12);color:var(--text-secondary);letter-spacing:.04em;margin-top:var(--space-4);}

/* 三个方向：等宽三卡，整卡可点 */
.focus-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--space-24);}
.focus-card{padding:var(--space-24);display:flex;flex-direction:column;gap:var(--space-8);min-height:188px;color:inherit;text-decoration:none;}
.focus-card:hover{border-color:rgba(57,255,20,.35);transform:translateY(-2px);}
.focus-num{font-size:var(--fs-12);margin-bottom:var(--space-4);letter-spacing:.08em;}
.focus-card h3{font-size:var(--fs-20);margin-bottom:0;letter-spacing:.02em;}
.focus-card p{font-size:var(--fs-14);line-height:var(--lh-tight);color:var(--text-secondary);}
.focus-meta{font-size:var(--fs-12);color:var(--text-muted);line-height:1.6;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;}
.focus-point{margin-top:auto;padding-top:var(--space-12);border-top:1px solid var(--border);display:flex;align-items:center;gap:var(--space-8);font-size:var(--fs-12);color:var(--accent);letter-spacing:.02em;}

/* 90 天：区块头 + Day 进度 + 阶段 tab + 阶段面板 */
.practice-head{display:flex;align-items:flex-end;justify-content:space-between;gap:var(--space-32);margin-bottom:var(--space-32);}
.practice-head .section-header{margin-bottom:var(--space-8);}
.practice-intro{font-size:var(--fs-14);line-height:var(--lh-body);max-width:640px;margin:0;}
.practice-aside{display:flex;flex-direction:column;align-items:flex-end;gap:var(--space-8);flex-shrink:0;}
.practice-period{font-family:'Inter',sans-serif;font-size:var(--fs-14);color:var(--text-secondary);letter-spacing:.04em;}
.practice-more{display:inline-flex;align-items:center;gap:var(--space-8);font-size:var(--fs-14);font-weight:600;color:var(--text);border-bottom:1px solid var(--border);padding-bottom:2px;transition:gap .3s ease,color .3s ease,border-color .3s ease;}
.practice-more:hover{gap:12px;color:var(--accent);border-bottom-color:rgba(57,255,20,.35);}
.practice-progress{display:flex;align-items:flex-end;gap:var(--space-24);margin-bottom:var(--space-16);}
.practice-day{font-family:'Inter',sans-serif;font-size:64px;font-weight:800;line-height:1;color:var(--accent);letter-spacing:-.02em;white-space:nowrap;}
.practice-day span{font-size:var(--fs-16);font-weight:600;color:var(--text-muted);margin-left:var(--space-4);letter-spacing:.02em;}
.practice-phase{font-size:var(--fs-14);color:var(--text-secondary);padding-bottom:var(--space-8);}
.stage-bar{display:flex;gap:6px;margin-bottom:var(--space-24);}
.stage{min-width:0;background:rgba(255,255,255,.04);border:1px solid var(--border);border-radius:10px;padding:var(--space-12) var(--space-16);display:flex;flex-direction:column;align-items:flex-start;gap:var(--space-4);text-align:left;font:inherit;color:inherit;cursor:pointer;transition:background .25s ease,border-color .25s ease;}
.stage:hover:not(.active){background:rgba(255,255,255,.08);border-color:rgba(255,255,255,.16);}
.stage:focus-visible{outline:2px solid var(--accent);outline-offset:2px;}
.stage-1{flex:14 1 0;}
.stage-2{flex:16 1 0;}
.stage-3{flex:30 1 0;}
.stage-4{flex:30 1 0;}
.stage.active{background:var(--accent);border-color:var(--accent);}
.stage-name{font-size:var(--fs-12);font-weight:700;letter-spacing:.04em;color:var(--text-muted);}
.stage-dates{font-family:'Inter',sans-serif;font-size:var(--fs-12);color:var(--text-muted);letter-spacing:.02em;}
.stage.active .stage-name,.stage.active .stage-dates{color:#062b02;}

.stage-panel{min-height:236px;display:flex;flex-direction:column;gap:var(--space-16);padding:var(--space-24);background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);}
.stage-panel[hidden]{display:none;}
.stage-goal{display:flex;align-items:flex-start;gap:var(--space-16);}
.stage-goal-label{flex-shrink:0;font-size:var(--fs-12);color:var(--text-muted);letter-spacing:.08em;padding-top:2px;}
.stage-goal p{margin:0;font-size:var(--fs-14);color:var(--text-secondary);line-height:var(--lh-body);}
.stage-outputs{list-style:none;display:grid;grid-template-columns:repeat(4,1fr);gap:var(--space-12);}
.stage-outputs li{display:flex;gap:var(--space-8);min-height:76px;padding:var(--space-12);background:rgba(255,255,255,.03);border:1px solid var(--border);border-radius:10px;font-size:var(--fs-12);color:var(--text-secondary);line-height:1.6;}
.out-num{font-family:'Inter',sans-serif;font-weight:700;color:var(--text-muted);flex-shrink:0;}
.stage-posts{display:flex;align-items:center;flex-wrap:wrap;gap:var(--space-12);padding-top:var(--space-16);border-top:1px solid var(--border);}
.stage-posts-label{font-size:var(--fs-12);color:var(--text-muted);letter-spacing:.08em;}
.stage-post{display:inline-flex;align-items:center;gap:var(--space-8);font-size:var(--fs-12);color:var(--text-secondary);}
.stage-post-date{font-family:'Inter',sans-serif;color:var(--text-muted);}
.stage-post-title{border-bottom:1px solid var(--border);transition:color .25s ease,border-color .25s ease;}
.stage-post:hover .stage-post-title{color:var(--accent);border-bottom-color:rgba(57,255,20,.35);}
.stage-posts-empty{font-size:var(--fs-12);color:var(--text-muted);}

/* 最新洞察：复用列表卡片样式 */
.latest-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--space-24);}
.latest-card{display:flex;flex-direction:column;background:#f5f5f5;border:1px solid rgba(0,0,0,.06);border-radius:var(--radius);overflow:hidden;box-shadow:0 4px 20px rgba(0,0,0,.15);transition:transform .3s ease,box-shadow .3s ease;}
.latest-card:hover{transform:translateY(-6px);box-shadow:0 16px 50px rgba(0,0,0,.3);}
.latest-img{aspect-ratio:16/10;background:#1a1a1a;overflow:hidden;}
.latest-img img{width:100%;height:100%;object-fit:cover;}
.latest-info{padding:var(--space-16);display:flex;flex-direction:column;gap:var(--space-8);flex:1;}
.latest-tag{align-self:flex-start;font-size:var(--fs-12);font-weight:600;color:#0f7a00;background:rgba(57,255,20,.14);border:1px solid rgba(15,122,0,.18);border-radius:6px;padding:var(--space-4) var(--space-8);letter-spacing:.02em;}
.latest-info h3{font-size:var(--fs-20);font-weight:700;color:#111;line-height:1.4;letter-spacing:.02em;}
.latest-info p{font-size:var(--fs-14);line-height:var(--lh-tight);color:#555;flex:1;}
.latest-date{font-size:var(--fs-12);color:#666;letter-spacing:.02em;}
.latest-view{margin-top:auto;font-size:var(--fs-12);font-weight:600;color:#0f7a00;letter-spacing:.02em;}
.latest-more{display:flex;justify-content:flex-end;margin-top:var(--space-16);}
.latest-more a{display:inline-flex;align-items:center;gap:var(--space-8);font-size:var(--fs-14);color:var(--accent);font-weight:600;letter-spacing:.02em;}

/* 底部 CTA：一条横向区块 */
.closing-band{display:flex;align-items:center;justify-content:space-between;gap:var(--space-32);background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:var(--space-32);}
.closing-copy h2{font-size:var(--fs-28);font-weight:800;letter-spacing:.06em;line-height:1.3;margin-bottom:var(--space-8);}
.closing-copy p{font-size:var(--fs-14);color:var(--text-secondary);margin:0;line-height:var(--lh-body);}
.closing-actions{display:flex;gap:var(--space-12);flex-shrink:0;}
.closing-meta{display:flex;flex-wrap:wrap;align-items:center;gap:var(--space-8);margin-top:var(--space-16);font-size:var(--fs-12);color:var(--text-muted);}
.closing-meta a{color:var(--text-secondary);border-bottom:1px solid var(--border);}
.closing-meta .meta-label{color:var(--text-muted);letter-spacing:.08em;}
.closing-meta .meta-strong{color:var(--text);}

.footer{padding:var(--space-24) var(--gutter);font-size:var(--fs-12);color:var(--text-muted);}

@media(max-width:900px){
  .focus-grid{grid-template-columns:1fr;}
  .hero-brand .hero-container{grid-template-columns:1fr;gap:0;}
  .hero-stats{border-left:none;border-top:1px solid var(--border);padding-left:0;padding-top:var(--space-24);flex-direction:row;gap:var(--space-24);}
  .hero-stat{flex:1;padding-bottom:0;border-bottom:none;}
  .practice-head{flex-direction:column;align-items:flex-start;gap:var(--space-16);margin-bottom:var(--space-24);}
  .practice-aside{flex-direction:row;align-items:center;gap:var(--space-24);}
  .practice-day{font-size:56px;}
  .stage-outputs{grid-template-columns:repeat(2,1fr);}
  .latest-grid{grid-template-columns:1fr;}
  .closing-band{flex-direction:column;align-items:flex-start;gap:var(--space-24);}
}
@media(max-width:768px){
  .hero-brand{padding:calc(64px + var(--space-24)) var(--gutter) var(--space-32);}
  .hero-title{font-size:32px;}
  .hero-buttons{gap:var(--space-8);}
  .hero-buttons .btn{flex:1;justify-content:center;padding:var(--space-12) var(--space-16);}
  .section-title{font-size:24px;}
  .closing-copy h2{font-size:24px;}
  .practice-day{font-size:48px;}
  .practice-progress{gap:var(--space-16);}
  .stage{padding:var(--space-8) var(--space-12);}
  .stage-dates{font-size:11px;}
  .closing-actions{width:100%;}
  .closing-actions .btn{flex:1;justify-content:center;}
}
@media(max-width:480px){
  .hero-stats{display:none;}
  .hero-tag:nth-child(3){display:none;}
  .hero-brand{padding:calc(64px + var(--space-16)) var(--gutter) var(--space-24);}
  .hero-title{margin-bottom:var(--space-8);}
  .hero-sub{margin-bottom:var(--space-12);}
  .hero-copy{margin-bottom:var(--space-16);}
  .hero-tags{gap:var(--space-8);}
  .hero-tag{font-size:11px;padding:var(--space-4) var(--space-8);}
  .practice-progress{flex-direction:column;align-items:flex-start;gap:var(--space-4);}
  .practice-day{font-size:44px;}
  .practice-day span{font-size:var(--fs-12);}
  .practice-phase{padding-bottom:0;}
  .stage-bar{gap:4px;}
  .stage-1,.stage-2,.stage-3,.stage-4{flex:1 1 0;}
  .stage{padding:var(--space-8);}
  .stage-dates{font-size:11px;line-height:1.3;}
  .stage-panels{margin-top:0;}
  .stage-panel{padding:var(--space-16);gap:var(--space-12);min-height:260px;}
  .stage-goal{flex-direction:column;gap:var(--space-4);}
  .stage-outputs{grid-template-columns:1fr;gap:var(--space-8);}
  .stage-outputs li{min-height:0;}
}
</style>
</head>
<body>

<!-- ===== Navigation ===== -->
<nav class="nav" id="nav">
  <div class="nav-inner">
    <a href="#hero" class="nav-logo"><img class="nav-avatar" src="/images/f409a539ce.jpg" alt="个人商业创造者" decoding="async">个人商业<span>创造者</span></a>
    <button class="nav-toggle" id="navToggle" aria-label="菜单" aria-expanded="false" aria-controls="navLinks"><span></span><span></span><span></span></button>
    <ul class="nav-links" id="navLinks">
      <li><a href="#hero" class="active">首页</a></li>
      <li><a href="#focus">我在做什么</a></li>
      <li><a href="/insights">洞察</a></li>
      <li><a href="/about">关于我</a></li>
    </ul>
  </div>
</nav>
<section class="hero hero-brand" id="hero">
  <div class="hero-watermark">90 DAYS</div>
  <div class="hero-inner">
    <div class="hero-container">
      <div class="hero-content">
        <div class="hero-badge">
          <span class="line"></span>
          <span class="label">PERSONAL BUSINESS CREATOR · 90 DAYS</span>
        </div>
        <h1 class="hero-title">从信息消费者，到商业创造者</h1>
        <div class="hero-sub">AI 时代的个人商业创造者</div>
        <div class="hero-copy">
          <p class="lead">每个人都应该拥有自己的商业资产。</p>
          <p>我正在借助 AI，把个人经验与专业能力转化为自己的产品与持续收入，并公开记录整个过程。</p>
        </div>
        <div class="hero-buttons">
          <a href="#practice" class="btn btn-primary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><polyline points="19 12 12 19 5 12"/></svg>
            了解我的实践
          </a>
          <a href="/insights" class="btn btn-outline">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
            阅读洞察
          </a>
        </div>
        <div class="hero-tags">
          <span class="hero-tag">18 年 IT 与产业数字化经验</span>
          <span class="hero-tag">产业数字化与 AI 应用</span>
          <span class="hero-tag">AI 与个人商业实践</span>
        </div>
      </div>
      <aside class="hero-stats fade-up" aria-label="关键数字">
        <div class="hero-stat">
          <strong>90<em>天</em></strong>
          <span>个人商业实践周期</span>
        </div>
        {publishedInsights.length > 0 && (
          <div class="hero-stat">
            <strong>{publishedInsights.length}<em>篇</em></strong>
            <span>已发布洞察</span>
          </div>
        )}
        <div class="hero-stat">
          <strong>3<em>个</em></strong>
          <span>持续投入的方向</span>
        </div>
      </aside>
    </div>
  </div>
</section>
<section id="focus" style="background:#0c0c0c;">
  <div class="section-container">
    <div class="section-header fade-up">
      <span class="line"></span>
      <h2 class="section-title">我在<span class="green">做什么</span></h2>
    </div>
    <p class="insight-intro fade-up">我关注三个相互关联的方向。</p>
    <div class="focus-grid">
      {directions.map((d) => {
        const count = countByTopic(d.title);
        const post = latestByTopic(d.title);
        return (
          <a class="focus-card fade-up" href={`/topics/${d.slug}`}>
            <div class="focus-num">{d.num}</div>
            <h3>{d.title}</h3>
            <p>{d.definition}</p>
            {count > 0 && (
              <div class="focus-meta">已发布 {count} 篇{post ? <> · 最新：{post.title}</> : null}</div>
            )}
            <div class="focus-point"><span>→</span>{d.point}</div>
          </a>
        );
      })}
    </div>
  </div>
</section>
<section id="practice" style="background:#0a0a0a;">
  <div class="section-container">
    <div class="practice-head fade-up">
      <div>
        <div class="section-header">
          <span class="line"></span>
          <h2 class="section-title">我的90天<span class="green">创造者实践</span></h2>
        </div>
        <p class="practice-intro">从寻找真实需求开始，用 90 天做出一个产品，并公开记录每一步。</p>
      </div>
      <aside class="practice-aside">
        <span class="practice-period">2026.11.08 — 2027.02.05</span>
        <a class="practice-more" href="/90-days">进入 90天实战<span aria-hidden="true">→</span></a>
      </aside>
    </div>

    <div class="practice-progress fade-up">
      <div class="practice-day">Day 01<span>/ 90</span></div>
      <div class="practice-phase" id="practicePhase">第一阶段 · 品牌与实践启动</div>
    </div>

    <div class="stage-bar fade-up" role="tablist" aria-label="90 天阶段">
      {stages.map((s) => (
        <button
          type="button"
          class={`stage stage-${s.id}${s.id === 1 ? ' active' : ''}`}
          id={`stage-tab-${s.id}`}
          role="tab"
          aria-selected={s.id === 1 ? 'true' : 'false'}
          aria-controls={`stage-panel-${s.id}`}
          data-stage={s.id}
          data-name={s.name}
          data-status={s.status}
          data-cn={cnNums[s.id - 1]}
        >
          <span class="stage-name">第{cnNums[s.id - 1]}阶段</span>
          <span class="stage-dates">{s.range.start}–{s.range.end}</span>
        </button>
      ))}
    </div>

    <div class="stage-panels fade-up">
      {stages.map((s) => {
        const posts = s.postIds.map(postOf).filter(Boolean).slice(0, 2);
        return (
          <div
            class="stage-panel"
            id={`stage-panel-${s.id}`}
            role="tabpanel"
            aria-labelledby={`stage-tab-${s.id}`}
            data-stage={s.id}
            hidden={s.id !== 1}
          >
            <div class="stage-goal">
              <span class="stage-goal-label">阶段目标</span>
              <p>{s.goal}</p>
            </div>
            <ol class="stage-outputs">
              {s.outputs.map((output, i) => (
                <li>
                  <span class="out-num">{String(i + 1).padStart(2, '0')}</span>
                  <span>{output}</span>
                </li>
              ))}
            </ol>
            <div class="stage-posts">
              <span class="stage-posts-label">相关记录</span>
              {posts.length ? posts.map((p) => (
                <a class="stage-post" href={`/insight/?id=${p.id}`}>
                  <span class="stage-post-date">{p.date}</span>
                  <span class="stage-post-title">{p.title}</span>
                </a>
              )) : (
                <span class="stage-posts-empty">计划中，随实践更新</span>
              )}
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>

{latest.length > 0 && (
<section id="latest" style="background:#0d0d0d;">
  <div class="section-container">
    <div class="section-header fade-up">
      <span class="line"></span>
      <h2 class="section-title">最新<span class="green">洞察</span></h2>
    </div>
    <div class="latest-grid">
      {latest.map((post) => (
        <a class="latest-card fade-up" href={`/insight/?id=${post.id}`}>
          <div class="latest-img">
            <img src={post.image} alt={post.title} width="1600" height="900" loading="lazy" decoding="async" />
          </div>
          <div class="latest-info">
            <span class="latest-tag">{post.category}</span>
            <h3>{post.title}</h3>
            <p>{post.excerpt}</p>
            <span class="latest-date">{post.date} · {post.readTime}</span>
            <span class="latest-view">阅读全文<span aria-hidden="true">→</span></span>
          </div>
        </a>
      ))}
    </div>
    <div class="latest-more fade-up"><a href="/insights">查看全部 {latest.length} 篇洞察<span aria-hidden="true">→</span></a></div>
  </div>
</section>
)}

<section id="closing" style="background:#0a0a0a;">
  <div class="section-container">
    <div class="closing-band fade-up">
      <div class="closing-copy">
        <h2>一起成为<span class="green">商业创造者</span></h2>
        <p>如果你也有多年经验与专业能力，欢迎关注我的实践。</p>
      </div>
      <div class="closing-actions">
        <a href="mailto:cronaldo.yang@outlook.com" class="btn btn-primary">邮件联系</a>
        <a href="/insights" class="btn btn-outline">阅读洞察</a>
      </div>
    </div>
    <div class="closing-meta fade-up">
      <span class="meta-label">联系方式</span>
      <a href="mailto:cronaldo.yang@outlook.com">cronaldo.yang@outlook.com</a>
      <span class="meta-divider" aria-hidden="true">·</span>
      <span>公众号：<span class="meta-strong">个人商业创造者</span></span>
    </div>
  </div>
</section>

<footer class="footer"><p>© 2026 个人商业创造者. 保留所有权利.</p></footer>

<script>
  const nav=document.getElementById('nav');
  const navLinks=document.querySelectorAll('.nav-links a');
  const navLinksContainer=document.getElementById('navLinks');
  const navToggle=document.getElementById('navToggle');
  window.addEventListener('scroll',()=>{
    if(nav) nav.classList.toggle('scrolled',window.scrollY>50);
    const sections=document.querySelectorAll('section[id]');
    let current='';
    sections.forEach(section=>{if(window.scrollY>=section.offsetTop-120){current=section.getAttribute('id');}});
    if(current!=='focus') current='hero';
    navLinks.forEach(link=>{link.classList.remove('active');if(link.getAttribute('href')==='#'+current)link.classList.add('active');});
  });
  if(navToggle&&navLinksContainer){
    navToggle.addEventListener('click',()=>{const open=navLinksContainer.classList.toggle('open');navToggle.classList.toggle('open');navToggle.setAttribute('aria-expanded',open?'true':'false');});
    navLinks.forEach(link=>{link.addEventListener('click',()=>{navLinksContainer.classList.remove('open');navToggle.classList.remove('open');navToggle.setAttribute('aria-expanded','false');});});
  }
  const observer=new IntersectionObserver((entries)=>{entries.forEach(entry=>{if(entry.isIntersecting){entry.target.classList.add('visible');observer.unobserve(entry.target);}});},{threshold:0.15});
  document.querySelectorAll('.fade-up').forEach(el=>observer.observe(el));

  // 90 天阶段 tab：点击/方向键切换，hash 深链接
  const stageTabs=[...document.querySelectorAll('.stage-bar [role="tab"]')];
  const stagePanels=[...document.querySelectorAll('.stage-panel')];
  const phaseEl=document.getElementById('practicePhase');
  function setStage(id,updateHash){
    if(!id||!document.getElementById('stage-panel-'+id)) id=stageTabs[0]?.dataset.stage;
    stageTabs.forEach(tab=>{
      const on=tab.dataset.stage===String(id);
      tab.classList.toggle('active',on);
      tab.setAttribute('aria-selected',on?'true':'false');
    });
    stagePanels.forEach(panel=>{panel.hidden=panel.dataset.stage!==String(id);});
    const activeTab=stageTabs.find(tab=>tab.dataset.stage===String(id));
    if(phaseEl&&activeTab){
      const status=activeTab.dataset.status;
      phaseEl.textContent='第'+activeTab.dataset.cn+'阶段 · '+activeTab.dataset.name+(status&&status!=='当前'?' · '+status:'');
    }
    if(updateHash){
      const url=new URL(location.href);
      url.hash='stage-'+id;
      history.replaceState(null,'',url);
    }
  }
  const hashStage=location.hash.match(/^#stage-([1-4])$/);
  setStage(hashStage?hashStage[1]:'1',false);
  stageTabs.forEach(tab=>{
    tab.addEventListener('click',()=>setStage(tab.dataset.stage,true));
    tab.addEventListener('keydown',event=>{
      if(event.key!=='ArrowLeft'&&event.key!=='ArrowRight') return;
      event.preventDefault();
      const index=stageTabs.indexOf(tab);
      const next=stageTabs[(index+(event.key==='ArrowRight'?1:stageTabs.length-1))%stageTabs.length];
      next.focus();
      setStage(next.dataset.stage,true);
    });
  });
</script>
</body>
</html>
