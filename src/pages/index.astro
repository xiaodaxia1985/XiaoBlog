---
import { getPublishedPosts } from '../lib/insights';
import { getPracticeSnapshot } from '../data/stages.mjs';
import { topics } from '../data/topics.mjs';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const posts = await getPublishedPosts();
const latest = posts.slice(0, 3);
const directions = topics;
const countByTopic = (t) => posts.filter((p) => p.topic === t).length;
const latestByTopic = (t) => posts.find((p) => p.topic === t);
const postOf = (slug) => posts.find((p) => p.slug === slug);
const practice = getPracticeSnapshot();
const stages = practice.stages;
const currentStage = stages.find((s) => s.id === practice.currentStageId) ?? stages[0];
const boardOutputs = currentStage.outputs.slice(0, 3);
---
<!DOCTYPE html>
<html lang="zh-CN" style="background:#0c0c0c;">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#0c0c0c">
<meta name="color-scheme" content="dark">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="stylesheet" href="/fonts/fonts.css">
<link rel="stylesheet" href="/css/tokens.css">
<script is:inline>document.documentElement.classList.add('js');</script>
<script is:inline src="/js/site-shell.js" defer></script>
<title>从信息消费者，到商业创造者｜个人商业创造者</title>
<meta name="description" content="AI时代的个人商业创造者。每个人都应该拥有自己的商业资产。公开记录从零建立个人商业系统的过程。">
<link rel="canonical" href={new URL('/', Astro.site ?? 'https://xiaomaker.top').toString()}>
<meta property="og:type" content="website">
<meta property="og:locale" content="zh_CN">
<meta property="og:title" content="从信息消费者，到商业创造者｜个人商业创造者">
<meta property="og:description" content="AI时代的个人商业创造者。每个人都应该拥有自己的商业资产。公开记录从零建立个人商业系统的过程。">
<meta property="og:url" content={new URL('/', Astro.site ?? 'https://xiaomaker.top').toString()}>
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="从信息消费者，到商业创造者｜个人商业创造者">
<meta name="twitter:description" content="AI时代的个人商业创造者。每个人都应该拥有自己的商业资产。公开记录从零建立个人商业系统的过程。">
<style>
  :root{
    --bg:#0C0C0C;
    --surface:#141414;
    --surface-2:#1A1A1A;
    --accent:#D8F26B;
    --accent-ink:#0C0C0C;
    --text:#F5F5F4;
    --text-secondary:#A8A8A3;
    --text-muted:#75756F;
    --border:rgba(255,255,255,.09);
    --radius:12px;
    --radius-sm:8px;
    --max-width:1200px;
  }
  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    font-family:'Noto Sans SC','Inter',-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Microsoft YaHei",sans-serif;
    font-size:var(--fs-16);
    line-height:var(--lh-body);
    background:var(--bg);
    color:var(--text);
    overflow-x:hidden;
    font-feature-settings:"palt" 1;
    -webkit-font-smoothing:antialiased;
    text-rendering:optimizeLegibility;
  }
  ::selection{background:var(--accent);color:var(--accent-ink);}
  a{text-decoration:none;color:inherit;}
  ul,ol{list-style:none;}
  button{font:inherit;color:inherit;}
  :focus-visible{outline:2px solid var(--accent);outline-offset:3px;border-radius:2px;}
  ::-webkit-scrollbar{width:8px;}
  ::-webkit-scrollbar-track{background:var(--bg);}
  ::-webkit-scrollbar-thumb{background:#2a2a2a;border-radius:4px;}

  /* ===== 首屏 ===== */
  .hero{padding:calc(64px + var(--space-56)) var(--gutter) var(--space-56);border-top:0;}
  .hero-container{max-width:var(--max-width);margin:0 auto;width:100%;display:grid;grid-template-columns:minmax(0,1fr) 400px;gap:var(--space-72);align-items:center;}
  .eyebrow{display:flex;align-items:center;gap:var(--space-8);font-size:var(--fs-12);color:var(--text-muted);margin-bottom:var(--space-16);}
  .eyebrow::before{content:'';width:6px;height:6px;border-radius:50%;background:var(--accent);flex-shrink:0;}
  .hero-title{font-size:var(--fs-48);font-weight:600;line-height:1.18;letter-spacing:0;margin-bottom:var(--space-12);word-break:normal;overflow-wrap:break-word;text-wrap:balance;}
  .hero-sub{font-size:var(--fs-16);font-weight:500;color:var(--text);margin-bottom:var(--space-16);line-height:1.6;}
  .hero-copy{max-width:560px;}
  .hero-copy .lead{font-size:var(--fs-16);font-weight:500;color:var(--text);margin-bottom:var(--space-8);line-height:1.6;}
  .hero-copy p{font-size:var(--fs-14);line-height:var(--lh-body);color:var(--text-secondary);margin:0;}
  .hero-buttons{display:flex;gap:var(--space-12);margin-top:var(--space-24);}
  .btn{display:inline-flex;align-items:center;justify-content:center;gap:var(--space-8);padding:var(--space-12) var(--space-24);border-radius:var(--radius-sm);font-size:var(--fs-14);font-weight:500;letter-spacing:0;cursor:pointer;border:1px solid transparent;transition:background-color .2s ease,border-color .2s ease,color .2s ease;}
  .btn-primary{background:var(--accent);color:var(--accent-ink);border-color:var(--accent);}
  .btn-primary:hover{background:#E4F98C;border-color:#E4F98C;}
  .btn-secondary{background:transparent;color:var(--text);border-color:var(--border);}
  .btn-secondary:hover{border-color:rgba(255,255,255,.22);background:var(--surface);}
  .btn svg{width:16px;height:16px;stroke-width:1.5;}
  .hero-meta{display:flex;flex-wrap:wrap;align-items:center;gap:var(--space-8);margin-top:var(--space-16);font-size:var(--fs-12);color:var(--text-muted);}
  .hero-meta .sep{color:rgba(255,255,255,.2);}

  /* 首屏右侧：90 天看板（真实内容） */
  .board{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:var(--space-24);}
  .board-head{display:flex;align-items:baseline;justify-content:space-between;gap:var(--space-16);}
  .board-label{font-size:var(--fs-12);color:var(--text-muted);}
  .board-day{font-family:'Inter',sans-serif;font-variant-numeric:tabular-nums;font-size:var(--fs-20);font-weight:600;color:var(--text);line-height:1.2;}
  .board-day span{font-size:var(--fs-12);font-weight:400;color:var(--text-muted);margin-left:var(--space-4);}
  .board-track{display:flex;gap:3px;height:4px;margin:var(--space-16) 0 var(--space-8);}
  .board-seg{background:rgba(255,255,255,.1);border-radius:2px;position:relative;}
  .board-seg.is-current{background:rgba(216,242,107,.24);}
  .board-seg.is-current::before{content:'';position:absolute;left:0;top:-4px;width:6px;height:12px;border-radius:2px;background:var(--accent);}
  .board-scale{display:flex;justify-content:space-between;font-size:var(--fs-12);color:var(--text-muted);font-family:'Inter',sans-serif;font-variant-numeric:tabular-nums;}
  .board-list{margin-top:var(--space-16);border-top:1px solid var(--border);}
  .board-list li{display:flex;gap:var(--space-12);padding:var(--space-12) 0;font-size:var(--fs-12);line-height:1.6;color:var(--text-secondary);border-bottom:1px solid rgba(255,255,255,.05);}
  .board-list li:last-child{border-bottom:none;padding-bottom:0;}
  .board-num{font-family:'Inter',sans-serif;font-variant-numeric:tabular-nums;color:var(--text-muted);flex-shrink:0;}
  .board-foot{display:flex;justify-content:space-between;gap:var(--space-16);margin-top:var(--space-12);font-size:var(--fs-12);color:var(--text-muted);font-family:'Inter',sans-serif;font-variant-numeric:tabular-nums;}

  /* ===== 区块 ===== */
  section{position:relative;padding:var(--space-56) var(--gutter);border-top:1px solid var(--border);}
  .section-container{max-width:var(--max-width);margin:0 auto;}
  .section-header{margin-bottom:var(--space-24);}
  .section-title{font-size:var(--fs-28);font-weight:600;letter-spacing:0;line-height:1.3;}
  .section-note{font-size:var(--fs-14);color:var(--text-secondary);margin:-8px 0 var(--space-24);max-width:680px;}

  /* 三个方向 */
  .focus-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0;border-top:1px solid var(--border);border-bottom:1px solid var(--border);}
  .focus-card{display:flex;flex-direction:column;align-items:flex-start;gap:12px;min-height:220px;padding:28px 28px 26px 0;transition:background-color .2s ease;}
  .focus-card+.focus-card{border-left:1px solid var(--border);padding-left:28px;}
  .focus-card:hover h3{color:var(--accent);}
  .focus-kicker{font-size:11px;letter-spacing:.12em;color:var(--accent);}
  .focus-card h3{font-size:22px;font-weight:600;letter-spacing:0;transition:color .2s ease;}
  .focus-card p{font-size:14px;line-height:1.85;color:var(--text-secondary);}
  .focus-meta{font-size:12px;color:var(--text-muted);line-height:1.6;}
  .focus-point{margin-top:auto;padding-top:14px;display:flex;align-items:center;gap:8px;font-size:13px;color:var(--text);}


  /* 90 天实践 */
  .practice-head{display:flex;align-items:flex-end;justify-content:space-between;gap:var(--space-32);margin-bottom:var(--space-32);}
  .practice-head .section-header{margin-bottom:0;}
  .practice-intro{font-size:var(--fs-14);line-height:var(--lh-body);color:var(--text-secondary);max-width:640px;margin-top:var(--space-8);}
  .practice-aside{display:flex;flex-direction:column;align-items:flex-end;gap:var(--space-8);flex-shrink:0;}
  .practice-period{font-family:'Inter',sans-serif;font-variant-numeric:tabular-nums;font-size:var(--fs-12);color:var(--text-muted);}
  .practice-more{display:inline-flex;align-items:center;gap:var(--space-8);font-size:var(--fs-14);color:var(--text);border-bottom:1px solid var(--border);padding-bottom:2px;transition:border-color .2s ease;}
  .practice-more:hover{border-bottom-color:rgba(255,255,255,.3);}
  .practice-progress{display:flex;align-items:baseline;gap:var(--space-16);margin-bottom:var(--space-24);}
  .practice-day{font-family:'Inter',sans-serif;font-variant-numeric:tabular-nums;font-size:var(--fs-48);font-weight:600;line-height:1;color:var(--text);letter-spacing:-.02em;white-space:nowrap;}
  .practice-day span{font-size:var(--fs-14);font-weight:400;color:var(--text-muted);margin-left:var(--space-4);letter-spacing:0;}
  .practice-phase{font-size:var(--fs-14);color:var(--text-secondary);}
  .stage-bar{display:flex;gap:var(--space-8);margin-bottom:var(--space-24);}
  .stage{min-width:0;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-sm);padding:var(--space-12) var(--space-16);display:flex;flex-direction:column;align-items:flex-start;gap:var(--space-4);text-align:left;cursor:pointer;transition:background-color .2s ease,border-color .2s ease;}
  .stage:hover{background:var(--surface-2);}
  .stage-1{flex:14 1 0;}
  .stage-2{flex:16 1 0;}
  .stage-3{flex:30 1 0;}
  .stage-4{flex:30 1 0;}
  .stage.active{background:var(--surface-2);border-color:rgba(216,242,107,.45);}
  .stage-name{display:flex;align-items:center;gap:var(--space-8);font-size:var(--fs-12);font-weight:500;color:var(--text-muted);line-height:1.4;}
  .stage.active .stage-name{color:var(--text);}
  .stage.active .stage-name::before{content:'';width:6px;height:6px;border-radius:50%;background:var(--accent);flex-shrink:0;}
  .stage-dates{font-family:'Inter',sans-serif;font-variant-numeric:tabular-nums;font-size:var(--fs-12);color:var(--text-muted);line-height:1.4;}
  .stage.active .stage-dates{color:var(--text-secondary);}

  .stage-panel{min-height:248px;display:flex;flex-direction:column;gap:var(--space-16);padding:var(--space-24);background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);}
  .stage-panel[hidden]{display:none;}
  .stage-goal{display:flex;align-items:flex-start;gap:var(--space-16);}
  .stage-goal-label{flex-shrink:0;font-size:var(--fs-12);color:var(--text-muted);padding-top:2px;}
  .stage-goal p{margin:0;font-size:var(--fs-14);color:var(--text-secondary);line-height:var(--lh-body);}
  .stage-outputs{display:grid;grid-template-columns:repeat(4,1fr);gap:var(--space-12);}
  .stage-outputs li{display:flex;gap:var(--space-8);min-height:76px;padding:var(--space-12);background:rgba(255,255,255,.03);border:1px solid var(--border);border-radius:var(--radius-sm);font-size:var(--fs-12);color:var(--text-secondary);line-height:1.6;}
  .out-num{font-family:'Inter',sans-serif;font-variant-numeric:tabular-nums;color:var(--text-muted);flex-shrink:0;}
  .stage-posts{display:flex;align-items:center;flex-wrap:wrap;gap:var(--space-12);padding-top:var(--space-16);border-top:1px solid var(--border);}
  .stage-posts-label{font-size:var(--fs-12);color:var(--text-muted);}
  .stage-post{display:inline-flex;align-items:center;gap:var(--space-8);font-size:var(--fs-12);color:var(--text-secondary);}
  .stage-post-date{font-family:'Inter',sans-serif;font-variant-numeric:tabular-nums;color:var(--text-muted);}
  .stage-post-title{border-bottom:1px solid var(--border);transition:border-color .2s ease;}
  .stage-post:hover .stage-post-title{border-bottom-color:rgba(255,255,255,.3);}
  .stage-posts-empty{font-size:var(--fs-12);color:var(--text-muted);}

  /* 最新洞察 */
  .latest-grid{border-top:1px solid var(--border);}
  .latest-card{display:grid;grid-template-columns:112px minmax(0,1fr) 24px;align-items:center;gap:8px 24px;padding:24px 4px;border-bottom:1px solid var(--border);transition:padding .2s ease,background .2s ease;}
  .latest-card:hover{padding-left:12px;padding-right:12px;background:rgba(255,255,255,.018);}
  .latest-info{padding:0;display:contents;}
  .latest-tag{grid-column:1;grid-row:1;font-size:12px;color:var(--text-muted);border:0;padding:0;}
  .latest-info h3{grid-column:2;grid-row:1;font-size:18px;font-weight:600;color:var(--text);line-height:1.5;letter-spacing:0;}
  .latest-info p{grid-column:2;grid-row:2;font-size:13px;line-height:1.75;color:var(--text-secondary);}
  .latest-date{grid-column:1;grid-row:2;font-family:'Inter',sans-serif;font-variant-numeric:tabular-nums;font-size:11px;color:var(--text-muted);}
  .latest-view{grid-column:3;grid-row:1 / span 2;font-size:18px;color:var(--text-muted);display:inline-flex;align-items:center;justify-content:center;}

  .latest-more{display:flex;justify-content:flex-end;margin-top:var(--space-16);}
  .latest-more a{display:inline-flex;align-items:center;gap:var(--space-8);font-size:var(--fs-14);color:var(--text-secondary);}
  .latest-more a:hover{color:var(--text);}

  /* 结尾 */
  .closing-band{display:flex;align-items:center;justify-content:space-between;gap:var(--space-32);background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:var(--space-32);}
  .closing-copy h2{font-size:var(--fs-28);font-weight:600;letter-spacing:0;line-height:1.3;margin-bottom:var(--space-8);}
  .closing-copy p{font-size:var(--fs-14);color:var(--text-secondary);margin:0;line-height:var(--lh-body);}
  .closing-actions{display:flex;gap:var(--space-12);flex-shrink:0;}
  .closing-meta{display:flex;flex-wrap:wrap;align-items:center;gap:var(--space-8);margin-top:var(--space-16);font-size:var(--fs-12);color:var(--text-muted);}
  .closing-meta a{color:var(--text-secondary);border-bottom:1px solid var(--border);}
  .closing-meta a:hover{color:var(--text);}
  .closing-meta .meta-strong{color:var(--text-secondary);}

  @media(max-width:1080px){
    .hero-container{grid-template-columns:minmax(0,1fr) 360px;gap:var(--space-40);}
    .stage-outputs{grid-template-columns:repeat(2,1fr);}
  }
  @media(max-width:900px){
    .hero-container{grid-template-columns:1fr;gap:var(--space-32);}
    .board{max-width:480px;}
    .focus-grid{grid-template-columns:1fr;}
    .focus-card{min-height:0;padding:22px 0;}
    .focus-card+.focus-card{border-left:0;border-top:1px solid var(--border);padding-left:0;}
    .practice-head{flex-direction:column;align-items:flex-start;gap:var(--space-16);}
    .practice-aside{flex-direction:row;align-items:center;gap:var(--space-24);}
    .closing-band{flex-direction:column;align-items:flex-start;gap:var(--space-24);}
  }
  @media(max-width:768px){
    .hero{padding:calc(56px + var(--space-32)) 24px var(--space-32);}
    .hero-title{font-size:30px;line-height:1.25;}
    .hero-sub{font-size:var(--fs-14);}
    .hero-buttons{flex-direction:column;margin-top:var(--space-16);}
    .hero-buttons .btn{width:100%;}
    .hero-meta{line-height:1.6;flex-direction:column;align-items:flex-start;gap:2px;}
    .hero-meta .sep{display:none;}

    section{padding:var(--space-32) 24px;}
    .section-title{font-size:24px;}
    .practice-day{font-size:36px;}
    .practice-progress{gap:var(--space-12);}
    .stage-bar{display:grid;grid-template-columns:1fr 1fr;gap:var(--space-8);}
    .stage{flex:none;padding:var(--space-12);}
    .stage-panel{padding:var(--space-16);min-height:0;}
    .stage-goal{flex-direction:column;gap:var(--space-4);}
    .stage-outputs{grid-template-columns:1fr;gap:var(--space-8);}
    .stage-outputs li{min-height:0;}
    .latest-card{grid-template-columns:1fr 24px;gap:8px 14px;padding:20px 0;}
    .latest-tag{grid-column:1;grid-row:1;}
    .latest-info h3{grid-column:1;grid-row:2;font-size:16px;}
    .latest-info p{grid-column:1;grid-row:3;}
    .latest-date{grid-column:1;grid-row:4;}
    .latest-view{grid-column:2;grid-row:1 / span 4;}
    .closing-band{padding:var(--space-24);}
    .closing-actions{width:100%;flex-direction:column;}
    .closing-actions .btn{width:100%;}
  }
</style>
</head>
<body>

<Nav active="home" />

<!-- ===== 首屏 ===== -->
<section class="hero">
  <div class="hero-container">
    <div class="hero-content">
      <p class="eyebrow">90 天个人商业实践</p>
      <h1 class="hero-title">从信息消费者，到商业创造者</h1>
      <p class="hero-sub">AI 时代的个人商业创造者</p>
      <div class="hero-copy">
        <p class="lead">每个人都应该拥有自己的商业资产。</p>
        <p>我正在借助 AI，把个人经验与专业能力转化为自己的产品与持续收入，并公开记录整个过程。</p>
      </div>
      <div class="hero-buttons">
        <a href="#practice" class="btn btn-primary">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><polyline points="19 12 12 19 5 12"/></svg>
          了解我的实践
        </a>
        <a href="/insights" class="btn btn-secondary">阅读洞察</a>
      </div>
      <p class="hero-meta">
        <span>18 年 IT 与产业数字化经验</span>
        <span class="sep">·</span>
        <span>产业数字化与 AI 应用</span>
        <span class="sep">·</span>
        <span>AI 与个人商业实践</span>
      </p>
    </div>

    <aside class="board" aria-label="90 天实践进度">
      <div class="board-head">
        <span class="board-label">实践进度</span>
        <span class="board-day">Day <span data-practice-day-number>{String(practice.dayNumber).padStart(2, '0')}</span><span>/ 90</span></span>
      </div>
      <div class="board-track" aria-hidden="true">
        {stages.map((s) => (
          <span class={`board-seg${s.status === '当前' ? ' is-current' : ''}`} style={`flex:${s.days} 1 0`}></span>
        ))}
      </div>
      <div class="board-scale"><span>11.08</span><span>02.05</span></div>
      <ul class="board-list" data-practice-board-outputs>
        {boardOutputs.map((output, i) => (
          <li><span class="board-num">{String(i + 1).padStart(2, '0')}</span><span data-board-output>{output}</span></li>
        ))}
      </ul>
      <div class="board-foot"><span data-practice-board-stage>第{cnNums[currentStage.id - 1]}阶段 · {currentStage.name}</span><span>{posts.length} 篇记录</span></div>
    </aside>
  </div>
</section>

<!-- ===== 我在做什么 ===== -->
<section id="focus">
  <div class="section-container">
    <div class="section-header">
      <h2 class="section-title">我在做什么</h2>
    </div>
    <p class="section-note">我关注三个相互关联的方向。</p>
    <div class="focus-grid">
      {directions.map((d) => {
        const count = countByTopic(d.title);
        const post = latestByTopic(d.title);
        return (
          <a class="focus-card" href={`/topics/${d.slug}`}>
            <span class="focus-kicker">主题专题</span>
            <h3>{d.title}</h3>
            <p>{d.definition}</p>
            {count > 0 && (
              <div class="focus-meta">已发布 {count} 篇{post ? <> · 最新：{post.title}</> : null}</div>
            )}
            <div class="focus-point"><span aria-hidden="true">→</span>{d.point}</div>
          </a>
        );
      })}
    </div>
  </div>
</section>

<!-- ===== 90 天实践 ===== -->
<section id="practice">
  <div class="section-container">
    <div class="practice-head">
      <div>
        <div class="section-header">
          <h2 class="section-title">我的 90 天创造者实践</h2>
        </div>
        <p class="practice-intro">从寻找真实需求开始，用 90 天做出一个产品，并公开记录每一步。</p>
      </div>
      <aside class="practice-aside">
        <span class="practice-period" data-practice-period>{practice.period}</span>
        <a class="practice-more" href="/90-days">进入 90 天实战<span aria-hidden="true">→</span></a>
      </aside>
    </div>

    <div class="practice-progress">
      <div class="practice-day">Day <span data-practice-day-number>{String(practice.dayNumber).padStart(2, '0')}</span><span>/ 90</span></div>
      <div class="practice-phase" id="practicePhase" data-practice-phase>第{cnNums[currentStage.id - 1]}阶段 · {currentStage.name}</div>
    </div>

    <div class="stage-bar" role="tablist" aria-label="90 天阶段" data-current-stage={practice.currentStageId}>
      {stages.map((s) => (
        <button
          type="button"
          class={`stage stage-${s.id}${s.id === practice.currentStageId ? ' active' : ''}`}
          id={`stage-tab-${s.id}`}
          role="tab"
          aria-selected={s.id === practice.currentStageId ? 'true' : 'false'}
          aria-controls={`stage-panel-${s.id}`}
          data-stage={s.id}
          data-name={s.name}
          data-status={s.status}
          data-stage-start={s.startDate}
          data-stage-end={s.endDate}
          data-outputs={JSON.stringify(s.outputs.slice(0, 3))}
          data-cn={cnNums[s.id - 1]}
        >
          <span class="stage-name">第{cnNums[s.id - 1]}阶段</span>
          <span class="stage-dates" data-stage-range>{s.range.start}–{s.range.end}</span>
        </button>
      ))}
    </div>

    <div class="stage-panels">
      {stages.map((s) => {
        const stagePosts = s.postIds.map(postOf).filter(Boolean).slice(0, 2);
        return (
          <div
            class="stage-panel"
            id={`stage-panel-${s.id}`}
            role="tabpanel"
            aria-labelledby={`stage-tab-${s.id}`}
            data-stage={s.id}
            hidden={s.id !== practice.currentStageId}
          >
            <div class="stage-goal">
              <span class="stage-goal-label">阶段目标</span>
              <p>{s.goal}</p>
            </div>
            <ol class="stage-outputs">
              {s.outputs.map((output, i) => (
                <li>
                  <span class="out-num">{String(i + 1).padStart(2, '0')}</span>
                  <span>{output}</span>
                </li>
              ))}
            </ol>
            <div class="stage-posts">
              <span class="stage-posts-label">相关记录</span>
              {stagePosts.length ? stagePosts.map((p) => (
                <a class="stage-post" href={p.url}>
                  <span class="stage-post-date">{p.date}</span>
                  <span class="stage-post-title">{p.title}</span>
                </a>
              )) : (
                <span class="stage-posts-empty">随实践更新</span>
              )}
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>

{latest.length > 0 && (
<section id="latest">
  <div class="section-container">
    <div class="section-header">
      <h2 class="section-title">最新洞察</h2>
    </div>
    <div class="latest-grid">
      {latest.map((post) => (
        <a class="latest-card" href={post.url}>
          <div class="latest-info">
            <span class="latest-tag">{post.category}</span>
            <h3>{post.title}</h3>
            <p>{post.excerpt}</p>
            <span class="latest-date">{post.date} · {post.readTime}</span>
            <span class="latest-view" aria-hidden="true">↗</span>
          </div>
        </a>
      ))}
    </div>
    <div class="latest-more"><a href="/insights">查看全部 {posts.length} 篇洞察<span aria-hidden="true">→</span></a></div>
  </div>
</section>
)}

<!-- ===== 结尾 ===== -->
<section id="closing">
  <div class="section-container">
    <div class="closing-band">
      <div class="closing-copy">
        <h2>一起成为商业创造者</h2>
        <p>如果你对我在做的事情感兴趣，也关心如何把自己的能力商业化，欢迎关注这场实践。</p>
      </div>
      <div class="closing-actions">
        <a href="mailto:cronaldo.yang@outlook.com" class="btn btn-primary">邮件联系</a>
        <a href="/insights" class="btn btn-secondary">阅读洞察</a>
      </div>
    </div>
    <div class="closing-meta">
      <a href="mailto:cronaldo.yang@outlook.com">cronaldo.yang@outlook.com</a>
      <span aria-hidden="true">·</span>
      <span>公众号：<span class="meta-strong">个人商业创造者</span></span>
    </div>
  </div>
</section>

<Footer />

<script is:inline src="/js/practice-clock.js" defer></script>
<script>
  // 90 天阶段 tab：点击/方向键切换，hash 深链接
  const stageTabs = [...document.querySelectorAll('.stage-bar [role="tab"]')];
  const stagePanels = [...document.querySelectorAll('.stage-panel')];
  const phaseEl = document.getElementById('practicePhase');

  function setStage(id, updateHash) {
    if (!id || !document.getElementById('stage-panel-' + id)) id = stageTabs[0]?.dataset.stage;
    stageTabs.forEach((tab) => {
      const on = tab.dataset.stage === String(id);
      tab.classList.toggle('active', on);
      tab.setAttribute('aria-selected', on ? 'true' : 'false');
    });
    stagePanels.forEach((panel) => { panel.hidden = panel.dataset.stage !== String(id); });
    const activeTab = stageTabs.find((tab) => tab.dataset.stage === String(id));
    if (phaseEl && activeTab) {
      const status = activeTab.dataset.status;
      phaseEl.textContent = '第' + activeTab.dataset.cn + '阶段 · ' + activeTab.dataset.name + (status && status !== '当前' ? ' · ' + status : '');
    }
    if (updateHash) {
      const url = new URL(location.href);
      url.hash = 'stage-' + id;
      history.replaceState(null, '', url);
    }
  }

  const hashStage = location.hash.match(/^#stage-([1-4])$/);
  const initialStageId = document.querySelector('.stage-bar')?.dataset.currentStage || '1';
  setStage(hashStage ? hashStage[1] : initialStageId, false);
  stageTabs.forEach((tab) => {
    tab.addEventListener('click', () => setStage(tab.dataset.stage, true));
    tab.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
      event.preventDefault();
      const index = stageTabs.indexOf(tab);
      const next = stageTabs[(index + (event.key === 'ArrowRight' ? 1 : stageTabs.length - 1)) % stageTabs.length];
      next.focus();
      setStage(next.dataset.stage, true);
    });
  });
</script>
</body>
</html>
