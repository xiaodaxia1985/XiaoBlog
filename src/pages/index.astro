<!DOCTYPE html>
<html lang="zh-CN" style="background:#0A0A0A;">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#0A0A0A">
<title>杨逍 — 产业数字化专家 · 技术架构师｜从理解产业到经营价值</title>
<style>
  :root{
    --bg:#0A0A0A;
    --bg-card:#161616;
    --bg-card-hover:#1E1E1E;
    --bg-input:#0F0F0F;
    --accent:#39FF14;
    --accent-rgb:57,255,20;
    --accent-dim:rgba(57,255,20,.15);
    --accent-dark:#1a8a00;
    --text:#FFFFFF;
    --text-secondary:#A1A1AA;
    --text-muted:#71717A;
    --border:rgba(255,255,255,.08);
    --radius:16px;
    --radius-sm:10px;
    --max-width:1200px;
  }
  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Microsoft YaHei","Hiragino Sans GB",sans-serif;
    background:var(--bg);
    color:var(--text);
    line-height:1.75;
    overflow-x:hidden;
    font-feature-settings:"palt" 1;
    -webkit-font-smoothing:antialiased;
    text-rendering:optimizeLegibility;
  }
  ::selection{background:var(--accent);color:#000;}
  a{text-decoration:none;color:inherit;}
  ul{list-style:none;}
  ::-webkit-scrollbar{width:8px;}
  ::-webkit-scrollbar-track{background:var(--bg);}
  ::-webkit-scrollbar-thumb{background:#333;border-radius:4px;}
  ::-webkit-scrollbar-thumb:hover{background:#444;}

  /* ===== Navigation ===== */
  .nav{
    position:fixed;top:0;left:0;right:0;z-index:1000;
    padding:20px 40px;display:flex;align-items:center;justify-content:space-between;
    background:rgba(10,10,10,.6);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);
    border-bottom:1px solid var(--border);transition:padding .3s ease,background .3s ease;
  }
  .nav.scrolled{padding:14px 40px;background:rgba(10,10,10,.85);}
  .nav-logo{font-weight:800;font-size:20px;letter-spacing:-.5px;color:var(--text);}
  .nav-logo span{color:var(--accent);}
  .nav-links{display:flex;gap:36px;}
  .nav-links a{font-size:14px;font-weight:500;color:var(--text-secondary);position:relative;transition:color .3s ease;letter-spacing:.08em;}
  .nav-links a::after{content:'';position:absolute;bottom:-4px;left:0;width:0;height:2px;background:var(--accent);transition:width .3s ease;border-radius:2px;}
  .nav-links a:hover,.nav-links a.active{color:var(--accent);}
  .nav-links a.active::after,.nav-links a:hover::after{width:100%;}
  .nav-toggle{display:none;flex-direction:column;gap:5px;cursor:pointer;background:none;border:none;padding:4px;}
  .nav-toggle span{width:24px;height:2px;background:var(--text);border-radius:2px;transition:.3s;}

  /* ===== Hero ===== */
  .hero{
    min-height:100vh;display:flex;align-items:center;position:relative;
    padding:120px 40px 80px;overflow:hidden;
    background:linear-gradient(110deg,#080808 0%,#0a0a0a 35%,#161616 55%,#222 75%,#2e2e2e 100%);
  }
  .hero::before{
    content:'';position:absolute;top:0;right:0;width:55%;height:100%;
    background:radial-gradient(ellipse at 70% 40%,rgba(50,50,50,.6) 0%,rgba(20,20,20,.3) 50%,transparent 80%);
    pointer-events:none;z-index:1;
  }
  .hero-watermark{
    position:absolute;bottom:40px;left:50%;transform:translateX(-50%);
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Microsoft YaHei","Hiragino Sans GB",sans-serif;font-size:clamp(80px,18vw,260px);font-weight:900;
    color:#27272A;opacity:.07;white-space:nowrap;letter-spacing:-.06em;
    pointer-events:none;z-index:0;text-transform:uppercase;
  }
  .hero-container{max-width:var(--max-width);margin:0 auto;width:100%;display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:center;position:relative;z-index:2;}
  .hero-content{max-width:560px;}
  .hero-badge{display:flex;align-items:center;gap:12px;margin-bottom:24px;}
  .hero-badge .line{width:40px;height:2px;background:var(--accent);border-radius:2px;box-shadow:0 0 8px var(--accent);}
  .hero-badge .label{color:var(--accent);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Microsoft YaHei","Hiragino Sans GB",sans-serif;font-weight:700;font-size:14px;letter-spacing:3px;text-shadow:0 0 12px rgba(var(--accent-rgb),.4);}
  .hero-title{font-size:clamp(30px,6vw,56px);font-weight:800;line-height:1.15;letter-spacing:.02em;margin-bottom:18px;color:var(--text);word-break:keep-all;overflow-wrap:break-word;}
  .hero-roles{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:28px;}
  .role-tag{display:inline-flex;align-items:center;padding:8px 18px;border-radius:999px;font-size:clamp(13px,1.6vw,16px);font-weight:600;letter-spacing:.04em;background:var(--accent-dim);border:1px solid rgba(var(--accent-rgb),.35);color:var(--accent);white-space:nowrap;transition:all .25s ease;}
  .role-tag:hover{background:rgba(var(--accent-rgb),.22);border-color:var(--accent);box-shadow:0 0 16px rgba(var(--accent-rgb),.25);transform:translateY(-2px);}
  .role-tag .dot{display:inline-block;width:6px;height:6px;border-radius:50%;background:var(--accent);margin-right:8px;box-shadow:0 0 8px var(--accent);}
  .hero-desc{font-size:16px;color:var(--text-secondary);line-height:1.9;margin-bottom:40px;max-width:500px;letter-spacing:.02em;}
  .hero-buttons{display:flex;gap:16px;margin-bottom:36px;flex-wrap:wrap;}
  .btn{display:inline-flex;align-items:center;gap:8px;padding:14px 28px;border-radius:var(--radius-sm);font-size:14px;font-weight:600;cursor:pointer;transition:all .3s ease;border:2px solid transparent;font-family:inherit;letter-spacing:.06em;}
  .btn-primary{background:var(--accent);color:#000;border-color:var(--accent);box-shadow:0 0 20px rgba(var(--accent-rgb),.25);}
  .btn-primary:hover{box-shadow:0 0 30px rgba(var(--accent-rgb),.5);transform:translateY(-2px);}
  .btn-outline{background:transparent;color:var(--accent);border-color:var(--accent);}
  .btn-outline:hover{background:var(--accent-dim);box-shadow:0 0 20px rgba(var(--accent-rgb),.2);transform:translateY(-2px);}
  .btn svg{width:18px;height:18px;}
  .hero-socials{display:flex;gap:16px;}
  .social-link{width:42px;height:42px;border-radius:50%;display:flex;align-items:center;justify-content:center;background:var(--bg-card);border:1px solid var(--border);color:var(--text-secondary);transition:all .3s ease;}
  .social-link:hover{color:var(--accent);border-color:var(--accent);box-shadow:0 0 15px rgba(var(--accent-rgb),.2);transform:translateY(-2px);}
  .social-link svg{width:18px;height:18px;}
  .hero-image-wrapper{position:relative;display:flex;align-items:center;justify-content:center;min-height:360px;z-index:2;}
  .hero-arc{position:absolute;width:250px;height:250px;border:3px solid var(--accent);border-radius:50%;box-shadow:0 0 25px rgba(var(--accent-rgb),.35),0 0 50px rgba(var(--accent-rgb),.15),inset 0 0 20px rgba(var(--accent-rgb),.08);animation:arcPulse 4s ease-in-out infinite;z-index:1;}
  @keyframes arcPulse{0%,100%{box-shadow:0 0 25px rgba(var(--accent-rgb),.35),0 0 50px rgba(var(--accent-rgb),.15),inset 0 0 20px rgba(var(--accent-rgb),.08);}50%{box-shadow:0 0 40px rgba(var(--accent-rgb),.55),0 0 80px rgba(var(--accent-rgb),.25),inset 0 0 30px rgba(var(--accent-rgb),.12);}}
  .hero-arc::before{content:'';position:absolute;top:-5px;left:-5px;right:-5px;bottom:-5px;border:2px solid var(--accent);border-radius:50%;opacity:.2;filter:blur(8px);}
  .hero-portrait{position:relative;z-index:2;width:238px;height:238px;border-radius:50%;overflow:hidden;box-shadow:0 20px 60px rgba(0,0,0,.7);background:#f0f0f0;display:flex;align-items:center;justify-content:center;}
  .hero-portrait img{width:100%;height:100%;object-fit:contain;object-position:center;}
  .hero-glow{position:absolute;width:300px;height:300px;border-radius:50%;background:radial-gradient(circle,rgba(var(--accent-rgb),.1) 0%,transparent 70%);z-index:0;filter:blur(25px);right:-20px;}

  /* ===== Section base ===== */
  section{position:relative;padding:100px 40px;}
  #about{background:#0c0c0c;}
  #services{background:#0a0a0a;}
  #resume{background:#0e0e0e;}
  #projects{background:#080808;}
  #projects::before{content:'';position:absolute;top:0;left:0;right:0;bottom:0;background:radial-gradient(ellipse at 50% 30%,rgba(30,30,30,.4) 0%,transparent 60%);pointer-events:none;}
  #patents{background:#0a0a0a;}
  #contact{background:#0a0a0a;}
  .section-container{max-width:var(--max-width);margin:0 auto;position:relative;z-index:1;}
  .section-header{margin-bottom:56px;display:flex;align-items:center;gap:16px;}
  .section-header .line{width:40px;height:2px;background:var(--accent);border-radius:2px;box-shadow:0 0 8px var(--accent);}
  .section-title{font-size:clamp(28px,4vw,46px);font-weight:800;letter-spacing:.12em;}
  .section-title .green{color:var(--accent);}

  /* ===== About ===== */
  .about-grid{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:start;}
  .about-text p{font-size:16px;color:var(--text-secondary);line-height:2;margin-bottom:24px;letter-spacing:.02em;}
  .about-text p strong{color:var(--text);font-weight:600;}
  .about-text p .hl{color:var(--accent);font-weight:600;}
  .about-tags{display:flex;flex-wrap:wrap;gap:10px;margin-top:8px;}
  .about-tag{padding:6px 16px;border-radius:8px;background:var(--accent-dim);border:1px solid rgba(var(--accent-rgb),.2);font-size:13px;font-weight:600;color:var(--accent);letter-spacing:.04em;}
  .about-stats{display:grid;grid-template-columns:1fr 1fr;gap:20px;}
  .stat-card{background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:28px;text-align:center;transition:all .3s ease;}
  .stat-card:hover{border-color:rgba(var(--accent-rgb),.3);box-shadow:0 0 20px rgba(var(--accent-rgb),.08);transform:translateY(-4px);}
  .stat-number{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Microsoft YaHei","Hiragino Sans GB",sans-serif;font-size:40px;font-weight:800;color:var(--accent);margin-bottom:4px;text-shadow:0 0 20px rgba(var(--accent-rgb),.3);}
  .stat-label{font-size:13px;color:var(--text-muted);letter-spacing:.08em;}

  /* ===== Highlights (核心优势) ===== */
  .highlights-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:20px;}
  .highlight-card{background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:32px 24px;transition:all .3s ease;position:relative;overflow:hidden;}
  .highlight-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:var(--accent);transform:scaleX(0);transform-origin:left;transition:transform .3s ease;}
  .highlight-card:hover{border-color:rgba(var(--accent-rgb),.2);transform:translateY(-6px);box-shadow:0 12px 40px rgba(0,0,0,.3);}
  .highlight-card:hover::before{transform:scaleX(1);}
  .highlight-num{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Microsoft YaHei","Hiragino Sans GB",sans-serif;font-size:28px;font-weight:800;color:var(--accent);opacity:.3;margin-bottom:16px;}
  .highlight-label{font-size:15px;font-weight:700;color:var(--text);margin-bottom:10px;letter-spacing:.02em;line-height:1.4;}
  .highlight-data{font-size:13px;color:var(--text-muted);line-height:1.7;letter-spacing:.02em;}

  /* ===== Services ===== */
  .services-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;}
  .service-card{background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:36px 28px;transition:all .3s ease;position:relative;overflow:hidden;}
  .service-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:var(--accent);transform:scaleX(0);transform-origin:left;transition:transform .3s ease;}
  .service-card:hover{background:var(--bg-card-hover);border-color:rgba(var(--accent-rgb),.2);transform:translateY(-6px);}
  .service-card:hover::before{transform:scaleX(1);}
  .service-icon{width:52px;height:52px;border-radius:12px;background:var(--accent-dim);border:1px solid rgba(var(--accent-rgb),.2);display:flex;align-items:center;justify-content:center;margin-bottom:20px;}
  .service-icon svg{width:24px;height:24px;color:var(--accent);}
  .service-card h3{font-size:18px;font-weight:700;margin-bottom:10px;letter-spacing:.04em;}
  .service-card p{font-size:14px;color:var(--text-muted);line-height:1.8;letter-spacing:.02em;}

  /* ===== Education & Jobs ===== */
  .edu-jobs{display:grid;grid-template-columns:1.5fr 1fr;gap:48px;align-items:start;}
  .edu-sidebar{background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:36px 32px;position:sticky;top:100px;}
  .edu-sidebar .section-header{margin-bottom:28px;}
  .edu-sidebar .timeline-item{padding-bottom:24px;}
  .cert-cards{display:flex;flex-direction:column;gap:12px;margin-top:8px;}
  .cert-card{display:flex;align-items:center;gap:14px;padding:14px 18px;background:rgba(var(--accent-rgb),.06);border:1px solid rgba(var(--accent-rgb),.15);border-radius:var(--radius-sm);transition:all .3s ease;}
  .cert-card:hover{background:rgba(var(--accent-rgb),.1);border-color:rgba(var(--accent-rgb),.3);transform:translateX(4px);}
  .cert-card-icon{width:36px;height:36px;border-radius:8px;background:var(--accent-dim);display:flex;align-items:center;justify-content:center;flex-shrink:0;}
  .cert-card-icon svg{width:20px;height:20px;color:var(--accent);}
  .cert-card-text{font-size:14px;font-weight:500;color:var(--text);}
  .edu-jobs .timeline-item{position:relative;padding-left:32px;padding-bottom:28px;}
  .edu-jobs .timeline-item:last-child{padding-bottom:0;}
  .edu-jobs .timeline-item::before{content:'';position:absolute;left:6px;top:8px;width:2px;height:calc(100% - 8px);background:var(--border);}
  .edu-jobs .timeline-item:last-child::before{display:none;}
  .edu-jobs .timeline-item::after{content:'';position:absolute;left:0;top:4px;width:14px;height:14px;border-radius:50%;background:var(--accent);box-shadow:0 0 12px rgba(var(--accent-rgb),.5);border:3px solid var(--bg);z-index:1;}
  .timeline-item{position:relative;padding-left:32px;padding-bottom:36px;}
  .timeline-item:last-child{padding-bottom:0;}
  .timeline-item::before{content:'';position:absolute;left:6px;top:8px;width:2px;height:calc(100% - 8px);background:var(--border);}
  .timeline-item:last-child::before{display:none;}
  .timeline-item::after{content:'';position:absolute;left:0;top:4px;width:14px;height:14px;border-radius:50%;background:var(--accent);box-shadow:0 0 12px rgba(var(--accent-rgb),.5);border:3px solid var(--bg);z-index:1;}
  .timeline-date{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Microsoft YaHei","Hiragino Sans GB",sans-serif;font-size:12px;color:var(--text-muted);letter-spacing:.08em;margin-bottom:8px;}
  .timeline-title{font-size:17px;font-weight:600;color:var(--accent);margin-bottom:6px;letter-spacing:.03em;}
  .timeline-org{font-size:14px;color:var(--text-secondary);letter-spacing:.02em;}
  .timeline-detail{font-size:13px;color:var(--text-muted);margin-top:8px;line-height:1.7;}

  /* ===== Projects ===== */
  .projects-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;}
  .project-card{
    background:#f5f5f5;border:1px solid rgba(0,0,0,.06);border-radius:var(--radius);
    overflow:hidden;transition:all .3s ease;cursor:pointer;display:block;
    box-shadow:0 4px 20px rgba(0,0,0,.15);
  }
  .project-card:hover{transform:translateY(-8px);box-shadow:0 16px 50px rgba(0,0,0,.3);}
  .project-img{width:100%;aspect-ratio:16/10;overflow:hidden;position:relative;background:#1a1a1a;}
  .project-img img{width:100%;height:100%;object-fit:cover;transition:transform .4s ease;}
  .project-card:hover .project-img img{transform:scale(1.08);}
  .project-img::after{content:'';position:absolute;top:0;left:0;right:0;bottom:0;background:linear-gradient(180deg,transparent 60%,rgba(0,0,0,.5));pointer-events:none;}
  .project-info{padding:24px;display:flex;flex-direction:column;gap:10px;}
  .project-info h3{font-size:17px;font-weight:700;color:#111;letter-spacing:.03em;}
  .project-desc{font-size:13px;color:#666;line-height:1.7;letter-spacing:.02em;}
  .project-tag{display:inline-block;padding:4px 12px;border-radius:6px;background:rgba(var(--accent-rgb),.12);color:var(--accent-dark);font-size:11px;font-weight:600;letter-spacing:.04em;width:fit-content;}
  .project-view{display:flex;align-items:center;gap:6px;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Microsoft YaHei","Hiragino Sans GB",sans-serif;font-size:13px;font-weight:600;color:var(--accent-dark);transition:gap .3s ease;letter-spacing:.05em;margin-top:4px;}
  .project-card:hover .project-view{gap:10px;}
  .project-view svg{width:14px;height:14px;}

  /* ===== Patents ===== */
  .patents-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;}
  .patent-card{
    background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);
    padding:32px 28px;transition:all .3s ease;position:relative;overflow:hidden;
  }
  .patent-card:hover{
    border-color:rgba(var(--accent-rgb),.2);transform:translateY(-6px);
    box-shadow:0 12px 40px rgba(0,0,0,.4);
  }
  .patent-card::before{
    content:'';position:absolute;top:0;left:0;right:0;height:3px;
    background:var(--accent);transform:scaleX(0);transform-origin:left;transition:transform .3s ease;
  }
  .patent-card:hover::before{transform:scaleX(1);}
  .patent-type-badge{
    display:inline-block;padding:4px 14px;border-radius:6px;font-size:11px;font-weight:700;
    letter-spacing:.06em;margin-bottom:16px;
  }
  .patent-type-badge.invention{background:rgba(var(--accent-rgb),.12);color:var(--accent);border:1px solid rgba(var(--accent-rgb),.2);}
  .patent-type-badge.utility{background:rgba(100,149,238,.12);color:#6495ED;border:1px solid rgba(100,149,238,.2);}
  .patent-card h3{font-size:16px;font-weight:600;margin-bottom:12px;line-height:1.5;letter-spacing:.02em;}
  .patent-number{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Microsoft YaHei","Hiragino Sans GB",sans-serif;font-size:12px;color:var(--text-muted);margin-bottom:12px;letter-spacing:.04em;}
  .patent-card p{font-size:13px;color:var(--text-muted);line-height:1.7;letter-spacing:.02em;}
  .patent-icon{width:48px;height:48px;border-radius:12px;background:var(--accent-dim);border:1px solid rgba(var(--accent-rgb),.2);display:flex;align-items:center;justify-content:center;margin-bottom:16px;}
  .patent-icon svg{width:24px;height:24px;color:var(--accent);}
  .patent-thumb{width:100%;aspect-ratio:16/10;border-radius:var(--radius-sm);overflow:hidden;margin-bottom:18px;cursor:pointer;position:relative;border:1px solid var(--border);transition:all .3s ease;}
  .patent-thumb:hover{border-color:rgba(var(--accent-rgb),.3);box-shadow:0 0 20px rgba(var(--accent-rgb),.1);transform:translateY(-2px);}
  .patent-thumb img{width:100%;height:100%;object-fit:cover;transition:transform .4s ease;}
  .patent-thumb:hover img{transform:scale(1.05);}
  .patent-thumb::after{content:'点击查看大图';position:absolute;bottom:0;left:0;right:0;padding:6px;background:linear-gradient(transparent,rgba(0,0,0,.8));color:var(--accent);font-size:11px;text-align:center;letter-spacing:.06em;opacity:0;transition:opacity .3s ease;pointer-events:none;}
  .patent-thumb:hover::after{opacity:1;}

  /* ===== Patent Lightbox ===== */
  .lightbox{position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,.92);z-index:9999;display:flex;align-items:center;justify-content:center;opacity:0;pointer-events:none;transition:opacity .3s ease;}
  .lightbox.active{opacity:1;pointer-events:auto;}
  .lightbox-content{max-width:90vw;max-height:90vh;position:relative;border-radius:var(--radius);overflow:hidden;box-shadow:0 20px 80px rgba(0,0,0,.5);}
  .lightbox-content img{max-width:90vw;max-height:85vh;object-fit:contain;display:block;transition:opacity .3s ease;}
  .lightbox-close{position:absolute;top:16px;right:16px;width:44px;height:44px;border-radius:50%;background:rgba(0,0,0,.6);border:1px solid rgba(255,255,255,.2);color:#fff;font-size:24px;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .3s ease;z-index:10000;}
  .lightbox-close:hover{background:var(--accent);color:#000;transform:rotate(90deg);}
  .lightbox-caption{position:absolute;bottom:0;left:0;right:0;padding:20px 24px;background:linear-gradient(transparent,rgba(0,0,0,.7));text-align:center;}
  .lightbox-caption h4{color:var(--accent);font-size:16px;font-weight:600;margin-bottom:4px;}
  .lightbox-caption p{color:var(--text-secondary);font-size:13px;}

  /* ===== Contact ===== */
  .contact-card{background:var(--bg-card);border:1px solid var(--border);border-radius:24px;padding:60px;text-align:center;}
