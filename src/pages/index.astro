---
import { getPublishedPosts } from '../lib/insights';
import { getPracticeSnapshot } from '../data/stages.mjs';
import { topics } from '../data/topics.mjs';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const posts = await getPublishedPosts();
const latest = posts.slice(0, 3);
const practice = getPracticeSnapshot();
const stages = practice.stages;
const currentStage = stages.find((stage) => stage.id === practice.currentStageId) ?? stages[0];
const countByTopic = (topic) => posts.filter((post) => post.topic === topic.title).length;
---
<!DOCTYPE html>
<html lang="zh-CN" style="background:#0c0c0c;">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#0c0c0c">
<meta name="color-scheme" content="dark">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="stylesheet" href="/fonts/fonts.css">
<link rel="stylesheet" href="/css/tokens.css">
<script is:inline>document.documentElement.classList.add('js');</script>
<script is:inline src="/js/site-shell.js" defer></script>
<title>个人商业创造者｜把能力变成自己的商业资产</title>
<meta name="description" content="记录一个人如何借助 AI，把专业经验转化为产品、内容与可持续的商业资产。关注个人商业创造、AI 产品与个人商业系统。">
<link rel="canonical" href={new URL('/', Astro.site ?? 'https://xiaomaker.top').toString()}>
<meta property="og:type" content="website">
<meta property="og:locale" content="zh_CN">
<meta property="og:title" content="个人商业创造者｜把能力变成自己的商业资产">
<meta property="og:description" content="记录一个人如何借助 AI，把专业经验转化为产品、内容与可持续的商业资产。">
<meta property="og:url" content={new URL('/', Astro.site ?? 'https://xiaomaker.top').toString()}>
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="个人商业创造者｜把能力变成自己的商业资产">
<meta name="twitter:description" content="记录一个人如何借助 AI，把专业经验转化为产品、内容与可持续的商业资产。">
<style>
  :root{--bg:#0c0c0c;--surface:#141414;--surface-2:#1a1a1a;--accent:#d8f26b;--accent-ink:#0c0c0c;--text:#f5f5f4;--text-secondary:#aaa9a3;--text-muted:#777770;--border:rgba(255,255,255,.1);--max-width:1120px;}
  *{box-sizing:border-box;margin:0;padding:0;}
  html{scroll-behavior:smooth;scroll-padding-top:84px;}
  body{background:var(--bg);color:var(--text);font-family:'Noto Sans SC','Inter',-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Microsoft YaHei',sans-serif;font-size:16px;line-height:1.7;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility;overflow-x:hidden;}
  a{color:inherit;text-decoration:none;}
  ::selection{background:var(--accent);color:var(--accent-ink);}
  :focus-visible{outline:2px solid var(--accent);outline-offset:4px;border-radius:3px;}
  .wrap{width:min(var(--max-width),calc(100% - 64px));margin-inline:auto;}
  .hero{padding:clamp(104px,10vw,136px) 0 64px;border:0;}
  .hero-grid{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(260px,.7fr);gap:clamp(48px,8vw,112px);align-items:end;}
  .eyebrow{display:flex;align-items:center;gap:10px;color:var(--accent);font-size:11px;letter-spacing:.16em;text-transform:uppercase;margin-bottom:24px;}
  .eyebrow:before{content:'';width:22px;height:1px;background:var(--accent);}
  h1{max-width:760px;font-size:clamp(32px,4.4vw,54px);line-height:1.16;font-weight:650;letter-spacing:-.045em;text-wrap:balance;}
  .hero-deck{max-width:650px;margin-top:26px;font-size:clamp(16px,1.7vw,19px);line-height:1.9;color:var(--text-secondary);}
  .hero-deck strong{color:var(--text);font-weight:550;}
  .hero-actions{display:flex;align-items:center;gap:24px;margin-top:34px;}
  .primary-link{display:inline-flex;align-items:center;gap:12px;padding:12px 18px;background:var(--accent);color:var(--accent-ink);font-size:13px;font-weight:650;border-radius:5px;transition:transform .2s ease,background .2s ease;}
  .primary-link:hover{background:#e5f995;transform:translateY(-2px);}
  .primary-link:focus-visible{box-shadow:0 0 0 4px rgba(216,242,107,.2);}
  .text-link{display:inline-flex;align-items:center;gap:8px;font-size:13px;color:var(--text-secondary);transition:color .2s ease;}
  .text-link:hover,.text-link:focus-visible{color:var(--accent);}
  .hero-aside{padding:24px 0 4px 26px;border-left:1px solid var(--border);}
  .aside-label{font-size:11px;color:var(--text-muted);letter-spacing:.12em;margin-bottom:16px;}
  .aside-statement{font-size:17px;line-height:1.75;font-weight:550;color:var(--text);}
  .aside-detail{margin-top:12px;font-size:13px;line-height:1.85;color:var(--text-secondary);}
  .aside-link{display:inline-flex;align-items:center;gap:8px;margin-top:20px;font-size:12px;color:var(--accent);transition:gap .18s ease,color .18s ease;}
  .aside-link:hover,.aside-link:focus-visible{gap:12px;color:#e5f995;}
  .section{padding:76px 0;border-top:1px solid var(--border);}
  .section-heading{display:flex;align-items:end;justify-content:space-between;gap:24px;margin-bottom:30px;}
  .section-kicker{font-size:11px;color:var(--text-muted);letter-spacing:.14em;margin-bottom:9px;}
  h2{font-size:clamp(25px,3vw,32px);font-weight:600;letter-spacing:-.025em;line-height:1.35;}
  .section-desc{max-width:480px;color:var(--text-secondary);font-size:13px;line-height:1.8;}
  .topic-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border-top:1px solid var(--border);border-bottom:1px solid var(--border);}
  .topic{position:relative;display:flex;flex-direction:column;align-items:flex-start;min-height:258px;padding:26px 28px 26px 0;transition:background .2s ease;}
  .topic+.topic{border-left:1px solid var(--border);padding-left:28px;}
  .topic:hover h3,.topic:focus-visible h3{color:var(--accent);}
  .topic:focus-visible{outline-offset:5px;background:rgba(216,242,107,.035);}
  .topic-label{font-size:10px;letter-spacing:.14em;color:var(--accent);margin-bottom:22px;}
  .topic h3{font-size:21px;font-weight:600;line-height:1.5;transition:color .2s ease;}
  .topic p{margin-top:10px;color:var(--text-secondary);font-size:13px;line-height:1.9;}
  .topic-foot{display:flex;justify-content:space-between;align-items:center;width:100%;gap:12px;margin-top:auto;padding-top:24px;font-size:12px;color:var(--text-muted);}
  .topic-arrow{font-size:18px;color:var(--text-secondary);transition:transform .2s ease,color .2s ease;}
  .topic:hover .topic-arrow{transform:translate(3px,-3px);color:var(--accent);}
  .practice{padding:34px 38px;background:linear-gradient(120deg,rgba(216,242,107,.07),rgba(255,255,255,.015) 55%);border:1px solid var(--border);border-radius:8px;}
  .practice-top{display:flex;justify-content:space-between;align-items:flex-start;gap:24px;}
  .practice-title{font-size:20px;font-weight:600;}
  .practice-copy{margin-top:7px;max-width:650px;color:var(--text-secondary);font-size:13px;line-height:1.85;}
  .practice-state{text-align:right;white-space:nowrap;}
  .practice-day{font-family:'Inter',sans-serif;font-size:30px;font-weight:600;line-height:1.1;font-variant-numeric:tabular-nums;}
  .practice-day small{font-size:12px;color:var(--text-muted);font-weight:400;}
  .practice-phase{margin-top:8px;font-size:11px;color:var(--accent);}
  .progress-track{display:flex;gap:4px;margin-top:26px;height:5px;}
  .progress-segment{position:relative;flex:1;background:rgba(255,255,255,.12);border-radius:10px;overflow:hidden;}
  .progress-segment.is-current{background:rgba(216,242,107,.5);}
  .progress-segment.is-current:after{content:'';position:absolute;inset:0;background:var(--accent);border-radius:10px;}
  .practice-bottom{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-top:16px;font-size:11px;color:var(--text-muted);}
  .practice-bottom a{color:var(--text);border-bottom:1px solid rgba(255,255,255,.3);padding-bottom:2px;}
  .practice-bottom a:hover,.practice-bottom a:focus-visible{color:var(--accent);border-color:var(--accent);}
  .article-list{border-top:1px solid var(--border);}
  .article{display:grid;grid-template-columns:120px minmax(0,1fr) 24px;gap:24px;align-items:center;padding:23px 8px;border-bottom:1px solid var(--border);transition:background .2s ease,padding .2s ease;}
  .article:hover,.article:focus-visible{padding-inline:16px;background:rgba(255,255,255,.035);}
  .article-meta{display:flex;flex-direction:column;gap:6px;font-size:11px;color:var(--text-muted);}
  .article-category{color:var(--accent);}
  .article-body h3{font-size:17px;font-weight:550;line-height:1.55;}
  .article-body p{margin-top:5px;color:var(--text-secondary);font-size:12px;line-height:1.75;}
  .article-arrow{font-size:18px;color:var(--text-muted);transition:transform .2s ease,color .2s ease;}
  .article:hover .article-arrow,.article:focus-visible .article-arrow{transform:translate(3px,-3px);color:var(--accent);}
  .all-articles{display:flex;justify-content:flex-end;margin-top:22px;}
  .all-articles a{font-size:12px;color:var(--text-secondary);}
  .all-articles a:hover,.all-articles a:focus-visible{color:var(--accent);text-decoration:underline;text-underline-offset:4px;}
  @media(max-width:850px){
    .hero-grid{grid-template-columns:1fr;gap:42px;}
    .hero-aside{max-width:560px;}
    .topic-grid{grid-template-columns:1fr;}
    .topic{min-height:0;padding:24px 0;}
    .topic+.topic{border-left:0;border-top:1px solid var(--border);padding-left:0;}
    .topic-label{margin-bottom:10px;}
    .topic-foot{padding-top:16px;}
    .section-heading{align-items:flex-start;flex-direction:column;}
  }
  @media(max-width:600px){
    .wrap{width:calc(100% - 40px);}
    .hero{padding:104px 0 52px;}
    h1{font-size:clamp(30px,8vw,38px);line-height:1.25;max-width:600px;}
    .hero-deck{font-size:15px;margin-top:20px;}
    .hero-actions{gap:18px;margin-top:26px;flex-wrap:wrap;}
    .hero-aside{padding:18px 0 0 18px;}
    .section{padding:50px 0;}
    .section-heading{margin-bottom:22px;}
    .practice{padding:22px 18px;}
    .practice-top{flex-direction:column;gap:20px;}
    .practice-state{text-align:left;}
    .practice-bottom{align-items:flex-start;flex-direction:column;gap:10px;}
    .article{grid-template-columns:minmax(0,1fr) 20px;gap:8px 12px;padding:19px 0;}
    .article-meta{grid-column:1;grid-row:1;flex-direction:row;gap:12px;}
    .article-body{grid-column:1;grid-row:2;}
    .article-body h3{font-size:15px;}
    .article-body p{font-size:12px;}
    .article-arrow{grid-column:2;grid-row:1 / span 2;}
  }
  @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.primary-link,.topic-arrow,.article-arrow,.article,.topic{transition:none}}
</style>
</head>
<body>
<Nav active="home" />

<main>
  <header class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow">INDEPENDENT BUSINESS BUILDER</p>
        <h1>把能力，变成自己的商业资产。</h1>
        <p class="hero-deck"><strong>个人商业创造者。</strong>我正在探索一个人如何借助 AI，把经验与专业能力转化为产品、内容和可持续的收入。这里记录真实尝试，也分享过程中形成的方法与判断。</p>
        <div class="hero-actions">
          <a class="primary-link" href="#topics">探索三个方向 <span aria-hidden="true">↘</span></a>
          <a class="text-link" href="/about">了解我 <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <aside class="hero-aside">
        <p class="aside-label">ABOUT THIS SITE</p>
        <p class="aside-statement">不是成功学，也不是工具资讯站。这里关注的是：如何把一个人的能力，变成真实可交付、有人愿意付费的东西。</p>
        <p class="aside-detail">18 年 IT 与产业数字化经验。从底层系统研发，到企业数字化，再到 AI 产品实践。</p>
        <a class="aside-link" href="/about">我的经历与代表成果 <span aria-hidden="true">↗</span></a>
      </aside>
    </div>
  </header>

  <section class="section" id="topics">
    <div class="wrap">
      <div class="section-heading">
        <div><p class="section-kicker">WHAT I EXPLORE</p><h2>三个相互关联的方向</h2></div>
        <p class="section-desc">从商业机会，到产品实现，再到让业务持续运转。不是三条孤立的内容线，而是一件事的三个侧面。</p>
      </div>
      <div class="topic-grid" id="focus">
        {topics.map((topic) => (
          <a class="topic" href={`/topics/${topic.slug}/`}>
            <span class="topic-label">专题 · {String(countByTopic(topic)).padStart(2, '0')} 篇文章</span>
            <h3>{topic.title}</h3>
            <p>{topic.definition}</p>
            <div class="topic-foot"><span>{topic.point}</span><span class="topic-arrow" aria-hidden="true">↗</span></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="practice">
    <div class="wrap">
      <div class="practice">
        <div class="practice-top">
          <div>
            <p class="section-kicker">BUILD IN PUBLIC</p>
            <h2 class="practice-title">正在进行：90 天个人商业实践</h2>
            <p class="practice-copy">从真实需求出发，做出产品，争取第一笔收入，再把有效的交付方式沉淀为系统。过程、结果和复盘都会持续公开。</p>
          </div>
          <div class="practice-state">
            <div class="practice-day">Day <span data-practice-day-number>{String(practice.dayNumber).padStart(2, '0')}</span><small> / 90</small></div>
            <p class="practice-phase" data-practice-state>{currentStage.status} · 第{currentStage.id}阶段</p>
          </div>
        </div>
        <div class="progress-track" aria-label="90 天实践四个阶段">
          {stages.map((stage) => <span class={`progress-segment${stage.status === '当前' ? ' is-current' : ''}`} style={`flex:${stage.days} 1 0`} data-stage={stage.id} data-name={stage.name} data-stage-start={stage.startDate} data-stage-end={stage.endDate}></span>)}
        </div>
        <div class="practice-bottom">
          <span data-practice-period>{practice.period}</span>
          <a href="/90-days">查看实践计划与阶段记录 <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  {latest.length > 0 && (
    <section class="section" id="latest">
      <div class="wrap">
        <div class="section-heading">
          <div><p class="section-kicker">LATEST NOTES</p><h2>最近写下的东西</h2></div>
          <p class="section-desc">记录正在发生的实践、值得追问的问题，以及从真实项目中得到的经验。</p>
        </div>
        <div class="article-list">
          {latest.map((post) => (
            <a class="article" href={post.url}>
              <div class="article-meta"><span class="article-category">{post.category}</span><span>{post.date} · {post.readTime}</span></div>
              <div class="article-body"><h3>{post.title}</h3><p>{post.excerpt}</p></div>
              <span class="article-arrow" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
        <div class="all-articles"><a href="/insights">浏览全部洞察（{posts.length}）→</a></div>
      </div>
    </section>
  )}
</main>

<Footer />
<script is:inline src="/js/practice-clock.js" defer></script>
</body>
</html>
