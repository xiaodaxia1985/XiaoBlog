---
import { getPublishedPosts } from '../lib/insights';
import { getPracticeSnapshot } from '../data/stages.mjs';
import { topics } from '../data/topics.mjs';
import { projectEntries } from '../data/projects.mjs';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../lib/site';

const posts = await getPublishedPosts();
const latest = posts.slice(0, 3);
const practice = getPracticeSnapshot();
const stages = practice.stages;
const currentStage = stages.find((stage) => stage.id === practice.currentStageId) ?? stages[0];
const countByTopic = (topic) => posts.filter((post) => post.topics.includes(topic.title)).length;
const categoryCounts = posts.reduce((acc, post) => { acc[post.category] = (acc[post.category] || 0) + 1; return acc; }, {});
const topCategories = Object.entries(categoryCounts).sort((a, b) => b[1] - a[1]).slice(0, 3);
---

<BaseLayout title={SITE.title} description={SITE.description} canonicalPath="/" active="home">
  <main id="main-content">
    <header class="hero">
      <div class="wrap hero-grid">
        <div>
          <p class="eyebrow">INDEPENDENT BUILDER</p>
          <h1>把经验，变成能交付的东西。</h1>
          <p class="hero-deck"><strong>18 年 IT 与产业数字化</strong>，做过底层系统、集团数字化、产业平台建设。现在用 AI 把专业经验重新组织成可以交付的产品与记录——过程公开，判断写在明处，不承诺结果。</p>
          <div class="hero-actions">
            <a class="primary-link" href="#topics">看三个方向 <span aria-hidden="true">↘</span></a>
            <a class="text-link" href="#practice">读实践记录 <span aria-hidden="true">→</span></a>
            <a class="text-link" href="/about">关于我 <span aria-hidden="true">→</span></a>
          </div>
        </div>
        <aside class="hero-aside">
          <p class="aside-label">NOW / PAST / METHOD</p>
          <ul class="aside-list">
            <li>
              <span class="aside-key">正在做</span>
              <span class="aside-val">90 天实践 · 第 {practice.dayNumber} 天（第{currentStage.id}阶段）</span>
            </li>
            <li>
              <span class="aside-key">做过什么</span>
              <span class="aside-val">底层系统研发 → 集团数字化 → 产业平台建设</span>
            </li>
            <li>
              <span class="aside-key">怎么写</span>
              <span class="aside-val">每篇写清背景、约束与代价，不只留结论</span>
            </li>
          </ul>
          <a class="aside-link" href="/about">完整经历与代表成果 <span aria-hidden="true">↗</span></a>
        </aside>
      </div>
    </header>

    <section class="stat-strip" aria-label="站点概况">
      <div class="wrap stat-grid">
        <div class="stat"><strong>18</strong><span>年 IT 与数字化</span></div>
        <div class="stat"><strong>3</strong><span>个探索方向</span></div>
        <div class="stat"><strong>{posts.length}</strong><span>篇公开记录</span></div>
        <div class="stat"><strong>Day {practice.dayNumber}</strong><span>90 天实践中</span></div>
      </div>
    </section>

    <section class="section" id="topics">
      <div class="wrap">
        <div class="section-heading">
          <div><p class="section-kicker">WHAT I EXPLORE</p><h2>三个相互关联的方向</h2></div>
          <p class="section-desc">不是三条并列的内容线，而是一条链：先看清需求，再把东西做出来，最后把方法沉淀下来。</p>
        </div>
        <div class="topic-grid" id="focus">
          {topics.map((topic) => (
            <a class="topic" href={`/topics/${topic.slug}/`}>
              <span class="topic-label">专题 · {String(countByTopic(topic)).padStart(2, '0')} 篇文章</span>
              <h3>{topic.title}</h3>
              <p class="topic-def">{topic.definition}</p>
              <ul class="topic-issues">
                {topic.issues.map((issue) => <li>{issue}</li>)}
              </ul>
              <div class="topic-foot"><span>{topic.point}</span><span class="topic-arrow" aria-hidden="true">↗</span></div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="site-map">
      <div class="wrap">
        <div class="section-heading">
          <div><p class="section-kicker">SITE OVERVIEW</p><h2>站内有什么</h2></div>
          <p class="section-desc">四个入口，按你现在的目的选：想知道我在关注什么、想看一次完整实践、想读具体记录，还是先看看人。</p>
        </div>
        <div class="site-map-grid">
          <a class="site-map-card" href="#topics">
            <span class="site-map-kicker">DIRECTIONS</span>
            <h3>三个方向</h3>
            <p>需求判断、交付设计、经验沉淀：一条链上的三段，各自有独立的专题页与记录。</p>
            <ul class="site-map-list">
              {topics.map((t) => <li><span>{t.title}</span><em>{String(countByTopic(t)).padStart(2, '0')} 篇</em></li>)}
            </ul>
            <div class="site-map-stat"><strong>{topics.length}</strong><span>个专题方向</span></div>
          </a>
          <a class="site-map-card" href="/90-days">
            <span class="site-map-kicker">PRACTICE</span>
            <h3>90 天实践</h3>
            <p>从真实需求出发做一次完整的事，阶段划分、每日进展与判断失误都记在里面。</p>
            <ul class="site-map-list">
              {stages.map((s) => <li><span>第{s.id}阶段 · {s.name}</span><em>{s.days} 天</em></li>)}
            </ul>
            <div class="site-map-stat"><strong>Day {practice.dayNumber}</strong><span>第{currentStage.id}阶段 · 共 90 天</span></div>
          </a>
          <a class="site-map-card" href="/insights">
            <span class="site-map-kicker">NOTES</span>
            <h3>全部记录</h3>
            <p>按方向与栏目归类，可以筛着读：哪些在讲需求，哪些在讲实现，哪些在讲代价。</p>
            <ul class="site-map-list">
              {topCategories.map(([name, n]) => <li><span>{name}</span><em>{String(n).padStart(2, '0')} 篇</em></li>)}
            </ul>
            <div class="site-map-stat"><strong>{posts.length}</strong><span>篇 · 最近 {latest[0]?.date ?? '—'}</span></div>
          </a>
          <a class="site-map-card" href="/projects">
            <span class="site-map-kicker">PROJECTS</span>
            <h3>项目与经历</h3>
            <p>18 年里做过的底层系统、集团数字化与产业平台，以及各自解决的具体问题。</p>
            <ul class="site-map-list">
              {projectEntries.slice(0, 3).map((p) => <li><span>{p.title}</span><em>{p.category}</em></li>)}
            </ul>
            <div class="site-map-stat"><strong>{projectEntries.length}</strong><span>个代表项目</span></div>
          </a>
        </div>
      </div>
    </section>

    <section class="section" id="practice">
      <div class="wrap">
        <div class="practice">
          <div class="practice-top">
            <div>
              <p class="section-kicker">IN PROGRESS</p>
              <h2 class="practice-title">正在进行：90 天个人成长实践</h2>
              <p class="practice-copy">用 90 天做一次完整的事：从真实需求出发，做出自己的东西，再把有效的方法沉淀下来。过程、结果和判断失误都会持续公开。</p>
            </div>
            <div class="practice-state">
              <div class="practice-day">Day <span data-practice-day-number>{String(practice.dayNumber).padStart(2, '0')}</span><small> / 90</small></div>
              <p class="practice-phase" data-practice-state>{currentStage.status} · 第{currentStage.id}阶段</p>
            </div>
          </div>
          <div class="progress-track" aria-label="90 天实践四个阶段">
            {stages.map((stage) => <span class={`progress-segment${stage.status === '当前' ? ' is-current' : ''}`} style={`flex:${stage.days} 1 0`} data-stage={stage.id} data-name={stage.name} data-stage-start={stage.startDate} data-stage-end={stage.endDate}></span>)}
          </div>
          <div class="practice-bottom">
            <span data-practice-period>{practice.period}</span>
            <a href="/90-days">查看实践计划与阶段记录 <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </div>
    </section>

    {latest.length > 0 && (
      <section class="section" id="latest">
        <div class="wrap">
          <div class="section-heading">
            <div><p class="section-kicker">LATEST NOTES</p><h2>最近写下的东西</h2></div>
            <p class="section-desc">正在发生的实践、值得追问的问题，以及从真实项目里得到的经验。</p>
          </div>
          <div class="article-list">
            {latest.map((post) => (
              <a class="article" href={post.url}>
                <div class="article-meta"><span class="article-category">{post.video ? `${post.category} · 视频` : post.category}</span><span>{post.date} · {post.video ? '视频' : post.readTime}</span></div>
                <div class="article-body"><h3>{post.title}</h3><p>{post.excerpt}</p></div>
                <span class="article-arrow" aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
          <div class="all-articles"><a href="/insights">浏览全部洞察（{posts.length}）→</a></div>
        </div>
      </section>
    )}
  </main>

  <style>
    :root{--max-width:1120px;}
    html{scroll-padding-top:84px;}
    .wrap{width:min(var(--max-width),calc(100% - 64px));margin-inline:auto;}
    .hero{padding:clamp(104px,10vw,136px) 0 56px;border:0;}
    .hero-grid{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(280px,.75fr);gap:clamp(48px,7vw,96px);align-items:start;}
    .eyebrow{display:flex;align-items:center;gap:10px;color:var(--accent);font-size:11px;letter-spacing:.16em;text-transform:uppercase;margin-bottom:24px;}
    .eyebrow:before{content:'';width:22px;height:1px;background:var(--accent);}
    h1{max-width:760px;font-size:clamp(34px,4.6vw,56px);line-height:1.14;font-weight:650;letter-spacing:-.045em;text-wrap:balance;}
    .hero-deck{max-width:650px;margin-top:26px;font-size:clamp(15px,1.6vw,18px);line-height:1.95;color:var(--text-secondary);}
    .hero-deck strong{color:var(--text);font-weight:550;}
    .hero-actions{display:flex;align-items:center;gap:22px;margin-top:34px;flex-wrap:wrap;}
    .primary-link{display:inline-flex;align-items:center;gap:12px;padding:12px 18px;background:var(--accent);color:var(--accent-ink);font-size:13px;font-weight:650;border-radius:5px;transition:transform .2s ease,background .2s ease;}
    .primary-link:hover{background:var(--accent-hover);transform:translateY(-2px);}
    .primary-link:focus-visible{box-shadow:0 0 0 4px rgba(var(--accent-rgb),.2);}
    .text-link{display:inline-flex;align-items:center;gap:8px;font-size:13px;color:var(--text-secondary);transition:color .2s ease;}
    .text-link:hover,.text-link:focus-visible{color:var(--accent);}
    .hero-aside{padding:26px 0 0 26px;border-left:1px solid var(--border);}
    .aside-label{font-size:11px;color:var(--text-muted);letter-spacing:.12em;margin-bottom:18px;}
    .aside-list{display:flex;flex-direction:column;gap:16px;list-style:none;margin:0;padding:0;}
    .aside-key{display:block;font-size:10px;letter-spacing:.1em;color:var(--accent);margin-bottom:5px;}
    .aside-val{display:block;font-size:13px;line-height:1.8;color:var(--text-secondary);}
    .aside-link{display:inline-flex;align-items:center;gap:8px;margin-top:22px;font-size:12px;color:var(--accent);transition:gap .18s ease,color .18s ease;}
    .aside-link:hover,.aside-link:focus-visible{gap:12px;color:var(--accent-hover);}

    .stat-strip{padding:0;}
    .stat-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));border-top:1px solid var(--border);border-bottom:1px solid var(--border);background:var(--overlay-soft);}
    .stat{display:flex;flex-direction:column;gap:4px;padding:22px 24px 22px 0;}
    .stat+.stat{border-left:1px solid var(--border);padding-left:24px;}
    .stat strong{font-family:'Inter',sans-serif;font-size:clamp(20px,2.2vw,26px);font-weight:600;line-height:1.2;font-variant-numeric:tabular-nums;}
    .stat span{font-size:11px;color:var(--text-muted);letter-spacing:.02em;}

    .section{padding:76px 0;border-top:1px solid var(--border);}
    .section-heading{display:flex;align-items:end;justify-content:space-between;gap:24px;margin-bottom:30px;}
    .section-kicker{font-size:11px;color:var(--text-muted);letter-spacing:.14em;margin-bottom:9px;}
    h2{font-size:clamp(25px,3vw,32px);font-weight:600;letter-spacing:-.025em;line-height:1.35;}
    .section-desc{max-width:480px;color:var(--text-secondary);font-size:13px;line-height:1.8;}
    .topic-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border-top:1px solid var(--border);border-bottom:1px solid var(--border);}
    .topic{position:relative;display:flex;flex-direction:column;align-items:flex-start;min-height:298px;padding:26px 28px 26px 0;transition:background .2s ease;}
    .topic+.topic{border-left:1px solid var(--border);padding-left:28px;}
    .topic:hover h3,.topic:focus-visible h3{color:var(--accent);}
    .topic:focus-visible{outline-offset:5px;background:rgba(var(--accent-rgb),.035);}
    .topic-label{font-size:10px;letter-spacing:.14em;color:var(--accent);margin-bottom:22px;}
    .topic h3{font-size:21px;font-weight:600;line-height:1.5;transition:color .2s ease;}
    .topic-def{margin-top:10px;color:var(--text-secondary);font-size:13px;line-height:1.9;}
    .topic-issues{display:flex;flex-wrap:wrap;gap:8px;list-style:none;margin:18px 0 0;padding:0;}
    .topic-issues li{padding:4px 9px;border:1px solid var(--border);border-radius:4px;font-size:11px;color:var(--text-muted);}
    .topic-foot{display:flex;justify-content:space-between;align-items:center;width:100%;gap:12px;margin-top:auto;padding-top:24px;font-size:12px;color:var(--text-muted);}
    .topic-arrow{font-size:18px;color:var(--text-secondary);transition:transform .2s ease,color .2s ease;}
    .topic:hover .topic-arrow{transform:translate(3px,-3px);color:var(--accent);}

    .site-map-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px;}
    .site-map-card{display:flex;flex-direction:column;gap:12px;min-height:252px;padding:24px 22px;border:1px solid var(--border);border-radius:8px;background:var(--surface);transition:border-color .2s ease,background .2s ease,transform .2s ease;}
    .site-map-card:hover,.site-map-card:focus-visible{border-color:rgba(var(--accent-rgb),.5);background:rgba(var(--accent-rgb),.03);transform:translateY(-2px);}
    .site-map-kicker{font-size:10px;letter-spacing:.14em;color:var(--accent);}
    .site-map-card h3{font-size:19px;font-weight:600;line-height:1.45;}
    .site-map-card p{font-size:13px;line-height:1.85;color:var(--text-secondary);max-width:460px;}
    .site-map-list{list-style:none;margin:0;padding:14px 0 0;border-top:1px solid var(--border);display:flex;flex-direction:column;gap:9px;}
    .site-map-list li{display:flex;align-items:baseline;justify-content:space-between;gap:14px;font-size:12.5px;color:var(--text-secondary);}
    .site-map-list li span{min-width:0;}
    .site-map-list em{font-style:normal;font-size:11px;color:var(--text-muted);white-space:nowrap;flex-shrink:0;}
    .site-map-stat{margin-top:auto;padding-top:14px;display:flex;align-items:baseline;flex-wrap:wrap;gap:8px;}
    .site-map-stat strong{font-family:'Inter',sans-serif;font-size:20px;font-weight:600;line-height:1.2;font-variant-numeric:tabular-nums;}
    .site-map-stat span{font-size:11px;color:var(--text-muted);}

    .practice{padding:34px 38px;background:linear-gradient(120deg,rgba(var(--accent-rgb),.07),var(--overlay-soft) 55%);border:1px solid var(--border);border-radius:8px;}
    .practice-top{display:flex;justify-content:space-between;align-items:flex-start;gap:24px;}
    .practice-title{font-size:20px;font-weight:600;}
    .practice-copy{margin-top:7px;max-width:650px;color:var(--text-secondary);font-size:13px;line-height:1.85;}
    .practice-state{text-align:right;white-space:nowrap;}
    .practice-day{font-family:'Inter',sans-serif;font-size:30px;font-weight:600;line-height:1.1;font-variant-numeric:tabular-nums;}
    .practice-day small{font-size:12px;color:var(--text-muted);font-weight:400;}
    .practice-phase{margin-top:8px;font-size:11px;color:var(--accent);}
    .progress-track{display:flex;gap:4px;margin-top:26px;height:5px;}
    .progress-segment{position:relative;flex:1;background:var(--border);border-radius:10px;overflow:hidden;}
    .progress-segment.is-current{background:rgba(var(--accent-rgb),.5);}
    .progress-segment.is-current:after{content:'';position:absolute;inset:0;background:var(--accent);border-radius:10px;}
    .practice-bottom{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-top:16px;font-size:11px;color:var(--text-muted);}
    .practice-bottom a{color:var(--text);border-bottom:1px solid var(--border);padding-bottom:2px;}
    .practice-bottom a:hover,.practice-bottom a:focus-visible{color:var(--accent);border-color:var(--accent);}
    .article-list{border-top:1px solid var(--border);}
    .article{display:grid;grid-template-columns:120px minmax(0,1fr) 24px;gap:24px;align-items:center;padding:23px 8px;border-bottom:1px solid var(--border);transition:background .2s ease,padding .2s ease;}
    .article:hover,.article:focus-visible{padding-inline:16px;background:var(--overlay-hover);}
    .article-meta{display:flex;flex-direction:column;gap:6px;font-size:11px;color:var(--text-muted);}
    .article-category{color:var(--accent);}
    .article-body h3{font-size:17px;font-weight:550;line-height:1.55;}
    .article-body p{margin-top:5px;color:var(--text-secondary);font-size:12px;line-height:1.75;}
    .article-arrow{font-size:18px;color:var(--text-muted);transition:transform .2s ease,color .2s ease;}
    .article:hover .article-arrow,.article:focus-visible .article-arrow{transform:translate(3px,-3px);color:var(--accent);}
    .all-articles{display:flex;justify-content:flex-end;margin-top:22px;}
    .all-articles a{font-size:12px;color:var(--text-secondary);}
    .all-articles a:hover,.all-articles a:focus-visible{color:var(--accent);text-decoration:underline;text-underline-offset:4px;}
    @media(max-width:1060px){
      .hero-grid{grid-template-columns:1fr;gap:38px;}
      .hero-aside{max-width:600px;}
      .stat-grid{grid-template-columns:repeat(2,minmax(0,1fr));}
      .stat:nth-child(3){border-left:0;padding-left:0;}
      .stat:nth-child(3),.stat:nth-child(4){border-top:1px solid var(--border);}
      .topic-grid{grid-template-columns:1fr;}
      .topic{min-height:0;padding:24px 0;border-bottom:0;}
      .topic+.topic{border-left:0;border-top:1px solid var(--border);padding-left:0;}
      .site-map-card p{max-width:none;}
      .topic-label{margin-bottom:10px;}
      .topic-foot{padding-top:16px;}
      .section-heading{align-items:flex-start;flex-direction:column;}
    }
    @media(max-width:720px){
      .wrap{width:calc(100% - 40px);}
      .hero{padding:104px 0 46px;}
      h1{font-size:clamp(30px,8vw,38px);line-height:1.24;max-width:600px;}
      .hero-deck{font-size:15px;margin-top:20px;}
      .hero-actions{gap:18px;margin-top:26px;flex-wrap:wrap;}
      .hero-aside{padding:18px 0 0 18px;}
      .stat{padding:16px 16px 16px 0;}
      .stat+.stat{padding-left:16px;}
      .stat strong{font-size:19px;}
      .section{padding:50px 0;}
      .section-heading{margin-bottom:22px;}
      .practice{padding:22px 18px;}
      .practice-top{flex-direction:column;gap:20px;}
      .practice-state{text-align:left;}
      .practice-bottom{align-items:flex-start;flex-direction:column;gap:10px;}
      .article{grid-template-columns:minmax(0,1fr) 20px;gap:8px 12px;padding:19px 0;}
      .article-meta{grid-column:1;grid-row:1;flex-direction:row;gap:12px;}
      .article-body{grid-column:1;grid-row:2;}
      .article-body h3{font-size:15px;}
      .article-body p{font-size:12px;}
      .article-arrow{grid-column:2;grid-row:1 / span 2;}
      .site-map-grid{grid-template-columns:1fr;}
      .site-map-card{min-height:0;padding:18px 16px;}
    }
    @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.primary-link,.topic-arrow,.article-arrow,.article,.topic{transition:none}}
  </style>

  <script slot="scripts" is:inline src="/js/practice-clock.js" defer></script>
</BaseLayout>
