---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---
<!DOCTYPE html>
<html lang="zh-CN" style="background:#0c0c0c;">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#0c0c0c">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<title>项目 — 个人商业创造者</title>
<meta name="description" content="项目记录：产业数字化、AI 与产品创造的实践档案。">
<link rel="stylesheet" href="/fonts/fonts.css">
<link rel="stylesheet" href="/css/tokens.css">
<style>
  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{font-family:'Noto Sans SC','Inter',-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Microsoft YaHei',sans-serif;font-size:var(--fs-16);line-height:var(--lh-body);background:var(--bg);color:var(--text);overflow-x:hidden;font-feature-settings:"palt" 1;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility;}
  ::selection{background:var(--accent);color:var(--accent-ink);}
  a{text-decoration:none;color:inherit;}
  img{display:block;}
  :focus-visible{outline:2px solid var(--accent);outline-offset:3px;border-radius:2px;}
  ::-webkit-scrollbar{width:8px;}
  ::-webkit-scrollbar-track{background:var(--bg);}
  ::-webkit-scrollbar-thumb{background:#2a2a2a;border-radius:4px;}

  .wrap{max-width:var(--container-w);margin:0 auto;padding:0 var(--gutter);}

  .page-hero{padding:calc(64px + var(--space-56)) 0 var(--space-32);border-bottom:1px solid var(--border);}
  .eyebrow{display:flex;align-items:center;gap:var(--space-8);font-size:var(--fs-12);color:var(--text-muted);margin-bottom:var(--space-16);}
  .eyebrow::before{content:'';width:6px;height:6px;border-radius:50%;background:var(--accent);flex-shrink:0;}
  .page-hero h1{font-size:var(--fs-48);font-weight:600;line-height:1.18;letter-spacing:0;text-wrap:balance;}
  .page-intro{max-width:640px;margin-top:var(--space-12);font-size:var(--fs-16);color:var(--text-secondary);}

  main{padding:var(--space-40) 0 var(--space-56);}
  .project-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--space-24);}
  .project-card{display:flex;flex-direction:column;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);overflow:hidden;transition:background-color .2s ease,border-color .2s ease;}
  .project-card:hover{background:var(--surface-2);border-color:rgba(255,255,255,.2);}
  .project-img{aspect-ratio:16/10;overflow:hidden;background:var(--surface-2);border-bottom:1px solid var(--border);}
  .project-img img{width:100%;height:100%;object-fit:cover;}
  .project-info{display:flex;flex-direction:column;gap:var(--space-8);flex:1;padding:var(--space-24);}
  .project-tag{align-self:flex-start;padding:2px 6px;border:1px solid var(--border);border-radius:4px;font-size:var(--fs-12);color:var(--text-muted);}
  .project-info h2{font-size:var(--fs-20);font-weight:600;line-height:1.4;letter-spacing:0;}
  .project-desc{flex:1;font-size:var(--fs-14);line-height:var(--lh-tight);color:var(--text-secondary);}
  .project-view{display:inline-flex;align-items:center;gap:var(--space-8);margin-top:var(--space-4);font-size:var(--fs-14);color:var(--text);}
  .project-view svg{width:14px;height:14px;stroke-width:1.5;}
  .project-card:hover .project-view{gap:var(--space-12);}

  @media(max-width:968px){
    .project-grid{grid-template-columns:repeat(2,1fr);}
  }
  @media(max-width:768px){
    .page-hero{padding:calc(56px + var(--space-32)) 0 var(--space-24);}
    .page-hero h1{font-size:28px;line-height:1.25;}
    .page-intro{font-size:var(--fs-14);}
    .project-grid{grid-template-columns:1fr;}
    .project-info{padding:var(--space-16);}
  }
</style>
</head>
<body>

<Nav />

<header class="page-hero">
  <div class="wrap">
    <p class="eyebrow">项目</p>
    <h1>项目作品</h1>
    <p class="page-intro">18 年技术架构 + 产业数字化落地的代表性案例。从移动端产品到集团级 ERP，从智慧养殖到冷链物流。</p>
  </div>
</header>

<main class="wrap">
  <div class="project-grid">
    <a href="/project?id=1" class="project-card">
      <div class="project-img"><img src="/images/108a419a1f.jpg" alt="集团级智慧养殖数字化平台" loading="lazy" decoding="async"></div>
      <div class="project-info">
        <span class="project-tag">ERP+MES+WMS</span>
        <h2>集团级智慧养殖数字化平台</h2>
        <p class="project-desc">覆盖5000+头牛，AI大模型实现精准饲喂与健康预警。统筹采购、养殖、销售、风险管控全链条数据打通，消除信息孤岛。</p>
        <span class="project-view">查看详情 <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></span>
      </div>
    </a>
    <a href="/project?id=2" class="project-card">
      <div class="project-img"><img src="/images/59d16544d3.jpg" alt="智慧冷链物流平台" loading="lazy" decoding="async"></div>
      <div class="project-info">
        <span class="project-tag">TMS+WMS+OMS</span>
        <h2>智慧冷链物流平台</h2>
        <p class="project-desc">运输效率+40%、年运输量+300%。接入车辆200+台、冷库50+座，温控可视化、智能调度、异常预警，年降本300万元、增收5000万元。</p>
        <span class="project-view">查看详情 <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></span>
      </div>
    </a>
    <a href="/project?id=3" class="project-card">
      <div class="project-img"><img src="/images/28730ee9fc.jpg" alt="农产品质量安全追溯平台" loading="lazy" decoding="async"></div>
      <div class="project-info">
        <span class="project-tag">QMS+BI</span>
        <h2>农产品质量安全追溯平台</h2>
        <p class="project-desc">OCR识别准确率98.7%，年赋码量120万枚。省级重点监管平台，BI数据可视化大屏。</p>
        <span class="project-view">查看详情 <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></span>
      </div>
    </a>
    <a href="/project?id=4" class="project-card">
      <div class="project-img"><img src="/images/88f4353f46.jpg" alt="智能数据采集与表单系统" loading="lazy" decoding="async"></div>
      <div class="project-info">
        <span class="project-tag">OA+数据中台</span>
        <h2>智能数据采集与表单系统</h2>
        <p class="project-desc">覆盖近10万养殖户，使用成本降低67%。手写数据即时数字化传输，打通数据采集到数据中台全链路。</p>
        <span class="project-view">查看详情 <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></span>
      </div>
    </a>
    <a href="/project?id=5" class="project-card">
      <div class="project-img"><img src="/images/2fedb07948.jpg" alt="精准饲喂智能控制系统" loading="lazy" decoding="async"></div>
      <div class="project-info">
        <span class="project-tag">MES+成本核算</span>
        <h2>精准饲喂智能控制系统</h2>
        <p class="project-desc">面向能繁母猪的精准饲喂系统，饲料转化率提升15%，首创代养/自繁成本分账核算体系，应用于近200个家庭农场。</p>
        <span class="project-view">查看详情 <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></span>
      </div>
    </a>
    <a href="/project?id=6" class="project-card">
      <div class="project-img"><img src="/images/018e5a8e2f.jpg" alt="移动端安全产品" loading="lazy" decoding="async"></div>
      <div class="project-info">
        <span class="project-tag">高并发+安全</span>
        <h2>移动端安全产品</h2>
        <p class="project-desc">移动端安全产品的研发与迭代，负责高并发架构设计与安全防护，产品在多个海外市场上线。</p>
        <span class="project-view">查看详情 <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></span>
      </div>
    </a>
  </div>
</main>

<Footer />
</body>
</html>
