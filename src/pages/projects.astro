    .hero-arc{animation:none;}
    .hero::before{display:none;}
    .hero-watermark{display:none;}
    .hero-arc{box-shadow:none!important;animation:none!important;}
  }
  @media(max-width:480px){
    .projects-grid,.patents-grid{grid-template-columns:1fr;gap:20px;}
