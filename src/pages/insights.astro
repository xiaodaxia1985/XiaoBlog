---
import { insights } from '../data/insights.mjs';
---
<!DOCTYPE html>
<html lang="zh-CN" style="background:#0A0A0A;">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#0A0A0A">
<title>洞察专栏 — 杨逍</title>
<meta name="description" content="杨逍的行业洞察专栏：产业数字化、AI 落地、企业软件、技术架构、业务创新与经营价值。">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Noto+Sans+SC:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#0A0A0A;
    --bg-card:#161616;
    --bg-card-hover:#1E1E1E;
    --bg-input:#0F0F0F;
    --accent:#39FF14;
    --accent-rgb:57,255,20;
    --accent-dim:rgba(57,255,20,.15);
    --accent-dark:#1a8a00;
    --text:#FFFFFF;
    --text-secondary:#A1A1AA;
    --text-muted:#71717A;
    --border:rgba(255,255,255,.08);
    --radius:16px;
    --radius-sm:10px;
    --max-width:1200px;
  }
  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    font-family:'Noto Sans SC','Inter',-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Microsoft YaHei',sans-serif;
    background:var(--bg);color:var(--text);line-height:1.75;overflow-x:hidden;
    -webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility;
  }
  ::selection{background:var(--accent);color:#000;}
  a{text-decoration:none;color:inherit;}
  img{display:block;}
  ::-webkit-scrollbar{width:8px;}
  ::-webkit-scrollbar-track{background:var(--bg);}
  ::-webkit-scrollbar-thumb{background:#333;border-radius:4px;}

  /* ===== Navigation ===== */
  .nav{
    position:fixed;top:0;left:0;right:0;z-index:1000;padding:20px 40px;
    display:flex;align-items:center;justify-content:space-between;
    background:rgba(10,10,10,.85);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);
    border-bottom:1px solid var(--border);transition:padding .3s ease,background .3s ease;
  }
  .nav.scrolled{padding:14px 40px;background:rgba(10,10,10,.85);}
  .nav-logo{font-weight:800;font-size:20px;letter-spacing:-.5px;}
  .nav-logo span{color:var(--accent);}
  .nav-links{display:flex;gap:36px;list-style:none;}
  .nav-links a{font-size:14px;font-weight:500;color:var(--text-secondary);position:relative;transition:color .3s ease;letter-spacing:.08em;}
  .nav-links a::after{content:'';position:absolute;bottom:-4px;left:0;width:0;height:2px;background:var(--accent);transition:width .3s ease;border-radius:2px;}
  .nav-links a:hover,.nav-links a.active{color:var(--accent);}
  .nav-links a.active::after,.nav-links a:hover::after{width:100%;}
  .nav-toggle{display:none;flex-direction:column;gap:5px;cursor:pointer;background:none;border:none;padding:4px;}
  .nav-toggle span{width:24px;height:2px;background:var(--text);border-radius:2px;transition:.3s;}

  section{position:relative;padding:100px 40px;}
  .section-container{max-width:var(--max-width);margin:0 auto;position:relative;z-index:1;}
  .section-header{margin-bottom:40px;display:flex;align-items:center;gap:16px;}
  .section-header .line{width:40px;height:2px;background:var(--accent);border-radius:2px;box-shadow:0 0 8px var(--accent);}
  .section-title{font-size:clamp(28px,4vw,46px);font-weight:800;letter-spacing:.12em;}
  .section-title .green{color:var(--accent);}
  .insight-intro{font-size:15px;color:var(--text-secondary);margin-bottom:48px;max-width:720px;line-height:1.9;letter-spacing:.01em;}
  .insight-intro span{color:var(--accent);font-weight:600;}

  /* ===== Cards — 与项目列表完全一致 ===== */
  .projects-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;}
  .project-card{
    background:#f5f5f5;border:1px solid rgba(0,0,0,.06);border-radius:var(--radius);
    overflow:hidden;transition:all .3s ease;cursor:pointer;display:block;
    box-shadow:0 4px 20px rgba(0,0,0,.15);
  }
  .project-card:hover{transform:translateY(-8px);box-shadow:0 16px 50px rgba(0,0,0,.3);}
  .project-img{width:100%;aspect-ratio:16/10;overflow:hidden;position:relative;background:#1a1a1a;}
  .project-img img{width:100%;height:100%;object-fit:cover;transition:transform .4s ease;}
  .project-card:hover .project-img img{transform:scale(1.08);}
  .project-img::after{content:'';position:absolute;top:0;left:0;right:0;bottom:0;background:linear-gradient(180deg,transparent 60%,rgba(0,0,0,.5));pointer-events:none;}
  .project-info{padding:24px;display:flex;flex-direction:column;gap:10px;}
  .project-info h3{font-size:17px;font-weight:700;color:#111;letter-spacing:.03em;line-height:1.5;}
  .project-desc{font-size:13px;color:#666;line-height:1.7;letter-spacing:.02em;}
  .project-tag{display:inline-block;padding:4px 12px;border-radius:6px;background:rgba(var(--accent-rgb),.12);color:var(--accent-dark);font-size:11px;font-weight:600;letter-spacing:.04em;width:fit-content;}
  .project-date{font-family:'Inter',sans-serif;font-size:11px;color:#999;letter-spacing:.06em;}
  .project-view{display:flex;align-items:center;gap:6px;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Microsoft YaHei","Hiragino Sans GB",sans-serif;font-size:13px;font-weight:600;color:var(--accent-dark);transition:gap .3s ease;letter-spacing:.05em;margin-top:4px;}
  .project-card:hover .project-view{gap:10px;}
  .project-view svg{width:14px;height:14px;}

  .footer{text-align:center;padding:40px;border-top:1px solid var(--border);font-size:13px;color:var(--text-muted);}
  .fade-up{opacity:0;transform:translateY(24px);transition:opacity .7s ease,transform .7s ease;}
  .fade-up.visible{opacity:1;transform:none;}

  @media(max-width:968px){
    .projects-grid{grid-template-columns:repeat(2,1fr);}
  }
  @media(max-width:768px){
    .nav{padding:16px 24px;}
    .nav.scrolled{padding:12px 24px;}
    .nav-links{position:fixed;top:0;right:-100%;width:70%;height:100vh;background:rgba(10,10,10,.98);flex-direction:column;justify-content:center;align-items:center;gap:32px;transition:right .4s ease;border-left:1px solid var(--border);}
    .nav-links.open{right:0;}
    .nav-links a{font-size:20px;}
    .nav-toggle{display:flex;z-index:1001;}
    .nav-toggle.open span:nth-child(1){transform:rotate(45deg) translate(5px,5px);}
    .nav-toggle.open span:nth-child(2){opacity:0;}
    .nav-toggle.open span:nth-child(3){transform:rotate(-45deg) translate(5px,-5px);}
    section{padding:80px 20px;}
    .section-title{letter-spacing:.08em;}
    .projects-grid{grid-template-columns:repeat(2,1fr);gap:16px;}
    .project-img{aspect-ratio:16/9;}
    .project-info{padding:14px 12px;}
    .project-info h3{font-size:13px;-webkit-line-clamp:2;overflow:hidden;text-overflow:ellipsis;display:-webkit-box;-webkit-box-orient:vertical;}
    .project-desc{font-size:11px;-webkit-line-clamp:2;display:-webkit-box;-webkit-box-orient:vertical;overflow:hidden;}
    .project-tag{font-size:10px;padding:2px 8px;}
    .project-view{font-size:11px;}
    .project-date{font-size:10px;}
    .nav{background:rgba(10,10,10,.95);backdrop-filter:none;-webkit-backdrop-filter:none;}
  }
  @media(max-width:480px){
    .projects-grid{grid-template-columns:1fr;gap:20px;}
    .project-info{padding:18px 16px;}
    .project-info h3{font-size:15px;-webkit-line-clamp:unset;display:block;overflow:visible;}
    .project-desc{font-size:12.5px;-webkit-line-clamp:unset;display:block;overflow:visible;}
    .project-tag{font-size:11px;padding:3px 10px;}
    .project-view{font-size:12px;}
    section{padding:72px 18px;}
    .insight-intro{font-size:14px;margin-bottom:32px;}
  }
</style>
</head>
<body>

<!-- ===== Navigation ===== -->
<nav class="nav" id="nav">
  <a href="/XiaoBlog/#hero" class="nav-logo">杨<span>.</span>逍</a>
  <ul class="nav-links" id="navLinks">
    <li><a href="/XiaoBlog/#hero">首页</a></li>
    <li><a href="/XiaoBlog/insights" class="active">洞察</a></li>
    <li><a href="/XiaoBlog/projects">项目</a></li>
    <li><a href="/XiaoBlog/about">履历</a></li>
    <li><a href="/XiaoBlog/#contact">联系</a></li>
  </ul>
  <button class="nav-toggle" id="navToggle" aria-label="菜单"><span></span><span></span><span></span></button>
</nav>

<!-- ===== Insights ===== -->
<section id="insights" style="background:#0a0a0a;padding-top:180px;">
  <div class="section-container">
    <div class="section-header fade-up">
      <span class="line"></span>
      <h2 class="section-title">洞察<span class="green">专栏</span></h2>
    </div>
    <p class="insight-intro fade-up">长期更新的独立专栏 —— 产业数字化、AI 落地、企业软件、技术架构、业务创新与经营价值。这里写下我从 18 年实战中沉淀的判断与案例，共 <span>{insights.length} 篇</span>。</p>
    <div class="projects-grid">
      {insights.map((post) => (
        <a href={`/XiaoBlog/insight?id=${post.id}`} class="project-card fade-up">
          <div class="project-img">
            <img src={post.image} alt={post.title} loading="lazy" decoding="async">
          </div>
          <div class="project-info">
            <span class="project-tag">{post.category}</span>
            <h3>{post.title}</h3>
            <p class="project-desc">{post.excerpt}</p>
            <span class="project-date">{post.date} · {post.readTime}</span>
            <span class="project-view">阅读全文 <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<footer class="footer"><p>© 2026 杨逍. 保留所有权利.</p></footer>

<script>
  const nav = document.getElementById('nav');
  const navLinksContainer = document.getElementById('navLinks');
  const navToggle = document.getElementById('navToggle');
  const navLinks = document.querySelectorAll('.nav-links a');
  window.addEventListener('scroll', () => {
    if (nav) nav.classList.toggle('scrolled', window.scrollY > 50);
  });
  if (navToggle && navLinksContainer) {
    navToggle.addEventListener('click', () => {
      navLinksContainer.classList.toggle('open');
      navToggle.classList.toggle('open');
    });
    navLinks.forEach((link) => {
      link.addEventListener('click', () => {
        navLinksContainer.classList.remove('open');
        navToggle.classList.remove('open');
      });
    });
  }
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.12 });
  document.querySelectorAll('.fade-up').forEach((el) => observer.observe(el));
</script>
</body>
</html>
