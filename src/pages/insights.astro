---
import { getPublishedPosts } from '../lib/insights';
import { CATEGORIES as categories, TOPICS as topics } from '../lib/taxonomy';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const posts = await getPublishedPosts();
const countOf = (c) => posts.filter((p) => p.category === c).length;
const topicCountOf = (t) => posts.filter((p) => p.topic === t).length;
import { ClientRouter } from 'astro:transitions';
---
<!DOCTYPE html>
<html lang="zh-CN" style="background:#0c0c0c;">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#0c0c0c">
<meta name="color-scheme" content="dark">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<title>洞察 — 个人商业创造者</title>
<meta name="description" content="记录从信息消费者到商业创造者的真实过程：90 天实战、产业数字化、AI 与产品、技术与管理。">
<link rel="canonical" href={new URL('/insights/', Astro.site ?? 'https://xiaomaker.top').toString()}>
<meta property="og:type" content="website">
<meta property="og:locale" content="zh_CN">
<meta property="og:title" content="洞察 — 个人商业创造者">
<meta property="og:description" content="记录从信息消费者到商业创造者的真实过程：90 天实战、产业数字化、AI 与产品、技术与管理。">
<meta property="og:url" content={new URL('/insights/', Astro.site ?? 'https://xiaomaker.top').toString()}>
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="洞察 — 个人商业创造者">
<meta name="twitter:description" content="记录从信息消费者到商业创造者的真实过程：90 天实战、产业数字化、AI 与产品、技术与管理。">
<link rel="stylesheet" href="/fonts/fonts.css">
<link rel="stylesheet" href="/css/tokens.css">
<script is:inline data-astro-rerun>document.documentElement.classList.add('js');</script>
<script is:inline src="/js/site-shell.js" defer></script>
<style>
  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    font-family:'Noto Sans SC','Inter',-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Microsoft YaHei',sans-serif;
    font-size:var(--fs-16);line-height:var(--lh-body);background:var(--bg);color:var(--text);
    overflow-x:hidden;font-feature-settings:"palt" 1;
    -webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility;
  }
  ::selection{background:var(--accent);color:var(--accent-ink);}
  a{text-decoration:none;color:inherit;}
  ul,ol{list-style:none;}
  :focus-visible{outline:2px solid var(--accent);outline-offset:3px;border-radius:2px;}
  ::-webkit-scrollbar{width:8px;}
  ::-webkit-scrollbar-track{background:var(--bg);}
  ::-webkit-scrollbar-thumb{background:#2a2a2a;border-radius:4px;}

  .wrap{max-width:var(--container-w);margin:0 auto;padding:0 var(--gutter);}

  /* ===== 页头 ===== */
  .page-hero{padding:calc(64px + var(--space-56)) 0 var(--space-32);border-bottom:1px solid var(--border);}
  .eyebrow{display:flex;align-items:center;gap:var(--space-8);font-size:var(--fs-12);color:var(--text-muted);margin-bottom:var(--space-16);}
  .eyebrow::before{content:'';width:6px;height:6px;border-radius:50%;background:var(--accent);flex-shrink:0;}
  .page-hero h1{font-size:var(--fs-48);font-weight:600;line-height:1.18;letter-spacing:0;text-wrap:balance;}
  .page-intro{margin-top:var(--space-12);max-width:640px;font-size:var(--fs-16);color:var(--text-secondary);}
  .page-intro .count{color:var(--text-muted);}

  /* ===== 筛选 ===== */
  main{padding:var(--space-32) 0 var(--space-56);}
  .filter-stack{display:flex;flex-direction:column;gap:var(--space-12);margin-bottom:var(--space-32);}
  .filter-row{display:flex;align-items:center;gap:var(--space-8);}
  .filter-scroll{display:block;position:relative;flex:1 1 auto;min-width:0;}
  .filter-bar{display:flex;flex-wrap:wrap;align-items:center;gap:var(--space-8);}
  .filter-label{min-width:2.5em;margin-right:var(--space-4);font-size:var(--fs-12);color:var(--text-muted);letter-spacing:0;}
  .filter-chip{display:inline-flex;align-items:center;gap:var(--space-8);padding:var(--space-4) var(--space-12);border:1px solid var(--border);border-radius:var(--radius-sm);font-size:var(--fs-14);color:var(--text-secondary);transition:color .2s ease,border-color .2s ease,background-color .2s ease;}
  .filter-chip:hover,.filter-chip:focus-visible{color:var(--text);border-color:rgba(216,242,107,.55);background:rgba(216,242,107,.045);}
  .filter-chip.active{color:var(--accent);border-color:rgba(216,242,107,.45);background:rgba(216,242,107,.08);box-shadow:inset 0 0 0 1px rgba(216,242,107,.08);}
  .filter-chip span{font-family:'Inter',sans-serif;font-variant-numeric:tabular-nums;font-size:var(--fs-12);color:var(--text-muted);}
  .filter-chip.active span{color:rgba(216,242,107,.7);}

  /* ===== 文章列表 ===== */
  .post-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--space-24);}
  .post-card{display:flex;flex-direction:column;gap:var(--space-8);min-height:232px;padding:var(--space-24);background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);transition:background-color .2s ease,border-color .2s ease;}
  .post-card:hover,.post-card:focus-visible{background:var(--surface-2);border-color:rgba(216,242,107,.42);transform:translateY(-2px);}
  .post-tag{align-self:flex-start;padding:2px 6px;border:1px solid var(--border);border-radius:4px;font-size:var(--fs-12);color:var(--text-muted);}
  .post-card h2{font-size:var(--fs-20);font-weight:600;line-height:1.4;letter-spacing:0;}
  .post-excerpt{flex:1;font-size:var(--fs-14);line-height:var(--lh-tight);color:var(--text-secondary);}
  .post-meta{font-family:'Inter',sans-serif;font-variant-numeric:tabular-nums;font-size:var(--fs-12);color:var(--text-muted);}
  .post-view{margin-top:auto;padding-top:var(--space-4);display:inline-flex;align-items:center;gap:var(--space-8);font-size:var(--fs-14);color:var(--text);}
  .post-card:hover .post-view,.post-card:focus-visible .post-view{gap:var(--space-12);color:var(--accent);}

  /* ===== 空状态 ===== */
  .empty{padding:var(--space-56) var(--space-24);text-align:center;border:1px dashed rgba(255,255,255,.14);border-radius:var(--radius);}
  .empty h2{font-size:var(--fs-20);font-weight:600;line-height:1.4;margin-bottom:var(--space-8);}
  .empty p{font-size:var(--fs-14);color:var(--text-secondary);}
  .empty .empty-filters{font-size:var(--fs-12);color:var(--text-muted);margin-bottom:var(--space-4);}
  .empty .empty-links{display:flex;flex-wrap:wrap;justify-content:center;gap:var(--space-12);margin-top:var(--space-24);}
  .empty .empty-links a{display:inline-flex;align-items:center;gap:var(--space-8);padding:var(--space-8) var(--space-16);border:1px solid var(--border);border-radius:var(--radius-sm);font-size:var(--fs-14);color:var(--text-secondary);transition:color .2s ease,border-color .2s ease;}
  .empty .empty-links a:hover,.empty .empty-links a:focus-visible{color:var(--accent);border-color:rgba(216,242,107,.55);background:rgba(216,242,107,.04);}

  @media(max-width:968px){
    .post-grid{grid-template-columns:repeat(2,1fr);}
  }
  @media(max-width:768px){
    .page-hero{padding:calc(56px + var(--space-32)) 0 var(--space-24);}
    .page-hero h1{font-size:30px;line-height:1.25;}
    .page-intro{font-size:var(--fs-14);}
    /* 筛选：每组固定一行、横向滑动；48px 可点高度 */
    .filter-stack{gap:10px;margin-bottom:var(--space-24);}
    .filter-row{flex-wrap:nowrap;gap:var(--space-8);height:44px;}
    .filter-label{flex:0 0 auto;min-width:auto;margin-right:0;font-size:12px;}
    .filter-scroll{position:relative;height:44px;overflow-x:auto;overflow-y:hidden;-webkit-overflow-scrolling:touch;scrollbar-width:none;-webkit-mask-image:linear-gradient(to right,#000 0,#000 calc(100% - 26px),transparent 100%);mask-image:linear-gradient(to right,#000 0,#000 calc(100% - 26px),transparent 100%);}
    .filter-scroll::-webkit-scrollbar{display:none;}
    .filter-scroll.is-end{-webkit-mask-image:none;mask-image:none;}
    .filter-bar{flex-wrap:nowrap;width:max-content;min-width:100%;height:44px;gap:var(--space-8);}
    .filter-chip{flex:0 0 auto;height:44px;padding:0 var(--space-12);white-space:nowrap;}
    .filter-chip.active{font-weight:500;}
    .post-grid{grid-template-columns:1fr;}
    .post-card{min-height:0;padding:var(--space-16);}
  }
</style>
  <ClientRouter fallback="swap" />
</head>
<body>

<Nav active="insights" />

<header class="page-hero">
  <div class="wrap">
    <p class="eyebrow">洞察</p>
    <h1>我的洞察</h1>
    <p class="page-intro">这里记录我的判断与实践：产业数字化、AI 与产品、技术与管理，以及正在进行的个人商业创造过程。{posts.length > 0 && (
      <span class="count">共 <span id="insightCount">{posts.length}</span> 篇。</span>
    )}</p>
  </div>
</header>

<main class="wrap">
  <div class="filter-stack">
    <div class="filter-row">
      <span class="filter-label">分类</span>
      <div class="filter-scroll" tabindex="0" role="group" aria-label="按分类筛选，可横向滚动" data-filter-scroll>
        <div class="filter-bar">
          <a class="filter-chip active" href="/insights/" data-category-filter="all">全部{posts.length > 0 && <span>{posts.length}</span>}</a>
          {categories.map((c) => (
            <a class="filter-chip" href={`/insights/?category=${encodeURIComponent(c)}`} data-category-filter={c}>{c}{countOf(c) > 0 && <span>{countOf(c)}</span>}</a>
          ))}
        </div>
      </div>
    </div>
    <div class="filter-row">
      <span class="filter-label">方向</span>
      <div class="filter-scroll" tabindex="0" role="group" aria-label="按方向筛选，可横向滚动" data-filter-scroll>
        <div class="filter-bar">
          <a class="filter-chip active" href="/insights/" data-topic-filter="all">全部{posts.length > 0 && <span>{posts.length}</span>}</a>
          {topics.map((t) => (
            <a class="filter-chip" href={`/insights/?topic=${encodeURIComponent(t)}`} data-topic-filter={t}>{t}{topicCountOf(t) > 0 && <span>{topicCountOf(t)}</span>}</a>
          ))}
        </div>
      </div>
    </div>
  </div>

  <div class="post-grid" id="insightGrid">
    {posts.map((post) => (
      <a href={post.url} class="post-card" data-category={post.category} data-topic={post.topic}>
        <span class="post-tag">{post.category}</span>
        <h2>{post.title}</h2>
        <p class="post-excerpt">{post.excerpt}</p>
        <span class="post-meta">{post.date} · {post.readTime}</span>
        <span class="post-view">阅读全文<span aria-hidden="true">→</span></span>
      </a>
    ))}
  </div>

  {posts.length === 0 && (
    <div class="empty">
      <h2>第一批文章正在整理</h2>
      <p>可以先从三个方向了解我在做什么。</p>
      <div class="empty-links">
        <a href="/topics/personal-business">个人商业创造<span aria-hidden="true">→</span></a>
        <a href="/topics/ai-product">AI与产品创造<span aria-hidden="true">→</span></a>
        <a href="/topics/business-system">个人商业系统<span aria-hidden="true">→</span></a>
      </div>
    </div>
  )}

  <div class="empty" id="insightEmpty" hidden>
    <h2>没有符合条件的文章</h2>
    <p class="empty-filters" id="emptyFilters"></p>
    <p>可以清空其中一个筛选条件，或等实践更新后再来看。</p>
  </div>
</main>

<Footer />

<script is:inline data-astro-rerun>
(function () {
  // 双维筛选：category × topic，query 参数驱动，静态页面内过滤
  const categoryChips = [...document.querySelectorAll('[data-category-filter]')];
  const topicChips = [...document.querySelectorAll('[data-topic-filter]')];
  const cards = [...document.querySelectorAll('#insightGrid .post-card')];
  const countEl = document.getElementById('insightCount');
  const emptyEl = document.getElementById('insightEmpty');
  const emptyFilters = document.getElementById('emptyFilters');

  const initial = new URLSearchParams(location.search);
  let currentCategory = initial.get('category') || 'all';
  let currentTopic = initial.get('topic') || 'all';

  function applyFilter(cat, topic) {
    const c = cat && cat !== 'all' ? cat : 'all';
    const t = topic && topic !== 'all' ? topic : 'all';
    let shown = 0;
    cards.forEach((card) => {
      const hit = (c === 'all' || card.dataset.category === c) && (t === 'all' || card.dataset.topic === t);
      card.style.display = hit ? '' : 'none';
      if (hit) shown++;
    });
    categoryChips.forEach((chip) => { const active = chip.dataset.categoryFilter === c; chip.classList.toggle('active', active); if (active) chip.setAttribute('aria-current', 'true'); else chip.removeAttribute('aria-current'); });
    topicChips.forEach((chip) => { const active = chip.dataset.topicFilter === t; chip.classList.toggle('active', active); if (active) chip.setAttribute('aria-current', 'true'); else chip.removeAttribute('aria-current'); });
    if (countEl) {
      countEl.textContent = shown;
      const countWrap = countEl.closest('.count');
      if (countWrap) countWrap.hidden = shown === 0; // 不出现「0 篇」，与空结果提示并存
    }
    if (emptyEl) {
      emptyEl.hidden = shown > 0 || cards.length === 0;
      if (emptyFilters) {
        const parts = [];
        if (c !== 'all') parts.push(c);
        if (t !== 'all') parts.push(t);
        emptyFilters.textContent = parts.length ? `当前筛选：${parts.join(' · ')}` : '';
      }
    }
  }

  function syncUrl() {
    const url = new URL(location.href);
    if (currentCategory === 'all') url.searchParams.delete('category');
    else url.searchParams.set('category', currentCategory);
    if (currentTopic === 'all') url.searchParams.delete('topic');
    else url.searchParams.set('topic', currentTopic);
    history.replaceState(null, '', url);
  }

  applyFilter(currentCategory, currentTopic);

  // 横向筛选条：选中项居中、两端渐隐、方向键可滚、可聚焦
  const scrollers = [...document.querySelectorAll('[data-filter-scroll]')];
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');

  function centerChip(chip, smooth) {
    const box = chip.closest('[data-filter-scroll]');
    if (!box || box.scrollWidth <= box.clientWidth + 1) return;
    const left = chip.offsetLeft - (box.clientWidth - chip.offsetWidth) / 2;
    box.scrollTo({ left: Math.max(0, left), behavior: smooth && !reduceMotion.matches ? 'smooth' : 'auto' });
  }

  function syncEdges(box) {
    box.classList.toggle('is-end', box.scrollLeft + box.clientWidth >= box.scrollWidth - 2);
  }

  scrollers.forEach((box) => {
    syncEdges(box);
    box.addEventListener('scroll', () => syncEdges(box), { passive: true });
    box.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
      event.preventDefault();
      const step = Math.round(box.clientWidth * 0.6) * (event.key === 'ArrowRight' ? 1 : -1);
      box.scrollBy({ left: step, behavior: reduceMotion.matches ? 'auto' : 'smooth' });
    });
    box.querySelectorAll('.filter-chip').forEach((chip) => {
      chip.addEventListener('focus', () => centerChip(chip, false));
    });
  });

  categoryChips.forEach((chip) => {
    chip.addEventListener('click', (e) => {
      // 保留 Ctrl/Cmd/Shift/Alt + 点击的浏览器原生新标签页/窗口行为。
      if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      e.preventDefault();
      currentCategory = chip.dataset.categoryFilter;
      applyFilter(currentCategory, currentTopic);
      syncUrl();
      centerChip(chip, true);
    });
  });

  topicChips.forEach((chip) => {
    chip.addEventListener('click', (e) => {
      // 保留 Ctrl/Cmd/Shift/Alt + 点击的浏览器原生新标签页/窗口行为。
      if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      e.preventDefault();
      currentTopic = chip.dataset.topicFilter;
      applyFilter(currentCategory, currentTopic);
      syncUrl();
      centerChip(chip, true);
    });
  });

  // 带 query 打开时，让已选中的 chip 直接可见
  [...document.querySelectorAll('.filter-chip.active')].forEach((chip) => centerChip(chip, false));

})();
</script>
</body>
</html>
