---
import { publishedInsights } from '../data/insights.mjs';

const posts = publishedInsights;
const categories = ['90天实战', '产业数字化', 'AI 与产品', '技术与管理'];
const topics = ['个人商业创造', 'AI与产品创造', '个人商业系统'];
const countOf = (c) => posts.filter((p) => p.category === c).length;
const topicCountOf = (t) => posts.filter((p) => p.topic === t).length;
---
<!DOCTYPE html>
<html lang="zh-CN" style="background:#0A0A0A;">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#0A0A0A">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<title>洞察 — 个人商业创造者</title>
<meta name="description" content="记录从信息消费者到商业创造者的真实过程：90 天实战、产业数字化、AI 与产品、技术与管理。">
<link rel="stylesheet" href="/fonts/fonts.css">
<link rel="stylesheet" href="/css/tokens.css">
<style>
  :root{
    --bg:#0A0A0A;
    --bg-card:#161616;
    --bg-card-hover:#1E1E1E;
    --bg-input:#0F0F0F;
    --accent:#39FF14;
    --accent-rgb:57,255,20;
    --accent-dim:rgba(57,255,20,.15);
    --accent-dark:#1a8a00;
    --text:#FFFFFF;
    --text-secondary:#A1A1AA;
    --text-muted:#8E8E97;
    --border:rgba(255,255,255,.08);
    --radius:16px;
    --radius-sm:10px;
    --max-width:1200px;
  }
  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    font-family:'Noto Sans SC','Inter',-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Microsoft YaHei',sans-serif;
    background:var(--bg);color:var(--text);line-height:1.75;overflow-x:hidden;
    -webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility;
  }
  ::selection{background:var(--accent);color:#000;}
  a{text-decoration:none;color:inherit;}
  img{display:block;}
  ::-webkit-scrollbar{width:8px;}
  ::-webkit-scrollbar-track{background:var(--bg);}
  ::-webkit-scrollbar-thumb{background:#333;border-radius:4px;}

  /* ===== Navigation ===== */
  .nav{
    position:fixed;top:0;left:0;right:0;z-index:1000;padding:var(--space-16) var(--gutter);
    display:flex;align-items:center;justify-content:space-between;
    background:rgba(10,10,10,.85);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);
    border-bottom:1px solid var(--border);transition:padding .3s ease,background .3s ease;
  }
  .nav.scrolled{padding:var(--space-12) var(--gutter);background:rgba(10,10,10,.85);}
  .nav-inner{max-width:var(--container-w);margin:0 auto;width:100%;display:flex;align-items:center;justify-content:space-between;gap:var(--space-24);}
  .nav-logo{font-weight:800;font-size:20px;letter-spacing:-.5px;}
  .nav-logo span{color:var(--accent);}
  .nav-links{display:flex;gap:36px;list-style:none;}
  .nav-links a{font-size:14px;font-weight:500;color:var(--text-secondary);position:relative;transition:color .3s ease;letter-spacing:.08em;}
  .nav-links a::after{content:'';position:absolute;bottom:-4px;left:0;width:0;height:2px;background:var(--accent);transition:width .3s ease;border-radius:2px;}
  .nav-links a:hover,.nav-links a.active{color:var(--accent);}
  .nav-links a.active::after,.nav-links a:hover::after{width:100%;}
  .nav-toggle{display:none;flex-direction:column;gap:5px;cursor:pointer;background:none;border:none;padding:4px;}
  .nav-toggle span{width:24px;height:2px;background:var(--text);border-radius:2px;transition:.3s;}

  section{position:relative;padding:var(--section-y) var(--gutter);}
  .section-container{max-width:var(--container-w);margin:0 auto;position:relative;z-index:1;}
  .section-header{margin-bottom:var(--space-16);display:flex;align-items:center;gap:var(--space-16);}
  .section-header .line{width:40px;height:2px;background:var(--accent);border-radius:2px;box-shadow:0 0 8px var(--accent);}
  .section-title{font-size:var(--fs-28);font-weight:800;letter-spacing:.08em;line-height:1.3;}
  .section-title .green{color:var(--accent);}
  .insight-intro{font-size:var(--fs-14);color:var(--text-secondary);margin-bottom:var(--space-24);max-width:680px;line-height:var(--lh-body);letter-spacing:.01em;}
  .insight-intro span{color:var(--accent);font-weight:600;}

  /* ===== Cards — 与项目列表完全一致 ===== */
  .projects-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;}
  .project-card{
    background:#f5f5f5;border:1px solid rgba(0,0,0,.06);border-radius:var(--radius);
    overflow:hidden;transition:all .3s ease;cursor:pointer;display:flex;flex-direction:column;
    box-shadow:0 4px 20px rgba(0,0,0,.15);
  }
  .project-card:hover{transform:translateY(-8px);box-shadow:0 16px 50px rgba(0,0,0,.3);}
  .project-img{width:100%;aspect-ratio:16/10;overflow:hidden;position:relative;background:#1a1a1a;}
  .project-img img{width:100%;height:100%;object-fit:cover;transition:transform .4s ease;}
  .project-card:hover .project-img img{transform:scale(1.08);}
  .project-img::after{content:'';position:absolute;top:0;left:0;right:0;bottom:0;background:linear-gradient(180deg,transparent 60%,rgba(0,0,0,.5));pointer-events:none;}
  .project-info{padding:var(--space-24);display:flex;flex-direction:column;gap:var(--space-8);flex:1;}
  .project-info h3{font-size:var(--fs-20);font-weight:700;color:#111;letter-spacing:.03em;line-height:1.4;}
  .project-desc{font-size:var(--fs-14);color:#666;line-height:var(--lh-tight);letter-spacing:.02em;flex:1;}
  .project-tag{display:inline-block;padding:var(--space-4) var(--space-12);border-radius:6px;background:rgba(var(--accent-rgb),.12);color:#0f7a00;font-size:var(--fs-12);font-weight:600;letter-spacing:.04em;width:fit-content;}
  .project-date{font-family:'Inter',sans-serif;font-size:var(--fs-12);color:#666;letter-spacing:.06em;}
  .project-view{display:flex;align-items:center;gap:6px;font-family:'Noto Sans SC','Inter',sans-serif;font-size:var(--fs-14);font-weight:600;color:#0f7a00;transition:gap .3s ease;letter-spacing:.05em;margin-top:auto;padding-top:var(--space-4);}
  .project-card:hover .project-view{gap:10px;}
  .project-view svg{width:14px;height:14px;}

  .footer{text-align:center;padding:var(--space-24) var(--gutter);border-top:1px solid var(--border);font-size:var(--fs-12);color:var(--text-muted);}
  .fade-up{opacity:0;transform:translateY(24px);transition:opacity .7s ease,transform .7s ease;}
  .fade-up.visible{opacity:1;transform:none;}

  @media(max-width:968px){
    .projects-grid{grid-template-columns:repeat(2,1fr);}
  }
  @media(max-width:768px){
    .nav{padding:16px 24px;}
    .nav.scrolled{padding:12px 24px;}
    .nav-links{position:fixed;top:0;right:-100%;width:70%;height:100vh;background:rgba(10,10,10,.98);flex-direction:column;justify-content:center;align-items:center;gap:32px;transition:right .4s ease,visibility .4s ease;visibility:hidden;border-left:1px solid var(--border);}
    .nav-links.open{right:0;visibility:visible;}
    .nav-links a{font-size:20px;}
    .nav-toggle{display:flex;z-index:1001;}
    .nav-toggle.open span:nth-child(1){transform:rotate(45deg) translate(5px,5px);}
    .nav-toggle.open span:nth-child(2){opacity:0;}
    .nav-toggle.open span:nth-child(3){transform:rotate(-45deg) translate(5px,-5px);}
    section{padding:80px 20px;}
    .section-title{letter-spacing:.08em;}
    .projects-grid{grid-template-columns:repeat(2,1fr);gap:16px;}
    .project-img{aspect-ratio:16/9;}
    .project-info{padding:var(--space-16);}
    .project-info h3{font-size:var(--fs-16);-webkit-line-clamp:2;overflow:hidden;text-overflow:ellipsis;display:-webkit-box;-webkit-box-orient:vertical;}
    .project-desc{font-size:var(--fs-14);-webkit-line-clamp:2;display:-webkit-box;-webkit-box-orient:vertical;overflow:hidden;}
    .project-tag{font-size:var(--fs-12);padding:var(--space-4) var(--space-8);}
    .project-view{font-size:var(--fs-14);}
    .project-date{font-size:var(--fs-12);}
    .nav{background:rgba(10,10,10,.95);backdrop-filter:none;-webkit-backdrop-filter:none;}
  }
  @media(max-width:480px){
    .projects-grid{grid-template-columns:1fr;gap:16px;}
    .project-info{padding:var(--space-16);}
    .project-info h3{font-size:var(--fs-16);-webkit-line-clamp:unset;display:block;overflow:visible;}
    .project-desc{font-size:var(--fs-14);-webkit-line-clamp:unset;display:block;overflow:visible;}
    .project-tag{font-size:var(--fs-12);padding:var(--space-4) var(--space-12);}
    .project-view{font-size:var(--fs-14);}
    section{padding:72px 18px;}
    .insight-intro{font-size:14px;margin-bottom:32px;}
  }

  /* ===== v5: 洞察筛选与间距 ===== */
  section#insights{padding:calc(72px + var(--space-32)) var(--gutter) var(--space-40);}
  .filter-stack{display:flex;flex-direction:column;gap:var(--space-12);margin-bottom:var(--space-24);}
  .filter-bar{display:flex;flex-wrap:wrap;align-items:center;gap:var(--space-8);}
  .filter-label{font-size:var(--fs-12);color:var(--text-muted);letter-spacing:.12em;margin-right:var(--space-4);min-width:2.5em;}
  .filter-chip{display:inline-flex;align-items:center;gap:6px;padding:var(--space-8) var(--space-16);border:1px solid rgba(255,255,255,.14);border-radius:99px;font-size:var(--fs-14);color:var(--text-secondary);letter-spacing:.02em;transition:all .25s ease;}
  .filter-chip:hover{color:#fff;border-color:rgba(57,255,20,.4);}
  .filter-chip.active{color:var(--accent);border-color:rgba(57,255,20,.55);background:rgba(57,255,20,.1);}
  .filter-chip span{font-family:'Inter',sans-serif;font-size:var(--fs-12);opacity:.75;}
  .insight-empty{padding:var(--space-56) var(--space-24);text-align:center;border:1px dashed rgba(255,255,255,.14);border-radius:16px;color:var(--text-muted);}
  .insight-empty .empty-title{font-size:var(--fs-20);color:var(--text);margin-bottom:var(--space-8);font-weight:600;}
  .insight-empty .empty-filters{font-size:var(--fs-12);color:var(--text-muted);margin-bottom:var(--space-4);letter-spacing:.02em;}
  .insight-soon{padding:var(--space-56) var(--space-24);text-align:center;border:1px dashed rgba(255,255,255,.14);border-radius:16px;}
  .insight-soon .soon-title{font-size:var(--fs-20);font-weight:600;color:var(--text);margin-bottom:var(--space-8);}
  .insight-soon .soon-note{font-size:var(--fs-14);color:var(--text-secondary);margin-bottom:var(--space-24);}
  .insight-soon .soon-topics{display:flex;flex-wrap:wrap;justify-content:center;gap:var(--space-12);}
  .insight-soon .soon-topics a{display:inline-flex;align-items:center;gap:var(--space-8);font-size:var(--fs-14);color:var(--text-secondary);border:1px solid var(--border);border-radius:99px;padding:var(--space-8) var(--space-16);transition:all .25s ease;}
  .insight-soon .soon-topics a:hover{color:var(--accent);border-color:rgba(var(--accent-rgb),.4);}
  .intro-count[hidden]{display:none;}
  @media(max-width:768px){
    section#insights{padding:calc(64px + var(--space-32)) var(--gutter) var(--space-32);}
    .filter-stack{gap:var(--space-8);margin-bottom:var(--space-24);}
    .filter-chip{padding:var(--space-8) var(--space-12);font-size:var(--fs-12);}
    .filter-label{font-size:var(--fs-12);}
    .insight-empty{padding:var(--space-40) var(--space-24);}
  }
</style>
</head>
<body>

<!-- ===== Navigation ===== -->
<nav class="nav" id="nav">
  <div class="nav-inner">
    <a href="/" class="nav-logo">个人商业<span>创造者</span></a>
    <button class="nav-toggle" id="navToggle" aria-label="菜单" aria-expanded="false" aria-controls="navLinks"><span></span><span></span><span></span></button>
    <ul class="nav-links" id="navLinks">
      <li><a href="/">首页</a></li>
      <li><a href="/#focus">我在做什么</a></li>
      <li><a href="/insights" class="active">洞察</a></li>
      <li><a href="/about">关于我</a></li>
    </ul>
  </div>
</nav>

<!-- ===== Insights ===== -->
<section id="insights" style="background:#0a0a0a;">
  <div class="section-container">
    <div class="section-header fade-up">
      <span class="line"></span>
      <h1 class="section-title">我的<span class="green">洞察</span></h1>
    </div>
    <p class="insight-intro fade-up">这里记录我的判断与实践：产业数字化、AI 与产品、技术与管理，以及正在进行的个人商业创造过程。{posts.length > 0 && (
      <span class="intro-count" id="introCount">共 <span id="insightCount">{posts.length}</span> 篇。</span>
    )}</p>
    <div class="filter-stack fade-up">
      <div class="filter-bar" role="group" aria-label="按分类筛选">
        <span class="filter-label">分类</span>
        <a class="filter-chip active" href="/insights/" data-category-filter="all">全部{posts.length > 0 && <span>{posts.length}</span>}</a>
        {categories.map((c) => (
          <a class="filter-chip" href={`/insights/?category=${encodeURIComponent(c)}`} data-category-filter={c}>{c}{countOf(c) > 0 && <span>{countOf(c)}</span>}</a>
        ))}
      </div>
      <div class="filter-bar" role="group" aria-label="按方向筛选">
        <span class="filter-label">方向</span>
        <a class="filter-chip active" href="/insights/" data-topic-filter="all">全部{posts.length > 0 && <span>{posts.length}</span>}</a>
        {topics.map((t) => (
          <a class="filter-chip" href={`/insights/?topic=${encodeURIComponent(t)}`} data-topic-filter={t}>{t}{topicCountOf(t) > 0 && <span>{topicCountOf(t)}</span>}</a>
        ))}
      </div>
    </div>
    <div class="projects-grid" id="insightGrid">
      {posts.map((post, i) => (
        <a href={`/insight?id=${post.id}`} class="project-card fade-up" data-category={post.category} data-topic={post.topic}>
          <div class="project-img">
            <img src={post.image} alt={post.title} width="1600" height="900" loading={i === 0 ? 'eager' : 'lazy'} decoding="async">
          </div>
          <div class="project-info">
            <span class="project-tag">{post.category}</span>
            <h3>{post.title}</h3>
            <p class="project-desc">{post.excerpt}</p>
            <span class="project-date">{post.date} · {post.readTime}</span>
            <span class="project-view">阅读全文 <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></span>
          </div>
        </a>
      ))}
    </div>
    {posts.length === 0 && (
      <div class="insight-soon fade-up">
        <p class="soon-title">第一批文章正在整理</p>
        <p class="soon-note">可以先从三个方向了解我在做什么。</p>
        <div class="soon-topics">
          <a href="/topics/personal-business">个人商业创造<span aria-hidden="true">→</span></a>
          <a href="/topics/ai-product">AI与产品创造<span aria-hidden="true">→</span></a>
          <a href="/topics/business-system">个人商业系统<span aria-hidden="true">→</span></a>
        </div>
      </div>
    )}
    <div class="insight-empty" id="insightEmpty" hidden>
      <p class="empty-title">没有符合条件的文章</p>
      <p class="empty-filters" id="emptyFilters"></p>
      <p>可以清空其中一个筛选条件，或等实践更新后再来看。</p>
    </div>
  </div>
</section>

<footer class="footer"><p>© 2026 个人商业创造者. 保留所有权利.</p></footer>

<script>
  const nav = document.getElementById('nav');
  const navLinksContainer = document.getElementById('navLinks');
  const navToggle = document.getElementById('navToggle');
  const navLinks = document.querySelectorAll('.nav-links a');
  window.addEventListener('scroll', () => {
    if (nav) nav.classList.toggle('scrolled', window.scrollY > 50);
  });
  if (navToggle && navLinksContainer) {
    navToggle.addEventListener('click', () => {
      const open = navLinksContainer.classList.toggle('open');
      navToggle.classList.toggle('open');
      navToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
    navLinks.forEach((link) => {
      link.addEventListener('click', () => {
        navLinksContainer.classList.remove('open');
        navToggle.classList.remove('open');
        navToggle.setAttribute('aria-expanded', 'false');
      });
    });
  }
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.12 });
  document.querySelectorAll('.fade-up').forEach((el) => observer.observe(el));

  // 双维筛选：category × topic，query 参数驱动，静态页面内过滤
  const categoryChips = [...document.querySelectorAll('[data-category-filter]')];
  const topicChips = [...document.querySelectorAll('[data-topic-filter]')];
  const cards = [...document.querySelectorAll('#insightGrid .project-card')];
  const countEl = document.getElementById('insightCount');
  const countWrap = document.getElementById('introCount');
  const emptyEl = document.getElementById('insightEmpty');
  const emptyFilters = document.getElementById('emptyFilters');

  const initial = new URLSearchParams(location.search);
  let currentCategory = initial.get('category') || 'all';
  let currentTopic = initial.get('topic') || 'all';

  function applyFilter(cat, topic) {
    const c = cat && cat !== 'all' ? cat : 'all';
    const t = topic && topic !== 'all' ? topic : 'all';
    let shown = 0;
    cards.forEach((card) => {
      const hit = (c === 'all' || card.dataset.category === c) && (t === 'all' || card.dataset.topic === t);
      card.style.display = hit ? '' : 'none';
      if (hit) {
        card.classList.add('visible');
        shown++;
      }
    });
    categoryChips.forEach((chip) => chip.classList.toggle('active', chip.dataset.categoryFilter === c));
    topicChips.forEach((chip) => chip.classList.toggle('active', chip.dataset.topicFilter === t));
    if (countEl) countEl.textContent = shown;
    if (countWrap) countWrap.hidden = shown === 0;
    if (emptyEl) {
      emptyEl.hidden = shown > 0 || cards.length === 0;
      if (emptyFilters) {
        const parts = [];
        if (c !== 'all') parts.push(c);
        if (t !== 'all') parts.push(t);
        emptyFilters.textContent = parts.length ? `当前筛选：${parts.join(' · ')}` : '';
      }
    }
  }

  function syncUrl() {
    const url = new URL(location.href);
    if (currentCategory === 'all') url.searchParams.delete('category');
    else url.searchParams.set('category', currentCategory);
    if (currentTopic === 'all') url.searchParams.delete('topic');
    else url.searchParams.set('topic', currentTopic);
    history.replaceState(null, '', url);
  }

  applyFilter(currentCategory, currentTopic);

  categoryChips.forEach((chip) => {
    chip.addEventListener('click', (e) => {
      e.preventDefault();
      currentCategory = chip.dataset.categoryFilter;
      applyFilter(currentCategory, currentTopic);
      syncUrl();
    });
  });

  topicChips.forEach((chip) => {
    chip.addEventListener('click', (e) => {
      e.preventDefault();
      currentTopic = chip.dataset.topicFilter;
      applyFilter(currentCategory, currentTopic);
      syncUrl();
    });
  });
</script>
</body>
</html>
