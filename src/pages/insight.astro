---
import { insights } from '../data/insights.mjs';
---
<!DOCTYPE html>
<html lang="zh-CN" style="background:#0A0A0A;">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#0A0A0A">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<title>洞察 — 个人商业创造者</title>
<meta name="description" content="个人商业创造者的洞察文章：90 天实战、产业数字化、AI 与产品、技术与管理。">
<link rel="stylesheet" href="/fonts/fonts.css">
<link rel="stylesheet" href="/css/tokens.css">
<style is:global>
  :root{
    --bg:#0A0A0A;
    --bg-card:#161616;
    --accent:#39FF14;
    --accent-rgb:57,255,20;
    --accent-dim:rgba(57,255,20,.15);
    --text:#FFFFFF;
    --text-secondary:#A1A1AA;
    --text-muted:#8E8E97;
    --border:rgba(255,255,255,.08);
    --radius:16px;
    --radius-sm:10px;
    --read-w:680px;
  }
  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    font-family:'Noto Sans SC','Inter',-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Microsoft YaHei',sans-serif;
    background:var(--bg);color:var(--text);line-height:1.8;overflow-x:hidden;
    -webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility;
  }
  ::selection{background:var(--accent);color:#000;}
  a{text-decoration:none;color:inherit;}
  img{display:block;}
  ::-webkit-scrollbar{width:8px;}
  ::-webkit-scrollbar-track{background:var(--bg);}
  ::-webkit-scrollbar-thumb{background:#333;border-radius:4px;}

  /* ===== 阅读进度 ===== */
  .reading-progress{position:fixed;top:0;left:0;height:2px;width:0;background:var(--accent);z-index:1100;box-shadow:0 0 10px rgba(var(--accent-rgb),.6);transition:width .08s linear;}

  /* ===== 导航 ===== */
  .nav{
    position:fixed;top:0;left:0;right:0;z-index:1000;padding:16px var(--gutter);
    display:flex;align-items:center;justify-content:space-between;
    background:rgba(10,10,10,.85);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);
    border-bottom:1px solid var(--border);
  }
  .nav-inner{max-width:var(--container-w);margin:0 auto;width:100%;display:flex;align-items:center;justify-content:space-between;gap:var(--space-24);}
  .nav-logo{font-weight:800;font-size:20px;letter-spacing:-.5px;}
  .nav-logo span{color:var(--accent);}
  .nav-back{display:inline-flex;align-items:center;gap:8px;font-size:14px;font-weight:500;color:var(--text-secondary);transition:color .3s ease;letter-spacing:.06em;}
  .nav-back:hover{color:var(--accent);}
  .nav-back svg{width:18px;height:18px;}

  /* ===== 文章头 ===== */
  .article-head{padding:calc(66px + var(--space-56)) 0 var(--space-40);}
  .read-wrap{width:100%;max-width:calc(var(--read-w) + 48px);margin:0 auto;padding:0 24px;}

  .meta-line{display:flex;flex-wrap:wrap;align-items:center;gap:10px;font-size:13px;color:var(--text-secondary);letter-spacing:.04em;margin-bottom:var(--space-16);}
  .meta-line .dot{color:var(--text-muted);}
  .article-status{display:inline-flex;align-items:center;padding:2px 8px;border:1px dashed rgba(242,193,78,.45);border-radius:6px;background:rgba(242,193,78,.08);color:#F2C14E;font-size:12px;font-weight:600;letter-spacing:.08em;}
  .article-status[hidden]{display:none;}

  .article-title{font-size:clamp(28px,4vw,40px);font-weight:800;line-height:1.28;letter-spacing:.02em;margin-bottom:var(--space-12);}
  .article-tagline{font-size:16px;color:var(--text-secondary);line-height:1.75;letter-spacing:.02em;}

  .article-cover{width:100%;aspect-ratio:16/10;max-height:380px;border-radius:12px;overflow:hidden;background:#1a1a1a;border:1px solid var(--border);margin-bottom:var(--space-40);}
  .article-cover img{width:100%;height:100%;object-fit:cover;}

  /* ===== 正文 ===== */
  .article-body{padding-bottom:var(--space-40);}
  .article-lead{font-size:18px;color:#D4D4D8;line-height:1.8;letter-spacing:.01em;margin-bottom:1.4em;}
  .article-section{margin-top:var(--space-40);}
  .article-section h3{font-size:20px;font-weight:700;line-height:1.5;margin-bottom:16px;letter-spacing:.04em;color:var(--text);}
  .article-section p{font-size:17px;color:var(--text-secondary);line-height:1.8;margin:0 0 1.1em;letter-spacing:.01em;}
  .article-section p:last-child{margin-bottom:0;}

  /* 核心观点 */
  .takeaway{margin-top:var(--space-48);padding:var(--space-24);border-radius:var(--radius);background:var(--bg-card);border:1px solid rgba(var(--accent-rgb),.18);position:relative;overflow:hidden;}
  .takeaway::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--accent),rgba(var(--accent-rgb),.15));}
  .takeaway h3{font-size:16px;font-weight:700;letter-spacing:.1em;color:var(--accent);margin-bottom:var(--space-16);display:flex;align-items:center;gap:var(--space-8);}
  .takeaway h3 svg{width:20px;height:20px;}
  .takeaway-list{display:grid;grid-template-columns:1fr;gap:var(--space-12);list-style:none;}
  .takeaway-list li{display:flex;align-items:flex-start;gap:var(--space-12);font-size:14px;color:var(--text-secondary);line-height:1.7;letter-spacing:.02em;}
  .takeaway-list li svg{width:18px;height:18px;color:var(--accent);flex-shrink:0;margin-top:3px;}

  .article-tags{display:flex;flex-wrap:wrap;gap:var(--space-8);padding-top:var(--space-24);margin-top:var(--space-40);border-top:1px solid var(--border);}
  .article-tag{padding:var(--space-8) var(--space-12);border-radius:8px;background:var(--accent-dim);border:1px solid rgba(var(--accent-rgb),.2);font-family:'Inter',sans-serif;font-size:12px;font-weight:600;color:var(--accent);letter-spacing:.04em;}

  /* ===== 作者卡 ===== */
  .author-card{margin-top:var(--space-40);padding:var(--space-24);background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);display:flex;align-items:flex-start;gap:var(--space-16);}
  .author-avatar{width:44px;height:44px;border-radius:50%;background:rgba(var(--accent-rgb),.12);border:1px solid rgba(var(--accent-rgb),.35);display:grid;place-items:center;color:var(--accent);font-weight:800;font-size:16px;flex-shrink:0;}
  .author-copy strong{display:block;font-size:16px;font-weight:700;margin-bottom:var(--space-4);}
  .author-copy p{font-size:14px;color:var(--text-secondary);line-height:1.7;margin-bottom:var(--space-4);}
  .author-copy a{font-size:13px;color:var(--text-secondary);border-bottom:1px solid var(--border);}
  .author-copy a:hover{color:var(--accent);border-color:var(--accent);}

  /* ===== 上一篇 / 下一篇 ===== */
  .article-nav{margin-top:var(--space-40);display:grid;grid-template-columns:1fr 1fr;gap:var(--space-16);}
  .article-nav[hidden]{display:none;}
  .article-nav-link{padding:var(--space-16) var(--space-24);background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);transition:all .3s ease;display:flex;flex-direction:column;gap:var(--space-4);}
  .article-nav-link:hover{border-color:rgba(var(--accent-rgb),.25);transform:translateY(-2px);}
  .article-nav-link.next{text-align:right;align-items:flex-end;}
  .article-nav-link .nav-label{font-size:12px;color:var(--text-muted);letter-spacing:.12em;}
  .article-nav-link .nav-title{font-size:14px;font-weight:600;color:var(--text);line-height:1.5;}

  .back-insights{display:flex;justify-content:center;margin-top:var(--space-40);}
  .back-insights a{display:inline-flex;align-items:center;gap:var(--space-8);font-size:14px;color:var(--text-secondary);letter-spacing:.04em;transition:color .25s ease;}
  .back-insights a:hover{color:var(--accent);}
  .back-insights svg{width:16px;height:16px;}

  .footer{text-align:center;padding:var(--space-24) var(--gutter);border-top:1px solid var(--border);font-size:12px;color:var(--text-muted);margin-top:var(--space-40);}

  @media(max-width:640px){
    .article-head{padding:calc(60px + var(--space-32)) 0 var(--space-32);}
    .read-wrap{padding:0 24px;}
    body{font-size:16px;line-height:1.85;}
    .article-title{font-size:28px;line-height:1.3;}
    .article-lead{font-size:16px;line-height:1.85;}
    .article-section p{font-size:16px;line-height:1.85;}
    .article-cover{margin-bottom:var(--space-32);}
    .article-nav{grid-template-columns:1fr;}
    .article-nav-link.next{text-align:left;align-items:flex-start;}
    .author-card{padding:var(--space-16);}
  }
</style>
</head>
<body>

<div class="reading-progress" id="readingProgress"></div>

<nav class="nav">
  <div class="nav-inner">
    <a href="/" class="nav-logo">个人商业<span>创造者</span></a>
    <a href="/insights" class="nav-back">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
      返回洞察
    </a>
  </div>
</nav>

<header class="article-head">
  <div class="read-wrap">
    <div class="meta-line" id="articleMeta"></div>
    <h1 class="article-title" id="articleTitle">加载中...</h1>
    <p class="article-tagline" id="articleTagline"></p>
  </div>
</header>

<main class="article-body">
  <div class="read-wrap">
    <div class="article-cover" id="articleCover"></div>
    <p class="article-lead" id="articleLead"></p>
    <div id="articleSections"></div>

    <section class="takeaway" id="articleTakeaway">
      <h3>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M12 2a7 7 0 0 0-4 12.7V17h8v-2.3A7 7 0 0 0 12 2z"/></svg>
        核心观点
      </h3>
      <ul class="takeaway-list" id="articleTakeaways"></ul>
    </section>

    <div class="article-tags" id="articleTags"></div>

    <section class="author-card">
      <div class="author-avatar" aria-hidden="true">商</div>
      <div class="author-copy">
        <strong>个人商业创造者</strong>
        <p>18 年 IT 与产业数字化经验，正在用 AI 把专业能力转化为自己的产品与商业资产。</p>
        <a href="mailto:cronaldo.yang@outlook.com">cronaldo.yang@outlook.com</a>
      </div>
    </section>

    <nav class="article-nav" id="articleNav" aria-label="同栏目文章"></nav>

    <div class="back-insights">
      <a href="/insights">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
        返回洞察
      </a>
    </div>
  </div>
</main>

<footer class="footer">
  <p>© 2026 个人商业创造者. 保留所有权利.</p>
</footer>

<script is:inline define:vars={{ insightData: insights }}>
  const params = new URLSearchParams(window.location.search);
  const requestedId = parseInt(params.get('id') || '11', 10);
  const post = insightData.find((p) => p.id === requestedId) || insightData[0];

  document.title = post.title + ' — 个人商业创造者';
  const descMeta = document.querySelector('meta[name="description"]');
  if (descMeta) descMeta.setAttribute('content', post.excerpt);

  const metaEl = document.getElementById('articleMeta');
  const statusText = post.status || (post.draft ? '草稿 · 未发布' : '');
  const statusHtml = statusText
    ? '<span class="article-status">' + statusText + '</span>'
    : '';
  metaEl.innerHTML =
    '<span>' + post.date + '</span><span class="dot">·</span>' +
    '<span>' + post.category + '</span><span class="dot">·</span>' +
    '<span>' + post.readTime + '</span>' + statusHtml;

  document.getElementById('articleTitle').textContent = post.title;
  document.getElementById('articleTagline').textContent = post.tagline;

  document.getElementById('articleCover').innerHTML =
    '<img src="' + post.image + '" alt="' + post.title + '" width="1600" height="900" loading="eager" decoding="async">';
  document.getElementById('articleLead').textContent = post.lead;

  document.getElementById('articleSections').innerHTML = post.sections
    .map((sec) =>
      '<section class="article-section"><h3>' + sec.title + '</h3>' +
      sec.paras.map((p) => '<p>' + p + '</p>').join('') +
      '</section>'
    )
    .join('');

  const checkIcon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';
  document.getElementById('articleTakeaways').innerHTML = post.takeaways
    .map((t) => '<li>' + checkIcon + '<span>' + t + '</span></li>')
    .join('');

  document.getElementById('articleTags').innerHTML = post.tags
    .map((t) => '<span class="article-tag">' + t + '</span>')
    .join('');

  // 同栏目的上一篇 / 下一篇
  const sameCategory = insightData.filter((p) => p.category === post.category);
  const index = sameCategory.findIndex((p) => p.id === post.id);
  const prevPost = index > 0 ? sameCategory[index - 1] : null;
  const nextPost = index < sameCategory.length - 1 ? sameCategory[index + 1] : null;
  const navEl = document.getElementById('articleNav');
  const parts = [];
  if (prevPost) {
    parts.push('<a href="/insight?id=' + prevPost.id + '" class="article-nav-link">' +
      '<span class="nav-label">上一篇</span><span class="nav-title">' + prevPost.title + '</span></a>');
  }
  if (nextPost) {
    parts.push('<a href="/insight?id=' + nextPost.id + '" class="article-nav-link next">' +
      '<span class="nav-label">下一篇</span><span class="nav-title">' + nextPost.title + '</span></a>');
  }
  if (parts.length) {
    navEl.innerHTML = parts.join('');
  } else {
    navEl.hidden = true;
  }

  // 阅读进度
  const progress = document.getElementById('readingProgress');
  const updateProgress = () => {
    const max = document.documentElement.scrollHeight - window.innerHeight;
    const ratio = max > 0 ? window.scrollY / max : 0;
    progress.style.width = Math.min(100, Math.max(0, ratio * 100)) + '%';
  };
  window.addEventListener('scroll', updateProgress, { passive: true });
  window.addEventListener('resize', updateProgress);
  updateProgress();
</script>
</body>
</html>
