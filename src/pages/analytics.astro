---
import BaseLayout from '../layouts/BaseLayout.astro';
import fs from 'node:fs';
import path from 'node:path';
import { renderDashboard } from '../lib/analytics-render.mjs';

// 构建时快照：首屏直接出完整看板（无 JS 也有内容），页面加载后再拉服务器实时数据覆盖。
const dataPath = path.resolve(process.cwd(), 'public/data/analytics.json');
const raw = fs.existsSync(dataPath) ? fs.readFileSync(dataPath, 'utf8') : '';
const data = raw ? JSON.parse(raw) : null;
const initialHtml = renderDashboard(data);
---

<BaseLayout title="数据统计 — 个人成长实践者" description="抖音、微信公众号、快手、小红书四平台后台数据的每日快照、逐条作品明细与我的分析。" canonicalPath="/analytics/" active="analytics">
  <link rel="stylesheet" href="/css/analytics.css" slot="head" />

  <header class="page-hero">
    <div class="wrap">
      <p class="eyebrow">
        <span class="eyebrow-dot" aria-hidden="true"></span>
        DATA / 数据
      </p>
      <h1>四平台数据快照</h1>
      <p class="page-intro">
        抖音、微信公众号、快手、小红书的后台原始数字，细到每一条作品。每天自动更新，数字不做二次加工。
      </p>
      <div class="hero-meta">
        <span class="hero-stamp" id="observed-at">观测时点 {data ? data.observedAt : '—'}（{data ? data.timezone : 'Asia/Shanghai'}）</span>
        <span class="hero-source" id="data-source" data-state="pending">正在连接实时数据…</span>
      </div>
    </div>
  </header>

  <main id="main-content" class="wrap analytics-main">
    <div id="analytics-root" set:html={initialHtml}></div>
  </main>
</BaseLayout>

<script>
  import { renderDashboard } from '../lib/analytics-render.mjs';

  const root = document.getElementById('analytics-root');
  const stamp = document.getElementById('observed-at');
  const source = document.getElementById('data-source');

  // 平台 tab：切换过滤，客户端与 SSR 共用 data-filter 机制。
  function bindTabs() {
    const nav = root?.querySelector('[data-an-tabs]');
    const list = root?.querySelector('.an-platforms');
    if (!nav || !list) return;
    nav.addEventListener('click', (e) => {
      const btn = e.target instanceof Element ? e.target.closest('[data-an-tab]') : null;
      if (!btn) return;
      const key = btn.getAttribute('data-an-tab');
      nav.querySelectorAll('[data-an-tab]').forEach((b) => {
        const on = b === btn;
        b.classList.toggle('is-active', on);
        b.setAttribute('aria-pressed', String(on));
      });
      list.dataset.filter = key;
      // 切换后回到平台区顶部，避免停在半空
      const first = list.querySelector('.an-platform:not([style*="none"])');
      if (key !== 'all' && first) first.scrollIntoView({ block: 'start', behavior: 'smooth' });
    });
  }

  fetch('/api/analytics/latest', { cache: 'no-store' })
    .then((r) => {
      if (!r.ok) throw new Error('HTTP ' + r.status);
      return r.json();
    })
    .then((d) => {
      if (!d || !d.douyin) throw new Error('payload has no platform data');
      if (root) {
        root.innerHTML = renderDashboard(d);
        bindTabs();
      }
      if (stamp) stamp.textContent = `观测时点 ${d.observedAt}（${d.timezone || 'Asia/Shanghai'}）`;
      if (source) {
        source.textContent = '服务器实时数据 · API';
        source.dataset.state = 'live';
      }
    })
    .catch((e) => {
      if (source) {
        source.textContent = '构建时快照（实时接口暂不可用）';
        source.dataset.state = 'snapshot';
      }
      console.warn('[analytics] live fetch failed:', e);
    });

  bindTabs();
</script>

<style>
  .wrap { max-width: var(--container-w); margin: 0 auto; padding: 0 var(--gutter); }

  .page-hero {
    padding: calc(64px + var(--space-40)) 0 var(--space-32);
    border-bottom: 1px solid var(--border);
    position: relative;
    overflow: hidden;
  }
  .page-hero::after {
    content: '';
    position: absolute;
    right: -120px;
    top: -60px;
    width: 380px;
    height: 380px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(var(--accent-rgb), .10), transparent 68%);
    pointer-events: none;
  }
  .eyebrow {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    font-size: var(--fs-12);
    color: var(--text-muted);
    letter-spacing: .08em;
    margin: 0 0 var(--space-16);
  }
  .eyebrow-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    flex-shrink: 0;
    box-shadow: 0 0 0 3px rgba(var(--accent-rgb), .18);
  }
  .page-hero h1 {
    font-size: var(--fs-48);
    font-weight: 600;
    line-height: 1.16;
    letter-spacing: -.015em;
    margin: 0;
    text-wrap: balance;
  }
  .page-intro {
    margin: var(--space-12) 0 0;
    max-width: 640px;
    font-size: var(--fs-16);
    line-height: var(--lh-body);
    color: var(--text-secondary);
  }
  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-12);
    margin-top: var(--space-20);
  }
  .hero-stamp {
    font-size: var(--fs-12);
    color: var(--text-secondary);
    font-variant-numeric: tabular-nums;
    padding: 4px 10px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
  }
  .hero-source {
    font-size: var(--fs-12);
    color: var(--text-muted);
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .hero-source::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--text-muted);
    flex-shrink: 0;
  }
  .hero-source[data-state="live"] { color: var(--accent); }
  .hero-source[data-state="live"]::before { background: var(--accent); }
  .hero-source[data-state="pending"]::before { background: var(--text-muted); animation: an-pulse 1.4s ease-in-out infinite; }
  .hero-source[data-state="snapshot"]::before { background: #C79A3A; }

  @keyframes an-pulse { 0%,100% { opacity: .35; } 50% { opacity: 1; } }

  .analytics-main { padding: var(--space-32) 0 var(--space-72); }

  @media (max-width: 768px) {
    .page-hero { padding: calc(56px + var(--space-24)) 0 var(--space-24); }
    .page-hero h1 { font-size: var(--fs-28); }
    .analytics-main { padding: var(--space-24) 0 var(--space-40); }
  }
</style>
