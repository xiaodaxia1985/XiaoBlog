---
import { ClientRouter } from 'astro:transitions';
---
<!DOCTYPE html>
<html lang="zh-CN" style="background:#0c0c0c;">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#0c0c0c">
<meta name="color-scheme" content="dark">
<meta name="robots" content="noindex">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<title>页面不存在 — 个人商业创造者</title>
<link rel="stylesheet" href="/fonts/fonts.css">
<link rel="stylesheet" href="/css/tokens.css">
<script is:inline>document.documentElement.classList.add('js');</script>
<script is:inline src="/js/site-shell.js" defer></script>
<style is:global>
  *{margin:0;padding:0;box-sizing:border-box;}
  body{font-family:'Noto Sans SC','Inter',-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Microsoft YaHei',sans-serif;background:var(--bg);color:var(--text);min-height:100vh;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:var(--space-16);padding:var(--space-32);line-height:var(--lh-body);text-align:center;}
  .code{font-family:'Inter',sans-serif;font-variant-numeric:tabular-nums;font-size:var(--fs-12);color:var(--text-muted);}
  h1{font-size:var(--fs-28);font-weight:600;line-height:1.3;letter-spacing:0;text-wrap:balance;}
  p{font-size:var(--fs-14);color:var(--text-secondary);max-width:520px;}
  a{display:inline-flex;align-items:center;justify-content:center;gap:var(--space-8);margin-top:var(--space-8);padding:var(--space-12) var(--space-24);border:1px solid var(--accent);border-radius:var(--radius-sm);background:var(--accent);color:var(--accent-ink);font-size:var(--fs-14);font-weight:500;text-decoration:none;transition:background-color .2s ease,border-color .2s ease;}
  a:hover,a:focus-visible{background:#E4F98C;border-color:#E4F98C;}
</style>
  <ClientRouter fallback="swap" />
</head>
<body>
  <span class="code">404</span>
  <h1>这篇文章不在这里</h1>
  <p>地址可能已经变化，或者文章还没发布。可以从洞察列表重新进入。</p>
  <a href="/insights/">查看洞察</a>
</body>
</html>
