---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---
<!DOCTYPE html>
<html lang="zh-CN" style="background:#0c0c0c;">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#0c0c0c">
<meta name="color-scheme" content="dark">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<title>项目详情 — 个人商业创造者</title>
<meta name="description" content="项目详情：产业数字化与 AI 产品创造的实践记录。">
<meta name="robots" content="noindex,follow">
<script is:inline>
  const legacyProjectSlugs = ['smart-livestock','cold-chain-logistics','food-traceability','digital-data-capture','precision-feeding','mobile-security'];
  const legacyProjectId = Number(new URLSearchParams(location.search).get('id') || 1);
  const legacyProjectSlug = legacyProjectSlugs[legacyProjectId - 1];
  if (legacyProjectSlug) location.replace('/projects/' + legacyProjectSlug + '/');
  else location.replace('/projects/');
</script>
<link rel="stylesheet" href="/fonts/fonts.css">
<link rel="stylesheet" href="/css/tokens.css">
<script is:inline>document.documentElement.classList.add('js');</script>
<script is:inline src="/js/site-shell.js" defer></script>
<style is:global>
  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{font-family:'Noto Sans SC','Inter',-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Microsoft YaHei',sans-serif;font-size:var(--fs-16);line-height:var(--lh-body);background:var(--bg);color:var(--text);overflow-x:hidden;font-feature-settings:"palt" 1;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility;}
  ::selection{background:var(--accent);color:var(--accent-ink);}
  a{text-decoration:none;color:inherit;}
  img{display:block;}
  :focus-visible{outline:2px solid var(--accent);outline-offset:3px;border-radius:2px;}
  ::-webkit-scrollbar{width:8px;}
  ::-webkit-scrollbar-track{background:var(--bg);}
  ::-webkit-scrollbar-thumb{background:#2a2a2a;border-radius:4px;}

  .project-hero{padding:calc(64px + var(--space-56)) var(--gutter) var(--space-40);}
  .project-hero-content{max-width:var(--article-w);margin:0 auto;}
  .project-badge{display:flex;align-items:center;gap:var(--space-8);margin-bottom:var(--space-16);}
  .project-badge .line{width:6px;height:6px;border-radius:50%;background:var(--accent);flex-shrink:0;}
  .project-badge .label{font-size:var(--fs-12);color:var(--text-muted);}
  .project-title{font-size:var(--fs-48);font-weight:600;line-height:1.18;letter-spacing:0;margin-bottom:var(--space-12);text-wrap:balance;}
  .project-tagline{max-width:640px;margin-bottom:var(--space-24);font-size:var(--fs-16);color:var(--text-secondary);}
  .project-meta{display:flex;flex-wrap:wrap;gap:var(--space-12) var(--space-32);margin-bottom:var(--space-24);}
  .meta-item h4{font-size:var(--fs-12);font-weight:400;color:var(--text-muted);margin-bottom:var(--space-4);}
  .meta-item p{font-size:var(--fs-14);color:var(--text);}
  .project-actions{display:flex;flex-wrap:wrap;gap:var(--space-12);margin-top:var(--space-24);}
  .btn{display:inline-flex;align-items:center;justify-content:center;gap:var(--space-8);padding:var(--space-12) var(--space-24);border:1px solid transparent;border-radius:var(--radius-sm);font-size:var(--fs-14);font-weight:500;cursor:pointer;transition:background-color .2s ease,border-color .2s ease,color .2s ease;}
  .btn-primary{background:var(--accent);color:var(--accent-ink);border-color:var(--accent);}
  .btn-primary:hover{background:#E4F98C;border-color:#E4F98C;}
  .btn-outline{background:transparent;color:var(--text);border-color:var(--border);}
  .btn-outline:hover{background:var(--surface);border-color:rgba(255,255,255,.22);}
  .btn svg{width:16px;height:16px;stroke-width:1.5;}

  .project-body{max-width:var(--article-w);margin:0 auto;padding:0 var(--gutter) var(--space-40);}
  .project-preview{width:100%;aspect-ratio:16/9;border-radius:var(--radius);overflow:hidden;background:var(--surface);border:1px solid var(--border);margin-bottom:var(--space-40);}
  .project-preview img{width:100%;height:100%;object-fit:cover;}
  .project-section{margin-bottom:var(--space-40);}
  .project-section h3{display:flex;align-items:center;gap:var(--space-8);font-size:var(--fs-20);font-weight:600;line-height:1.4;letter-spacing:0;margin-bottom:var(--space-16);}
  .project-section h3::before{content:'';width:6px;height:6px;border-radius:50%;background:var(--accent);flex-shrink:0;}
  .project-section p{font-size:var(--fs-16);color:var(--text-secondary);line-height:1.75;margin-bottom:1.1em;}
  #projectOverview p:first-child{font-size:var(--fs-20);line-height:var(--lh-tight);color:var(--text);}
  .tech-tags{display:flex;flex-wrap:wrap;gap:var(--space-8);}
  .tech-tag{padding:var(--space-4) var(--space-12);border:1px solid var(--border);border-radius:4px;font-size:var(--fs-14);color:var(--text-secondary);transition:color .2s ease,border-color .2s ease;}
  .tech-tag:hover{color:var(--text);border-color:rgba(255,255,255,.2);}
  .features-list{display:grid;grid-template-columns:repeat(2,1fr);gap:var(--space-12);}
  .feature-item{display:flex;align-items:flex-start;gap:var(--space-12);padding:var(--space-16);background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-sm);}
  .feature-item svg{width:18px;height:18px;color:var(--text-muted);flex-shrink:0;margin-top:3px;}
  .feature-item span{font-size:var(--fs-14);color:var(--text-secondary);line-height:var(--lh-tight);}

  .project-nav{max-width:var(--article-w);margin:0 auto;padding:0 var(--gutter) var(--space-56);display:flex;justify-content:space-between;gap:var(--space-16);flex-wrap:wrap;}
  .project-nav-link{flex:1;min-width:200px;display:flex;align-items:center;gap:var(--space-16);padding:var(--space-24);background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);transition:background-color .2s ease,border-color .2s ease;}
  .project-nav-link:hover{background:var(--surface-2);border-color:rgba(255,255,255,.2);}
  .project-nav-link.prev{flex-direction:row-reverse;text-align:right;}
  .project-nav-link svg{width:20px;height:20px;color:var(--text-muted);flex-shrink:0;stroke-width:1.5;}
  .project-nav-link .nav-text{flex:1;}
  .project-nav-link .nav-label{font-size:var(--fs-12);color:var(--text-muted);margin-bottom:var(--space-4);}
  .project-nav-link .nav-title{font-size:var(--fs-16);font-weight:600;}

  @media(max-width:768px){
    .project-hero{padding:calc(56px + var(--space-32)) var(--gutter) var(--space-32);}
    .project-title{font-size:28px;line-height:1.25;}
    .project-tagline{font-size:var(--fs-14);}
    .project-body{padding:0 var(--gutter) var(--space-32);}
    .project-nav{padding:0 var(--gutter) var(--space-40);}
    .features-list{grid-template-columns:1fr;}
    .project-nav-link{min-width:100%;}
    .project-nav-link.prev{flex-direction:row;text-align:left;}
  }
</style>
</head>
<body>

<Nav variant="article" backHref="/projects" backLabel="返回项目" />

<!-- ===== Project Hero ===== -->
<section class="project-hero">
  <div class="project-hero-content">
    <div class="project-badge fade-in">
      <span class="line"></span>
      <span class="label" id="projectCategory">项目</span>
    </div>
    <h1 class="project-title fade-in" id="projectTitle">加载中...</h1>
    <p class="project-tagline fade-in" id="projectTagline"></p>
    <div class="project-meta fade-in" id="projectMeta"></div>
    <div class="project-actions fade-in" id="projectActions"></div>
  </div>
</section>

<!-- ===== Project Body ===== -->
<div class="project-body">
  <!-- Preview -->
  <div class="project-preview fade-in" id="projectPreview"></div>

  <!-- Overview -->
  <div class="project-section fade-in">
    <h3>项目概述</h3>
    <div id="projectOverview"></div>
  </div>

  <!-- Tech Stack -->
  <div class="project-section fade-in">
    <h3>技术栈</h3>
    <div class="tech-tags" id="projectTech"></div>
  </div>

  <!-- Features -->
  <div class="project-section fade-in">
    <h3>核心功能</h3>
    <div class="features-list" id="projectFeatures"></div>
  </div>
</div>

<!-- ===== Project Navigation ===== -->
<div class="project-nav" id="projectNav"></div>

<Footer />

