---
const slugs = [
  'smart-livestock',
  'cold-chain-logistics',
  'food-traceability',
  'digital-data-capture',
  'precision-feeding',
  'mobile-security',
];
const id = Number(Astro.url.searchParams.get('id') ?? 1);
const slug = slugs[id - 1];
const destination = slug ? `/projects/${slug}/` : '/projects/';
---
<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex,follow">
<meta http-equiv="refresh" content={`0;url=${destination}`}>
<link rel="canonical" href={new URL(destination, Astro.site ?? 'https://xiaomaker.top').toString()}>
<title>项目页面迁移中 — 个人商业创造者</title>
</head>
<body>
<p>项目页面已更新。如果没有自动跳转，请<a href={destination}>点击这里继续查看</a>。</p>
</body>
</html>
