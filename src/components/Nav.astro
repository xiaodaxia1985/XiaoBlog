---
interface Props {
  active?: 'home' | 'focus' | 'insights' | 'about' | '';
  variant?: 'main' | 'article';
  backHref?: string;
  backLabel?: string;
}
const { active = '', variant = 'main', backHref = '/insights', backLabel = '返回洞察' } = Astro.props;
---
<nav class="site-nav">
  <div class="site-nav-inner">
    <a href="/" class="site-logo">
      <img class="site-avatar" src="/images/f409a539ce.jpg" alt="" decoding="async" width="26" height="26">
      个人商业创造者
    </a>
    {variant === 'article' ? (
      <a href={backHref} class="site-back">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
        {backLabel}
      </a>
    ) : (
      <>
        <button class="site-nav-toggle" id="siteNavToggle" aria-label="打开导航菜单" aria-expanded="false" aria-controls="siteNavLinks"><span></span><span></span><span></span></button>
        <button class="site-nav-backdrop" id="siteNavBackdrop" type="button" aria-label="关闭导航菜单" hidden></button>
        <ul class="site-nav-links" id="siteNavLinks" aria-label="主导航">
          <li><a href="/" class:list={{ active: active === 'home' }} aria-current={active === 'home' ? 'page' : undefined}>首页</a></li>
          <li><a href="/#focus" class:list={{ active: active === 'focus' }} aria-current={active === 'focus' ? 'page' : undefined}>方向</a></li>
          <li><a href="/insights" class:list={{ active: active === 'insights' }} aria-current={active === 'insights' ? 'page' : undefined}>洞察</a></li>
          <li><a href="/about" class:list={{ active: active === 'about' }} aria-current={active === 'about' ? 'page' : undefined}>关于</a></li>
        </ul>
      </>
    )}
  </div>
</nav>

<style>
  .site-nav{position:fixed;top:0;left:0;right:0;z-index:1000;padding:0 var(--gutter);background:rgba(12,12,12,.9);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border-bottom:1px solid var(--border);}
  .site-nav-inner{max-width:var(--container-w);margin:0 auto;width:100%;height:64px;display:flex;align-items:center;justify-content:space-between;gap:var(--space-24);}
  .site-logo{display:inline-flex;align-items:center;gap:var(--space-8);font-size:var(--fs-16);font-weight:600;color:var(--text);}
  .site-avatar{width:26px;height:26px;border-radius:50%;object-fit:cover;border:1px solid var(--border);flex-shrink:0;}
  .site-nav-links{display:grid;grid-template-columns:repeat(4,minmax(56px,1fr));gap:var(--space-12);list-style:none;margin:0;padding:0;min-width:296px;text-align:center;}
  .site-nav-links a{display:block;font-size:var(--fs-14);letter-spacing:.04em;color:var(--text-secondary);transition:color .2s ease;}
  .site-nav-links a:hover,.site-nav-links a.active,.site-nav-links a:focus-visible{color:var(--accent);}
  .site-back{display:inline-flex;align-items:center;gap:var(--space-8);font-size:var(--fs-14);color:var(--text-secondary);transition:color .2s ease;}
  .site-back:hover,.site-back:focus-visible{color:var(--accent);}
  .site-back svg{width:16px;height:16px;stroke-width:1.5;}
  .site-nav-toggle{display:none;flex-direction:column;gap:5px;cursor:pointer;background:none;border:none;padding:8px;border-radius:6px;}
  .site-nav-toggle span{width:22px;height:1.5px;background:var(--text);border-radius:2px;transition:transform .2s ease,opacity .2s ease;}
  .site-nav-backdrop{display:none;}

  @media(max-width:768px){
    .site-nav-inner{height:56px;}
    .site-nav-links{position:fixed;top:0;right:0;width:min(360px,84vw);height:100vh;height:100dvh;background:var(--bg);display:flex;flex-direction:column;justify-content:center;align-items:flex-start;padding:calc(56px + var(--space-24)) var(--space-32) var(--space-32);gap:var(--space-24);min-width:0;text-align:left;transform:translateX(102%);transition:transform .25s ease;visibility:hidden;border-left:1px solid var(--border);z-index:1002;box-shadow:-24px 0 64px rgba(0,0,0,.28);}
    .site-nav-links.open{transform:translateX(0);visibility:visible;}
    .site-nav-links a{font-size:var(--fs-16);padding:8px 0;}
    .site-nav-toggle{display:flex;z-index:1003;}
    .site-nav-backdrop:not([hidden]){display:block;position:fixed;inset:0;z-index:1001;background:rgba(0,0,0,.62);border:0;backdrop-filter:blur(2px);}
    body.nav-menu-open{overflow:hidden;}
    .site-nav-toggle.open span:nth-child(1){transform:rotate(45deg) translate(4px,4px);}
    .site-nav-toggle.open span:nth-child(2){opacity:0;}
    .site-nav-toggle.open span:nth-child(3){transform:rotate(-45deg) translate(4px,-4px);}
  }
</style>

<script>
  const toggle = document.getElementById('siteNavToggle');
  const links = document.getElementById('siteNavLinks');
  const backdrop = document.getElementById('siteNavBackdrop');
  if (toggle && links && backdrop) {
    const menuItems = Array.from(links.querySelectorAll('a[href]'));
    const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';

    const closeMenu = (restoreFocus = false) => {
      links.classList.remove('open');
      toggle.classList.remove('open');
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', '打开导航菜单');
      backdrop.hidden = true;
      document.body.classList.remove('nav-menu-open');
      if (restoreFocus) toggle.focus();
    };

    const openMenu = () => {
      links.classList.add('open');
      toggle.classList.add('open');
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', '关闭导航菜单');
      backdrop.hidden = false;
      document.body.classList.add('nav-menu-open');
      requestAnimationFrame(() => menuItems[0]?.focus());
    };

    toggle.addEventListener('click', () => isOpen() ? closeMenu(true) : openMenu());
    backdrop.addEventListener('click', () => closeMenu(true));
    menuItems.forEach((link) => link.addEventListener('click', () => closeMenu(false)));

    document.addEventListener('keydown', (event) => {
      if (!isOpen()) return;
      if (event.key === 'Escape') {
        event.preventDefault();
        closeMenu(true);
        return;
      }
      if (event.key !== 'Tab' || !menuItems.length) return;
      const first = menuItems[0];
      const last = menuItems[menuItems.length - 1];
      if (event.shiftKey && (document.activeElement === first || !links.contains(document.activeElement))) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && (document.activeElement === last || !links.contains(document.activeElement))) {
        event.preventDefault();
        first.focus();
      }
    });

    window.addEventListener('resize', () => {
      if (window.innerWidth > 768 && isOpen()) closeMenu(false);
    });
  }
</script>
