---
interface Props {
  active?: 'home' | 'focus' | 'insights' | 'about' | '';
  variant?: 'main' | 'article';
}
const { active = '', variant = 'main' } = Astro.props;
---
<nav class="site-nav">
  <div class="site-nav-inner">
    <a href="/" class="site-logo">
      <img class="site-logo-mark" src="/images/logo-mark.svg" alt="" decoding="async" width="24" height="24">
      个人商业创造者
    </a>
    <div class="site-nav-actions">
      <button type="button" class="site-nav-action" data-theme-toggle aria-label="切换明暗主题" aria-pressed="false">
        <svg data-icon-moon width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z"></path></svg>
        <svg data-icon-sun width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" hidden><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
      </button>
      <button type="button" class="site-nav-action" data-search-open aria-label="站内搜索">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
      </button>
    </div>
    <button class="site-nav-toggle" id="siteNavToggle" aria-label="打开导航菜单" aria-expanded="false" aria-controls="siteNavLinks"><span></span><span></span><span></span></button>
    <button class="site-nav-backdrop" id="siteNavBackdrop" type="button" aria-label="关闭导航菜单" hidden></button>
    <ul class="site-nav-links" id="siteNavLinks" aria-label="主导航">
      <li><a href="/" class:list={{ active: active === 'home' }} aria-current={active === 'home' ? 'page' : undefined}>首页</a></li>
      <li><a href="/#focus" class:list={{ active: active === 'focus' }} aria-current={active === 'focus' ? 'page' : undefined}>方向</a></li>
      <li><a href="/insights" class:list={{ active: active === 'insights' }} aria-current={active === 'insights' ? 'page' : undefined}>洞察</a></li>
      <li><a href="/about" class:list={{ active: active === 'about' }} aria-current={active === 'about' ? 'page' : undefined}>关于</a></li>
    </ul>
  </div>
</nav>

<style>
  .site-nav{position:fixed;top:0;left:0;right:0;z-index:1000;padding:0 var(--gutter);background:var(--surface);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border-bottom:1px solid var(--border);}
  .site-nav-inner{max-width:var(--container-w);margin:0 auto;width:100%;height:64px;display:flex;align-items:center;justify-content:space-between;gap:var(--space-24);}
  .site-logo{display:inline-flex;align-items:center;gap:var(--space-8);font-size:var(--fs-16);font-weight:600;color:var(--text);}
  .site-logo-mark{width:24px;height:24px;flex-shrink:0;display:block;}
  .site-nav-actions{display:flex;align-items:center;gap:var(--space-8);}
  .site-nav-action{display:inline-flex;align-items:center;justify-content:center;width:36px;height:36px;border:1px solid var(--border);border-radius:8px;background:none;color:var(--text-secondary);cursor:pointer;}
  .site-nav-action:hover,.site-nav-action:focus-visible{color:var(--accent);border-color:var(--accent);}
  .site-nav-links{display:grid;grid-template-columns:repeat(4,minmax(56px,1fr));gap:var(--space-12);list-style:none;margin:0;padding:0;min-width:296px;text-align:center;}
  .site-nav-links a{display:block;font-size:var(--fs-14);letter-spacing:.04em;color:var(--text-secondary);transition:color .2s ease;}
  .site-nav-links a:hover,.site-nav-links a.active,.site-nav-links a:focus-visible{color:var(--accent);}
  .site-nav-toggle{display:none;flex-direction:column;gap:5px;cursor:pointer;background:none;border:none;padding:8px;border-radius:6px;}
  .site-nav-toggle span{width:22px;height:1.5px;background:var(--text);border-radius:2px;transition:transform .2s ease,opacity .2s ease;}
  .site-nav-backdrop{display:none;}

  @media(max-width:768px){
    .site-nav-inner{height:56px;}
    .site-nav-links{position:fixed;top:0;right:0;width:min(360px,84vw);height:100vh;height:100dvh;background:var(--bg);display:flex;flex-direction:column;justify-content:center;align-items:flex-start;padding:calc(56px + var(--space-24)) var(--space-32) var(--space-32);gap:var(--space-24);min-width:0;text-align:left;transform:translateX(102%);transition:transform .25s ease;visibility:hidden;border-left:1px solid var(--border);z-index:1002;box-shadow:-24px 0 64px rgba(0,0,0,.28);}
    .site-nav-links.open{transform:translateX(0);visibility:visible;}
    .site-nav-links a{font-size:var(--fs-16);padding:8px 0;}
    .site-nav-toggle{display:flex;z-index:1003;}
    .site-nav-backdrop:not([hidden]){display:block;position:fixed;inset:0;z-index:1001;background:rgba(0,0,0,.62);border:0;backdrop-filter:blur(2px);}
    body.nav-menu-open{overflow:hidden;}
    .site-nav-toggle.open span:nth-child(1){transform:rotate(45deg) translate(4px,4px);}
    .site-nav-toggle.open span:nth-child(2){opacity:0;}
    .site-nav-toggle.open span:nth-child(3){transform:rotate(-45deg) translate(4px,-4px);}
  }
</style>

<script>
  // 使用事件委托，兼容 Astro ClientRouter 替换页面 body 后的导航 DOM。
  if (!window.__siteNavDelegationInstalled) {
    window.__siteNavDelegationInstalled = true;

    const getParts = () => ({
      toggle: document.getElementById('siteNavToggle'),
      links: document.getElementById('siteNavLinks'),
      backdrop: document.getElementById('siteNavBackdrop')
    });
    const isOpen = (toggle) => toggle?.getAttribute('aria-expanded') === 'true';

    const closeMenu = (restoreFocus = false) => {
      const { toggle, links, backdrop } = getParts();
      if (!toggle || !links || !backdrop) return;
      links.classList.remove('open');
      toggle.classList.remove('open');
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', '打开导航菜单');
      backdrop.hidden = true;
      document.body.classList.remove('nav-menu-open');
      if (restoreFocus) toggle.focus();
    };

    const openMenu = () => {
      const { toggle, links, backdrop } = getParts();
      if (!toggle || !links || !backdrop) return;
      const menuItems = Array.from(links.querySelectorAll('a[href]'));
      links.classList.add('open');
      toggle.classList.add('open');
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', '关闭导航菜单');
      backdrop.hidden = false;
      document.body.classList.add('nav-menu-open');
      requestAnimationFrame(() => menuItems[0]?.focus());
    };

    document.addEventListener('click', (event) => {
      const target = event.target instanceof Element ? event.target : null;
      if (!target) return;
      const { toggle, links, backdrop } = getParts();
      if (toggle && target.closest('#siteNavToggle')) {
        isOpen(toggle) ? closeMenu(true) : openMenu();
        return;
      }
      if (backdrop && target.closest('#siteNavBackdrop')) {
        closeMenu(true);
        return;
      }
      if (links && target.closest('#siteNavLinks a[href]')) closeMenu(false);
    });

    document.addEventListener('keydown', (event) => {
      const { toggle, links } = getParts();
      if (!toggle || !links || !isOpen(toggle)) return;
      if (event.key === 'Escape') {
        event.preventDefault();
        closeMenu(true);
        return;
      }
      if (event.key !== 'Tab') return;
      const menuItems = Array.from(links.querySelectorAll('a[href]'));
      if (!menuItems.length) return;
      const first = menuItems[0];
      const last = menuItems[menuItems.length - 1];
      if (event.shiftKey && (document.activeElement === first || !links.contains(document.activeElement))) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && (document.activeElement === last || !links.contains(document.activeElement))) {
        event.preventDefault();
        first.focus();
      }
    });

    window.addEventListener('resize', () => {
      const { toggle } = getParts();
      if (window.innerWidth > 768 && isOpen(toggle)) closeMenu(false);
    });

    document.addEventListener('astro:before-swap', () => closeMenu(false));
  }

  // 明暗主题切换：持久化到 localStorage，同步 <html data-theme>、theme-color 与图标。
  if (!window.__themeDelegationInstalled) {
    window.__themeDelegationInstalled = true;
    const root = document.documentElement;

    function applyTheme(t) {
      root.dataset.theme = t;
      try { localStorage.setItem('xm-theme', t); } catch (e) {}
      const btn = document.querySelector('[data-theme-toggle]');
      if (btn) {
        btn.setAttribute('aria-pressed', String(t === 'light'));
        const moon = btn.querySelector('[data-icon-moon]');
        const sun = btn.querySelector('[data-icon-sun]');
        if (moon) moon.hidden = t === 'light';
        if (sun) sun.hidden = t !== 'light';
      }
      const m = document.querySelector('meta[name="theme-color"]');
      if (m) m.setAttribute('content', t === 'light' ? '#F6F6F2' : '#0C0C0C');
    }

    document.addEventListener('click', (event) => {
      const target = event.target instanceof Element ? event.target : null;
      const btn = target && target.closest ? target.closest('[data-theme-toggle]') : null;
      if (!btn) return;
      applyTheme(root.dataset.theme === 'light' ? 'dark' : 'light');
    });
    document.addEventListener('astro:page-load', () => applyTheme(root.dataset.theme || 'dark'));
    applyTheme(root.dataset.theme || 'dark');
  }
</script>
