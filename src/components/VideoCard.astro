---
/**
 * 自建播放器：站点自己放一份 9:16 成片，播放器 UI 全部自己做。
 * 为什么不用抖音 iframe：那套播放器带抖音水印、关注按钮、底部「去抖音看」条，
 * 封面还会叠出重影（官方 poster 和首帧两层错位），放进文章里很难看。
 * 这里只保留：画面、中央播放键、进度条、时间，另加静音与全屏两个钮。
 */
interface Props {
  src?: string;
  poster: string;
  title: string;
  duration?: string;
  episode?: string;
  fallbackUrl?: string;
  /** card = 正文卡片尺寸（旧版三块叠排）；stage = 三态阅读的视频面（桌面限高 74vh） */
  size?: 'card' | 'stage';
}
const { src = '', poster, title, duration = '', fallbackUrl = '', size = 'card' } = Astro.props;
---
<section class:list={["vp", `vp-${size}`]} data-vp>
  <div class="vp-frame is-paused" data-frame>
    <video
      data-video
      data-src={src}
      poster={poster}
      title={title}
      playsinline
      preload="none"
      controlslist="nodownload"
      disablepictureinpicture></video>

    <div class="vp-fail" data-fail hidden>
      <p>这一集的视频暂时没加载出来</p>
      {fallbackUrl && (
        <a href={fallbackUrl} target="_blank" rel="noopener">去抖音看这一集 →</a>
      )}
    </div>

    <button type="button" class="vp-big" data-toggle aria-label="播放">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" /></svg>
    </button>

    <div class="vp-bar">
      <button type="button" class="vp-btn" data-toggle aria-label="播放或暂停">
        <svg class="i-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" /></svg>
        <svg class="i-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5h3v14H8zM13 5h3v14h-3z" /></svg>
      </button>
      <div class="vp-track" data-track>
        <div class="vp-fill" data-fill></div>
        <div class="vp-knob" data-knob></div>
      </div>
      <span class="vp-time"><b data-cur>00:00</b><span>/</span><span data-dur>{duration || '00:00'}</span></span>
      <button type="button" class="vp-btn" data-mute aria-label="静音">
        <svg class="i-sound" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9h3l4-3v12l-4-3H4zM15.5 8.5a5 5 0 0 1 0 7" /></svg>
        <svg class="i-muted" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9h3l4-3v12l-4-3H4zM15 9l5 6M20 9l-5 6" /></svg>
      </button>
      <button type="button" class="vp-btn" data-fs aria-label="全屏">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" /></svg>
      </button>
    </div>
  </div>
</section>

<style>
  .vp { margin: 0 0 var(--space-24); }
  .vp-head {
    display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-12);
    padding: 0 2px; margin-bottom: 10px;
  }
  .vp-kicker { margin: 0; font-size: var(--fs-12); letter-spacing: .06em; color: var(--accent); }
  .vp-note { font-size: 11px; color: var(--text-muted); letter-spacing: .04em; }

  .vp-frame {
    position: relative; margin: 0 auto; width: var(--vp-w, 400px); max-width: 100%;
    aspect-ratio: 9 / 16; background: #0B0B0B; border-radius: 12px; overflow: hidden;
    box-shadow: 0 1px 2px rgba(45, 49, 66, .08), 0 12px 28px -18px rgba(45, 49, 66, .45);
  }
  .vp-stage { --vp-w: min(400px, calc(74vh * 9 / 16)); }
  .vp-frame video { width: 100%; height: 100%; display: block; object-fit: cover; background: #0B0B0B; }

  .vp-fail {
    position: absolute; inset: 0; display: grid; align-content: center; justify-items: center; gap: 10px;
    padding: 24px; text-align: center; background: rgba(11, 11, 11, .78); color: #EDECE6;
  }
  .vp-fail[hidden] { display: none; }
  .vp-fail p { margin: 0; font-size: 13px; line-height: 1.6; color: #D5D4CE; }
  .vp-fail a {
    font-size: 13px; color: var(--accent); text-decoration: none; border-bottom: 1px solid currentColor;
    padding-bottom: 2px;
  }
  .vp-frame.is-fail .vp-big { display: none; }

  .vp-big {
    position: absolute; left: 50%; top: 50%; width: 62px; height: 62px; margin: -31px 0 0 -31px;
    display: grid; place-items: center; border: 0; border-radius: 50%; padding: 0;
    background: var(--accent); box-shadow: 0 8px 22px -10px rgba(20, 24, 20, .55); cursor: pointer;
    transition: opacity .2s ease, transform .16s ease, background .16s ease;
  }
  .vp-big svg { width: 24px; height: 24px; fill: var(--accent-ink); margin-left: 3px; }
  .vp-big:hover { transform: scale(1.05); background: var(--accent-hover); }
  .vp-frame.is-playing .vp-big { opacity: 0; pointer-events: none; }

  .vp-bar {
    position: absolute; left: 0; right: 0; bottom: 0; height: 46px;
    display: flex; align-items: center; gap: 8px; padding: 0 10px;
    background: linear-gradient(rgba(6, 6, 6, 0), rgba(6, 6, 6, .72) 55%);
    opacity: 0; transition: opacity .2s ease;
  }
  .vp-frame:hover .vp-bar,
  .vp-frame:focus-within .vp-bar,
  .vp-frame.is-paused .vp-bar { opacity: 1; }
  .vp-btn {
    flex: 0 0 auto; width: 26px; height: 26px; display: grid; place-items: center;
    border: 0; background: transparent; cursor: pointer; padding: 0; color: #EDECE6;
  }
  .vp-btn svg { width: 16px; height: 16px; fill: none; stroke: #EDECE6; stroke-width: 1.6; stroke-linejoin: round; }
  .vp-btn .i-play { fill: #EDECE6; stroke: none; width: 14px; height: 14px; }
  .vp-btn .i-play { display: none; }
  .vp-frame.is-paused .vp-btn[data-toggle] .i-play { display: block; }
  .vp-frame.is-paused .vp-btn[data-toggle] .i-pause { display: none; }

  .vp-track { position: relative; flex: 1 1 auto; height: 16px; display: flex; align-items: center; cursor: pointer; }
  .vp-track::before {
    content: ''; position: absolute; left: 0; right: 0; height: 3px; border-radius: 3px;
    background: rgba(237, 236, 230, .26);
  }
  .vp-fill {
    position: absolute; left: 0; height: 3px; border-radius: 3px; background: var(--accent);
    width: 0; transition: width .08s linear;
  }
  .vp-knob {
    position: absolute; left: 0; width: 9px; height: 9px; margin-left: -4px; border-radius: 50%;
    background: #EDECE6; transform: scale(.6); transition: transform .15s ease;
  }
  .vp-track:hover .vp-knob { transform: scale(1); }

  .vp-time { flex: 0 0 auto; font: 11px/1 'Inter', ui-monospace, monospace; color: #C9C8C2; letter-spacing: .02em; }
  .vp-time b { color: #EDECE6; font-weight: 400; }
  .vp-time span { margin: 0 2px; opacity: .7; }

  .vp-btn[data-mute] .i-muted { display: none; }
  .vp-frame.is-muted .vp-btn[data-mute] .i-sound { display: none; }
  .vp-frame.is-muted .vp-btn[data-mute] .i-muted { display: block; }

  @media (max-width: 720px) {
    .vp-stage { --vp-w: min(100%, calc(56vh * 9 / 16)); }
    .vp-frame { width: var(--vp-w, 100%); }
    .vp-bar { opacity: 1; }
    .vp-big { width: 56px; height: 56px; margin: -28px 0 0 -28px; }
    .vp-time { display: none; }
  }
</style>

<script slot="scripts" is:inline data-astro-rerun>
  (function () {
    document.querySelectorAll('[data-vp]').forEach(function (sec) {
      if (sec.dataset.ready === '1') return;
      sec.dataset.ready = '1';
      var frame = sec.querySelector('[data-frame]');
      var video = sec.querySelector('[data-video]');
      var fill = sec.querySelector('[data-fill]');
      var knob = sec.querySelector('[data-knob]');
      var track = sec.querySelector('[data-track]');
      var cur = sec.querySelector('[data-cur]');
      var dur = sec.querySelector('[data-dur]');
      var muted = false;
      var loaded = false;
      var fail = sec.querySelector('[data-fail]');
      function broke() {
        frame.classList.add('is-fail');
        fail.hidden = false;
        video.pause();
      }
      if (!video.dataset.src) broke();
      function load() {
        if (loaded) return;
        loaded = true;
        video.src = video.dataset.src;
      }

      function mmss(t) {
        if (!isFinite(t)) return '00:00';
        var total = Math.round(t);
        var m = Math.floor(total / 60), s = total % 60;
        return (m < 10 ? '0' + m : m) + ':' + (s < 10 ? '0' + s : s);
      }
      function paint() {
        var p = video.duration ? video.currentTime / video.duration : 0;
        fill.style.width = (p * 100).toFixed(2) + '%';
        knob.style.left = (p * 100).toFixed(2) + '%';
        cur.textContent = mmss(video.currentTime);
      }
      function state() {
        frame.classList.toggle('is-playing', !video.paused);
        frame.classList.toggle('is-paused', video.paused);
      }
      function toggle() {
        if (video.paused) { load(); var p = video.play(); if (p && p.catch) p.catch(function () {}); }
        else { video.pause(); }
      }

      video.addEventListener('loadedmetadata', function () { dur.textContent = mmss(video.duration); paint(); });
      video.addEventListener('timeupdate', paint);
      video.addEventListener('play', state);
      video.addEventListener('pause', state);
      video.addEventListener('ended', state);
      video.addEventListener('error', broke);

      sec.querySelectorAll('[data-toggle]').forEach(function (b) { b.addEventListener('click', toggle); });
      frame.addEventListener('click', function (e) {
        if (e.target.closest('.vp-bar') || e.target.closest('[data-toggle]')) return;
        toggle();
      });
      sec.querySelector('[data-mute]').addEventListener('click', function () {
        muted = !muted; video.muted = muted; frame.classList.toggle('is-muted', muted);
      });
      sec.querySelector('[data-fs]').addEventListener('click', function () {
        if (document.fullscreenElement) { document.exitFullscreen(); }
        else if (frame.requestFullscreen) { frame.requestFullscreen(); }
      });
      track.addEventListener('click', function (e) {
        load();
        if (!video.duration) return;
        var r = track.getBoundingClientRect();
        var x = e.clientX - r.left;
        var p = Math.max(0, Math.min(1, x / r.width));
        if (video.duration) { video.currentTime = p * video.duration; paint(); }
      });
      // 三态切换用：外部读/写播放位置，不碰内部状态机
      sec.__vp = {
        el: video,
        load: load,
        getTime: function () { return video.currentTime || 0; },
        pause: function () { video.pause(); },
        play: function () { load(); var p = video.play(); if (p && p.catch) p.catch(function () {}); },
        seekTo: function (secs) {
          if (!isFinite(secs) || secs <= 0) return;
          load();
          var apply = function () { try { video.currentTime = secs; paint(); } catch (e) {} };
          if (video.readyState > 0) apply();
          else video.addEventListener('loadedmetadata', apply, { once: true });
        },
      };
      state();    });
  })();
</script>
