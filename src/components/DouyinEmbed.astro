---
/**
 * 抖音官方播放器嵌入组件。
 *
 * 只用官方开放播放器 open.douyin.com/player/video（实测无 X-Frame-Options / 无 frame-ancestors，可跨站嵌入）。
 * 分享页 www.douyin.com/video/{id} 带 X-Frame-Options: DENY，不可嵌入，仅作"去抖音观看"外链。
 *
 * 尺寸结论（多轮实测，含官方文档对照）：
 * - 播放器内部内容宽度**固定 325px**（TikTok 官方 embed 文档同样给 325×578 的竖版最小尺寸），
 *   容器一旦宽于 325，右侧就会露出 iframe 自己的白底，看起来像"右边一大块白屏"；
 * - 所以 iframe 必须锁定 325×730 原生尺寸，不能靠 CSS 拉伸宽度；
 * - 想显示更大时用 transform: scale() 整体放大（不动 iframe 尺寸，画面比例与铺满都不受影响）；
 * - 不要用放大 iframe 宽度再裁边的做法：内部会连封面顶部一起裁掉。
 */
interface Props {
  id: string;
  /** '9:16' | '16:9' | '1:1' | '4:3' | '3:4' | 'auto'；仅用于语义与后续 SEO，不驱动布局 */
  ratio?: string;
  title?: string;
  /** 原始分享链接，缺省按 video_id 拼 douyin.com */
  url?: string;
}

const { id, ratio = 'auto', title = '抖音视频', url } = Astro.props;

const playerSrc = `https://open.douyin.com/player/video?vid=${id}&autoplay=0`;
const watchUrl = url?.trim() || `https://www.douyin.com/video/${id}`;
---

<div class="dy-embed" data-ratio={ratio}>
  <div class="dy-stage">
    <iframe
      src={playerSrc}
      title={title}
      width="325"
      height="730"
      allowfullscreen
      scrolling="no"
      referrerpolicy="unsafe-url"
      allow="autoplay; fullscreen; encrypted-media; picture-in-picture"
    ></iframe>
  </div>
  <p class="dy-note">
    <span class="dy-badge">抖音</span>
    <a href={watchUrl} target="_blank" rel="noopener noreferrer">在抖音观看 ↗</a>
  </p>
</div>

<style>
  .dy-embed {
    margin: 0 auto var(--space-32, 32px);
  }
  /* 舞台：宽度 = 325 * scale，播放器画面正好铺满，不出现白边 */
  .dy-stage {
    position: relative;
    width: 325px;
    height: 730px;
    margin: 0 auto;
    background: #000;
    border-radius: 12px;
    overflow: hidden;
  }
  .dy-stage iframe {
    width: 325px;
    height: 730px;
    border: 0;
    display: block;
    transform-origin: top left;
  }
  .dy-note {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin: 2px auto 0;
    max-width: 325px;
    font-size: 12px;
    line-height: 1.6;
    color: var(--text-muted, #888);
  }
  .dy-badge {
    display: inline-flex;
    align-items: center;
    padding: 1px 6px;
    border: 1px solid var(--border, #2a2a2a);
    border-radius: 4px;
    font-size: 11px;
    color: var(--text-secondary, #aaa);
    letter-spacing: .02em;
  }
  .dy-note a {
    color: var(--accent, #c8e64a);
    border-bottom: 1px solid transparent;
    text-decoration: none;
  }
  .dy-note a:hover,
  .dy-note a:focus-visible {
    border-bottom-color: currentColor;
  }

  /* 手机端：略微放大到 357（422 视口下正好落在版心内），保持铺满 */
  @media (min-width: 400px) and (max-width: 720px) {
    .dy-stage {
      width: 357px;
      height: 802px;
    }
    .dy-stage iframe {
      transform: scale(1.0985);
    }
    .dy-note {
      max-width: 357px;
    }
  }

  /* 桌面端：放大到 380，避免在宽版心里显得过小 */
  @media (min-width: 721px) {
    .dy-stage {
      width: 380px;
      height: 854px;
    }
    .dy-stage iframe {
      transform: scale(1.16923);
    }
    .dy-note {
      max-width: 380px;
    }
  }

  @media print {
    .dy-embed { display: none; }
  }
</style>
