---
/**
 * 放映区：deck 就地嵌在文章里（三态阅读的「PPT」面），不弹全屏浮层。
 * 关键取舍：deck 上面盖一层透明护盾（.decksec-shield），指针事件永远不落进 iframe。
 * 为什么不靠 deck 回传 dy 来滚页面：手指在 iframe 里算出来的 dy 是「相对 iframe」的，
 * 页面一滚、iframe 跟着手指一起动，delta 被污染成 0 甚至反向，越划越卡。
 * 盖了护盾以后竖向滚动完全交给浏览器原生滚动，父窗口只管横向意图与翻页。
 */
interface Props {
  path: string;
  count: number;
  note?: string;
  /** inline = 旧版三段叠排的整栏宽度；stage = 三态阅读的 PPT 面（桌面限高 74vh、居中） */
  size?: 'inline' | 'stage';
}
const { path, count, note = '点左右或横滑翻页 · 竖着滑继续读下面正文', size = 'inline' } = Astro.props;
const deckSrc = `/decks/${path}/index.html`;
---

<section class:list={['decksec', `decksec--${size}`]} data-deck={path} data-count={count} id="deck">
  <div class="decksec-stage" data-deck-stage>
    <div class="decksec-frame">
      <iframe
        data-deck-iframe
        src={deckSrc}
        title="WebPPT 放映"
        allow="fullscreen"
        scrolling="no"
        loading="eager"></iframe>
      <span class="decksec-shield" data-deck-shield aria-hidden="true"></span>
    </div>
    <button type="button" class="deck-nav prev" data-deck-go="-1" aria-label="上一页">‹</button>
    <button type="button" class="deck-nav next" data-deck-go="1" aria-label="下一页">›</button>
  </div>

  <div class="decksec-pager" data-deck-pager>
    <span class="decksec-dots" data-deck-dots aria-hidden="true"></span>
    <span class="decksec-count"><b data-deck-cur>1</b><span>/</span>{count}<span class="decksec-pct" data-deck-pct>14%</span></span>
  </div>

  <p class="decksec-hint">
    <span class="decksec-swipe" aria-hidden="true">⇄</span>
    {note}
  </p>
</section>

<style>
  .decksec { margin: 0; }

  /* 三态阅读：PPT 面不铺满整栏，桌面限高 74vh（≈330 宽），整块居中 */
  .decksec--stage .decksec-stage { width: fit-content; max-width: 100%; margin: 0 auto; }
  /* 74vh 要连 pager / hint 一起算进去，否则底部页码会被视口切掉 */
  .decksec--stage .decksec-frame { width: min(460px, calc((74vh - 84px) * 9 / 16)); }
  .decksec--stage .decksec-pager,
  .decksec--stage .decksec-hint { width: fit-content; margin-left: auto; margin-right: auto; }

  .decksec-stage {
    position: relative;
    display: flex; justify-content: center;
    padding: var(--space-12);
    background: var(--deck-plate, var(--surface));
    border: 1px solid var(--border); border-radius: var(--radius);
  }
  /* iframe 与护盾共用同一块尺寸：护盾要严丝合缝盖住，不能留缝让指针漏进去 */
  .decksec-frame {
    position: relative;
    width: min(460px, 100%); aspect-ratio: 9 / 16;
    border-radius: var(--radius-sm);
    box-shadow: 0 10px 30px -24px rgba(0, 0, 0, .55);
  }
  .decksec-frame iframe {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    border: 0; display: block; background: var(--surface-2); border-radius: var(--radius-sm);
  }
  /* 透明护盾：只接手势，不画东西。竖向滚动是原生滚动（不 preventDefault），
     横向留给脚本翻页，所以 touch-action 只放 pan-y。 */
  .decksec-shield {
    position: absolute; inset: 0; z-index: 2;
    display: block;
    touch-action: pan-y;
    cursor: default;
    border-radius: var(--radius-sm);
  }
  .deck-nav {
    position: absolute; top: 50%; transform: translateY(-50%); z-index: 3;
    width: 34px; height: 34px; display: grid; place-items: center;
    border: 1px solid var(--border); border-radius: 50%;
    background: var(--surface); color: var(--text-secondary);
    font: 400 17px/1 'Inter', sans-serif; cursor: pointer; padding: 0;
  }
  .deck-nav.prev { left: 8px; }
  .deck-nav.next { right: 8px; }
  .deck-nav:hover { color: var(--accent-ink); background: var(--accent); border-color: var(--accent); }

  .decksec-pager {
    display: flex; align-items: center; gap: var(--space-12);
    margin-top: var(--space-12);
    padding: 0 2px;
  }
  .decksec-dots { display: flex; gap: 5px; }
  /* 点是由脚本运行时插进来的，拿不到 Astro 作用域属性，必须走 :global() */
  .decksec-dots :global(i) {
    display: block; width: 5px; height: 5px; border-radius: 50%;
    background: var(--text-muted); opacity: .45;
    transition: background-color .18s ease, width .18s ease, opacity .18s ease;
  }
  .decksec-dots :global(i.on) { background: var(--accent); opacity: 1; width: 14px; border-radius: 3px; }
  .decksec-count {
    font: 400 11.5px/1 'Inter', ui-monospace, monospace;
    color: var(--text-muted); letter-spacing: .04em;
    font-variant-numeric: tabular-nums;
  }
  .decksec-count b { color: var(--text); font-weight: 600; }
  .decksec-count span { margin: 0 3px; opacity: .7; }
  .decksec-pct { margin-left: var(--space-8); color: var(--text-muted); }

  .decksec-hint {
    display: flex; align-items: center; gap: 6px; margin: var(--space-8) 0 0;
    font-size: 11.5px; color: var(--text-muted);
  }
  .decksec-swipe { color: var(--accent); font-size: 13px; }

  @media (max-width: 720px) {
    .decksec-stage { padding: var(--space-8); }
    .decksec-frame { width: 100%; }
    .decksec--stage .decksec-stage { width: auto; }
    .decksec--stage .decksec-frame { width: 100%; }
    .deck-nav { width: 30px; height: 30px; font-size: 15px; }
    .decksec-hint { display: none; }
  }
</style>

<script slot="scripts" is:inline data-astro-rerun>
  (function () {
    document.querySelectorAll('[data-deck]').forEach(function (sec) {
      if (sec.dataset.ready === '1') return;
      sec.dataset.ready = '1';
      var stage = sec.querySelector('[data-deck-stage]');
      var iframe = sec.querySelector('[data-deck-iframe]');
      var shield = sec.querySelector('[data-deck-shield]');
      var dotsBox = sec.querySelector('[data-deck-dots]');
      var curEl = sec.querySelector('[data-deck-cur]');
      var pctEl = sec.querySelector('[data-deck-pct]');
      var count = Number(sec.dataset.count) || 0;
      var index = 0;

      function post(msg) {
        if (!iframe.contentWindow) return;
        iframe.contentWindow.postMessage(msg, '*');
      }
      function draw() {
        if (curEl) curEl.textContent = String(index + 1);
        if (pctEl && count) pctEl.textContent = Math.round(((index + 1) / count) * 100) + '%';
        if (dotsBox) {
          Array.prototype.forEach.call(dotsBox.children, function (d, i) {
            d.classList.toggle('on', i === index);
          });
        }
        sec.dataset.index = String(index);
      }
      function setIndex(i) {
        index = Math.max(0, Math.min(count ? count - 1 : 0, i));
        draw();
      }
      function go(dir) {
        setIndex(index + dir);
        post({ type: 'webppt:go', dir: dir });
      }
      // 给外层（三态切换时定位页码）用的入口
      sec.__deckGoTo = function (i) {
        setIndex(i);
        post({ type: 'webppt:to', index: i });
      };

      if (dotsBox && count) {
        for (var k = 0; k < count; k++) dotsBox.appendChild(document.createElement('i'));
      }
      draw();

      sec.querySelectorAll('[data-deck-go]').forEach(function (b) {
        b.addEventListener('click', function (e) {
          e.stopPropagation();
          go(Number(b.dataset.deckGo));
        });
      });

      if (!shield) return;

      // 点护盾：按左右半区翻页（deck 自己收不到指针，语义由这里补齐）
      shield.addEventListener('click', function (e) {
        var r = shield.getBoundingClientRect();
        go(e.clientX < r.left + r.width * 0.4 ? -1 : 1);
      });

      // 横向滚轮/触控板横滑 = 翻页；竖向一律放行，走浏览器原生滚动
      var locked = false;
      shield.addEventListener('wheel', function (e) {
        if (Math.abs(e.deltaX) <= Math.abs(e.deltaY) + 2 || Math.abs(e.deltaX) < 6) return;
        e.preventDefault();
        if (locked) return;
        locked = true;
        setTimeout(function () { locked = false; }, 550);
        go(e.deltaX > 0 ? 1 : -1);
      }, { passive: false });

      // 手指横滑 = 翻页；竖向放行（touch-action: pan-y 已经让浏览器自己滚）
      var tx = 0, ty = 0, axis = 0, live = false;
      shield.addEventListener('touchstart', function (e) {
        if (e.touches.length !== 1) return;
        tx = e.touches[0].clientX; ty = e.touches[0].clientY; axis = 0; live = true;
      }, { passive: true });
      shield.addEventListener('touchmove', function (e) {
        if (!live) return;
        var dx = e.touches[0].clientX - tx, dy = e.touches[0].clientY - ty;
        if (!axis && (Math.abs(dx) > 8 || Math.abs(dy) > 8)) axis = Math.abs(dx) > Math.abs(dy) ? 1 : 2;
        if (axis === 1) e.preventDefault();
      }, { passive: false });
      shield.addEventListener('touchend', function (e) {
        if (!live) return;
        live = false;
        if (axis !== 1) return;
        var dx = e.changedTouches[0].clientX - tx;
        if (Math.abs(dx) > 36) go(dx < 0 ? 1 : -1);
      }, { passive: true });
    });
  })();
</script>
