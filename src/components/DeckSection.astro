---
/**
 * 放映区：直接把 deck 嵌在文章里，不再弹全屏浮层。
 * 关键取舍：deck 上面盖一层透明护盾（.decksec-shield），指针事件永远不落进 iframe。
 * 为什么不靠 deck 回传 dy 来滚页面：手指在 iframe 里算出来的 dy 是「相对 iframe」的，
 * 页面一滚、iframe 跟着手指一起动，delta 就被污染成 0 甚至反向，越划越卡（线上就是这么坏的）。
 * 盖了护盾以后，竖向滚动完全交给浏览器原生滚动（惯性、deltaMode、iOS 惯性全都正常），
 * 父窗口只管横向意图：横滑 / 横滚翻页，点击左右半区翻页。
 */
interface Props {
  path: string;
  count: number;
  note?: string;
}
const { path, count, note = '点左右或横滑翻页 · 竖着滑继续读下面正文' } = Astro.props;
const deckSrc = `/decks/${path}/index.html`;
---

<section class="decksec" data-deck={path} id="deck">
  <div class="decksec-stage" data-deck-stage>
    <div class="decksec-frame">
      <iframe
        data-deck-iframe
        src={deckSrc}
        title="WebPPT 放映"
        allow="fullscreen"
        scrolling="no"
        loading="eager"></iframe>
      <span class="decksec-shield" data-deck-shield aria-hidden="true"></span>
    </div>
    <button type="button" class="deck-nav prev" data-deck-go="-1" aria-label="上一页">‹</button>
    <button type="button" class="deck-nav next" data-deck-go="1" aria-label="下一页">›</button>
  </div>

  <p class="decksec-hint">
    <span class="decksec-swipe" aria-hidden="true">⇄</span>
    {note}
  </p>
</section>

<style>
  .decksec { margin: 0; }
  .decksec-head {
    display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between;
    gap: var(--space-8); padding-bottom: var(--space-12);
  }
  .decksec-head b { font-size: 15px; color: var(--text); letter-spacing: .01em; }
  .decksec-head span { font-size: 12px; color: var(--text-muted); }

  .decksec-stage {
    position: relative;
    display: flex; justify-content: center;
    padding: 12px; margin-top: var(--space-12);
    background: var(--deck-plate, rgba(255, 255, 255, .9));
    border: 1px solid var(--border); border-radius: var(--radius);
  }
  /* iframe 与护盾共用同一块尺寸：护盾要严丝合缝盖住，不能留缝让指针漏进去 */
  .decksec-frame {
    position: relative;
    width: min(460px, 100%); aspect-ratio: 9 / 16;
    border-radius: 6px;
    box-shadow: 0 2px 10px -6px rgba(0, 0, 0, .45);
  }
  .decksec-frame iframe {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    border: 0; display: block; background: #F5F5F5; border-radius: 6px;
  }
  /* 透明护盾：只负责接手势，不画东西。竖向滚动是原生滚动（不 preventDefault），
     横向留给下面的脚本翻页，所以 touch-action 只放 pan-y。 */
  .decksec-shield {
    position: absolute; inset: 0; z-index: 2;
    display: block;
    touch-action: pan-y;
    cursor: default;
  }
  .deck-nav {
    position: absolute; top: 50%; transform: translateY(-50%); z-index: 3;
    width: 34px; height: 34px; display: grid; place-items: center;
    border: 1px solid var(--border); border-radius: 50%;
    background: var(--surface); color: var(--text-secondary);
    font: 400 17px/1 'Inter', sans-serif; cursor: pointer; padding: 0;
    transition: color .18s ease, border-color .18s ease, opacity .18s ease;
  }
  .deck-nav.prev { left: 8px; }
  .deck-nav.next { right: 8px; }
  .deck-nav:hover { color: var(--accent); border-color: var(--accent); }
  @media (max-width: 720px) {
    .deck-nav { width: 30px; height: 30px; font-size: 15px; }
  }

  .decksec-hint {
    display: flex; align-items: center; gap: 6px; margin: var(--space-12) 0 0;
    font-size: 12px; color: var(--text-secondary);
  }
  .decksec-swipe { color: var(--accent-hover); font-size: 14px; }

  @media (max-width: 720px) {
    .decksec-stage { padding: var(--space-8); }
    .decksec-frame { width: 100%; }
  }
</style>

<script slot="scripts" is:inline data-astro-rerun>
  (function () {
    document.querySelectorAll('[data-deck]').forEach(function (sec) {
      if (sec.dataset.ready === '1') return;
      sec.dataset.ready = '1';
      var stage = sec.querySelector('[data-deck-stage]');
      var iframe = sec.querySelector('[data-deck-iframe]');
      var shield = sec.querySelector('[data-deck-shield]');

      // 翻页指令发给 iframe 里的 deck（它自己管缓动与进度点）
      function go(dir) {
        if (!iframe.contentWindow) return;
        iframe.contentWindow.postMessage({ type: 'webppt:go', dir: dir }, '*');
      }

      sec.querySelectorAll('[data-deck-go]').forEach(function (b) {
        b.addEventListener('click', function (e) {
          e.stopPropagation();
          go(Number(b.dataset.deckGo));
        });
      });

      if (!shield) return;

      // 点护盾：按左右半区翻页（deck 自己收不到指针，语义由这里补齐）
      shield.addEventListener('click', function (e) {
        var r = shield.getBoundingClientRect();
        go(e.clientX < r.left + r.width * 0.4 ? -1 : 1);
      });

      // 横向滚轮/触控板横滑 = 翻页；竖向一律放行，走浏览器原生滚动
      var locked = false;
      shield.addEventListener('wheel', function (e) {
        if (Math.abs(e.deltaX) <= Math.abs(e.deltaY) + 2 || Math.abs(e.deltaX) < 6) return;
        e.preventDefault();
        if (locked) return;
        locked = true;
        setTimeout(function () { locked = false; }, 550);
        go(e.deltaX > 0 ? 1 : -1);
      }, { passive: false });

      // 手指横滑 = 翻页；竖向放行（touch-action: pan-y 已经让浏览器自己滚）
      var tx = 0, ty = 0, axis = 0, live = false;
      shield.addEventListener('touchstart', function (e) {
        if (e.touches.length !== 1) return;
        tx = e.touches[0].clientX; ty = e.touches[0].clientY; axis = 0; live = true;
      }, { passive: true });
      shield.addEventListener('touchmove', function (e) {
        if (!live) return;
        var dx = e.touches[0].clientX - tx, dy = e.touches[0].clientY - ty;
        if (!axis && (Math.abs(dx) > 8 || Math.abs(dy) > 8)) axis = Math.abs(dx) > Math.abs(dy) ? 1 : 2;
        if (axis === 1) e.preventDefault();
      }, { passive: false });
      shield.addEventListener('touchend', function (e) {
        if (!live) return;
        live = false;
        if (axis !== 1) return;
        var dx = e.changedTouches[0].clientX - tx;
        if (Math.abs(dx) > 36) go(dx < 0 ? 1 : -1);
      }, { passive: true });
    });
  })();
</script>
