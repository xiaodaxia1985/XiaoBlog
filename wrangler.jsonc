{
  // Cloudflare Workers 静态资源部署配置。
  // 构建命令：npm run build；部署命令：npx wrangler deploy；Root：/（仓库根目录，本文件所在位置）
  "name": "xiaoblog",
  "compatibility_date": "2026-11-07",
  "assets": {
    // Astro 默认 build.format = 'directory'，产物形如 /insight/<slug>/index.html
    // auto-trailing-slash：访问 /insight/<slug> 时自动 301 到 /insight/<slug>/，再命中 index.html
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    // 未匹配路由返回 dist/404.html（由 src/pages/404.astro 生成）
    "not_found_handling": "404-page"
  }
}
