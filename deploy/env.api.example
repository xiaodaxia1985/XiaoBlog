# 薄 API 环境变量样例（部署到 server/.env，权限 600，属主 xb，不进前端产物）。
# 真实值由 deploy/setup-ecs.sh 生成，这里仅作字段说明。

# PostgreSQL 连接串：脚本按下面的库名/角色/密码生成。
DATABASE_URL=postgres://xb_api:__GENERATED__@127.0.0.1:5432/xb_api

# 站点对外原始地址，用于浏览器 Origin/Referer 同源校验。
# IP 联调期填 http://39.96.115.35；上线切域名后填 https://xiaomaker.top
SITE_URL=http://39.96.115.35

# 访客标识哈希盐：长随机串（≥8 位），脚本用 openssl 生成 32 字节十六进制。
VISITOR_SALT=__GENERATED__

# slug 白名单清单，相对 server/ 工作目录；由前端构建 scripts/gen-slugs.mjs 产出。
SLUG_WHITELIST_FILE=../public/data/slugs.json

PORT=8787
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW=1 minute
